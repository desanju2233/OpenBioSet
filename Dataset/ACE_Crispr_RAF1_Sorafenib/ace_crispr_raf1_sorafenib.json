      },
      {
        "phase": "BB2_BB3_CTRL_QC",
        "label": "Ctrl Arm QC Gate",
        "basic_block": "BB2_or_BB3",
        "branch_variable": "signalCtrl6",
        "branch_variable_description": "Vehicle-only baseline for Ctrl arm (0 uM Sorafenib + Ctrl sgRNA). All Ctrl-arm viabilities normalised to this value.",
        "branches": [
          {
            "condition": "signalCtrl6 > 0",
            "basic_block": "BB2",
            "compiler_label": "bsbbif_2_t",
            "outcome": "QC PASS — data accepted",
            "operations": [
              {"op": "dispose", "targets": ["viabCtrl1","viabCtrl2","viabCtrl3","viabCtrl4","viabCtrl5","viabCtrl6"]}
            ]
          },
          {
            "condition": "signalCtrl6 <= 0",
            "basic_block": "BB3",
            "compiler_label": "bsbbif_3_f",
            "outcome": "QC FAIL — arm flagged bad",
            "operations": [
              {"op": "drain", "targets": ["viabCtrl1","viabCtrl2","viabCtrl3","viabCtrl4","viabCtrl5","viabCtrl6"]}
            ]
          }
        ]
      },
      {
        "phase": "BB4_CTRL_QC_JOIN",
        "label": "Ctrl Arm QC Join",
        "basic_block": "BB4",
        "compiler_label": "bsbbif_4_j",
        "notes": "Dispose all Ctrl-arm signal droplets regardless of QC outcome. Distinct basic block — separates the Ctrl join from the RAF1 branch entry, producing the clean 4→5/4→6 split in the DOT graph.",
        "operations": [
          {
            "op": "dispose",
            "targets": ["signalCtrl1","signalCtrl2","signalCtrl3","signalCtrl4","signalCtrl5","signalCtrl6"]
          }
        ]
      },
      {
        "phase": "BB5_BB6_RAF1_QC",
        "label": "RAF1 Arm QC Gate",
        "basic_block": "BB5_or_BB6",
        "branch_variable": "signalRaf6",
        "branch_variable_description": "Vehicle-only baseline for RAF1 arm (0 uM Sorafenib + RAF1_sg94 sgRNA). Independent of Ctrl arm QC.",
        "branches": [
          {
            "condition": "signalRaf6 > 0",
            "basic_block": "BB5",
            "compiler_label": "bsbbif_5_t",
            "outcome": "QC PASS — data accepted",
            "operations": [
              {"op": "dispose", "targets": ["viabRaf1","viabRaf2","viabRaf3","viabRaf4","viabRaf5","viabRaf6"]}
            ]
          },
          {
            "condition": "signalRaf6 <= 0",
            "basic_block": "BB6",
            "compiler_label": "bsbbif_6_f",
            "outcome": "QC FAIL — arm flagged bad",
            "operations": [
              {"op": "drain", "targets": ["viabRaf1","viabRaf2","viabRaf3","viabRaf4","viabRaf5","viabRaf6"]}
            ]
          }
        ]
      },
