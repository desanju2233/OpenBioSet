              {"input": "viabCtrl3", "output": "signalCtrl3"},
              {"input": "viabCtrl4", "output": "signalCtrl4"},
              {"input": "viabCtrl5", "output": "signalCtrl5"},
              {"input": "viabCtrl6", "output": "signalCtrl6"},
              {"input": "viabRaf1",  "output": "signalRaf1"},
              {"input": "viabRaf2",  "output": "signalRaf2"},
              {"input": "viabRaf3",  "output": "signalRaf3"},
              {"input": "viabRaf4",  "output": "signalRaf4"},
              {"input": "viabRaf5",  "output": "signalRaf5"},
