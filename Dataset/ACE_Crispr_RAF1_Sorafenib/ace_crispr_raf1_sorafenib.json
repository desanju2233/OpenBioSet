          {
            "step": 21,
            "op": "mix",
            "pairs": [
              {"input_a": "freshCtrl1", "input_b": "ctrlCell1", "output": "maintainCtrl1"},
              {"input_a": "freshCtrl2", "input_b": "ctrlCell2", "output": "maintainCtrl2"},
              {"input_a": "freshCtrl3", "input_b": "ctrlCell3", "output": "maintainCtrl3"},
              {"input_a": "freshCtrl4", "input_b": "ctrlCell4", "output": "maintainCtrl4"},
              {"input_a": "freshCtrl5", "input_b": "ctrlCell5", "output": "maintainCtrl5"},
              {"input_a": "freshCtrl6", "input_b": "ctrlCell6", "output": "maintainCtrl6"},
              {"input_a": "freshRaf1",  "input_b": "rafCell1",  "output": "maintainRaf1"},
              {"input_a": "freshRaf2",  "input_b": "rafCell2",  "output": "maintainRaf2"},
              {"input_a": "freshRaf3",  "input_b": "rafCell3",  "output": "maintainRaf3"},
              {"input_a": "freshRaf4",  "input_b": "rafCell4",  "output": "maintainRaf4"},
