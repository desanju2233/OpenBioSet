{
  "protocol": {
    "metadata": {
      "id": "ace_crispr_raf1_sorafenib",
      "title": "Automated CRISPR-Cas9 Gene Editing: RAF1 Knockout + Sorafenib Inhibition on DMF (ACE Platform)",
      "source": {
        "citation": "Sinha H, Quach ABV, Vo PQN, Shih SCC. An automated microfluidic gene-editing platform for deciphering cancer genes. Lab Chip. 2018;18:2300-2312.",
        "doi": "10.1039/c8lc00470f"
      },
      "platform": "Digital Microfluidics (DMF) — ACE platform, DropBot-compatible",
      "cell_line": "NCI-H1299 (human lung squamous cell carcinoma, dual-labeled stable)",
      "assay_type": "MAPK/ERK pathway — CRISPR-Cas9 RAF1 knockout + Sorafenib Tosylate dose-response",
      "experimental_design": {
        "arms": 2,
        "arm_labels": ["Ctrl_sgRNA", "RAF1_sg94"],
        "drug_concentrations_uM": [120, 60, 30, 15, 7.5, 0],
        "total_sites": 12,
        "readout": "Calcein-AM violet cell viability (Fig. 4c on-chip, Fig. 4d off-chip)",
        "duration_days": 5
      },
      "bs_source_file": "ace_crispr_raf1_sorafenib_corrected.bs",
      "cfg_dot_file": "ace_crispr_raf1_sorafenib_main_dag.dot"
    },

    "modules": [
      "fluorescenceImaging",
      "cellViabilityAssay"
    ],

    "manifests": [
      {
        "name": "cellSuspension",
        "description": "NCI-H1299 cells at ~1.75e6 cells/mL in RPMI-1640 complete media + 0.05% w/v Pluronics F-68"
      },
      {
        "name": "lipofectamine",
        "description": "Invitrogen Lipofectamine 3000 transfection reagent, diluted in Opti-MEM"
      },
      {
        "name": "optiMEM",
        "description": "Opti-MEM reduced serum medium (Thermo Fisher), used as diluent for transfection reagents"
      },
      {
        "name": "p3000Reagent",
        "description": "P3000 enhancer reagent for Lipofectamine 3000 transfection"
      },
      {
        "name": "pCRISPR_ctrl",
        "description": "All-in-one pCRISPR/Cas9 plasmid with sgRNA targeting eGFP (non-genomic control, ~10.5 kb)"
      },
      {
        "name": "pCRISPR_RAF1",
        "description": "All-in-one pCRISPR/Cas9 plasmid with sgRNA RAF1_sg94 targeting the RAF1 genomic locus (~10.5 kb)"
      },
      {
        "name": "completeMedia",
        "description": "RPMI-1640 + 10% FBS, no antibiotics; used for cell maintenance and drug dilutions"
      },
      {
        "name": "calceinAM",
        "description": "Calcein-AM violet (5 uM working concentration); live-cell esterase viability probe, lambda_ex=408nm, lambda_em=450nm"
      },
      {
        "name": "sorafenib",
        "description": "Sorafenib Tosylate stock solution (Selleckchem); RAF kinase inhibitor used for dose-response assay"
      },
      {
        "name": "hoechst",
        "description": "Hoechst 33342 (1 uM working concentration); nuclear stain for Day-1 transfection-efficiency checkpoint only, lambda_ex=350nm, lambda_em=461nm. NOTE: not used at Day 5 due to spectral overlap with Calcein-AM violet."
      }
    ],

    "cfg": {
      "description": "Control-flow graph for the main function. Matches compiler output ace_crispr_raf1_sorafenib_main_dag.dot exactly.",
      "basic_blocks": [
        {
          "id": "BB1",
          "compiler_label": "main",
          "dot_node": 1,
          "role": "entry",
          "days": "Day 0 through Day 5 detection",
          "successors": [
            {"target": "BB2", "condition": "signalCtrl6 > 0"},
            {"target": "BB3", "condition": "signalCtrl6 <= 0"}
          ]
        },
        {
          "id": "BB2",
          "compiler_label": "bsbbif_2_t",
          "dot_node": 2,
          "role": "ctrl_qc_pass",
          "description": "Ctrl arm QC passed — dispose viabCtrl1..6",
          "successors": [{"target": "BB4", "condition": "unconditional"}]
        },
        {
          "id": "BB3",
          "compiler_label": "bsbbif_3_f",
          "dot_node": 3,
          "role": "ctrl_qc_fail",
          "description": "Ctrl arm QC failed — drain viabCtrl1..6",
          "successors": [{"target": "BB4", "condition": "unconditional"}]
        },
        {
          "id": "BB4",
          "compiler_label": "bsbbif_4_j",
          "dot_node": 4,
          "role": "ctrl_qc_join",
          "description": "Dispose signalCtrl1..6 regardless of QC outcome; enter RAF1 arm QC branch",
          "successors": [
            {"target": "BB5", "condition": "signalRaf6 > 0"},
            {"target": "BB6", "condition": "signalRaf6 <= 0"}
          ]
        },
        {
          "id": "BB5",
          "compiler_label": "bsbbif_5_t",
          "dot_node": 5,
          "role": "raf1_qc_pass",
          "description": "RAF1 arm QC passed — dispose viabRaf1..6",
          "successors": [{"target": "BB7", "condition": "unconditional"}]
        },
        {
          "id": "BB6",
          "compiler_label": "bsbbif_6_f",
          "dot_node": 6,
          "role": "raf1_qc_fail",
          "description": "RAF1 arm QC failed — drain viabRaf1..6",
          "successors": [{"target": "BB7", "condition": "unconditional"}]
        },
        {
          "id": "BB7",
          "compiler_label": "bsbbif_7_j",
          "dot_node": 7,
          "role": "raf1_qc_join",
          "description": "Dispose signalRaf1..6 regardless of QC outcome; fall into BB8",
          "successors": [{"target": "BB8", "condition": "unconditional"}]
        },
        {
          "id": "BB8",
          "compiler_label": "finalCleanup",
          "dot_node": null,
          "role": "terminal",
          "description": "No instructions. Single exit node. Compiler emits no extra node since BB7 has no further instructions.",
          "successors": []
        }
      ]
    },

    "protocol_phases": [
      {
        "phase": "DAY_0",
        "label": "Cell Seeding",
        "basic_block": "BB1",
        "notes": "H1299 cells dispensed onto 12 hydrophilic spots (6 Ctrl arm + 6 RAF1 arm). Device inverted into humidified chamber for overnight adhesion.",
        "operations": [
          {
            "step": 1,
            "op": "dispense",
            "outputs": [
              "ctrlCell1","ctrlCell2","ctrlCell3","ctrlCell4","ctrlCell5","ctrlCell6",
              "rafCell1","rafCell2","rafCell3","rafCell4","rafCell5","rafCell6"
            ],
            "manifest": "cellSuspension",
            "quantity": 1,
            "unit": "units"
          },
          {
            "step": 2,
            "op": "heat",
            "inputs": [
              "ctrlCell1","ctrlCell2","ctrlCell3","ctrlCell4","ctrlCell5","ctrlCell6",
              "rafCell1","rafCell2","rafCell3","rafCell4","rafCell5","rafCell6"
            ],
            "temperature_celsius": 37,
            "duration": "16h",
            "purpose": "overnight incubation for H1299 adhesion to hydrophilic spots"
          }
        ]
      },
      {
        "phase": "DAY_1_STEP_1",
        "label": "Lipofectamine Premix",
        "basic_block": "BB1",
        "notes": "Lipofectamine diluted in Opti-MEM per site. 12 lipid mixes prepared (6 Ctrl + 6 RAF1).",
        "operations": [
          {
            "step": 3,
            "op": "dispense",
            "outputs": [
              "lipoCtrl1","lipoCtrl2","lipoCtrl3","lipoCtrl4","lipoCtrl5","lipoCtrl6",
              "lipoRaf1","lipoRaf2","lipoRaf3","lipoRaf4","lipoRaf5","lipoRaf6"
            ],
            "manifest": "lipofectamine",
            "quantity": 1,
            "unit": "units"
          },
          {
            "step": 4,
            "op": "dispense",
            "outputs": [
              "omCtrl1","omCtrl2","omCtrl3","omCtrl4","omCtrl5","omCtrl6",
              "omRaf1","omRaf2","omRaf3","omRaf4","omRaf5","omRaf6"
            ],
            "manifest": "optiMEM",
            "quantity": 1,
            "unit": "units"
          },
          {
            "step": 5,
            "op": "mix",
            "pairs": [
              {"input_a": "lipoCtrl1", "input_b": "omCtrl1", "output": "lipidMixCtrl1"},
              {"input_a": "lipoCtrl2", "input_b": "omCtrl2", "output": "lipidMixCtrl2"},
              {"input_a": "lipoCtrl3", "input_b": "omCtrl3", "output": "lipidMixCtrl3"},
              {"input_a": "lipoCtrl4", "input_b": "omCtrl4", "output": "lipidMixCtrl4"},
              {"input_a": "lipoCtrl5", "input_b": "omCtrl5", "output": "lipidMixCtrl5"},
              {"input_a": "lipoCtrl6", "input_b": "omCtrl6", "output": "lipidMixCtrl6"},
              {"input_a": "lipoRaf1",  "input_b": "omRaf1",  "output": "lipidMixRaf1"},
              {"input_a": "lipoRaf2",  "input_b": "omRaf2",  "output": "lipidMixRaf2"},
              {"input_a": "lipoRaf3",  "input_b": "omRaf3",  "output": "lipidMixRaf3"},
              {"input_a": "lipoRaf4",  "input_b": "omRaf4",  "output": "lipidMixRaf4"},
              {"input_a": "lipoRaf5",  "input_b": "omRaf5",  "output": "lipidMixRaf5"},
              {"input_a": "lipoRaf6",  "input_b": "omRaf6",  "output": "lipidMixRaf6"}
            ],
            "duration": "30s"
          }
        ]
      },
      {
        "phase": "DAY_1_STEP_2",
        "label": "DNA + P3000 Premix",
        "basic_block": "BB1",
        "notes": "Ctrl arm uses pCRISPR_ctrl (eGFP sgRNA). RAF1 arm uses pCRISPR_RAF1 (RAF1_sg94). Each plasmid mixed with P3000 reagent then diluted into Opti-MEM.",
        "operations": [
          {
            "step": 6,
            "op": "dispense",
            "ctrl_outputs": ["dnaCtrl1","dnaCtrl2","dnaCtrl3","dnaCtrl4","dnaCtrl5","dnaCtrl6"],
            "ctrl_manifest": "pCRISPR_ctrl",
            "raf1_outputs": ["dnaRaf1","dnaRaf2","dnaRaf3","dnaRaf4","dnaRaf5","dnaRaf6"],
            "raf1_manifest": "pCRISPR_RAF1",
            "quantity": 1,
            "unit": "units"
          },
          {
            "step": 7,
            "op": "dispense",
            "outputs": [
              "p3000Ctrl1","p3000Ctrl2","p3000Ctrl3","p3000Ctrl4","p3000Ctrl5","p3000Ctrl6",
              "p3000Raf1","p3000Raf2","p3000Raf3","p3000Raf4","p3000Raf5","p3000Raf6"
            ],
            "manifest": "p3000Reagent",
            "quantity": 1,
            "unit": "units"
          },
          {
            "step": 8,
            "op": "dispense",
            "outputs": [
              "omCtrl1b","omCtrl2b","omCtrl3b","omCtrl4b","omCtrl5b","omCtrl6b",
              "omRaf1b","omRaf2b","omRaf3b","omRaf4b","omRaf5b","omRaf6b"
            ],
            "manifest": "optiMEM",
            "quantity": 1,
            "unit": "units"
          },
          {
            "step": 9,
            "op": "mix",
            "description": "DNA + P3000 mix",
            "pairs": [
              {"input_a": "dnaCtrl1", "input_b": "p3000Ctrl1", "output": "dnaP3000Ctrl1"},
              {"input_a": "dnaCtrl2", "input_b": "p3000Ctrl2", "output": "dnaP3000Ctrl2"},
              {"input_a": "dnaCtrl3", "input_b": "p3000Ctrl3", "output": "dnaP3000Ctrl3"},
              {"input_a": "dnaCtrl4", "input_b": "p3000Ctrl4", "output": "dnaP3000Ctrl4"},
              {"input_a": "dnaCtrl5", "input_b": "p3000Ctrl5", "output": "dnaP3000Ctrl5"},
              {"input_a": "dnaCtrl6", "input_b": "p3000Ctrl6", "output": "dnaP3000Ctrl6"},
              {"input_a": "dnaRaf1",  "input_b": "p3000Raf1",  "output": "dnaP3000Raf1"},
              {"input_a": "dnaRaf2",  "input_b": "p3000Raf2",  "output": "dnaP3000Raf2"},
              {"input_a": "dnaRaf3",  "input_b": "p3000Raf3",  "output": "dnaP3000Raf3"},
              {"input_a": "dnaRaf4",  "input_b": "p3000Raf4",  "output": "dnaP3000Raf4"},
              {"input_a": "dnaRaf5",  "input_b": "p3000Raf5",  "output": "dnaP3000Raf5"},
              {"input_a": "dnaRaf6",  "input_b": "p3000Raf6",  "output": "dnaP3000Raf6"}
            ],
            "duration": "30s"
          },
          {
            "step": 10,
            "op": "mix",
            "description": "Dilute DNA-P3000 into Opti-MEM",
            "pairs": [
              {"input_a": "dnaP3000Ctrl1", "input_b": "omCtrl1b", "output": "dnaMixCtrl1"},
              {"input_a": "dnaP3000Ctrl2", "input_b": "omCtrl2b", "output": "dnaMixCtrl2"},
              {"input_a": "dnaP3000Ctrl3", "input_b": "omCtrl3b", "output": "dnaMixCtrl3"},
              {"input_a": "dnaP3000Ctrl4", "input_b": "omCtrl4b", "output": "dnaMixCtrl4"},
              {"input_a": "dnaP3000Ctrl5", "input_b": "omCtrl5b", "output": "dnaMixCtrl5"},
              {"input_a": "dnaP3000Ctrl6", "input_b": "omCtrl6b", "output": "dnaMixCtrl6"},
              {"input_a": "dnaP3000Raf1",  "input_b": "omRaf1b",  "output": "dnaMixRaf1"},
              {"input_a": "dnaP3000Raf2",  "input_b": "omRaf2b",  "output": "dnaMixRaf2"},
              {"input_a": "dnaP3000Raf3",  "input_b": "omRaf3b",  "output": "dnaMixRaf3"},
              {"input_a": "dnaP3000Raf4",  "input_b": "omRaf4b",  "output": "dnaMixRaf4"},
              {"input_a": "dnaP3000Raf5",  "input_b": "omRaf5b",  "output": "dnaMixRaf5"},
              {"input_a": "dnaP3000Raf6",  "input_b": "omRaf6b",  "output": "dnaMixRaf6"}
            ],
            "duration": "30s"
          }
        ]
      },
      {
        "phase": "DAY_1_STEP_3",
        "label": "Lipid-DNA Complex Formation",
        "basic_block": "BB1",
        "notes": "Lipid mix merged with DNA mix on 2x2 electrode array. 10-minute incubation to form transfection complexes.",
        "operations": [
          {
            "step": 11,
            "op": "mix",
            "pairs": [
              {"input_a": "lipidMixCtrl1", "input_b": "dnaMixCtrl1", "output": "complexCtrl1"},
              {"input_a": "lipidMixCtrl2", "input_b": "dnaMixCtrl2", "output": "complexCtrl2"},
              {"input_a": "lipidMixCtrl3", "input_b": "dnaMixCtrl3", "output": "complexCtrl3"},
              {"input_a": "lipidMixCtrl4", "input_b": "dnaMixCtrl4", "output": "complexCtrl4"},
              {"input_a": "lipidMixCtrl5", "input_b": "dnaMixCtrl5", "output": "complexCtrl5"},
              {"input_a": "lipidMixCtrl6", "input_b": "dnaMixCtrl6", "output": "complexCtrl6"},
              {"input_a": "lipidMixRaf1",  "input_b": "dnaMixRaf1",  "output": "complexRaf1"},
              {"input_a": "lipidMixRaf2",  "input_b": "dnaMixRaf2",  "output": "complexRaf2"},
              {"input_a": "lipidMixRaf3",  "input_b": "dnaMixRaf3",  "output": "complexRaf3"},
              {"input_a": "lipidMixRaf4",  "input_b": "dnaMixRaf4",  "output": "complexRaf4"},
              {"input_a": "lipidMixRaf5",  "input_b": "dnaMixRaf5",  "output": "complexRaf5"},
              {"input_a": "lipidMixRaf6",  "input_b": "dnaMixRaf6",  "output": "complexRaf6"}
            ],
            "duration": "10m"
          }
        ]
      },
      {
        "phase": "DAY_1_STEP_4",
        "label": "1:1 Dilution of Complexes with Opti-MEM",
        "basic_block": "BB1",
        "notes": "On-device optimum ratio is 1:1 (paper Fig. 2d). Off-chip manufacturer default is 1:10, which yields only ~15% transfection efficiency on-chip vs ~65% at 1:1.",
        "operations": [
          {
            "step": 12,
            "op": "dispense",
            "outputs": [
              "omDilCtrl1","omDilCtrl2","omDilCtrl3","omDilCtrl4","omDilCtrl5","omDilCtrl6",
              "omDilRaf1","omDilRaf2","omDilRaf3","omDilRaf4","omDilRaf5","omDilRaf6"
            ],
            "manifest": "optiMEM",
            "quantity": 1,
            "unit": "units"
          },
          {
            "step": 13,
            "op": "mix",
            "pairs": [
              {"input_a": "complexCtrl1", "input_b": "omDilCtrl1", "output": "dilutedCtrl1"},
              {"input_a": "complexCtrl2", "input_b": "omDilCtrl2", "output": "dilutedCtrl2"},
              {"input_a": "complexCtrl3", "input_b": "omDilCtrl3", "output": "dilutedCtrl3"},
              {"input_a": "complexCtrl4", "input_b": "omDilCtrl4", "output": "dilutedCtrl4"},
              {"input_a": "complexCtrl5", "input_b": "omDilCtrl5", "output": "dilutedCtrl5"},
              {"input_a": "complexCtrl6", "input_b": "omDilCtrl6", "output": "dilutedCtrl6"},
              {"input_a": "complexRaf1",  "input_b": "omDilRaf1",  "output": "dilutedRaf1"},
              {"input_a": "complexRaf2",  "input_b": "omDilRaf2",  "output": "dilutedRaf2"},
              {"input_a": "complexRaf3",  "input_b": "omDilRaf3",  "output": "dilutedRaf3"},
              {"input_a": "complexRaf4",  "input_b": "omDilRaf4",  "output": "dilutedRaf4"},
              {"input_a": "complexRaf5",  "input_b": "omDilRaf5",  "output": "dilutedRaf5"},
              {"input_a": "complexRaf6",  "input_b": "omDilRaf6",  "output": "dilutedRaf6"}
            ],
            "duration": "30s"
          }
        ]
      },
      {
        "phase": "DAY_1_STEPS_5_6",
        "label": "Transfection Delivery — 24h Incubation",
        "basic_block": "BB1",
        "notes": "Diluted complexes passively dispensed onto each hydrophilic cell culture spot. 24h incubation for Cas9 + sgRNA expression.",
        "operations": [
          {
            "step": 14,
            "op": "mix",
            "pairs": [
              {"input_a": "dilutedCtrl1", "input_b": "ctrlCell1", "output": "transfectCtrl1"},
              {"input_a": "dilutedCtrl2", "input_b": "ctrlCell2", "output": "transfectCtrl2"},
              {"input_a": "dilutedCtrl3", "input_b": "ctrlCell3", "output": "transfectCtrl3"},
              {"input_a": "dilutedCtrl4", "input_b": "ctrlCell4", "output": "transfectCtrl4"},
              {"input_a": "dilutedCtrl5", "input_b": "ctrlCell5", "output": "transfectCtrl5"},
              {"input_a": "dilutedCtrl6", "input_b": "ctrlCell6", "output": "transfectCtrl6"},
              {"input_a": "dilutedRaf1",  "input_b": "rafCell1",  "output": "transfectRaf1"},
              {"input_a": "dilutedRaf2",  "input_b": "rafCell2",  "output": "transfectRaf2"},
              {"input_a": "dilutedRaf3",  "input_b": "rafCell3",  "output": "transfectRaf3"},
              {"input_a": "dilutedRaf4",  "input_b": "rafCell4",  "output": "transfectRaf4"},
              {"input_a": "dilutedRaf5",  "input_b": "rafCell5",  "output": "transfectRaf5"},
              {"input_a": "dilutedRaf6",  "input_b": "rafCell6",  "output": "transfectRaf6"}
            ],
            "duration": "24h"
          }
        ]
      },
      {
        "phase": "DAY_1_STEP_7",
        "label": "Transfection-Efficiency Checkpoint (Hoechst)",
        "basic_block": "BB1",
        "notes": "Hoechst 33342 staining for nuclear count via CellProfiler transfection pipeline (paper Fig. 2a). Hoechst used HERE ONLY — not at Day 5 (spectral overlap with Calcein-AM violet, both ~450-461 nm). All hoechstTfx* droplets fully disposed before Day 2 to prevent contamination of Day-5 viability channel. FIX 1: manifest hoechst restored here; original .bs erroneously dispensed calceinAM instead.",
        "operations": [
          {
            "step": 15,
            "op": "dispense",
            "outputs": [
              "hoechstTfxCtrl1","hoechstTfxCtrl2","hoechstTfxCtrl3",
              "hoechstTfxCtrl4","hoechstTfxCtrl5","hoechstTfxCtrl6",
              "hoechstTfxRaf1","hoechstTfxRaf2","hoechstTfxRaf3",
              "hoechstTfxRaf4","hoechstTfxRaf5","hoechstTfxRaf6"
            ],
            "manifest": "hoechst",
            "quantity": 1,
            "unit": "units"
          },
          {
            "step": 16,
            "op": "mix",
            "pairs": [
              {"input_a": "hoechstTfxCtrl1", "input_b": "transfectCtrl1", "output": "tfxStainCtrl1"},
              {"input_a": "hoechstTfxCtrl2", "input_b": "transfectCtrl2", "output": "tfxStainCtrl2"},
              {"input_a": "hoechstTfxCtrl3", "input_b": "transfectCtrl3", "output": "tfxStainCtrl3"},
              {"input_a": "hoechstTfxCtrl4", "input_b": "transfectCtrl4", "output": "tfxStainCtrl4"},
              {"input_a": "hoechstTfxCtrl5", "input_b": "transfectCtrl5", "output": "tfxStainCtrl5"},
              {"input_a": "hoechstTfxCtrl6", "input_b": "transfectCtrl6", "output": "tfxStainCtrl6"},
              {"input_a": "hoechstTfxRaf1",  "input_b": "transfectRaf1",  "output": "tfxStainRaf1"},
              {"input_a": "hoechstTfxRaf2",  "input_b": "transfectRaf2",  "output": "tfxStainRaf2"},
              {"input_a": "hoechstTfxRaf3",  "input_b": "transfectRaf3",  "output": "tfxStainRaf3"},
              {"input_a": "hoechstTfxRaf4",  "input_b": "transfectRaf4",  "output": "tfxStainRaf4"},
              {"input_a": "hoechstTfxRaf5",  "input_b": "transfectRaf5",  "output": "tfxStainRaf5"},
              {"input_a": "hoechstTfxRaf6",  "input_b": "transfectRaf6",  "output": "tfxStainRaf6"}
            ],
            "duration": "30m"
          },
          {
            "step": 17,
            "op": "detect",
            "module": "fluorescenceImaging",
            "inputs_outputs": [
              {"input": "tfxStainCtrl1", "output": "tfxEffCtrl1"},
              {"input": "tfxStainCtrl2", "output": "tfxEffCtrl2"},
              {"input": "tfxStainCtrl3", "output": "tfxEffCtrl3"},
              {"input": "tfxStainCtrl4", "output": "tfxEffCtrl4"},
              {"input": "tfxStainCtrl5", "output": "tfxEffCtrl5"},
              {"input": "tfxStainCtrl6", "output": "tfxEffCtrl6"},
              {"input": "tfxStainRaf1",  "output": "tfxEffRaf1"},
              {"input": "tfxStainRaf2",  "output": "tfxEffRaf2"},
              {"input": "tfxStainRaf3",  "output": "tfxEffRaf3"},
              {"input": "tfxStainRaf4",  "output": "tfxEffRaf4"},
              {"input": "tfxStainRaf5",  "output": "tfxEffRaf5"},
              {"input": "tfxStainRaf6",  "output": "tfxEffRaf6"}
            ],
            "duration": "5s"
          },
          {
            "step": 18,
            "op": "dispose",
            "targets": [
              "tfxEffCtrl1","tfxEffCtrl2","tfxEffCtrl3","tfxEffCtrl4","tfxEffCtrl5","tfxEffCtrl6",
              "tfxEffRaf1","tfxEffRaf2","tfxEffRaf3","tfxEffRaf4","tfxEffRaf5","tfxEffRaf6"
            ]
          }
        ]
      },
      {
        "phase": "DAY_2",
        "label": "Media Refresh",
        "basic_block": "BB1",
        "notes": "Lipid complexes removed (drain tfxStain*). Fresh complete media dispensed and merged with cells for 24h maintenance.",
        "operations": [
          {
            "step": 19,
            "op": "drain",
            "targets": [
              "tfxStainCtrl1","tfxStainCtrl2","tfxStainCtrl3",
              "tfxStainCtrl4","tfxStainCtrl5","tfxStainCtrl6",
              "tfxStainRaf1","tfxStainRaf2","tfxStainRaf3",
              "tfxStainRaf4","tfxStainRaf5","tfxStainRaf6"
