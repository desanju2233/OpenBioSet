      {
        "phase": "DAY_3_SERIAL_DILUTION",
        "label": "Sorafenib Tosylate Serial Dilution",
        "basic_block": "BB1",
        "notes": "2-fold serial dilution chain: 120 → 60 → 30 → 15 → 7.5 → 0 uM. FIX 2: each step immediately splits its full product into _ctrlAliquot, _raf1Aliquot, and _carry to avoid double-use of spent variables. 0 uM is pure vehicle (no carry).",
        "drug_concentrations": [
          {
            "conc_uM": 120,
            "operations": [
              {"op": "dispense",  "output": "drugStock",         "manifest": "sorafenib", "quantity": 1, "unit": "units"},
              {"op": "dispense",  "output": "mediaDil1",         "manifest": "completeMedia", "quantity": 1, "unit": "units"},
              {"op": "mix",       "input_a": "drugStock",        "input_b": "mediaDil1",   "output": "drugConc120_full", "duration": "30s"},
              {"op": "split",     "input": "drugConc120_full",   "output": "drugConc120_split",       "into": 2},
              {"op": "split",     "input": "drugConc120_split",  "output": "drugConc120_ctrlAliquot", "into": 2},
              {"op": "split",     "input": "drugConc120_split",  "output": "drugConc120_raf1Aliquot", "into": 2},
              {"op": "split",     "input": "drugConc120_full",   "output": "drugConc120_carry",       "into": 2}
            ]
          },
          {
            "conc_uM": 60,
            "operations": [
              {"op": "dispense",  "output": "mediaDil2",        "manifest": "completeMedia", "quantity": 1, "unit": "units"},
              {"op": "mix",       "input_a": "drugConc120_carry","input_b": "mediaDil2",    "output": "drugConc60_full", "duration": "30s"},
              {"op": "split",     "input": "drugConc60_full",   "output": "drugConc60_ctrlAliquot", "into": 2},
              {"op": "split",     "input": "drugConc60_full",   "output": "drugConc60_raf1Aliquot", "into": 2},
              {"op": "split",     "input": "drugConc60_full",   "output": "drugConc60_carry",       "into": 2}
            ]
          },
          {
            "conc_uM": 30,
            "operations": [
              {"op": "dispense",  "output": "mediaDil3",        "manifest": "completeMedia", "quantity": 1, "unit": "units"},
              {"op": "mix",       "input_a": "drugConc60_carry", "input_b": "mediaDil3",    "output": "drugConc30_full", "duration": "30s"},
              {"op": "split",     "input": "drugConc30_full",   "output": "drugConc30_ctrlAliquot", "into": 2},
              {"op": "split",     "input": "drugConc30_full",   "output": "drugConc30_raf1Aliquot", "into": 2},
              {"op": "split",     "input": "drugConc30_full",   "output": "drugConc30_carry",       "into": 2}
            ]
          },
          {
            "conc_uM": 15,
            "operations": [
              {"op": "dispense",  "output": "mediaDil4",        "manifest": "completeMedia", "quantity": 1, "unit": "units"},
              {"op": "mix",       "input_a": "drugConc30_carry", "input_b": "mediaDil4",    "output": "drugConc15_full", "duration": "30s"},
              {"op": "split",     "input": "drugConc15_full",   "output": "drugConc15_ctrlAliquot", "into": 2},
              {"op": "split",     "input": "drugConc15_full",   "output": "drugConc15_raf1Aliquot", "into": 2},
              {"op": "split",     "input": "drugConc15_full",   "output": "drugConc15_carry",       "into": 2}
            ]
          },
          {
            "conc_uM": 7.5,
            "operations": [
              {"op": "dispense",  "output": "mediaDil5",        "manifest": "completeMedia", "quantity": 1, "unit": "units"},
              {"op": "mix",       "input_a": "drugConc15_carry", "input_b": "mediaDil5",    "output": "drugConc7_full", "duration": "30s"},
              {"op": "split",     "input": "drugConc7_full",    "output": "drugConc7_ctrlAliquot", "into": 2},
              {"op": "split",     "input": "drugConc7_full",    "output": "drugConc7_raf1Aliquot", "into": 2},
              {"op": "split",     "input": "drugConc7_full",    "output": "drugConc7_carry",       "into": 2}
            ]
          },
          {
            "conc_uM": 0,
            "notes": "Vehicle control — pure complete media. No carry needed (terminal dilution step).",
            "operations": [
              {"op": "dispense",  "output": "mediaDil6",        "manifest": "completeMedia", "quantity": 1, "unit": "units"},
              {"op": "mix",       "input_a": "drugConc7_carry",  "input_b": "mediaDil6",    "output": "drugConc0_full", "duration": "30s"},
              {"op": "split",     "input": "drugConc0_full",    "output": "drugConc0_ctrlAliquot", "into": 2},
              {"op": "split",     "input": "drugConc0_full",    "output": "drugConc0_raf1Aliquot", "into": 2}
            ]
          }
        ]
      },
      {
        "phase": "DAY_3_TO_5_DRUG_DELIVERY",
        "label": "Drug Delivery — 48h Incubation",
        "basic_block": "BB1",
        "notes": "Each site receives one aliquot at its assigned concentration. Sites 1/1 = 120 uM (highest dose); sites 6/6 = 0 uM (vehicle control, QC baseline). 48h incubation bridges Day 3 to Day 5 readout.",
        "operations": [
          {
            "step": 22,
            "op": "mix",
            "pairs": [
              {"input_a": "drugConc120_ctrlAliquot", "input_b": "maintainCtrl1", "output": "drugSiteCtrl1", "conc_uM": 120},
              {"input_a": "drugConc60_ctrlAliquot",  "input_b": "maintainCtrl2", "output": "drugSiteCtrl2", "conc_uM": 60},
              {"input_a": "drugConc30_ctrlAliquot",  "input_b": "maintainCtrl3", "output": "drugSiteCtrl3", "conc_uM": 30},
              {"input_a": "drugConc15_ctrlAliquot",  "input_b": "maintainCtrl4", "output": "drugSiteCtrl4", "conc_uM": 15},
              {"input_a": "drugConc7_ctrlAliquot",   "input_b": "maintainCtrl5", "output": "drugSiteCtrl5", "conc_uM": 7.5},
              {"input_a": "drugConc0_ctrlAliquot",   "input_b": "maintainCtrl6", "output": "drugSiteCtrl6", "conc_uM": 0},
              {"input_a": "drugConc120_raf1Aliquot", "input_b": "maintainRaf1",  "output": "drugSiteRaf1",  "conc_uM": 120},
              {"input_a": "drugConc60_raf1Aliquot",  "input_b": "maintainRaf2",  "output": "drugSiteRaf2",  "conc_uM": 60},
              {"input_a": "drugConc30_raf1Aliquot",  "input_b": "maintainRaf3",  "output": "drugSiteRaf3",  "conc_uM": 30},
              {"input_a": "drugConc15_raf1Aliquot",  "input_b": "maintainRaf4",  "output": "drugSiteRaf4",  "conc_uM": 15},
              {"input_a": "drugConc7_raf1Aliquot",   "input_b": "maintainRaf5",  "output": "drugSiteRaf5",  "conc_uM": 7.5},
              {"input_a": "drugConc0_raf1Aliquot",   "input_b": "maintainRaf6",  "output": "drugSiteRaf6",  "conc_uM": 0}
            ],
            "duration": "48h"
          }
        ]
      },
      {
        "phase": "DAY_5_VIABILITY",
        "label": "Calcein-AM Viability Assay",
        "basic_block": "BB1",
        "notes": "Sole Day-5 readout. 5 uM Calcein-AM violet, 30 min incubation. No Hoechst (spectral conflict). Counts live cells via esterase activity fluorescence.",
        "operations": [
          {
            "step": 23,
            "op": "dispense",
            "outputs": [
              "calceinCtrl1","calceinCtrl2","calceinCtrl3","calceinCtrl4","calceinCtrl5","calceinCtrl6",
              "calceinRaf1","calceinRaf2","calceinRaf3","calceinRaf4","calceinRaf5","calceinRaf6"
            ],
            "manifest": "calceinAM",
            "quantity": 1,
            "unit": "units"
          },
          {
            "step": 24,
            "op": "mix",
            "pairs": [
              {"input_a": "calceinCtrl1", "input_b": "drugSiteCtrl1", "output": "viabCtrl1"},
              {"input_a": "calceinCtrl2", "input_b": "drugSiteCtrl2", "output": "viabCtrl2"},
              {"input_a": "calceinCtrl3", "input_b": "drugSiteCtrl3", "output": "viabCtrl3"},
              {"input_a": "calceinCtrl4", "input_b": "drugSiteCtrl4", "output": "viabCtrl4"},
              {"input_a": "calceinCtrl5", "input_b": "drugSiteCtrl5", "output": "viabCtrl5"},
              {"input_a": "calceinCtrl6", "input_b": "drugSiteCtrl6", "output": "viabCtrl6"},
              {"input_a": "calceinRaf1",  "input_b": "drugSiteRaf1",  "output": "viabRaf1"},
              {"input_a": "calceinRaf2",  "input_b": "drugSiteRaf2",  "output": "viabRaf2"},
              {"input_a": "calceinRaf3",  "input_b": "drugSiteRaf3",  "output": "viabRaf3"},
              {"input_a": "calceinRaf4",  "input_b": "drugSiteRaf4",  "output": "viabRaf4"},
              {"input_a": "calceinRaf5",  "input_b": "drugSiteRaf5",  "output": "viabRaf5"},
              {"input_a": "calceinRaf6",  "input_b": "drugSiteRaf6",  "output": "viabRaf6"}
