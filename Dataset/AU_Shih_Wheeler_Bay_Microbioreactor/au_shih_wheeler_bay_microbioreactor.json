{
  "protocol": {
    "title": "Integrated Microbioreactor for Culture and Analysis of Bacteria, Algae and Yeast",
    "source": "Biomed Microdevices (2011) 13:41-50",
    "doi": "10.1007/s10544-010-9469-3",
    "platform": "Digital microfluidics (DMF) - EWOD parallel-plate device",
    "organisms": [
      "Escherichia coli DH5alpha (bacteria)",
      "Saccharomyces cerevisiae BY4741, S288C background (yeast)",
      "Cyclotella cryptica CCMP 332 (algae)"
    ],
    "objective": "Automated micro-scale culture and absorbance-based density monitoring of bacteria, algae and yeast in a shared mother-drop reactor, with on-chip integration of a fluorescent viability assay and genetic transformation as downstream processes",

    "device": {
      "layers": [
        "Chromium electrodes on glass bottom plate, patterned by photolithography/etching",
        "Parylene-C dielectric, 6.9 um thick, vapor-deposited",
        "Teflon-AF hydrophobic coating, 235 nm, spin-coated on both plates",
        "Unpatterned ITO/Teflon-AF top plate (ground electrode)"
      ],
      "sections": [
        "Reactor region: four 10.5 x 9.5 mm electrodes in a 2x2 array (holds ~70 uL mother drop)",
        "Sample region: three rows of eleven 3 x 3 mm electrodes",
        "Reservoir region: three 6 x 6 mm electrodes, one per sample row"
      ],
      "absorbance_windows": {
        "electrode_type": "L-shaped electrode, one per sample row",
        "window_size_mm": "1.5 x 1.5",
        "window_to_electrode_area_ratio": "1/4 (1/2 and 1/8 tested, found sub-optimal)",
        "electrode_pitch_mm": 9,
        "compatible_with": "96-well-plate-format plate reader (PHERAstar)"
      },
      "spacer_thickness_um": 350,
      "actuation": {
        "voltage_Vrms": "400-500",
        "frequency_kHz": "1-5",
        "control_system": "custom LabVIEW program + DAQPAD 6507 + high-voltage relay network"
      }
    },

    "reagents": {
      "growth_media": {
        "E_coli": "LB broth",
        "S_cerevisiae": "YPD broth",
        "C_cryptica": "f/2 medium + biotin + cyanocobalamin (2 nM each)"
      },
      "anti_adhesion_additive": "Pluronic F68 (0.1% w/v bacteria/yeast, 0.02% w/v algae) in microscale media only",
      "sterilization_agent": "70% ethanol rinse",
      "viability_stain": {
        "EthD-1": { "concentration_uM": 2, "target": "compromised/dead cells (nucleic-acid dye)" },
        "TritonX-100": { "concentration_pct_v_v": 0.05, "role": "lytic positive control for cell death" }
      },
      "transformation_reagents": {
        "plasmid": "pTriEx vector encoding YFP + ampicillin resistance",
        "plasmid_amount_ng": 200,
        "CaCl2_concentration_M": 0.2,
        "selection_agent": "ampicillin LB agar plate, 100 mg/L (off-chip)"
      }
    },

    "steps": [
      {
        "id": "S1",
        "name": "Device sterilization and priming",
        "bb": "pre-BB1 (off-chip)",
        "inputs": ["70% ethanol"],
        "operation": "rinse (no droplet operation encoded)",
        "notes": "Devices rinsed in 70% ethanol prior to loading; not represented as a BioScript droplet instruction."
      },
      {
        "id": "S2",
        "name": "Bacteria (E. coli) culture and absorbance-based growth check",
        "bb": "BB1",
        "organism": "E. coli DH5alpha",
        "inputs": ["E_coli", "LB_Broth"],
        "operation": "mix (inoculation) + heat (semi-continuous circular mixing / incubation) + detect (absorbance, 600 nm)",
        "inoculation_mix_duration_s": 5,
        "incubation_temperature_C": 37,
        "incubation_duration_s": 3600,
        "mixing_interval_min": 2.5,
        "absorbance_measurement_interval_h": 1,
        "detection_module": "densityDetection",
        "detection_duration_s": 1,
        "doubling_time_h": { "macroscale": "0.79 +/- 0.06", "microscale": "1.23 +/- 0.43", "p_value": 0.08 },
        "branch": {
          "pass": { "condition": "bactGrowthSignal > 0", "action": "dispose", "bb": "BB2" },
          "fail": { "condition": "bactGrowthSignal <= 0", "action": "drain",   "bb": "BB3" }
        },
        "join_bb": "BB4"
      },
      {
        "id": "S3",
        "name": "Yeast (S. cerevisiae) culture and absorbance-based growth check",
        "bb": "BB4",
        "organism": "S. cerevisiae BY4741",
        "inputs": ["S_cerevisiae", "YPD_Broth"],
        "operation": "mix (inoculation) + heat (semi-continuous circular mixing / incubation) + detect (absorbance, 600 nm)",
        "inoculation_mix_duration_s": 5,
        "incubation_temperature_C": 30,
        "incubation_duration_s": 7200,
        "mixing_interval_min": 2.5,
        "absorbance_measurement_interval_h": 2,
        "detection_module": "densityDetection",
        "detection_duration_s": 1,
        "doubling_time_h": { "macroscale": "1.80 +/- 0.24", "microscale": "1.88 +/- 0.15", "p_value": 0.31 },
        "branch": {
          "pass": { "condition": "yeastGrowthSignal > 0", "action": "dispose", "bb": "BB5" },
          "fail": { "condition": "yeastGrowthSignal <= 0", "action": "drain",   "bb": "BB6" }
        },
        "join_bb": "BB7"
      },
      {
        "id": "S4",
        "name": "Algae (C. cryptica) culture and absorbance-based growth check",
        "bb": "BB7",
        "organism": "C. cryptica CCMP 332",
        "inputs": ["C_cryptica", "F2_Media"],
        "operation": "mix (inoculation) + heat (semi-continuous circular mixing / incubation under illumination) + detect (absorbance, 660 nm)",
        "inoculation_mix_duration_s": 5,
        "incubation_temperature_C": 14,
        "incubation_duration_s": 86400,
        "mixing_interval_min": 120,
        "absorbance_measurement_interval_h": 24,
        "detection_module": "densityDetection",
        "detection_duration_s": 1,
        "doubling_time_h": { "macroscale": "37.0 +/- 1.2", "microscale": "42.6 +/- 2.4", "p_value": 0.02 },
        "branch": {
          "pass": { "condition": "algaeGrowthSignal > 0", "action": "dispose", "bb": "BB8" },
          "fail": { "condition": "algaeGrowthSignal <= 0", "action": "drain",   "bb": "BB9" }
        },
        "join_bb": "BB10"
      },
      {
        "id": "S5",
        "name": "Yeast viability assay (EthD-1 +/- Triton X-100)",
        "bb": "BB10",
        "organism": "S. cerevisiae BY4741",
        "inputs": ["S_cerevisiae", "YPD_Broth", "EthidiumHomodimer1", "TritonX100"],
        "operation": "mix (inoculation) + heat (4 h pre-assay growth) + mix (reagent dispense/merge) + mix (linear-path merge, ~10 actuations) + heat (1 h stain incubation) + detect (fluorescence)",
        "pre_assay_growth_duration_s": 14400,
        "pre_assay_growth_temperature_C": 30,
        "reagent_prep_mix_duration_s": 5,
        "merge_mix_duration_s": 10,
        "stain_incubation_temperature_C": 30,
        "stain_incubation_duration_s": 3600,
        "detection_module": "viabilityDetection",
        "detection_duration_s": 30,
        "results": {
          "triton_condition_nonviable_pct": ">99",
          "notes": "EthD-1 stains cells with compromised membranes (dead/dying); Triton X-100 used as lytic positive control."
        },
        "branch": {
          "pass": { "condition": "viabilitySignal > 0", "action": "dispose", "bb": "BB11" },
          "fail": { "condition": "viabilitySignal <= 0", "action": "drain",   "bb": "BB12" }
        },
        "join_bb": "BB13"
      },
      {
        "id": "S6",
        "name": "E. coli transformation with pTriEx-YFP plasmid",
        "bb": "BB13",
        "organism": "E. coli (ampicillin-sensitive)",
        "inputs": ["E_coli", "LB_Broth", "pTriEx_YFP_Plasmid", "CaCl2_Solution"],
        "operation": "mix (inoculation) + heat (1 h growth to early/mid-log) + heat (ice pre-chill) + mix (plasmid/CaCl2 prep) + mix (merge, ~10 actuations) + heat (ice chill) + heat (heat shock) + heat (ice cool) + heat (recovery) + detect (colony formation, off-chip)",
        "growth_duration_s": 3600,
        "growth_temperature_C": 37,
        "pre_chill_temperature_C": 4,
        "pre_chill_duration_s": 300,
        "merge_mix_duration_s": 10,
        "ice_chill_duration_s": 3600,
        "heat_shock_temperature_C": 42,
        "heat_shock_duration_s": 50,
        "post_shock_ice_duration_s": 60,
        "recovery_temperature_C": 37,
        "recovery_duration_s": 3600,
        "detection_module": "transformationQC",
        "detection_duration_s": 30,
        "off_chip_step": "Droplet spread on ampicillin (100 mg/L) LB agar plate, incubated overnight at 37 C",
        "branch": {
          "pass": { "condition": "transformSignal > 0", "action": "dispose", "bb": "BB14" },
          "fail": { "condition": "transformSignal <= 0", "action": "drain",   "bb": "BB15" }
        },
        "join_bb": "BB16 (terminal)"
      }
    ],

    "droplet_operations": {
      "circular_mixing": {
        "pattern": "sequence of four movements between adjacent electrodes on the 2x2 reactor array",
        "actuation_time_s": 1.5,
        "purpose": "semi-continuous mixing of the mother drop; reported 10-50x faster than diffusion alone",
        "interval_bacteria_yeast_min": 2.5,
        "interval_algae_min": 120
      },
      "daughter_droplet_dispense": {
        "volume_uL": 7,
        "count_per_measurement": 3,
        "purpose": "absorbance measurement on L-shaped transparent-window electrodes",
        "returned_to_mother_drop": true,
        "bioscript_abstraction": "modelled as a non-consumptive detect() directly on the culture droplet rather than an explicit split/re-merge, due to compiler split-array limitations"
      },
      "reservoir_merge": {
        "notes": "Reagents (EthD-1, Triton X-100, plasmid/CaCl2) dispensed from reservoir electrodes and merged with sample-region droplets by linear-path actuation (~10 cycles)"
      },
      "actuation": {
        "voltage_Vrms": "400-500",
        "frequency_kHz": "1-5",
        "electrode_pitch_mm": 9,
        "spacer_thickness_um": 350
      }
    },

    "cfg": {
      "basic_blocks": [
        { "id": "BB1",  "label": "main",         "type": "entry" },
        { "id": "BB2",  "label": "bsbbif_2_t",   "type": "branch_true",  "condition": "bactGrowthSignal > 0",  "action": "dispose(bactCulture)" },
        { "id": "BB3",  "label": "bsbbif_3_f",   "type": "branch_false", "condition": "bactGrowthSignal <= 0", "action": "drain(bactCulture)" },
        { "id": "BB4",  "label": "bsbbif_4_j",   "type": "join" },
        { "id": "BB5",  "label": "bsbbif_5_t",   "type": "branch_true",  "condition": "yeastGrowthSignal > 0",  "action": "dispose(yeastCulture)" },
        { "id": "BB6",  "label": "bsbbif_6_f",   "type": "branch_false", "condition": "yeastGrowthSignal <= 0", "action": "drain(yeastCulture)" },
        { "id": "BB7",  "label": "bsbbif_7_j",   "type": "join" },
        { "id": "BB8",  "label": "bsbbif_8_t",   "type": "branch_true",  "condition": "algaeGrowthSignal > 0",  "action": "dispose(algaeCulture)" },
        { "id": "BB9",  "label": "bsbbif_9_f",   "type": "branch_false", "condition": "algaeGrowthSignal <= 0", "action": "drain(algaeCulture)" },
        { "id": "BB10", "label": "bsbbif_10_j",  "type": "join" },
        { "id": "BB11", "label": "bsbbif_11_t",  "type": "branch_true",  "condition": "viabilitySignal > 0",  "action": "dispose(stainedYeast)" },
        { "id": "BB12", "label": "bsbbif_12_f",  "type": "branch_false", "condition": "viabilitySignal <= 0", "action": "drain(stainedYeast)" },
        { "id": "BB13", "label": "bsbbif_13_j",  "type": "join" },
        { "id": "BB14", "label": "bsbbif_14_t",  "type": "branch_true",  "condition": "transformSignal > 0",  "action": "dispose(transformMix)" },
        { "id": "BB15", "label": "bsbbif_15_f",  "type": "branch_false", "condition": "transformSignal <= 0", "action": "drain(transformMix)" },
        { "id": "BB16", "label": "bsbbif_16_j",  "type": "terminal" }
      ],
      "edges": [
        ["BB1","BB2"], ["BB1","BB3"],
        ["BB2","BB4"], ["BB3","BB4"],
        ["BB4","BB5"], ["BB4","BB6"],
        ["BB5","BB7"], ["BB6","BB7"],
        ["BB7","BB8"], ["BB7","BB9"],
        ["BB8","BB10"],["BB9","BB10"],
        ["BB10","BB11"],["BB10","BB12"],
        ["BB11","BB13"],["BB12","BB13"],
        ["BB13","BB14"],["BB13","BB15"],
        ["BB14","BB16"],["BB15","BB16"]
      ]
    }
  }
}
