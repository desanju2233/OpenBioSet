bsbbif_2_t:
	dispose(bactCulture1[0])
bsbbif_3_f:
	dispose(bactCulture1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(bactGrowthSignal1[0])
	motherDropYeast1[0] = dispense(S_cerevisiae)
	ypdMedia1[0] = dispense(YPD_Broth)
	yeastCulture1[0] = mix(motherDropYeast1[0], ypdMedia1[0]) @ 5.0SECOND
	heat(yeastCulture1[0]) @ 30.0CELSIUS @ 7200.0SECOND
	yeastGrowthSignal1[0] = detect(densityDetection, yeastCulture1[0]) @ 1.0SECOND
	if yeastGrowthSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	motherDropBact1[0] = dispense(E_coli)
	lbMedia1[0] = dispense(LB_Broth)
	bactCulture1[0] = mix(motherDropBact1[0], lbMedia1[0]) @ 5.0SECOND
	heat(bactCulture1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	bactGrowthSignal1[0] = detect(densityDetection, bactCulture1[0]) @ 1.0SECOND
	if bactGrowthSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(yeastCulture1[0])
bsbbif_6_f:
	dispose(yeastCulture1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(yeastGrowthSignal1[0])
	motherDropAlgae1[0] = dispense(C_cryptica)
	f2Media1[0] = dispense(F2_Media)
	algaeCulture1[0] = mix(motherDropAlgae1[0], f2Media1[0]) @ 5.0SECOND
	heat(algaeCulture1[0]) @ 14.0CELSIUS @ 86400.0SECOND
	algaeGrowthSignal1[0] = detect(densityDetection, algaeCulture1[0]) @ 1.0SECOND
	if algaeGrowthSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(algaeCulture1[0])
bsbbif_9_f:
	dispose(algaeCulture1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(algaeGrowthSignal1[0])
	yeastForAssay1[0] = dispense(S_cerevisiae)
	ypdMedia21[0] = dispense(YPD_Broth)
	assayCulture1[0] = mix(yeastForAssay1[0], ypdMedia21[0]) @ 5.0SECOND
	heat(assayCulture1[0]) @ 30.0CELSIUS @ 14400.0SECOND
	ethd1Dye1[0] = dispense(EthidiumHomodimer1)
	tritonReagent1[0] = dispense(TritonX100)
	dyeTritonMix1[0] = mix(ethd1Dye1[0], tritonReagent1[0]) @ 5.0SECOND
	stainedYeast1[0] = mix(assayCulture1[0], dyeTritonMix1[0]) @ 10.0SECOND
	heat(stainedYeast1[0]) @ 30.0CELSIUS @ 3600.0SECOND
	viabilitySignal1[0] = detect(viabilityDetection, stainedYeast1[0]) @ 30.0SECOND
	if viabilitySignal1[0] > 0	|	true: jump bsbbif_11_t	|	false: jump bsbbif_12_f
bsbbif_11_t:
	dispose(stainedYeast1[0])
bsbbif_12_f:
	dispose(stainedYeast1[0])
	jump: bsbbif_13_j
bsbbif_13_j:
	dispose(viabilitySignal1[0])
	competentEcoli1[0] = dispense(E_coli)
	lbMedia31[0] = dispense(LB_Broth)
	transformCulture1[0] = mix(competentEcoli1[0], lbMedia31[0]) @ 5.0SECOND
	heat(transformCulture1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	heat(transformCulture1[0]) @ 4.0CELSIUS @ 300.0SECOND
	plasmidDrop1[0] = dispense(pTriEx_YFP_Plasmid)
	cacl2Drop1[0] = dispense(CaCl2_Solution)
	plasmidCacl2Mix1[0] = mix(plasmidDrop1[0], cacl2Drop1[0]) @ 5.0SECOND
	transformMix1[0] = mix(transformCulture1[0], plasmidCacl2Mix1[0]) @ 10.0SECOND
	heat(transformMix1[0]) @ 4.0CELSIUS @ 3600.0SECOND
	heat(transformMix1[0]) @ 42.0CELSIUS @ 50.0SECOND
	heat(transformMix1[0]) @ 4.0CELSIUS @ 60.0SECOND
	heat(transformMix1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	transformSignal1[0] = detect(transformationQC, transformMix1[0]) @ 30.0SECOND
	if transformSignal1[0] > 0	|	true: jump bsbbif_14_t	|	false: jump bsbbif_15_f
bsbbif_14_t:
	dispose(transformMix1[0])
bsbbif_15_f:
	dispose(transformMix1[0])
	jump: bsbbif_16_j
bsbbif_16_j:
