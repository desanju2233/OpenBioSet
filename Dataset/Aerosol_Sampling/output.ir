main:
bsbbr_2_h:
	PHI extract1 = {extract0,extract2}
	PHI REPEAT_31 = {REPEAT_30,REPEAT_32}
	PHI absorbance1 = {absorbance0,absorbance2}
	PHI solvent1 = {solvent0,solvent2}
	PHI surface1 = {surface0,surface2}
	PHI reaction1 = {reaction0,reaction2}
	PHI reagent1 = {reagent0,reagent2}
	if REPEAT_31[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	surface2[0] = dispense(Aerosol_Impaction_Surface)
	solvent2[0] = dispense(Ultra_Pure_Solvent)
	extract2[0] = mix(solvent2[0], surface2[0]) @ 60.0SECOND
	reagent2[0] = dispense(Colorimetric_Reagent)
	reaction2[0] = mix(extract2[0], reagent2[0]) @ 5.0SECOND
	absorbance2[0] = detect(fluorescence, reaction2[0]) @ 30.0SECOND
	dispose(reaction2[0])
	REPEAT_32[0] = REPEAT_31[0] - 1
bsbbr_4_f:
	NOP
