main:
	extract1[0] = dispense(aerosol_sample)
bsbbr_2_h:
	PHI REPEAT_21 = {REPEAT_20,REPEAT_22}
	PHI extract2 = {extract1,extract3}
	if REPEAT_21[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	extract3[0] = mix(extract2[0], extract2[0]) @ 30.0SECOND
	REPEAT_22[0] = REPEAT_21[0] - 1
bsbbr_4_f:
bsbbr_5_h:
	PHI su_std1 = {su_std0,su_std2}
	PHI su_cal1 = {su_cal0,su_cal2}
	PHI su_cal_reading1 = {su_cal_reading0,su_cal_reading2}
	PHI mtb1 = {mtb0,mtb2}
	PHI REPEAT_61 = {REPEAT_60,REPEAT_62}
	if REPEAT_61[0] > 0	|	true: jump bsbbr_6_t	|	false: jump bsbbr_7_f
bsbbr_6_t:
	su_std2[0] = dispense(sulfate_standard)
	mtb2[0] = dispense(mtb_ba_reagent)
	su_cal2[0] = mix(su_std2[0], mtb2[0]) @ 10.0SECOND
	su_cal_reading2[0] = detect(absorbance, su_cal2[0]) @ 5.0SECOND
	dispose(su_cal2[0])
	REPEAT_62[0] = REPEAT_61[0] - 1
bsbbr_7_f:
	mtb_sample1[0] = dispense(mtb_ba_reagent)
	su_mix1[0] = mix(extract2[0], mtb_sample1[0]) @ 10.0SECOND
	sulfate_reading1[0] = detect(absorbance, su_mix1[0]) @ 5.0SECOND
	if sulfate_reading1[0] >= 11	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(su_mix1[0])
bsbbif_9_f:
	PHI su_mix2 = {su_mix1,su_mix}
bsbbr_10_h:
	PHI nh4_reagent1 = {nh4_reagent0,nh4_reagent2}
	PHI nh4_cal1 = {nh4_cal0,nh4_cal2}
	PHI nh4_cal_reading1 = {nh4_cal_reading0,nh4_cal_reading2}
	PHI nh4_std1 = {nh4_std0,nh4_std2}
	PHI REPEAT_63 = {REPEAT_61,REPEAT_64}
	if REPEAT_63[0] > 0	|	true: jump bsbbr_11_t	|	false: jump bsbbr_12_f
bsbbr_11_t:
	nh4_std2[0] = dispense(ammonium_standard)
	nh4_reagent2[0] = dispense(ammonium_reagent)
	nh4_cal2[0] = mix(nh4_std2[0], nh4_reagent2[0]) @ 10.0SECOND
	nh4_cal_reading2[0] = detect(absorbance, nh4_cal2[0]) @ 5.0SECOND
	dispose(nh4_cal2[0])
	REPEAT_64[0] = REPEAT_63[0] - 1
bsbbr_12_f:
	nh4_reagent_sample1[0] = dispense(ammonium_reagent)
	nh4_mix1[0] = mix(extract2[0], nh4_reagent_sample1[0]) @ 10.0SECOND
	ammonium_reading1[0] = detect(absorbance, nh4_mix1[0]) @ 5.0SECOND
	if ammonium_reading1[0] >= 0.256	|	true: jump bsbbif_13_t	|	false: jump bsbbif_14_f
bsbbif_13_t:
	dispose(nh4_mix1[0])
bsbbif_14_f:
	PHI nh4_mix2 = {nh4_mix1,nh4_mix}
bsbbr_15_h:
	PHI no3_std1 = {no3_std0,no3_std2}
	PHI no3_cal1 = {no3_cal0,no3_cal2}
	PHI no3_cal_reading1 = {no3_cal_reading0,no3_cal_reading2}
	PHI no3_reagent1 = {no3_reagent0,no3_reagent2}
	PHI REPEAT_65 = {REPEAT_63,REPEAT_66}
	if REPEAT_65[0] > 0	|	true: jump bsbbr_16_t	|	false: jump bsbbr_17_f
bsbbr_16_t:
	no3_std2[0] = dispense(nitrate_standard)
	no3_reagent2[0] = dispense(nitrate_reagent)
	no3_cal2[0] = mix(no3_std2[0], no3_reagent2[0]) @ 10.0SECOND
	heat(no3_cal2[0]) @ 25.0CELSIUS @ 150.0SECOND
	no3_cal_reading2[0] = detect(absorbance, no3_cal2[0]) @ 5.0SECOND
	dispose(no3_cal2[0])
	REPEAT_66[0] = REPEAT_65[0] - 1
bsbbr_17_f:
	no3_reagent_sample1[0] = dispense(nitrate_reagent)
	no3_mix1[0] = mix(extract2[0], no3_reagent_sample1[0]) @ 10.0SECOND
	heat(no3_mix1[0]) @ 25.0CELSIUS @ 150.0SECOND
	nitrate_reading1[0] = detect(absorbance, no3_mix1[0]) @ 5.0SECOND
	dispose(no3_mix1[0])
	dispose(extract2[0])
	NOP
