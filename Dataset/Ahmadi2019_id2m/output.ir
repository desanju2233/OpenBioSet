bsbbif_2_t:
	dispose(fluorStockCheck1[0])
	dispose(dil2x1[0])
	dispose(dil4x1[0])
	dispose(dil8x1[0])
bsbbif_3_f:
	dispose(fluorStockCheck1[0])
	dispose(dil2x1[0])
	dispose(dil4x1[0])
	dispose(dil8x1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(calSignalStock1[0])
	dispose(calSignal2x1[0])
	dispose(calSignal4x1[0])
	dispose(calSignal8x1[0])
	wtDroplet1[0] = dispense(WildTypeYeast)
	mut1Droplet1[0] = dispense(MutantYeast1)
	mut2Droplet1[0] = dispense(MutantYeast2)
	ilDropWT1[0] = dispense(IonicLiquidStock)
	ilDropMut11[0] = dispense(IonicLiquidStock)
	ilDropMut21[0] = dispense(IonicLiquidStock)
	wtMix1[0] = mix(wtDroplet1[0], ilDropWT1[0]) @ 5.0SECOND
	mut1Mix1[0] = mix(mut1Droplet1[0], ilDropMut11[0]) @ 5.0SECOND
	mut2Mix1[0] = mix(mut2Droplet1[0], ilDropMut21[0]) @ 5.0SECOND
	heat(wtMix1[0]) @ 30.0CELSIUS @ 86400.0SECOND
	heat(mut1Mix1[0]) @ 30.0CELSIUS @ 86400.0SECOND
	heat(mut2Mix1[0]) @ 30.0CELSIUS @ 86400.0SECOND
	ilSignalWT1[0] = detect(absorbanceDetection, wtMix1[0]) @ 30.0SECOND
	ilSignalMut11[0] = detect(absorbanceDetection, mut1Mix1[0]) @ 30.0SECOND
	ilSignalMut21[0] = detect(absorbanceDetection, mut2Mix1[0]) @ 30.0SECOND
	if ilSignalMut21[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	fluorStockCheck1[0] = dispense(FluoresceinStock)
	fluorStock2x1[0] = dispense(FluoresceinStock)
	bufFor2x1[0] = dispense(DilutionBuffer)
	dil2x1[0] = mix(fluorStock2x1[0], bufFor2x1[0]) @ 5.0SECOND
	fluorStock4x1[0] = dispense(FluoresceinStock)
	buf4x_a1[0] = dispense(DilutionBuffer)
	buf4x_b1[0] = dispense(DilutionBuffer)
	buf4x_c1[0] = dispense(DilutionBuffer)
	buf4x_ab1[0] = mix(buf4x_a1[0], buf4x_b1[0]) @ 5.0SECOND
	buf4x_abc1[0] = mix(buf4x_ab1[0], buf4x_c1[0]) @ 5.0SECOND
	dil4x1[0] = mix(fluorStock4x1[0], buf4x_abc1[0]) @ 5.0SECOND
	fluorStock8x1[0] = dispense(FluoresceinStock)
	buf8x_11[0] = dispense(DilutionBuffer)
	buf8x_21[0] = dispense(DilutionBuffer)
	buf8x_31[0] = dispense(DilutionBuffer)
	buf8x_41[0] = dispense(DilutionBuffer)
	buf8x_51[0] = dispense(DilutionBuffer)
	buf8x_61[0] = dispense(DilutionBuffer)
	buf8x_71[0] = dispense(DilutionBuffer)
	buf8x_121[0] = mix(buf8x_11[0], buf8x_21[0]) @ 5.0SECOND
	buf8x_1231[0] = mix(buf8x_121[0], buf8x_31[0]) @ 5.0SECOND
	buf8x_12341[0] = mix(buf8x_1231[0], buf8x_41[0]) @ 5.0SECOND
	buf8x_123451[0] = mix(buf8x_12341[0], buf8x_51[0]) @ 5.0SECOND
	buf8x_1234561[0] = mix(buf8x_123451[0], buf8x_61[0]) @ 5.0SECOND
	buf8x_12345671[0] = mix(buf8x_1234561[0], buf8x_71[0]) @ 5.0SECOND
	dil8x1[0] = mix(fluorStock8x1[0], buf8x_12345671[0]) @ 5.0SECOND
	calSignalStock1[0] = detect(fluorescenceDetection, fluorStockCheck1[0]) @ 30.0SECOND
	calSignal2x1[0] = detect(fluorescenceDetection, dil2x1[0]) @ 30.0SECOND
	calSignal4x1[0] = detect(fluorescenceDetection, dil4x1[0]) @ 30.0SECOND
	calSignal8x1[0] = detect(fluorescenceDetection, dil8x1[0]) @ 30.0SECOND
	if calSignalStock1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(wtMix1[0])
	dispose(mut1Mix1[0])
	dispose(mut2Mix1[0])
bsbbif_6_f:
	dispose(wtMix1[0])
	dispose(mut1Mix1[0])
	dispose(mut2Mix1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(ilSignalWT1[0])
	dispose(ilSignalMut11[0])
	dispose(ilSignalMut21[0])
	NOP
