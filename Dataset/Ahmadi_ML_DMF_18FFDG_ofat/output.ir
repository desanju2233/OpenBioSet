	f18_ofat1[0] = dispense(F18_Fluoride)
	heat(f18_ofat1[0]) @ 120.0CELSIUS @ 600.0SECOND
	kryp_ofat1[0] = dispense(Kryptofix_Acetonitrile_Mix)
	actF18_ofat1[0] = mix(f18_ofat1[0], kryp_ofat1[0]) @ 60.0SECOND
	mtrif_ofat1[0] = dispense(MannoseTriflate)
	label_ofat1[0] = mix(actF18_ofat1[0], mtrif_ofat1[0]) @ 30.0SECOND
	heat(label_ofat1[0]) @ 100.0CELSIUS @ 300.0SECOND
	naoh_ofat1[0] = dispense(SodiumHydroxide)
	fdg_ofat1[0] = mix(label_ofat1[0], naoh_ofat1[0]) @ 30.0SECOND
	heat(fdg_ofat1[0]) @ 50.0CELSIUS @ 300.0SECOND
	ofatSignal1[0] = detect(fluorinationEfficiencyDetection, fdg_ofat1[0]) @ 30.0SECOND
	if ofatSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	f18Droplet1[0] = dispense(F18_Fluoride)
	heat(f18Droplet1[0]) @ 120.0CELSIUS @ 600.0SECOND
	kryptofixDrop1[0] = dispense(Kryptofix_Acetonitrile_Mix)
	activatedF181[0] = mix(f18Droplet1[0], kryptofixDrop1[0]) @ 60.0SECOND
	mtrif_base1[0] = dispense(MannoseTriflate)
	labelingMix_base1[0] = mix(activatedF181[0], mtrif_base1[0]) @ 30.0SECOND
	heat(labelingMix_base1[0]) @ 85.0CELSIUS @ 300.0SECOND
	naoh_base1[0] = dispense(SodiumHydroxide)
	fdg_base1[0] = mix(labelingMix_base1[0], naoh_base1[0]) @ 30.0SECOND
	heat(fdg_base1[0]) @ 25.0CELSIUS @ 300.0SECOND
	baseSignal1[0] = detect(fluorinationEfficiencyDetection, fdg_base1[0]) @ 30.0SECOND
	if baseSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	aluminaDisc1[0] = dispense(NeutralAlumina_Disc)
	purifiedFDG1[0] = mix(fdg_ofat1[0], aluminaDisc1[0]) @ 2400.0SECOND
	heat(purifiedFDG1[0]) @ 25.0CELSIUS @ 1.0SECOND
	purifSignal1[0] = detect(radioactivityDetection, purifiedFDG1[0]) @ 30.0SECOND
	if purifSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_6_f:
	dispose(fdg_ofat1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(ofatSignal1[0])
	NOP
bsbbif_8_t:
	dispose(purifiedFDG1[0])
bsbbif_9_f:
	dispose(purifiedFDG1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(purifSignal1[0])
	jump: bsbbif_7_j
