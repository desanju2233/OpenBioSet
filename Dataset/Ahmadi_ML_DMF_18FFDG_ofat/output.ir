	heat(fdg_v21[0]) @ 25.0CELSIUS @ 300.0SECOND
	sig_v21[0] = detect(fluorinationEfficiencyDetection, fdg_v21[0]) @ 30.0SECOND
	dispose(sig_v21[0])
	dispose(fdg_v21[0])
