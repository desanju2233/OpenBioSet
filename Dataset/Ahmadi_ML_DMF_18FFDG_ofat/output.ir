	heat(fdg_v31[0]) @ 25.0CELSIUS @ 300.0SECOND
	sig_v31[0] = detect(fluorinationEfficiencyDetection, fdg_v31[0]) @ 30.0SECOND
	dispose(sig_v31[0])
