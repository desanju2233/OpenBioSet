	heat(f18_v61[0]) @ 120.0CELSIUS @ 600.0SECOND
	kryp_v61[0] = dispense(Kryptofix_Acetonitrile_Mix)
	actF18_v61[0] = mix(f18_v61[0], kryp_v61[0]) @ 60.0SECOND
	mtrif_v61[0] = dispense(MannoseTriflate)
	label_v61[0] = mix(actF18_v61[0], mtrif_v61[0]) @ 30.0SECOND
	heat(label_v61[0]) @ 85.0CELSIUS @ 300.0SECOND
	naoh_v61[0] = dispense(SodiumHydroxide)
	fdg_v61[0] = mix(label_v61[0], naoh_v61[0]) @ 30.0SECOND
	heat(fdg_v61[0]) @ 25.0CELSIUS @ 180.0SECOND
	sig_v61[0] = detect(fluorinationEfficiencyDetection, fdg_v61[0]) @ 30.0SECOND
