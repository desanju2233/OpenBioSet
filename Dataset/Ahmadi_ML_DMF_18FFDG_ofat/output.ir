	heat(fdg_v41[0]) @ 25.0CELSIUS @ 300.0SECOND
	sig_v41[0] = detect(fluorinationEfficiencyDetection, fdg_v41[0]) @ 30.0SECOND
	dispose(sig_v41[0])
	dispose(fdg_v41[0])
	f18_v51[0] = dispense(F18_Fluoride)
	heat(f18_v51[0]) @ 120.0CELSIUS @ 600.0SECOND
	kryp_v51[0] = dispense(Kryptofix_Acetonitrile_Mix)
	actF18_v51[0] = mix(f18_v51[0], kryp_v51[0]) @ 60.0SECOND
