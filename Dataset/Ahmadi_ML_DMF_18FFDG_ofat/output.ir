bsbbif_2_t:
	dispose(fdg_base1[0])
bsbbif_3_f:
	dispose(fdg_base1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(baseSignal1[0])
	f18_v11[0] = dispense(F18_Fluoride)
	heat(f18_v11[0]) @ 120.0CELSIUS @ 600.0SECOND
	kryp_v11[0] = dispense(Kryptofix_Acetonitrile_Mix)
	actF18_v11[0] = mix(f18_v11[0], kryp_v11[0]) @ 60.0SECOND
	mtrif_v11[0] = dispense(MannoseTriflate)
	label_v11[0] = mix(actF18_v11[0], mtrif_v11[0]) @ 30.0SECOND
	heat(label_v11[0]) @ 85.0CELSIUS @ 300.0SECOND
	naoh_v11[0] = dispense(SodiumHydroxide)
	fdg_v11[0] = mix(label_v11[0], naoh_v11[0]) @ 30.0SECOND
	heat(fdg_v11[0]) @ 25.0CELSIUS @ 300.0SECOND
	sig_v11[0] = detect(fluorinationEfficiencyDetection, fdg_v11[0]) @ 30.0SECOND
	dispose(sig_v11[0])
	dispose(fdg_v11[0])
