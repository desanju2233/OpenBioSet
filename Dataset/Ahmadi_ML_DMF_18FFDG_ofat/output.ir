	label_v31[0] = mix(actF18_v31[0], mtrif_v31[0]) @ 30.0SECOND
	heat(label_v31[0]) @ 85.0CELSIUS @ 420.0SECOND
	naoh_v31[0] = dispense(SodiumHydroxide)
