main:
	sample1[0] = dispense(DNASample)
	reagent1[0] = dispense(PCRReagent)
	pcr_mix1[0] = mix(sample1[0], reagent1[0]) @ 10.0SECOND
bsbbr_2_h:
	PHI REPEAT_251 = {REPEAT_250,REPEAT_252}
	PHI pcr_mix2 = {pcr_mix1,pcr_mix2}
	if REPEAT_251[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	heat(pcr_mix2[0]) @ 95.0CELSIUS @ 45.0SECOND
	heat(pcr_mix2[0]) @ 54.0CELSIUS @ 30.0SECOND
	heat(pcr_mix2[0]) @ 72.0CELSIUS @ 90.0SECOND
	REPEAT_252[0] = REPEAT_251[0] - 1
bsbbr_4_f:
	dna_signal1[0] = detect(fluorescence, pcr_mix2[0]) @ 30.0SECOND
	dispose(pcr_mix2[0])
	NOP
