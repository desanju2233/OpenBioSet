module fluorescence

manifest NaOH_Solution
manifest PHP_Indicator_Solution

instructions:

// --- Horizontal droplet handling: transport, electrocoalescence, horizontal shaking mixing ---
// (Figure 4a: NaOH droplet charges negative at ground electrode, PHP droplet charges
// positive at activated electrode, both transported horizontally toward each other)
naoh_h = dispense NaOH_Solution
php_h = dispense PHP_Indicator_Solution

// Electrocoalescence when the oppositely charged droplets meet
merged_h = mix naoh_h with php_h for 1s

// Horizontal reciprocating shaking (CCEP actuation, 400 V, 2 mm electrode pitch)
// completes mixing in roughly one minute per the PHP colorimetric endpoint
heat merged_h at 25c for 60s

// Mixing-index readout via colorimetric (PHP colorless-to-pink) chromic change
h_mixing_index = detect fluorescence on merged_h for 60s

if (h_mixing_index <= 80) {
    dispose merged_h
}

heat merged_h at 25c for 1s
dispose merged_h

// --- 3D droplet handling: horizontal + vertical transport, electrocoalescence, vertical shaking mixing ---
// (Figure 5a: droplets first transported horizontally toward each other, then vertically
// between upper and lower electrode modules, taking on opposite charge and merging)
naoh_v = dispense NaOH_Solution
php_v = dispense PHP_Indicator_Solution

// Electrocoalescence after horizontal + vertical transport
merged_v = mix naoh_v with php_v for 1s

// Vertical reciprocating shaking (CCEP actuation, 400 V, 4 mm electrode distance)
// achieves the fastest full mixing, in approximately 2.4 s
heat merged_v at 25c for 3s

v_mixing_index = detect fluorescence on merged_v for 3s

if (v_mixing_index <= 80) {
    dispose merged_v
}

heat merged_v at 25c for 1s
dispose merged_v
