main:
bsbbr_2_h:
	PHI REPEAT_101 = {REPEAT_100,REPEAT_102}
	PHI cells1 = {cells0,cells2}
	PHI plasmid1 = {plasmid0,plasmid2}
	PHI mix11 = {mix10,mix12}
	PHI efficiency1 = {efficiency0,efficiency2}
	PHI medium1 = {medium0,medium2}
	PHI atet1 = {atet0,atet2}
	PHI kan1 = {kan0,kan2}
	PHI oligo1 = {oligo0,oligo2}
	PHI edited1 = {edited0,edited2}
	PHI induced1 = {induced0,induced3}
	PHI recovered1 = {recovered0,recovered2}
	PHI selected1 = {selected0,selected2}
	if REPEAT_101[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_6_f
bsbbr_3_t:
	plasmid2[0] = dispense(grna_plasmid)
	oligo2[0] = dispense(oligo_dna)
	cells2[0] = dispense(competent_cells)
	mix12[0] = mix(plasmid2[0], oligo2[0]) @ 10.0SECOND
	edited2[0] = mix(mix12[0], cells2[0]) @ 60.0SECOND
	medium2[0] = dispense(recovery_medium)
	recovered2[0] = mix(edited2[0], medium2[0]) @ 30.0SECOND
	heat(recovered2[0]) @ 37.0CELSIUS @ 7200.0SECOND
	kan2[0] = dispense(kanamycin)
	selected2[0] = mix(recovered2[0], kan2[0]) @ 30.0SECOND
	heat(selected2[0]) @ 37.0CELSIUS @ 10800.0SECOND
	atet2[0] = dispense(anhydrotetracycline)
	induced2[0] = mix(selected2[0], atet2[0]) @ 30.0SECOND
	heat(induced2[0]) @ 37.0CELSIUS @ 43200.0SECOND
	efficiency2[0] = detect(fluorescence, induced2[0]) @ 30.0SECOND
	if efficiency2[0] < 80	|	true: jump bsbbif_4_t	|	false: jump bsbbif_5_f
bsbbif_4_t:
	dispose(induced2[0])
bsbbif_5_f:
	PHI induced3 = {induced2,induced}
	REPEAT_102[0] = REPEAT_101[0] - 1
	jump: bsbbr_2_h
bsbbr_6_f:
	media1[0] = dispense(galactose_media)
	plasmid21[0] = dispense(grna_plasmid)
	oligo21[0] = dispense(oligo_dna)
	cells21[0] = dispense(competent_cells)
	mixA1[0] = mix(plasmid21[0], oligo21[0]) @ 10.0SECOND
	mixB1[0] = mix(mixA1[0], cells21[0]) @ 60.0SECOND
	screened1[0] = mix(mixB1[0], media1[0]) @ 60.0SECOND
	heat(screened1[0]) @ 37.0CELSIUS @ 43200.0SECOND
	colony_color1[0] = detect(fluorescence, screened1[0]) @ 60.0SECOND
	if colony_color1[0] >= 90	|	true: jump bsbbif_7_t	|	false: jump bsbbif_8_f
bsbbif_7_t:
	dispose(screened1[0])
bsbbif_8_f:
	PHI screened2 = {screened1,screened}
bsbbr_9_h:
	PHI REPEAT_61 = {REPEAT_60,REPEAT_62}
	PHI production1 = {production0,production3}
	PHI absorbance6151 = {absorbance6150,absorbance6152}
	PHI mixC1 = {mixC0,mixC2}
	PHI oligo31 = {oligo30,oligo32}
	PHI recovered21 = {recovered20,recovered22}
	PHI medium21 = {medium20,medium22}
	PHI cells31 = {cells30,cells32}
	PHI plasmid31 = {plasmid30,plasmid32}
	PHI mixD1 = {mixD0,mixD2}
	PHI inducer1 = {inducer0,inducer2}
	if REPEAT_61[0] > 0	|	true: jump bsbbr_10_t	|	false: jump bsbbr_13_f
bsbbr_10_t:
	plasmid32[0] = dispense(grna_plasmid)
	oligo32[0] = dispense(oligo_dna)
	cells32[0] = dispense(competent_cells)
	mixC2[0] = mix(plasmid32[0], oligo32[0]) @ 10.0SECOND
	mixD2[0] = mix(mixC2[0], cells32[0]) @ 60.0SECOND
	medium22[0] = dispense(recovery_medium)
	recovered22[0] = mix(mixD2[0], medium22[0]) @ 30.0SECOND
	heat(recovered22[0]) @ 37.0CELSIUS @ 7200.0SECOND
	inducer2[0] = dispense(iptg)
	production2[0] = mix(recovered22[0], inducer2[0]) @ 30.0SECOND
	heat(production2[0]) @ 30.0CELSIUS @ 43200.0SECOND
	absorbance6152[0] = detect(fluorescence, production2[0]) @ 30.0SECOND
	if absorbance6152[0] < 60	|	true: jump bsbbif_11_t	|	false: jump bsbbif_12_f
bsbbif_11_t:
	dispose(production2[0])
bsbbif_12_f:
	PHI production3 = {production2,production}
	REPEAT_62[0] = REPEAT_61[0] - 1
	jump: bsbbr_9_h
bsbbr_13_f:
	NOP
