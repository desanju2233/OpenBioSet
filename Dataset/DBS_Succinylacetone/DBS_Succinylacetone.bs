module fluorescence

// Reagents / sample used in the DMF-nESI-MS dried blood spot (DBS)
// succinylacetone (SA) assay (Shih et al., Anal. Chem. 2012, 84, 3731-3738)
manifest dbs_sample
manifest methanol
manifest hydrazine_reagent

instructions:

// ---- Steps 1-6: triplicate pre-extraction of DBS punch in methanol ----
// (15 uL MeOH droplet, 15 min RT incubation, then actuated away to waste)
dbs = dispense dbs_sample
meoh = dispense 15 units of methanol
wash = mix meoh with dbs for 900s
dispose wash

repeat 2 times {
    dbs = dispense dbs_sample
    meoh = dispense 15 units of methanol
    wash = mix meoh with dbs for 900s
    dispose wash
}

// ---- Step 7: first SA extraction/derivatization droplet ----
// (15 uL hydrazine/13C5-SA/ACN:H2O solvent, incubated at 37c until evaporation)
dbs = dispense dbs_sample
hz1 = dispense 15 units of hydrazine_reagent
deriv1 = mix hz1 with dbs
heat deriv1 at 37c for 15m
dispose deriv1

// ---- Step 8: second (fresh) SA extraction/derivatization droplet ----
// (15 uL hydrazine reagent, RT incubation with circular actuation ~1 min)
dbs = dispense dbs_sample
hz2 = dispense 15 units of hydrazine_reagent
deriv2 = mix hz2 with dbs for 60s

// ---- Step 9: deliver droplet to capillary emitter and analyze by nESI-MS/MS ----
// (quantification via m/z 155->137 SA / m/z 160->142 13C5-SA transition intensity ratio)
sa_reading = detect fluorescence on deriv2 for 50s

dispose deriv2
