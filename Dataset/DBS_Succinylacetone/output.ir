main:
	dbs1[0] = dispense(dbs_sample)
	meoh1[0] = dispense(methanol)
	wash1[0] = mix(meoh1[0], dbs1[0]) @ 900.0SECOND
	dispose(wash1[0])
bsbbr_2_h:
	PHI REPEAT_21 = {REPEAT_22,REPEAT_2}
	PHI wash2 = {wash3,wash}
	PHI meoh2 = {meoh3,meoh}
	PHI dbs2 = {dbs3,dbs}
	if REPEAT_21[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	dbs3[0] = dispense(dbs_sample)
	meoh3[0] = dispense(methanol)
	wash3[0] = mix(meoh3[0], dbs3[0]) @ 900.0SECOND
	dispose(wash3[0])
	REPEAT_22[0] = REPEAT_21[0] - 1
bsbbr_4_f:
	dbs4[0] = dispense(dbs_sample)
	hz11[0] = dispense(hydrazine_reagent)
	deriv11[0] = mix(hz11[0], dbs4[0])
	heat(deriv11[0]) @ 37.0CELSIUS @ 900.0SECOND
	dispose(deriv11[0])
	dbs5[0] = dispense(dbs_sample)
	hz21[0] = dispense(hydrazine_reagent)
	deriv21[0] = mix(hz21[0], dbs5[0]) @ 60.0SECOND
	sa_reading1[0] = detect(fluorescence, deriv21[0]) @ 50.0SECOND
	dispose(deriv21[0])
	NOP
