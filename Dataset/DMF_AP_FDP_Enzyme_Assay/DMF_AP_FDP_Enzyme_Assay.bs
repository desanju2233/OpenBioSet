module fluorescence

// Reagents used in Miller & Wheeler, Anal. Chem. 2008, 80, 1614-1619
// "A Digital Microfluidic Approach to Homogeneous Enzyme Assays"
// AP = alkaline phosphatase (in DEA buffer, 1 mM MgCl2, 0.1% w/v Pluronic F-127)
// FDP = fluorescein diphosphate substrate (in DEA buffer)
// Pi = inorganic phosphate (competitive AP inhibitor)

manifest ap_enzyme
manifest fdp_substrate
manifest dea_buffer
manifest inorganic_phosphate

instructions:

// =========================================================
// Part 1: Basic fluorogenic enzyme assay (Fig. 1)
// AP + FDP merged and mixed -> fluorescein product detected
// =========================================================

ap_drop = dispense 1 units of ap_enzyme
fdp_drop = dispense 1 units of fdp_substrate
rxn_basic = mix ap_drop with fdp_drop for 15s

basic_assay_signal = detect fluorescence on rxn_basic for 1m
dispose rxn_basic

// =========================================================
// Part 2: Substrate quantitation / FDP calibration curve (Fig. 2)
// Fixed AP concentration (6 U/mL) mixed with a dilution series
// of FDP substrate; single endpoint fluorescence reading each
// =========================================================

ap_std = dispense 1 units of ap_enzyme
fdp_std1 = dispense 1 units of fdp_substrate
rxn_std1 = mix ap_std with fdp_std1 for 15s
fdp_0_5nM_signal = detect fluorescence on rxn_std1 for 1m
dispose rxn_std1

ap_std2 = dispense 1 units of ap_enzyme
fdp_std2 = dispense 1 units of fdp_substrate
rxn_std2 = mix ap_std2 with fdp_std2 for 15s
fdp_1nM_signal = detect fluorescence on rxn_std2 for 1m
dispose rxn_std2

ap_std3 = dispense 1 units of ap_enzyme
fdp_std3 = dispense 1 units of fdp_substrate
rxn_std3 = mix ap_std3 with fdp_std3 for 15s
fdp_2_5nM_signal = detect fluorescence on rxn_std3 for 1m
dispose rxn_std3

ap_std4 = dispense 1 units of ap_enzyme
fdp_std4 = dispense 1 units of fdp_substrate
rxn_std4 = mix ap_std4 with fdp_std4 for 15s
fdp_5nM_signal = detect fluorescence on rxn_std4 for 1m
dispose rxn_std4

ap_std5 = dispense 1 units of ap_enzyme
fdp_std5 = dispense 1 units of fdp_substrate
rxn_std5 = mix ap_std5 with fdp_std5 for 15s
fdp_10nM_signal = detect fluorescence on rxn_std5 for 1m
dispose rxn_std5

// =========================================================
// Part 3: Enzyme kinetics (Fig. 4)
// Low-concentration AP (0.21 U/mL) merged/mixed with FDP,
// fluorescent product monitored continuously over ~500s
// to obtain initial reaction rate
// =========================================================

ap_kinetic = dispense 1 units of ap_enzyme
fdp_kinetic = dispense 1 units of fdp_substrate
rxn_kinetic = mix ap_kinetic with fdp_kinetic for 15s

// Time-course fluorescence monitoring (10 x 30s intervals ~ 300-500s)
repeat 10 times {
    kinetic_timepoint_signal = detect fluorescence on rxn_kinetic for 30s
}

dispose rxn_kinetic

// =========================================================
// Part 4: Enzyme inhibition with inorganic phosphate (Fig. 5)
// FDP held constant at 10 uM or 5 uM; Pi varied 0-45 uM;
// reaction rate monitored over time for each condition
// =========================================================

// --- 10 uM FDP series ---
fdp10_pi0 = dispense 1 units of fdp_substrate
ap10_pi0 = dispense 1 units of ap_enzyme
rxn_fdp10_pi0 = mix fdp10_pi0 with ap10_pi0 for 15s
repeat 5 times {
    fdp10_pi0_signal = detect fluorescence on rxn_fdp10_pi0 for 30s
}
dispose rxn_fdp10_pi0

fdp10_pi15 = dispense 1 units of fdp_substrate
pi15a = dispense 1 units of inorganic_phosphate
fdp10_dose1 = mix fdp10_pi15 with pi15a for 15s
ap10_pi15 = dispense 1 units of ap_enzyme
rxn_fdp10_pi15 = mix fdp10_dose1 with ap10_pi15 for 15s
repeat 5 times {
    fdp10_pi15_signal = detect fluorescence on rxn_fdp10_pi15 for 30s
}
dispose rxn_fdp10_pi15

fdp10_pi30 = dispense 1 units of fdp_substrate
pi30a = dispense 1 units of inorganic_phosphate
fdp10_dose2 = mix fdp10_pi30 with pi30a for 15s
ap10_pi30 = dispense 1 units of ap_enzyme
rxn_fdp10_pi30 = mix fdp10_dose2 with ap10_pi30 for 15s
repeat 5 times {
    fdp10_pi30_signal = detect fluorescence on rxn_fdp10_pi30 for 30s
}
dispose rxn_fdp10_pi30

fdp10_pi45 = dispense 1 units of fdp_substrate
pi45a = dispense 1 units of inorganic_phosphate
fdp10_dose3 = mix fdp10_pi45 with pi45a for 15s
ap10_pi45 = dispense 1 units of ap_enzyme
rxn_fdp10_pi45 = mix fdp10_dose3 with ap10_pi45 for 15s
repeat 5 times {
    fdp10_pi45_signal = detect fluorescence on rxn_fdp10_pi45 for 30s
}
dispose rxn_fdp10_pi45

// --- 5 uM FDP series ---
fdp5_pi0 = dispense 1 units of fdp_substrate
ap5_pi0 = dispense 1 units of ap_enzyme
rxn_fdp5_pi0 = mix fdp5_pi0 with ap5_pi0 for 15s
repeat 5 times {
    fdp5_pi0_signal = detect fluorescence on rxn_fdp5_pi0 for 30s
}
dispose rxn_fdp5_pi0

fdp5_pi15 = dispense 1 units of fdp_substrate
pi15b = dispense 1 units of inorganic_phosphate
fdp5_dose1 = mix fdp5_pi15 with pi15b for 15s
ap5_pi15 = dispense 1 units of ap_enzyme
rxn_fdp5_pi15 = mix fdp5_dose1 with ap5_pi15 for 15s
repeat 5 times {
    fdp5_pi15_signal = detect fluorescence on rxn_fdp5_pi15 for 30s
}
dispose rxn_fdp5_pi15

fdp5_pi30 = dispense 1 units of fdp_substrate
pi30b = dispense 1 units of inorganic_phosphate
fdp5_dose2 = mix fdp5_pi30 with pi30b for 15s
ap5_pi30 = dispense 1 units of ap_enzyme
rxn_fdp5_pi30 = mix fdp5_dose2 with ap5_pi30 for 15s
repeat 5 times {
    fdp5_pi30_signal = detect fluorescence on rxn_fdp5_pi30 for 30s
}
dispose rxn_fdp5_pi30

fdp5_pi45 = dispense 1 units of fdp_substrate
pi45b = dispense 1 units of inorganic_phosphate
fdp5_dose3 = mix fdp5_pi45 with pi45b for 15s
ap5_pi45 = dispense 1 units of ap_enzyme
rxn_fdp5_pi45 = mix fdp5_dose3 with ap5_pi45 for 15s
repeat 5 times {
    fdp5_pi45_signal = detect fluorescence on rxn_fdp5_pi45 for 30s
}
dispose rxn_fdp5_pi45
