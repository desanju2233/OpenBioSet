bsbbif_2_t:
	dispose(plated1[0])
bsbbif_3_f:
	PHI plated2 = {plated1,plated}
	NOP
main:
	cells1[0] = dispense(ecoli_cells)
	heat(cells1[0]) @ 37.0CELSIUS @ 10800.0SECOND
	heat(cells1[0]) @ 4.0CELSIUS @ 900.0SECOND
	buffer11[0] = dispense(cacl2_buffer)
	resuspended11[0] = mix(cells1[0], buffer11[0]) @ 30.0SECOND
	heat(resuspended11[0]) @ 4.0CELSIUS @ 1800.0SECOND
	buffer21[0] = dispense(cacl2_glycerol)
	competent_cells1[0] = mix(resuspended11[0], buffer21[0]) @ 30.0SECOND
	heat(competent_cells1[0]) @ 4.0CELSIUS @ 300.0SECOND
	dna1[0] = dispense(plasmid_dna)
	transformation_mix1[0] = mix(competent_cells1[0], dna1[0]) @ 30.0SECOND
	heat(transformation_mix1[0]) @ 4.0CELSIUS @ 1800.0SECOND
	heat(transformation_mix1[0]) @ 42.0CELSIUS @ 45.0SECOND
	broth1[0] = dispense(lb_broth)
	recovery1[0] = mix(transformation_mix1[0], broth1[0]) @ 30.0SECOND
	heat(recovery1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	agar1[0] = dispense(kanamycin_agar)
	plated1[0] = mix(recovery1[0], agar1[0]) @ 30.0SECOND
	heat(plated1[0]) @ 37.0CELSIUS @ 43200.0SECOND
	expression_signal1[0] = detect(fluorescence, plated1[0]) @ 30.0SECOND
	if expression_signal1[0] < 50	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
