module fluorescence

manifest sample_powder
manifest kcl_buffer_ph1
manifest sodium_acetate_buffer_ph45

instructions:

// Step 1: Combine sample powder with 0.025 mol/L potassium chloride buffer (pH 1.0)
// in a 1:8 extract-to-buffer ratio
powder1 = dispense 1 units of sample_powder
kcl = dispense 8 units of kcl_buffer_ph1
sol_ph1 = mix powder1 with kcl

// Step 2: Measure absorbance at 515 nm and 700 nm for the pH 1.0 extract
// (detect fluorescence used as the generic optical-signal readout stand-in, since BioScript
// exposes no dedicated absorbance/spectrophotometric detect module)
abs_515_ph1 = detect fluorescence on sol_ph1 for 30s
abs_700_ph1 = detect fluorescence on sol_ph1 for 30s
dispose sol_ph1

// Step 3: Combine sample powder with 0.4 mol/L sodium acetate buffer (pH 4.5)
// in a 1:8 extract-to-buffer ratio
powder2 = dispense 1 units of sample_powder
naoac = dispense 8 units of sodium_acetate_buffer_ph45
sol_ph45 = mix powder2 with naoac

// Step 4: Measure absorbance at 515 nm and 700 nm for the pH 4.5 extract
abs_515_ph45 = detect fluorescence on sol_ph45 for 30s
abs_700_ph45 = detect fluorescence on sol_ph45 for 30s
dispose sol_ph45
