main:
	powder11[0] = dispense(sample_powder)
	kcl1[0] = dispense(kcl_buffer_ph1)
	sol_ph11[0] = mix(powder11[0], kcl1[0])
	abs_515_ph11[0] = detect(fluorescence, sol_ph11[0]) @ 30.0SECOND
	abs_700_ph11[0] = detect(fluorescence, sol_ph11[0]) @ 30.0SECOND
	dispose(sol_ph11[0])
	powder21[0] = dispense(sample_powder)
	naoac1[0] = dispense(sodium_acetate_buffer_ph45)
	sol_ph451[0] = mix(powder21[0], naoac1[0])
	abs_515_ph451[0] = detect(fluorescence, sol_ph451[0]) @ 30.0SECOND
	abs_700_ph451[0] = detect(fluorescence, sol_ph451[0]) @ 30.0SECOND
	dispose(sol_ph451[0])
	NOP
