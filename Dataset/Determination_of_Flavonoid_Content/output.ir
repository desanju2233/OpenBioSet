main:
	extract1[0] = dispense(methanolic_extract)
	water11[0] = dispense(distilled_water)
	sol11[0] = mix(extract1[0], water11[0])
	nano21[0] = dispense(sodium_nitrite)
	sol21[0] = mix(sol11[0], nano21[0])
	heat(sol21[0]) @ 25.0CELSIUS @ 300.0SECOND
	alcl31[0] = dispense(aluminium_chloride)
	sol31[0] = mix(sol21[0], alcl31[0])
	heat(sol31[0]) @ 25.0CELSIUS @ 360.0SECOND
	naoh1[0] = dispense(sodium_hydroxide)
	sol41[0] = mix(sol31[0], naoh1[0])
	water21[0] = dispense(distilled_water)
	reaction1[0] = mix(sol41[0], water21[0])
	flavonoid_reading1[0] = detect(fluorescence, reaction1[0]) @ 30.0SECOND
	dispose(reaction1[0])
	NOP
