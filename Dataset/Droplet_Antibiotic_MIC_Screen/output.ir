main:
bsbbr_2_h:
	PHI REPEAT_161 = {REPEAT_160,REPEAT_162}
	PHI droplet1 = {droplet0,droplet3}
	PHI medium1 = {medium0,medium2}
	PHI antibiotic1 = {antibiotic0,antibiotic2}
	PHI a1 = {a0,a2}
	PHI bacteria1 = {bacteria0,bacteria2}
	PHI growth_signal1 = {growth_signal0,growth_signal2}
	if REPEAT_161[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_6_f
bsbbr_3_t:
	bacteria2[0] = dispense(Bacteria)
	medium2[0] = dispense(GrowthMedium)
	antibiotic2[0] = dispense(Cefotaxime)
	a2[0] = mix(bacteria2[0], medium2[0])
	droplet2[0] = mix(a2[0], antibiotic2[0]) @ 5.0SECOND
	heat(droplet2[0]) @ 37.0CELSIUS @ 57600.0SECOND
	growth_signal2[0] = detect(fluorescence, droplet2[0]) @ 30.0SECOND
	if growth_signal2[0] >= 500	|	true: jump bsbbif_4_t	|	false: jump bsbbif_5_f
bsbbif_4_t:
	dispose(droplet2[0])
bsbbif_5_f:
	PHI droplet3 = {droplet2,droplet}
	dispose(droplet3[0])
	REPEAT_162[0] = REPEAT_161[0] - 1
	jump: bsbbr_2_h
bsbbr_6_f:
	NOP
