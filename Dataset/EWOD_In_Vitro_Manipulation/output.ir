bsbbif_2_t:
	dispose(embryo_droplet1[0])
bsbbif_3_f:
	PHI embryo_droplet2 = {embryo_droplet1,embryo_droplet}
main:
	coc1[0] = dispense(OocyteCOC)
	tcm1[0] = dispense(TCM199)
	gent1[0] = dispense(Gentamycin)
	egf1[0] = dispense(EGF)
	a1[0] = mix(coc1[0], tcm1[0])
	b1[0] = mix(a1[0], gent1[0])
	maturing_oocytes1[0] = mix(b1[0], egf1[0])
	heat(maturing_oocytes1[0]) @ 38.0CELSIUS @ 79200.0SECOND
	sperm1[0] = dispense(Spermatozoa)
	ivftalp1[0] = dispense(IVFTALP)
	bsa1[0] = dispense(BSA)
	heparin1[0] = dispense(Heparin)
	c1[0] = mix(sperm1[0], ivftalp1[0])
	d1[0] = mix(c1[0], bsa1[0])
	prepared_sperm1[0] = mix(d1[0], heparin1[0])
	hepes1[0] = dispense(HEPESTALP)
	washed_oocytes1[0] = mix(maturing_oocytes1[0], hepes1[0])
	presumed_zygotes1[0] = mix(washed_oocytes1[0], prepared_sperm1[0])
	heat(presumed_zygotes1[0]) @ 38.0CELSIUS @ 75600.0SECOND
	dispose(prepared_sperm1[0])
	sof1[0] = dispense(SOFaaITSBSA)
	tween1[0] = dispense(Tween80)
	loading_medium1[0] = mix(sof1[0], tween1[0])
	embryo_droplet1[0] = mix(presumed_zygotes1[0], loading_medium1[0])
	heat(embryo_droplet1[0]) @ 38.0CELSIUS @ 60.0SECOND
	cleavage_check1[0] = detect(fluorescence, embryo_droplet1[0]) @ 30.0SECOND
	if cleavage_check1[0] <= 50	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbr_4_h:
	PHI REPEAT_31 = {REPEAT_30,REPEAT_32}
	PHI embryo_droplet3 = {embryo_droplet2,embryo_droplet3}
	if REPEAT_31[0] > 0	|	true: jump bsbbr_5_t	|	false: jump bsbbr_6_f
bsbbr_5_t:
	heat(embryo_droplet3[0]) @ 38.0CELSIUS @ 86400.0SECOND
	REPEAT_32[0] = REPEAT_31[0] - 1
bsbbr_6_f:
	fresh1[0] = dispense(FreshMedium)
	supplied_droplet1[0] = mix(embryo_droplet3[0], fresh1[0])
	heat(supplied_droplet1[0]) @ 38.0CELSIUS @ 60.0SECOND
bsbbr_7_h:
	PHI REPEAT_41 = {REPEAT_40,REPEAT_42}
	PHI supplied_droplet2 = {supplied_droplet1,supplied_droplet2}
	if REPEAT_41[0] > 0	|	true: jump bsbbr_8_t	|	false: jump bsbbr_9_f
bsbbr_8_t:
	heat(supplied_droplet2[0]) @ 38.0CELSIUS @ 86400.0SECOND
	REPEAT_42[0] = REPEAT_41[0] - 1
bsbbr_9_f:
	blastocyst_check1[0] = detect(fluorescence, supplied_droplet2[0]) @ 30.0SECOND
	if blastocyst_check1[0] <= 80	|	true: jump bsbbif_10_t	|	false: jump bsbbif_11_f
bsbbif_10_t:
	dispose(supplied_droplet2[0])
bsbbif_11_f:
	PHI supplied_droplet3 = {supplied_droplet2,supplied_droplet}
	dispose(supplied_droplet3[0])
	NOP
