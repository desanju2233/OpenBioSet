module fluorescence

manifest apple_tissue
manifest metaphosphoric_acid
manifest dichloroindophenol_reagent

instructions:

// Step 1: Homogenize apple fruit tissue in 1% meta-phosphoric acid for 1 min
tissue = dispense 1000 units of apple_tissue
mpa = dispense 10000 units of metaphosphoric_acid
homogenate = mix tissue with mpa

// Step 2: Agitate slowly at room temperature for 45 min
heat homogenate at 25c for 45m

// Step 3: Centrifugation (1370 x g, 10 min) and Whatman No. 1 filtration are off-chip;
// filtrate is carried forward

// Step 4: Mix 1 mL of filtrate with 9 mL of 2,6-dichloro-indophenol reagent
dcip = dispense 9000 units of dichloroindophenol_reagent
reaction = mix homogenate with dcip

// Step 5: Measure absorbance at 515 nm to quantify ascorbic acid content
// (detect fluorescence used as the generic optical-signal readout stand-in, since BioScript
// exposes no dedicated absorbance/spectrophotometric detect module)
ascorbic_reading = detect fluorescence on reaction for 30s

dispose reaction
