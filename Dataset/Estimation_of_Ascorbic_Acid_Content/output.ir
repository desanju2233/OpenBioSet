main:
	tissue1[0] = dispense(apple_tissue)
	mpa1[0] = dispense(metaphosphoric_acid)
	homogenate1[0] = mix(tissue1[0], mpa1[0])
	heat(homogenate1[0]) @ 25.0CELSIUS @ 2700.0SECOND
	dcip1[0] = dispense(dichloroindophenol_reagent)
	reaction1[0] = mix(homogenate1[0], dcip1[0])
	ascorbic_reading1[0] = detect(fluorescence, reaction1[0]) @ 30.0SECOND
	dispose(reaction1[0])
	NOP
