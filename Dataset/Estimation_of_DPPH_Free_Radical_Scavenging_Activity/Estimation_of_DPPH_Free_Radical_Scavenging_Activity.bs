module fluorescence

manifest methanolic_extract
manifest dpph_solution

instructions:

// Step 1: Combine 40 uL of methanolic extract with 160 uL of 100 uM DPPH solution (in methanol)
extract = dispense 40 units of methanolic_extract
dpph = dispense 160 units of dpph_solution
reaction = mix extract with dpph

// Step 2: Incubate in the dark at room temperature for 30 min
heat reaction at 25c for 30m

// Step 3: Measure absorbance at 517 nm to quantify DPPH radical scavenging activity
// (detect fluorescence used as the generic optical-signal readout stand-in, since BioScript
// exposes no dedicated absorbance/spectrophotometric detect module)
dpph_reading = detect fluorescence on reaction for 30s

dispose reaction
