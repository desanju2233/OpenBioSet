module fluorescence

manifest methanolic_extract
manifest folin_ciocalteu_reagent
manifest sodium_carbonate

instructions:

// Step 1: Combine 100 uL methanolic extract with 500 uL diluted Folin-Ciocalteu reagent (1:9 in water);
// hold at room temperature (~28-30 C) for 5 min
extract = dispense 100 units of methanolic_extract
fc_reagent = dispense 500 units of folin_ciocalteu_reagent
mixture = mix extract with fc_reagent
heat mixture at 28c for 5m

// Step 2: Add 400 uL of 5% sodium carbonate to develop the color reaction; incubate 20 min in the dark
na2co3 = dispense 400 units of sodium_carbonate
developed = mix mixture with na2co3
heat developed at 28c for 20m

// Step 3: Read absorbance at 765 nm to quantify total phenolic content
// (detect fluorescence used as the generic optical-signal readout stand-in, since BioScript
// exposes no dedicated absorbance/spectrophotometric detect module)
tpc_reading = detect fluorescence on developed for 30s

dispose developed
