main:
	tissue1[0] = dispense(apple_tissue)
	meoh1[0] = dispense(methanol)
	extract1[0] = mix(tissue1[0], meoh1[0])
	heat(extract1[0]) @ 25.0CELSIUS @ 120.0SECOND
	water1[0] = dispense(deionized_water)
	diluted1[0] = mix(extract1[0], water1[0])
	heat(diluted1[0]) @ 4.0CELSIUS @ 120.0SECOND
	anthrone1[0] = dispense(anthrone_reagent)
	reaction1[0] = mix(diluted1[0], anthrone1[0])
	heat(reaction1[0]) @ 100.0CELSIUS @ 600.0SECOND
	heat(reaction1[0]) @ 4.0CELSIUS @ 300.0SECOND
	sugar_reading1[0] = detect(fluorescence, reaction1[0]) @ 30.0SECOND
	dispose(reaction1[0])
	NOP
