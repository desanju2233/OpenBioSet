module fluorescence

manifest di_water
manifest nacl_0_1m
manifest nacl_1m

instructions:

// ==================================================================
// Droplet manipulation demo (Figure 1b,c): single droplet actuation,
// straight/turn movement across the 2 mm x 2 mm electrode array with
// 0.5 mm spacing, and two-droplet merging.
// ==================================================================
d1 = dispense 10 units of di_water

repeat 4 times {
    d1 = mix d1 with d1 for 1s
}

d2 = dispense 10 units of di_water
merged = mix d1 with d2 for 1s
dispose merged

// ==================================================================
// Contact angle characterization (Figure 9a): DI water, 0.1 M NaCl,
// and 1 M NaCl droplets (10 uL) actuated under increasing AC voltage
// (1 kHz); contact angle decreases toward saturation with voltage.
// ==================================================================
water_drop = dispense 10 units of di_water
water_angle_reading = detect fluorescence on water_drop for 1s
dispose water_drop

nacl_low_drop = dispense 10 units of nacl_0_1m
nacl_low_angle_reading = detect fluorescence on nacl_low_drop for 1s
dispose nacl_low_drop

nacl_high_drop = dispense 10 units of nacl_1m
nacl_high_angle_reading = detect fluorescence on nacl_high_drop for 1s
dispose nacl_high_drop

// ==================================================================
// Leakage current characterization (Figure 8): AC voltage swept from
// 250 to 450 Vrms in 25 V steps, five repeated measurements per step,
// across the PE-dielectric/ITO/PET stack.
// ==================================================================
leak_drop = dispense 10 units of di_water

repeat 9 times {
    repeat 5 times {
        leakage_reading = detect fluorescence on leak_drop for 1s
    }
}

dispose leak_drop

// ==================================================================
// Minimum driving voltage characterization (Figure 9b): DI water
// droplets of 8, 10, and 12 uL actuated with electrode on/off times
// of 1, 2, 3, and 4 s to find the minimum voltage for reliable motion.
// ==================================================================
repeat 3 times {
    vdrop = dispense 8 units of di_water

    repeat 4 times {
        min_voltage_reading = detect fluorescence on vdrop for 1s
        vdrop = mix vdrop with vdrop for 1s
    }

    dispose vdrop
}
