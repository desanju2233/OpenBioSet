bsbbif_2_t:
	beadsAG21[0] = dispense(ProteinAGBeads)
	beadsHSA21[0] = dispense(AntiHSABeads)
	beads21[0] = mix(beadsAG21[0], beadsHSA21[0])
	depletion21[0] = mix(beads21[0], depletion11[0])
	heat(depletion21[0]) @ 25.0CELSIUS @ 600.0SECOND
	signal21[0] = detect(fluorescence, depletion21[0]) @ 30.0SECOND
	dispose(depletion11[0])
bsbbif_3_f:
	PHI beads22 = {beads20,beads2}
	PHI depletion12 = {depletion11,depletion1}
	PHI depletion22 = {depletion20,depletion2}
	PHI beadsAG22 = {beadsAG20,beadsAG2}
	PHI signal22 = {signal20,signal2}
	PHI beadsHSA22 = {beadsHSA20,beadsHSA2}
	NOP
main:
	beadsAG1[0] = dispense(ProteinAGBeads)
	beadsHSA1[0] = dispense(AntiHSABeads)
	beads1[0] = mix(beadsAG1[0], beadsHSA1[0])
	sample1[0] = dispense(ProteinSample)
	depletion11[0] = mix(beads1[0], sample1[0])
	heat(depletion11[0]) @ 25.0CELSIUS @ 600.0SECOND
	signal11[0] = detect(fluorescence, depletion11[0]) @ 30.0SECOND
	if signal11[0] > 5	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
