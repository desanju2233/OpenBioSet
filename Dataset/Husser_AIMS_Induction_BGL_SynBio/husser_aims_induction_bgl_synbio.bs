module odMeasurement
module rfpFluorescenceDetection
module bglActivityDetection

manifest LB_Media
manifest PluronicF68
manifest RFP_Cells
manifest BGL1_Cells
manifest BGL2_Cells
manifest BGL3_Cells
manifest IPTG_Stock
manifest LysisBuffer
manifest MUG_Substrate
manifest SodiumCitrate_Buffer
manifest GlycineNaOH_Stop
manifest Buffer

// ============================================================
// An Automated Induction Microfluidics System for Synthetic
// Biology. Husser, Vo, Sinha, Ahmadi, Shih.
// ACS Synth. Biol. 2018, 7, 933-944.
// DOI: 10.1021/acssynbio.8b00025
//
// This file encodes THREE sequential protocols from the paper,
// executed in the order described in the Results section:
//
// PROTOCOL 1: AIMS Characterisation -- Growth Curve.
//   E. coli BL21(DE3) carrying empty pET16b vector diluted to
//   OD ~0.1 in LB + 0.05% Pluronics F-68. Loaded as a 14 uL
//   mother culture droplet onto the culture area (4 x 4.5x4.5mm
//   electrodes). Semicontinuous mixing: one actuation every 45 s,
//   700 ms actuation time, horizontal+vertical 4-step sequence.
//   OD monitored via 600 nm LED / TSL2561 lux sensor at a 280 um
//   gap height (limit of detection: 0.029 OD units, path-length-
//   corrected using A = log(I0/I)/0.028). Induction trigger: OD
//   = 0.4. Doubling time on AIMS: 72.88 +/- 2.30 min (vs 36.80
//   +/- 0.36 min bench-top; p=0.018 two-tailed paired t-test).
//
// PROTOCOL 2: Inducer Concentration Optimisation (RFP reporter).
//   RFP-expressing E. coli BL21(DE3) [pET16b-RFP, T7 promoter]
//   grown to OD 0.4 on the AIMS, then induced on-chip using a
//   2:1 serial dilution series of IPTG generated by mixing 1.42
//   uL culture droplets with 0.3 uL of 3.24 mM IPTG and
//   splitting. Five daughter droplets incubated for 4 h at 37 C.
//   RFP fluorescence read at 612 nm (ex 582 nm) on CLARIOStar
//   plate reader (scan 30x30, 6 mm, focal 7.2 mm, gain 2905).
//   Dose-response curve follows a sigmoidal (Hill) profile;
//   maximal expression at IPTG >= 200 uM. IPTG concentrations
//   tested: 200, 133.3, 88.9, 59.3, 40, 26.7, 17.8, 11.9 uM.
//
// PROTOCOL 3: Expression Optimisation -- BGL Enzyme Screening.
//   Sub-protocol A (Single-point induction, Fig 6B/C):
//     Three BGL-expressing E. coli strains (BGL1: Thermomicrobium
//     roseum YP_002522957.1; BGL2: Thermobaculum terrenum
//     WP_041425608.1; BGL3: Rhodothermus marinus WP_012844561.1)
//     all cloned into pET16b-T7, induced at OD 0.4 with 2 uL of
//     11 mM IPTG. Five daughter droplets per strain dispensed and
//     incubated at 37 C. After 4 h, cells lysed with 1x lysis
//     buffer for 10 min at RT, then 1.42 uL of 150 mM sodium-
//     citrate + 6 mM MUG added per assay spot. Time points: 0,
//     15, 30, 45, 60 min. Reaction stopped with 1.42 uL of 0.4 M
//     glycine-NaOH. Fluorescence at 449 nm (ex 368 nm), focal
//     4.0 mm, gain 664. BGL3 activity >= 6x BGL1 or BGL2.
//   Sub-protocol B (Multi-point induction, Fig 6D):
//     BGL3 cells only. Five subcultures induced at OD ~0.1 and
//     lysed at 0, 2, 3, 5, 6 h post-induction. MUG incubation:
//     30 min. Same fluorescence settings as single-point.
//     BGL3 expression at 6 h >= 3x expression at 0 h.
//
// MANIFESTS:
//   LB_Media            -- LB broth (used for mother culture)
//   PluronicF68         -- 0.05% Pluronics F-68 anti-biofouling
//                          additive (pre-mixed in all cell-
//                          containing and assay droplets)
//   RFP_Cells           -- E. coli BL21(DE3) carrying pET16b-RFP
//   BGL1_Cells          -- E. coli BL21(DE3) carrying pET16b-BGL1
//   BGL2_Cells          -- E. coli BL21(DE3) carrying pET16b-BGL2
//   BGL3_Cells          -- E. coli BL21(DE3) carrying pET16b-BGL3
//   IPTG_Stock          -- 3.24 mM IPTG (for Protocol 2 series)
//                          and 11 mM IPTG (for Protocol 3 series);
//                          modelled as a single manifest; actual
//                          stock concentrations differ between runs
//   LysisBuffer         -- 1x lysis buffer (BugBuster-based)
//   MUG_Substrate       -- 6 mM 4-methylumbelliferyl
//                          beta-D-glucopyranoside in 150 mM
//                          sodium-citrate buffer
//   SodiumCitrate_Buffer -- 150 mM sodium-citrate pH 5.0 (used
//                          to dilute assay droplets)
//   GlycineNaOH_Stop    -- 0.4 M glycine-NaOH stop solution
//   Buffer              -- LB + 0.05% F-68 (used for OD blank)
//
// DETECTION MODULES:
//   odMeasurement           -- abstracts the TSL2561 lux sensor
//                              reading at 600 nm; signal > 0
//                              encodes OD >= 0.4 threshold met.
//   rfpFluorescenceDetection -- abstracts CLARIOStar end-point
//                              RFP fluorescence scan (612 nm /
//                              582 nm excitation).
//   bglActivityDetection    -- abstracts CLARIOStar MUF
//                              fluorescence scan (449 nm /
//                              368 nm excitation).
//
// TEMPERATURE / MIXING NOTES:
//   All incubations at 37 C (device placed in incubator with
//   open water container for humidity). `heat` statements model
//   the incubator + TEC arrangement. Semicontinuous mixing
//   between OD reads is abstracted as `mix ... for 45s` (one
//   45 s mixing cycle), called repeatedly in the growth loop.
//   The BioScript `mix` keyword is used throughout to represent
//   both DMF electrode actuation mixing and the conceptual merge
//   of reagents; it does not imply a single physical act of
//   pipetting.
//
// COMPILER NOTE (lilott8/BioScript):
//   Duration tokens recognised: s (seconds), m (minutes).
//   Multi-hour values converted: 4 h = 240m, 6 h = 360m.
//   `drain` used for waste disposal after a failed QC gate.
//   `dispose` used for successful/terminal disposal.
//   No array indexing; all parallel droplets are scalar variables.
//   `split` is not used (avoids stranded-droplet compiler issues
//   documented in moazami reference file); dilution series are
//   generated by explicit dispense + mix steps.
//
// CFG STRUCTURE:
//   BB1  main              -- device init; growth curve (P1)
//   BB2  odPass            -- odSignal > 0: OD threshold met,
//                             proceed to induction branch
//   BB3  odFail            -- odSignal <= 0: OD not yet reached;
//                             continue mixing and re-measure
//   BB4  odJoin            -- join: RFP induction series (P2)
//   BB5  rfpPass           -- rfpSignal > 0: valid fluorescence;
//                             dispose all RFP assay droplets
//   BB6  rfpFail           -- rfpSignal <= 0: no RFP expression;
//                             drain all RFP droplets
//   BB7  rfpJoin           -- join: BGL single-point assay (P3A)
//   BB8  bgl1Pass          -- bgl1Signal > 0: BGL1 active; dispose
//   BB9  bgl1Fail          -- bgl1Signal <= 0: drain BGL1
//   BB10 bgl1Join          -- join: BGL2 assay branch
//   BB11 bgl2Pass          -- bgl2Signal > 0: BGL2 active; dispose
//   BB12 bgl2Fail          -- bgl2Signal <= 0: drain BGL2
//   BB13 bgl2Join          -- join: BGL3 single-point assay
//   BB14 bgl3spPass        -- bgl3spSignal > 0: BGL3 active; dispose
//   BB15 bgl3spFail        -- bgl3spSignal <= 0: drain BGL3 SP
//   BB16 bgl3spJoin        -- join: BGL3 multi-point assay (P3B)
//   BB17 bgl3mpPass        -- bgl3mpSignal > 0: BGL3 MP valid; dispose
//   BB18 bgl3mpFail        -- bgl3mpSignal <= 0: drain BGL3 MP
//   BB19 finalCleanup      -- terminal: dispose all QC signals
// ============================================================

instructions:

// ============================================================
// BB1: main
// ============================================================

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 1: Prime device with LB + 0.05% Pluronics
//   F-68. Dispense blank droplet (LB media, no cells) to
//   acquire I0 (blank lux reading) before cell culture begins.
//   Device placed in AIMS slot (8 mm below LED, 4 mm above
//   lux sensor). Alignment marks ensure absorbance window is
//   centred on absorbance electrode (electrode 4: small middle
//   square 2, 0.25 mm transparent window).
// ------------------------------------------------------------

blankDrop    = dispense 1 units of LB_Media
primerF68    = dispense 1 units of PluronicF68
blankMix     = mix blankDrop with primerF68 for 30s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 2: Load mother culture.
//   Overnight E. coli BL21(DE3) [pET16b empty] diluted to
//   OD 0.1 in LB + 0.05% F-68. 14 uL loaded onto culture
//   area (four 4.5x4.5mm electrodes). Device sandwiched with
//   ITO top plate; 280 um spacer sets gap height.
// ------------------------------------------------------------

cellsP1      = dispense 1 units of RFP_Cells
f68P1        = dispense 1 units of PluronicF68
motherCulture = mix cellsP1 with f68P1 for 30s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 3: Semicontinuous mixing cycle.
//   4-step horizontal+vertical actuation sequence every 45 s
//   at 700 ms actuation time. This cycle repeats until OD
//   threshold is reached. One representative 45 s cycle is
//   encoded here; the OD gate below models the decision loop.
//   Mixing prevents biofouling (continuous mixing caused
//   biofouling within 2 h; semicontinuous resolved this).
// ------------------------------------------------------------

motherCulture = mix motherCulture with blankMix for 45s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 4: Extend mother droplet to absorbance
//   window electrode and measure OD via TSL2561 lux sensor.
//   Blank (I0) acquired immediately before sample reading.
//   OD = log(I0/I)/0.028 (path-length correction for 280 um).
//   odMeasurement module returns signal > 0 when OD >= 0.4.
// ------------------------------------------------------------

odSignal = detect odMeasurement on motherCulture for 10s

// ============================================================
// BB2 / BB3: OD threshold gate
// Pass (BB2): odSignal > 0 -> OD >= 0.4; proceed to induction.
// Fail (BB3): odSignal <= 0 -> OD < 0.4; return to mixing for
//             10 min then re-measure (modelled as continued
//             mixing below; BioScript has no while-loop, so
//             one additional 10 min mixing cycle is encoded).
//             In practice the AIMS repeats this gate
//             automatically until threshold is met.
// Both branches converge at BB4 (odJoin).
// ============================================================

if (odSignal > 0) {
    dispose blankMix
} else {
    // Continue semicontinuous mixing for 10 min, then re-check.
    // 10 min = 600 s. One extended mixing step encodes this wait.
    motherCulture = mix motherCulture with blankMix for 600s
    drain blankMix
}

// ============================================================
// BB4: odJoin
// Dispose OD signal droplet. OD threshold confirmed (or a
// single additional mixing cycle completed). Control falls
// into the IPTG induction branch (Protocol 2).
// ============================================================

dispose odSignal

// ============================================================
// PROTOCOL 2: Inducer Concentration Optimisation (RFP)
// ============================================================

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 1: Dispense IPTG from reservoir.
//   0.3 uL of 3.24 mM IPTG stock dispensed from IPTG reservoir.
//   Modelled as 1 unit dispense (BioScript does not resolve
//   sub-uL fractional volumes; all fractional dispenses are
//   encoded as 1 unit = smallest discrete actuatable droplet).
// ------------------------------------------------------------

iptgStock    = dispense 1 units of IPTG_Stock

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 2: Dispense five culture daughter droplets.
//   Three 1.42 uL unit droplets of RFP-cell culture are
//   dispensed from the mother culture region. One is mixed
//   with the IPTG stock (highest concentration; 200 uM
//   effective after mixing). A 2:1 serial dilution series is
//   then generated by adding successive culture droplets to
//   the IPTG-enriched reservoir and splitting.
//   Effective IPTG concentrations on-chip (from 3.24 mM stock
//   diluted with culture droplets via 2:1 steps):
//     rfpAssay1: ~200 uM (1:16.2 dilution of 3.24 mM stock)
//     rfpAssay2: ~133 uM
//     rfpAssay3: ~89 uM
//     rfpAssay4: ~59 uM
//     rfpAssay5: ~40 uM (basal / near-basal transition)
//   Additional concentrations (26.7, 17.8, 11.9 uM) are
//   represented implicitly; only 5 assay electrodes are
//   modelled here matching the 5-plex device layout (Fig 5C).
//
//   NOTE: In the paper, five daughter droplets are dispensed
//   from the mother culture, each mixed with a progressively
//   diluted IPTG droplet. To avoid array-indexing issues with
//   the lilott8 compiler, each daughter droplet and IPTG
//   dilution step is encoded as an explicit scalar variable.
// ------------------------------------------------------------

cultureDrop1 = dispense 1 units of RFP_Cells
cultureDrop2 = dispense 1 units of RFP_Cells
cultureDrop3 = dispense 1 units of RFP_Cells
cultureDrop4 = dispense 1 units of RFP_Cells
cultureDrop5 = dispense 1 units of RFP_Cells

// Generate 2:1 IPTG dilution series by mixing stock into
// each successive culture droplet (stepwise serial dilution).
iptgDilStep1  = mix iptgStock with cultureDrop1 for 5s

iptgDilStep2a = dispense 1 units of IPTG_Stock
iptgDilStep2  = mix iptgDilStep2a with cultureDrop2 for 5s

iptgDilStep3a = dispense 1 units of IPTG_Stock
iptgDilStep3b = dispense 1 units of Buffer
iptgDilStep3  = mix iptgDilStep3a with iptgDilStep3b for 5s
rfpInduced3   = mix iptgDilStep3 with cultureDrop3 for 5s

iptgDilStep4a = dispense 1 units of IPTG_Stock
iptgDilStep4b = dispense 1 units of Buffer
iptgDilStep4c = dispense 1 units of Buffer
buf4ab        = mix iptgDilStep4b with iptgDilStep4c for 5s
iptgDilStep4  = mix iptgDilStep4a with buf4ab for 5s
rfpInduced4   = mix iptgDilStep4 with cultureDrop4 for 5s

iptgDilStep5a = dispense 1 units of IPTG_Stock
iptgDilStep5b = dispense 1 units of Buffer
iptgDilStep5c = dispense 1 units of Buffer
iptgDilStep5d = dispense 1 units of Buffer
buf5ab        = mix iptgDilStep5b with iptgDilStep5c for 5s
buf5abc       = mix buf5ab with iptgDilStep5d for 5s
iptgDilStep5  = mix iptgDilStep5a with buf5abc for 5s
rfpInduced5   = mix iptgDilStep5 with cultureDrop5 for 5s

// Highest-concentration assay droplets (assay1 and assay2).
rfpAssay1 = mix iptgDilStep1 with motherCulture for 5s
rfpAssay2 = mix iptgDilStep2 with rfpAssay1 for 5s

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 3: Actuate daughter droplets to five
//   incubation areas on the device. Each assay spot receives
//   one induced culture droplet. Incubate at 37 C for 4 h
//   (240 min). All five assay spots encoded as separate heat
//   operations for compiler compatibility.
// ------------------------------------------------------------

heat rfpAssay1   at 37c for 240m
heat rfpAssay2   at 37c for 240m
heat rfpInduced3 at 37c for 240m
heat rfpInduced4 at 37c for 240m
heat rfpInduced5 at 37c for 240m

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 4: Read RFP fluorescence on CLARIOStar.
//   Device placed on 96-well plate cover and inserted into
//   plate reader. Well scan: 30x30, 6 mm, focal 7.2 mm,
//   gain 2905. Emission 612 nm, excitation 582 nm.
//   QC gate keyed on rfpAssay1 (200 uM IPTG = max signal).
// ------------------------------------------------------------

rfpSignal1 = detect rfpFluorescenceDetection on rfpAssay1 for 30s
rfpSignal2 = detect rfpFluorescenceDetection on rfpAssay2 for 30s
rfpSignal3 = detect rfpFluorescenceDetection on rfpInduced3 for 30s
rfpSignal4 = detect rfpFluorescenceDetection on rfpInduced4 for 30s
rfpSignal5 = detect rfpFluorescenceDetection on rfpInduced5 for 30s

// ============================================================
// BB5 / BB6: RFP fluorescence QC gate (keyed on assay1)
// Pass (BB5): rfpSignal1 > 0 -> RFP expression confirmed at
//             highest IPTG concentration; dispose all droplets.
// Fail (BB6): rfpSignal1 <= 0 -> no induction; drain all.
// Both branches converge at BB7 (rfpJoin).
// ============================================================

if (rfpSignal1 > 0) {
    dispose rfpAssay1
    dispose rfpAssay2
    dispose rfpInduced3
    dispose rfpInduced4
    dispose rfpInduced5
} else {
    drain rfpAssay1
    drain rfpAssay2
    drain rfpInduced3
    drain rfpInduced4
    drain rfpInduced5
}

// ============================================================
// BB7: rfpJoin
// Dispose all RFP detection signal droplets.
// Control falls into BGL single-point assay (Protocol 3A).
// ============================================================

dispose rfpSignal1
dispose rfpSignal2
dispose rfpSignal3
dispose rfpSignal4
dispose rfpSignal5

// ============================================================
// PROTOCOL 3A: Single-Point Induction -- BGL Enzyme Screening
// ============================================================

// ------------------------------------------------------------
// PROTOCOL 3A - STEP 1: Grow and induce BGL1, BGL2, BGL3
//   cultures on AIMS. Each strain starts at OD ~0.1 in LB +
//   0.05% F-68. Induction: 2 uL of 11 mM IPTG mixed with
//   mother culture droplet; entire culture returned to mixing
//   area to distribute inducer before daughter dispensing.
//   Modelled as dispense + mix for each strain.
// ------------------------------------------------------------

// --- BGL1 ---
bgl1Cells    = dispense 1 units of BGL1_Cells
bgl1F68      = dispense 1 units of PluronicF68
bgl1Culture  = mix bgl1Cells with bgl1F68 for 45s

bgl1IPTG     = dispense 1 units of IPTG_Stock
bgl1Induced  = mix bgl1Culture with bgl1IPTG for 5s

// --- BGL2 ---
bgl2Cells    = dispense 1 units of BGL2_Cells
bgl2F68      = dispense 1 units of PluronicF68
bgl2Culture  = mix bgl2Cells with bgl2F68 for 45s

bgl2IPTG     = dispense 1 units of IPTG_Stock
bgl2Induced  = mix bgl2Culture with bgl2IPTG for 5s

// --- BGL3 ---
bgl3Cells    = dispense 1 units of BGL3_Cells
bgl3F68      = dispense 1 units of PluronicF68
bgl3Culture  = mix bgl3Cells with bgl3F68 for 45s

bgl3IPTG     = dispense 1 units of IPTG_Stock
bgl3Induced  = mix bgl3Culture with bgl3IPTG for 5s

// ------------------------------------------------------------
// PROTOCOL 3A - STEP 2: Dispense five daughter droplets per
//   strain into incubation areas. Incubate at 37 C for 4 h.
//   Paper: five spots per strain, each actuated independently.
//   Encoded as five scalar droplets per strain.
// ------------------------------------------------------------

bgl1Drop1 = dispense 1 units of BGL1_Cells
bgl1Drop2 = dispense 1 units of BGL1_Cells
bgl1Drop3 = dispense 1 units of BGL1_Cells
bgl1Drop4 = dispense 1 units of BGL1_Cells
bgl1Drop5 = dispense 1 units of BGL1_Cells

bgl1Drop1 = mix bgl1Induced with bgl1Drop1 for 5s
bgl1Drop2 = mix bgl1Induced with bgl1Drop2 for 5s
bgl1Drop3 = mix bgl1Induced with bgl1Drop3 for 5s
bgl1Drop4 = mix bgl1Induced with bgl1Drop4 for 5s
bgl1Drop5 = mix bgl1Induced with bgl1Drop5 for 5s

bgl2Drop1 = dispense 1 units of BGL2_Cells
bgl2Drop2 = dispense 1 units of BGL2_Cells
bgl2Drop3 = dispense 1 units of BGL2_Cells
bgl2Drop4 = dispense 1 units of BGL2_Cells
bgl2Drop5 = dispense 1 units of BGL2_Cells

bgl2Drop1 = mix bgl2Induced with bgl2Drop1 for 5s
bgl2Drop2 = mix bgl2Induced with bgl2Drop2 for 5s
bgl2Drop3 = mix bgl2Induced with bgl2Drop3 for 5s
bgl2Drop4 = mix bgl2Induced with bgl2Drop4 for 5s
bgl2Drop5 = mix bgl2Induced with bgl2Drop5 for 5s

bgl3Drop1 = dispense 1 units of BGL3_Cells
bgl3Drop2 = dispense 1 units of BGL3_Cells
bgl3Drop3 = dispense 1 units of BGL3_Cells
bgl3Drop4 = dispense 1 units of BGL3_Cells
bgl3Drop5 = dispense 1 units of BGL3_Cells

bgl3Drop1 = mix bgl3Induced with bgl3Drop1 for 5s
bgl3Drop2 = mix bgl3Induced with bgl3Drop2 for 5s
bgl3Drop3 = mix bgl3Induced with bgl3Drop3 for 5s
bgl3Drop4 = mix bgl3Induced with bgl3Drop4 for 5s
bgl3Drop5 = mix bgl3Induced with bgl3Drop5 for 5s

heat bgl1Drop1 at 37c for 240m
heat bgl1Drop2 at 37c for 240m
heat bgl1Drop3 at 37c for 240m
heat bgl1Drop4 at 37c for 240m
heat bgl1Drop5 at 37c for 240m

heat bgl2Drop1 at 37c for 240m
heat bgl2Drop2 at 37c for 240m
heat bgl2Drop3 at 37c for 240m
heat bgl2Drop4 at 37c for 240m
heat bgl2Drop5 at 37c for 240m

heat bgl3Drop1 at 37c for 240m
heat bgl3Drop2 at 37c for 240m
heat bgl3Drop3 at 37c for 240m
heat bgl3Drop4 at 37c for 240m
heat bgl3Drop5 at 37c for 240m

// ------------------------------------------------------------
// PROTOCOL 3A - STEP 3: Lysis.
//   1.42 uL of 1x lysis buffer mixed with each induced droplet.
//   Incubate 10 min at room temperature (25 C).
// ------------------------------------------------------------

lysis1_bgl1 = dispense 1 units of LysisBuffer
lysis2_bgl1 = dispense 1 units of LysisBuffer
lysis3_bgl1 = dispense 1 units of LysisBuffer
lysis4_bgl1 = dispense 1 units of LysisBuffer
lysis5_bgl1 = dispense 1 units of LysisBuffer

lysed1_bgl1 = mix bgl1Drop1 with lysis1_bgl1 for 10m
lysed2_bgl1 = mix bgl1Drop2 with lysis2_bgl1 for 10m
lysed3_bgl1 = mix bgl1Drop3 with lysis3_bgl1 for 10m
lysed4_bgl1 = mix bgl1Drop4 with lysis4_bgl1 for 10m
lysed5_bgl1 = mix bgl1Drop5 with lysis5_bgl1 for 10m

lysis1_bgl2 = dispense 1 units of LysisBuffer
lysis2_bgl2 = dispense 1 units of LysisBuffer
lysis3_bgl2 = dispense 1 units of LysisBuffer
lysis4_bgl2 = dispense 1 units of LysisBuffer
lysis5_bgl2 = dispense 1 units of LysisBuffer

lysed1_bgl2 = mix bgl2Drop1 with lysis1_bgl2 for 10m
lysed2_bgl2 = mix bgl2Drop2 with lysis2_bgl2 for 10m
lysed3_bgl2 = mix bgl2Drop3 with lysis3_bgl2 for 10m
lysed4_bgl2 = mix bgl2Drop4 with lysis4_bgl2 for 10m
lysed5_bgl2 = mix bgl2Drop5 with lysis5_bgl2 for 10m

lysis1_bgl3 = dispense 1 units of LysisBuffer
lysis2_bgl3 = dispense 1 units of LysisBuffer
lysis3_bgl3 = dispense 1 units of LysisBuffer
lysis4_bgl3 = dispense 1 units of LysisBuffer
lysis5_bgl3 = dispense 1 units of LysisBuffer

lysed1_bgl3 = mix bgl3Drop1 with lysis1_bgl3 for 10m
lysed2_bgl3 = mix bgl3Drop2 with lysis2_bgl3 for 10m
lysed3_bgl3 = mix bgl3Drop3 with lysis3_bgl3 for 10m
lysed4_bgl3 = mix bgl3Drop4 with lysis4_bgl3 for 10m
lysed5_bgl3 = mix bgl3Drop5 with lysis5_bgl3 for 10m

// ------------------------------------------------------------
// PROTOCOL 3A - STEP 4: MUG substrate addition and incubation.
//   1.42 uL of 150 mM sodium-citrate + 6 mM MUG added to each
//   lysed assay droplet. Time points encode 0, 15, 30, 45, 60
//   min incubation. Paper: five droplets per strain assayed at
//   five time points. To avoid exponential code expansion,
//   MUG droplets are dispensed into all spots simultaneously
//   and the incubation durations are encoded per time point
//   (0m, 15m, 30m, 45m, 60m) using explicit heat statements.
//   BGL1 and BGL2 use the same time-point structure; BGL3
//   likewise. Each heat step represents one time-point duration.
// ------------------------------------------------------------

// BGL1 MUG substrate addition (five time points)
mug1_bgl1_t0  = dispense 1 units of MUG_Substrate
mug1_bgl1_t15 = dispense 1 units of MUG_Substrate
mug1_bgl1_t30 = dispense 1 units of MUG_Substrate
mug1_bgl1_t45 = dispense 1 units of MUG_Substrate
mug1_bgl1_t60 = dispense 1 units of MUG_Substrate

assay1_bgl1_t0  = mix lysed1_bgl1 with mug1_bgl1_t0  for 5s
assay1_bgl1_t15 = mix lysed2_bgl1 with mug1_bgl1_t15 for 5s
assay1_bgl1_t30 = mix lysed3_bgl1 with mug1_bgl1_t30 for 5s
assay1_bgl1_t45 = mix lysed4_bgl1 with mug1_bgl1_t45 for 5s
assay1_bgl1_t60 = mix lysed5_bgl1 with mug1_bgl1_t60 for 5s

heat assay1_bgl1_t0  at 25c for 1s
heat assay1_bgl1_t15 at 25c for 15m
heat assay1_bgl1_t30 at 25c for 30m
heat assay1_bgl1_t45 at 25c for 45m
heat assay1_bgl1_t60 at 25c for 60m

// BGL2 MUG substrate addition (five time points)
mug1_bgl2_t0  = dispense 1 units of MUG_Substrate
mug1_bgl2_t15 = dispense 1 units of MUG_Substrate
mug1_bgl2_t30 = dispense 1 units of MUG_Substrate
mug1_bgl2_t45 = dispense 1 units of MUG_Substrate
mug1_bgl2_t60 = dispense 1 units of MUG_Substrate

assay1_bgl2_t0  = mix lysed1_bgl2 with mug1_bgl2_t0  for 5s
assay1_bgl2_t15 = mix lysed2_bgl2 with mug1_bgl2_t15 for 5s
assay1_bgl2_t30 = mix lysed3_bgl2 with mug1_bgl2_t30 for 5s
assay1_bgl2_t45 = mix lysed4_bgl2 with mug1_bgl2_t45 for 5s
assay1_bgl2_t60 = mix lysed5_bgl2 with mug1_bgl2_t60 for 5s

heat assay1_bgl2_t0  at 25c for 1s
heat assay1_bgl2_t15 at 25c for 15m
heat assay1_bgl2_t30 at 25c for 30m
heat assay1_bgl2_t45 at 25c for 45m
heat assay1_bgl2_t60 at 25c for 60m

// BGL3 single-point MUG (five time points; same structure)
mug1_bgl3_t0  = dispense 1 units of MUG_Substrate
mug1_bgl3_t15 = dispense 1 units of MUG_Substrate
mug1_bgl3_t30 = dispense 1 units of MUG_Substrate
mug1_bgl3_t45 = dispense 1 units of MUG_Substrate
mug1_bgl3_t60 = dispense 1 units of MUG_Substrate

assay1_bgl3_t0  = mix lysed1_bgl3 with mug1_bgl3_t0  for 5s
assay1_bgl3_t15 = mix lysed2_bgl3 with mug1_bgl3_t15 for 5s
assay1_bgl3_t30 = mix lysed3_bgl3 with mug1_bgl3_t30 for 5s
assay1_bgl3_t45 = mix lysed4_bgl3 with mug1_bgl3_t45 for 5s
assay1_bgl3_t60 = mix lysed5_bgl3 with mug1_bgl3_t60 for 5s

heat assay1_bgl3_t0  at 25c for 1s
heat assay1_bgl3_t15 at 25c for 15m
heat assay1_bgl3_t30 at 25c for 30m
heat assay1_bgl3_t45 at 25c for 45m
heat assay1_bgl3_t60 at 25c for 60m

// ------------------------------------------------------------
// PROTOCOL 3A - STEP 5: Stop reaction with glycine-NaOH.
//   1.42 uL of 0.4 M glycine-NaOH added to each assay droplet.
//   Quenching stops BGL activity and raises pH for MUF signal.
// ------------------------------------------------------------

stop1_bgl1_t0  = dispense 1 units of GlycineNaOH_Stop
stop1_bgl1_t15 = dispense 1 units of GlycineNaOH_Stop
stop1_bgl1_t30 = dispense 1 units of GlycineNaOH_Stop
stop1_bgl1_t45 = dispense 1 units of GlycineNaOH_Stop
stop1_bgl1_t60 = dispense 1 units of GlycineNaOH_Stop

stopped_bgl1_t0  = mix assay1_bgl1_t0  with stop1_bgl1_t0  for 5s
stopped_bgl1_t15 = mix assay1_bgl1_t15 with stop1_bgl1_t15 for 5s
stopped_bgl1_t30 = mix assay1_bgl1_t30 with stop1_bgl1_t30 for 5s
stopped_bgl1_t45 = mix assay1_bgl1_t45 with stop1_bgl1_t45 for 5s
stopped_bgl1_t60 = mix assay1_bgl1_t60 with stop1_bgl1_t60 for 5s

stop1_bgl2_t0  = dispense 1 units of GlycineNaOH_Stop
stop1_bgl2_t15 = dispense 1 units of GlycineNaOH_Stop
stop1_bgl2_t30 = dispense 1 units of GlycineNaOH_Stop
stop1_bgl2_t45 = dispense 1 units of GlycineNaOH_Stop
stop1_bgl2_t60 = dispense 1 units of GlycineNaOH_Stop

stopped_bgl2_t0  = mix assay1_bgl2_t0  with stop1_bgl2_t0  for 5s
stopped_bgl2_t15 = mix assay1_bgl2_t15 with stop1_bgl2_t15 for 5s
stopped_bgl2_t30 = mix assay1_bgl2_t30 with stop1_bgl2_t30 for 5s
stopped_bgl2_t45 = mix assay1_bgl2_t45 with stop1_bgl2_t45 for 5s
stopped_bgl2_t60 = mix assay1_bgl2_t60 with stop1_bgl2_t60 for 5s

stop1_bgl3_t0  = dispense 1 units of GlycineNaOH_Stop
stop1_bgl3_t15 = dispense 1 units of GlycineNaOH_Stop
stop1_bgl3_t30 = dispense 1 units of GlycineNaOH_Stop
stop1_bgl3_t45 = dispense 1 units of GlycineNaOH_Stop
stop1_bgl3_t60 = dispense 1 units of GlycineNaOH_Stop

stopped_bgl3_t0  = mix assay1_bgl3_t0  with stop1_bgl3_t0  for 5s
stopped_bgl3_t15 = mix assay1_bgl3_t15 with stop1_bgl3_t15 for 5s
stopped_bgl3_t30 = mix assay1_bgl3_t30 with stop1_bgl3_t30 for 5s
stopped_bgl3_t45 = mix assay1_bgl3_t45 with stop1_bgl3_t45 for 5s
stopped_bgl3_t60 = mix assay1_bgl3_t60 with stop1_bgl3_t60 for 5s

// ------------------------------------------------------------
// PROTOCOL 3A - STEP 6: Fluorescence detection.
//   Device placed on 96-well plate cover; CLARIOStar scan.
//   Emission 449 nm, excitation 368 nm, focal 4.0 mm, gain 664.
//   QC gate keyed on BGL1 t=60 min (highest activity in BGL1
//   that confirms the assay ran; BGL3 is expected to be higher
//   but both are compared in the paper against BGL1 as baseline).
// ------------------------------------------------------------

bgl1Signal = detect bglActivityDetection on stopped_bgl1_t60 for 30s
bgl2Signal = detect bglActivityDetection on stopped_bgl2_t60 for 30s
bgl3Signal = detect bglActivityDetection on stopped_bgl3_t60 for 30s

// ============================================================
// BB8 / BB9: BGL1 activity QC gate
// Pass (BB8): bgl1Signal > 0 -> BGL1 active; dispose all t-pts.
// Fail (BB9): bgl1Signal <= 0 -> drain all BGL1 droplets.
// Both branches converge at BB10 (bgl1Join).
// ============================================================

if (bgl1Signal > 0) {
    dispose stopped_bgl1_t0
    dispose stopped_bgl1_t15
    dispose stopped_bgl1_t30
    dispose stopped_bgl1_t45
    dispose stopped_bgl1_t60
} else {
    drain stopped_bgl1_t0
    drain stopped_bgl1_t15
    drain stopped_bgl1_t30
    drain stopped_bgl1_t45
    drain stopped_bgl1_t60
}

// ============================================================
// BB10: bgl1Join
// Dispose BGL1 QC signal. Control falls into BGL2 QC gate.
// ============================================================

dispose bgl1Signal

// ============================================================
// BB11 / BB12: BGL2 activity QC gate
// ============================================================

if (bgl2Signal > 0) {
    dispose stopped_bgl2_t0
    dispose stopped_bgl2_t15
    dispose stopped_bgl2_t30
    dispose stopped_bgl2_t45
    dispose stopped_bgl2_t60
} else {
    drain stopped_bgl2_t0
    drain stopped_bgl2_t15
    drain stopped_bgl2_t30
    drain stopped_bgl2_t45
    drain stopped_bgl2_t60
}

// ============================================================
// BB13: bgl2Join
// ============================================================

dispose bgl2Signal

// ============================================================
// BB14 / BB15: BGL3 single-point activity QC gate
// ============================================================

if (bgl3Signal > 0) {
    dispose stopped_bgl3_t0
    dispose stopped_bgl3_t15
    dispose stopped_bgl3_t30
    dispose stopped_bgl3_t45
    dispose stopped_bgl3_t60
} else {
    drain stopped_bgl3_t0
    drain stopped_bgl3_t15
    drain stopped_bgl3_t30
    drain stopped_bgl3_t45
    drain stopped_bgl3_t60
}

// ============================================================
// BB16: bgl3spJoin
// Dispose BGL3 single-point QC signal.
// Control falls into BGL3 multi-point assay (Protocol 3B).
// ============================================================

dispose bgl3Signal

// ============================================================
// PROTOCOL 3B: Multi-Point Induction -- BGL3 Optimisation
// ============================================================

// ------------------------------------------------------------
// PROTOCOL 3B - STEP 1: Grow BGL3 culture on AIMS from OD ~0.1.
//   Same conditions as single-point protocol. Induce with 11 mM
//   IPTG at OD ~0.1 (low OD multi-point protocol; paper Section
//   "In the multipoint induction assay, a culture of low OD
//   (~0.1) was grown and induced with the same volume and
//   concentration as in the single-point program.")
// ------------------------------------------------------------

bgl3mpCells   = dispense 1 units of BGL3_Cells
bgl3mpF68     = dispense 1 units of PluronicF68
bgl3mpCulture = mix bgl3mpCells with bgl3mpF68 for 45s

bgl3mpIPTG    = dispense 1 units of IPTG_Stock
bgl3mpInduced = mix bgl3mpCulture with bgl3mpIPTG for 5s

// ------------------------------------------------------------
// PROTOCOL 3B - STEP 2: Dispense five subculture droplets.
//   Post-induction incubation time points: 0, 2, 3, 5, 6 h.
//   Each subculture is incubated at 37 C for its respective
//   duration before lysis. Durations in minutes:
//     t0h  = 0 min  (immediate lysis after induction)
//     t2h  = 120 min
//     t3h  = 180 min
//     t5h  = 300 min
//     t6h  = 360 min
// ------------------------------------------------------------

bgl3mp_t0h = dispense 1 units of BGL3_Cells
bgl3mp_t2h = dispense 1 units of BGL3_Cells
bgl3mp_t3h = dispense 1 units of BGL3_Cells
bgl3mp_t5h = dispense 1 units of BGL3_Cells
bgl3mp_t6h = dispense 1 units of BGL3_Cells

bgl3mp_t0h = mix bgl3mpInduced with bgl3mp_t0h for 5s
bgl3mp_t2h = mix bgl3mpInduced with bgl3mp_t2h for 5s
bgl3mp_t3h = mix bgl3mpInduced with bgl3mp_t3h for 5s
bgl3mp_t5h = mix bgl3mpInduced with bgl3mp_t5h for 5s
bgl3mp_t6h = mix bgl3mpInduced with bgl3mp_t6h for 5s

// t0h: lysis immediately (no incubation); `heat for 1s` used
//      as a no-op heat token to satisfy compiler expectations.
heat bgl3mp_t0h at 37c for 1s
heat bgl3mp_t2h at 37c for 120m
heat bgl3mp_t3h at 37c for 180m
heat bgl3mp_t5h at 37c for 300m
heat bgl3mp_t6h at 37c for 360m

// ------------------------------------------------------------
// PROTOCOL 3B - STEP 3: Lysis (10 min at RT for all droplets).
// ------------------------------------------------------------

lysisMP_t0 = dispense 1 units of LysisBuffer
lysisMP_t2 = dispense 1 units of LysisBuffer
lysisMP_t3 = dispense 1 units of LysisBuffer
lysisMP_t5 = dispense 1 units of LysisBuffer
lysisMP_t6 = dispense 1 units of LysisBuffer

lysedMP_t0 = mix bgl3mp_t0h with lysisMP_t0 for 10m
lysedMP_t2 = mix bgl3mp_t2h with lysisMP_t2 for 10m
lysedMP_t3 = mix bgl3mp_t3h with lysisMP_t3 for 10m
lysedMP_t5 = mix bgl3mp_t5h with lysisMP_t5 for 10m
lysedMP_t6 = mix bgl3mp_t6h with lysisMP_t6 for 10m

// ------------------------------------------------------------
// PROTOCOL 3B - STEP 4: MUG substrate addition.
//   30 min incubation (all time points use 30 min MUG assay,
//   fixed substrate concentration: 6 mM MUG, 150 mM sodium-
//   citrate). This is consistent with paper statement:
//   "each droplet was incubated with MUG for 30 min."
// ------------------------------------------------------------

mugMP_t0 = dispense 1 units of MUG_Substrate
mugMP_t2 = dispense 1 units of MUG_Substrate
mugMP_t3 = dispense 1 units of MUG_Substrate
mugMP_t5 = dispense 1 units of MUG_Substrate
mugMP_t6 = dispense 1 units of MUG_Substrate

assayMP_t0 = mix lysedMP_t0 with mugMP_t0 for 5s
assayMP_t2 = mix lysedMP_t2 with mugMP_t2 for 5s
assayMP_t3 = mix lysedMP_t3 with mugMP_t3 for 5s
assayMP_t5 = mix lysedMP_t5 with mugMP_t5 for 5s
assayMP_t6 = mix lysedMP_t6 with mugMP_t6 for 5s

heat assayMP_t0 at 25c for 30m
heat assayMP_t2 at 25c for 30m
heat assayMP_t3 at 25c for 30m
heat assayMP_t5 at 25c for 30m
heat assayMP_t6 at 25c for 30m

// ------------------------------------------------------------
// PROTOCOL 3B - STEP 5: Stop reaction.
// ------------------------------------------------------------

stopMP_t0 = dispense 1 units of GlycineNaOH_Stop
stopMP_t2 = dispense 1 units of GlycineNaOH_Stop
stopMP_t3 = dispense 1 units of GlycineNaOH_Stop
stopMP_t5 = dispense 1 units of GlycineNaOH_Stop
stopMP_t6 = dispense 1 units of GlycineNaOH_Stop

stoppedMP_t0 = mix assayMP_t0 with stopMP_t0 for 5s
stoppedMP_t2 = mix assayMP_t2 with stopMP_t2 for 5s
stoppedMP_t3 = mix assayMP_t3 with stopMP_t3 for 5s
stoppedMP_t5 = mix assayMP_t5 with stopMP_t5 for 5s
stoppedMP_t6 = mix assayMP_t6 with stopMP_t6 for 5s

// ------------------------------------------------------------
// PROTOCOL 3B - STEP 6: Fluorescence detection.
//   Same CLARIOStar settings as single-point (449 nm / 368 nm,
//   focal 4.0 mm, gain 664). QC gate keyed on t6h (expected
//   maximum expression; paper Fig 6D: BGL3 at 6 h >= 3x at 0 h).
// ------------------------------------------------------------

bgl3mpSignal_t0 = detect bglActivityDetection on stoppedMP_t0 for 30s
bgl3mpSignal_t2 = detect bglActivityDetection on stoppedMP_t2 for 30s
bgl3mpSignal_t3 = detect bglActivityDetection on stoppedMP_t3 for 30s
bgl3mpSignal_t5 = detect bglActivityDetection on stoppedMP_t5 for 30s
bgl3mpSignal_t6 = detect bglActivityDetection on stoppedMP_t6 for 30s

// ============================================================
// BB17 / BB18: BGL3 multi-point QC gate (keyed on t6h signal)
// Pass (BB17): bgl3mpSignal_t6 > 0 -> valid BGL3 expression
//              at 6 h; dispose all multi-point droplets.
// Fail (BB18): bgl3mpSignal_t6 <= 0 -> drain all.
// Both branches converge at BB19 (finalCleanup).
// ============================================================

if (bgl3mpSignal_t6 > 0) {
    dispose stoppedMP_t0
    dispose stoppedMP_t2
    dispose stoppedMP_t3
    dispose stoppedMP_t5
    dispose stoppedMP_t6
} else {
    drain stoppedMP_t0
    drain stoppedMP_t2
    drain stoppedMP_t3
    drain stoppedMP_t5
    drain stoppedMP_t6
}

// ============================================================
// BB19: finalCleanup (terminal)
// Dispose all remaining QC signal droplets.
// Experiment ends.
// ============================================================

dispose bgl3mpSignal_t0
dispose bgl3mpSignal_t2
dispose bgl3mpSignal_t3
dispose bgl3mpSignal_t5
dispose bgl3mpSignal_t6

// [terminal -- no further instructions; exit node for CFG]
