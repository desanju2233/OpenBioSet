{
  "protocol": {
    "title": "An Automated Induction Microfluidics System for Synthetic Biology",
    "source": "ACS Synthetic Biology 2018, 7, 933-944",
    "doi": "10.1021/acssynbio.8b00025",
    "platform": "Digital microfluidics (DMF) with integrated OD reader and automation system",
    "organism": "Escherichia coli BL21(DE3)",
    "objective": "Automated bacterial cell culture, OD-triggered IPTG induction, inducer concentration optimisation (RFP reporter), and expression screening of thermophilic beta-glucosidase (BGL) enzymes for biomass hydrolysis",

    "device": {
      "type": "Digital microfluidic (DMF) device",
      "substrate": "Chromium electrodes on glass (S1811 photoresist, Telic)",
      "dielectric": "Parylene-C, 7.2 um thick (SCS Labcoter 2 PDS 2010)",
      "hydrophobic_coating": "FluoroPel PFC1601 V (Cytonix), spin-coated at 1500 rpm, 30 s, baked 180 C 10 min",
      "top_plate": "ITO-coated glass (RS = 15-25 Ohm, Delta Technologies)",
      "gap_height_um": 280,
      "gap_height_tested_um": [210, 280, 350],
      "design_tool": "AutoCAD 2016",
      "fabrication_facility": "Concordia Silicon Microfabrication Lab (ConSIM)",
      "mask_resolution_dpi": 25400,
      "sections": [
        "Mother culture area (4 x 4.5x4.5 mm square electrodes)",
        "Absorbance reading electrode (transparent window, small middle square 2, 0.25 mm)",
        "IPTG reservoir",
        "LB media reservoir",
        "Lysis solution reservoir",
        "Substrate solution reservoir",
        "Stop solution reservoir",
        "Waste reservoir",
        "5 assay/incubation areas"
      ],
      "absorbance_window": {
        "chosen_electrode": "Small middle square 2 (electrode 4)",
        "transparent_window_mm": 0.25,
        "slope": 0.998,
        "r_squared": 0.999,
        "electrodes_tested": 7,
        "limit_of_detection_OD": 0.029
      },
      "actuation_electrodes": 32
    },

    "aims_hardware": {
      "led_wavelength_nm": 600,
      "led_part": "Digikey Cat no. 1497-1021-ND",
      "lux_sensor": "TSL2561 (Adafruit)",
      "led_to_device_distance_mm": 8,
      "device_to_sensor_distance_mm": 4,
      "microcontroller": "Arduino Uno",
      "control_software": "MATLAB (custom GUI)",
      "high_voltage_relays": "AQW216 Panasonic (Digikey)",
      "function_generator": "33201A Agilent (Allied Electronics)",
      "amplifier": "PZD-700A Trek Inc.",
      "voltage_applied_Vrms": "130-270",
      "communication_protocol": "I2C (Maxim 7300 I/O expander)",
      "enclosure": "3D printed PLA (top cover + bottom holder)",
      "github": "https://github.com/shihmicrolab/AIMS"
    },

    "reagents": {
      "cell_culture_media": "LB broth (Sigma) + 100 ug/mL ampicillin",
      "anti_biofouling_additive": "Pluronics F-68, 0.05% (prevents protein/cell adsorption on DMF device)",
      "inducer": {
        "name": "IPTG (isopropyl beta-D-1-thiogalactopyranoside)",
        "stock_concentration_mM_protocol2": 3.24,
        "stock_concentration_mM_protocol3": 11,
        "volume_dispensed_protocol2_uL": 0.3,
        "volume_dispensed_protocol3_uL": 2
      },
      "reporter": {
        "gene": "RFP (BBa_E1010, iGEM registry)",
        "vector": "pET16b (T7 promoter + lacI)",
        "host": "E. coli BL21(DE3)"
      },
      "bgl_enzymes": {
        "BGL1": {
          "organism": "Thermomicrobium roseum",
          "accession": "YP_002522957.1",
          "source": "IDT (synthesised as linear DNA fragment)"
        },
        "BGL2": {
          "organism": "Thermobaculum terrenum",
          "accession": "WP_041425608.1",
          "source": "Gen9 (now Ginkgo Bioworks)"
        },
        "BGL3": {
          "organism": "Rhodothermus marinus DSM4252",
          "accession": "WP_012844561.1",
          "source": "Gen9 (now Ginkgo Bioworks)"
        }
      },
      "bgl_substrate": {
        "name": "4-methylumbelliferyl beta-D-glucopyranoside (MUG)",
        "supplier": "Carbosynth, cat no. EM05983",
        "concentration_mM": 6,
        "buffer": "150 mM sodium-citrate"
      },
      "lysis_solution": "1x BugBuster-based lysis buffer",
      "stop_solution": {
        "composition": "0.4 M glycine-NaOH",
        "purpose": "Stop BGL enzymatic reaction; raise pH to enhance MUF fluorescence"
      },
      "restriction_enzymes": ["XbaI", "BamHI (Thermo, Waltham MA)"],
      "ligase": "T4 ligase (Thermo, Waltham MA)",
      "polymerase": "Phusion polymerase",
      "miniprep_kit": "BioBasic cat no. BS413",
      "gel_extraction_kit": "BioBasic cat no. BS354"
    },

    "od_measurement": {
      "formula": "A = log(I0/I) / 0.028",
      "I0": "blank lux reading (LB media, no cells)",
      "I": "sample lux reading",
      "path_length_correction_factor": 0.028,
      "path_length_um": 280,
      "induction_threshold_OD": 0.4,
      "limit_of_detection_OD": 0.035,
      "monitoring_interval_min": 10,
      "mixing_actuation_interval_s": 45,
      "mixing_actuation_duration_ms": 700,
      "mixing_direction": "horizontal + vertical 4-step sequence",
      "doubling_time_AIMS_min": { "mean": 72.88, "sd": 2.30 },
      "doubling_time_benchtop_min": { "mean": 36.80, "sd": 0.36 },
      "p_value": 0.018,
      "test": "two-tailed paired t-test"
    },

    "steps": [
      {
        "id": "S1",
        "name": "Device preparation and blank acquisition",
        "bb": "BB1",
        "protocol": "P1 - Growth Curve",
        "inputs": ["LB_Media", "PluronicF68"],
        "operation": "mix",
        "duration_s": 30,
        "notes": "Blank droplet (LB + 0.05% F-68, no cells) dispensed to acquire I0 lux reading. Device inserted into AIMS slot: 8 mm below 600 nm LED, 4 mm above TSL2561 lux sensor. Alignment marks on device and bottom holder centre absorbance window on lux sensor."
      },
      {
        "id": "S2",
        "name": "Mother culture loading",
        "bb": "BB1",
        "protocol": "P1 - Growth Curve",
        "cell_line": "E. coli BL21(DE3) [pET16b]",
        "starting_OD": 0.1,
        "culture_volume_uL": 14,
        "inputs": ["RFP_Cells", "PluronicF68"],
        "operation": "mix",
        "duration_s": 30,
        "gap_height_um": 280,
        "temperature_C": 37,
        "humidity": "open water container in incubator to prevent droplet evaporation",
        "notes": "Overnight culture diluted to OD 0.1 in LB + 0.05% F-68. 14 uL loaded onto mother culture area (four 4.5x4.5 mm electrodes). Bottom plate mated with ITO top plate for grounding."
      },
      {
        "id": "S3",
        "name": "Semicontinuous mixing and OD monitoring",
        "bb": "BB1",
        "protocol": "P1 - Growth Curve",
        "operation": "mix + detect",
        "mixing_cycle_interval_s": 45,
        "mixing_actuation_duration_ms": 700,
        "mixing_pattern": "horizontal + vertical 4-step sequence",
        "od_check_interval_min": 10,
        "od_threshold": 0.4,
        "detection_module": "odMeasurement",
        "detection_duration_s": 10,
        "branch": {
          "pass": { "condition": "odSignal > 0 (OD >= 0.4)", "action": "dispose blankMix; proceed to induction", "bb": "BB2" },
          "fail": { "condition": "odSignal <= 0 (OD < 0.4)", "action": "continue mixing 10 min; re-measure", "bb": "BB3" }
        },
        "notes": "Continuous mixing caused biofouling within 2 h; semicontinuous resolved this. 700 ms actuation time is the minimum for reliable droplet movement without biofouling."
      },
      {
        "id": "S4",
        "name": "IPTG serial dilution series preparation",
        "bb": "BB4",
        "protocol": "P2 - Inducer Concentration Optimisation",
        "inputs": ["IPTG_Stock (3.24 mM)", "RFP_Cells", "Buffer"],
        "operation": "dispense + mix (2:1 serial dilution)",
        "iptg_stock_concentration_mM": 3.24,
        "iptg_volume_per_droplet_uL": 0.3,
        "culture_droplet_volume_uL": 1.42,
        "effective_concentrations_uM": [200, 133.3, 88.9, 59.3, 40, 26.7, 17.8, 11.9],
        "assay_spots": 5,
        "dilution_method": "2:1 serial dilution on-chip; successive culture droplets mixed into IPTG-enriched reservoir",
        "notes": "Macroscale control: 45 mL of culture induced at 200 uM; diluted with fresh media to generate concentration series. On-chip: 2:1 serial dilutions generated by explicit dispense + mix steps (no split operations)."
      },
      {
        "id": "S5",
        "name": "RFP induction and incubation",
        "bb": "BB4",
        "protocol": "P2 - Inducer Concentration Optimisation",
        "operation": "heat",
        "temperature_C": 37,
        "duration_min": 240,
        "duration_s": 14400,
        "assay_spots": 5,
        "notes": "Five daughter droplets actuated to respective assay spots. Incubated in AIMS setup at 37 C for 4 h."
      },
      {
        "id": "S6",
        "name": "RFP fluorescence detection",
        "bb": "BB4",
        "protocol": "P2 - Inducer Concentration Optimisation",
        "operation": "detect",
        "detection_module": "rfpFluorescenceDetection",
        "detection_duration_s": 30,
        "plate_reader": "CLARIOStar (BGM Labtech, Ortenberg, Germany)",
        "excitation_nm": 582,
        "emission_nm": 612,
        "scan_matrix": "30x30",
        "scan_width_mm": 6,
        "focal_height_mm": 7.2,
        "gain": 2905,
        "qc_gate_keyed_on": "rfpAssay1 (200 uM IPTG, highest expected signal)",
        "results": {
          "dose_response_profile": "Sigmoidal (Hill function)",
          "max_expression_threshold_uM": 200,
          "basal_expression_below_uM": 30,
          "note": "Both macroscale and AIMS show sigmoidal profile; differences in steepness attributed to volume, E-field actuation, and mixing efficiency differences"
        },
        "branch": {
          "pass": { "condition": "rfpSignal1 > 0", "action": "dispose all 5 RFP droplets", "bb": "BB5" },
          "fail": { "condition": "rfpSignal1 <= 0", "action": "drain all 5 RFP droplets", "bb": "BB6" }
        }
      },
      {
        "id": "S7",
        "name": "BGL culture growth and induction (single-point)",
        "bb": "BB7",
        "protocol": "P3A - BGL Single-Point Screening",
        "strains": ["BGL1_Cells", "BGL2_Cells", "BGL3_Cells"],
        "operation": "dispense + mix",
        "starting_OD": 0.4,
        "iptg_volume_uL": 2,
        "iptg_concentration_mM": 11,
        "daughter_droplets_per_strain": 5,
        "notes": "2 uL of 11 mM IPTG mixed with single culture droplet; returned to culture mixing area to distribute inducer uniformly before daughter droplet dispensing."
      },
      {
        "id": "S8",
        "name": "BGL post-induction incubation (single-point)",
        "bb": "BB7",
        "protocol": "P3A - BGL Single-Point Screening",
        "operation": "heat",
        "temperature_C": 37,
        "duration_min": 240,
        "duration_s": 14400,
        "droplets_per_strain": 5,
        "total_droplets": 15,
        "notes": "Five daughter droplets per strain actuated to respective incubation spots. Incubated at 37 C for 4 h."
      },
      {
        "id": "S9",
        "name": "Cell lysis",
        "bb": "BB7",
        "protocol": "P3A - BGL Single-Point Screening",
        "inputs": ["LysisBuffer"],
        "operation": "mix",
        "lysis_volume_uL": 1.42,
        "temperature_C": 25,
        "duration_min": 10,
        "duration_s": 600,
        "total_lysis_droplets": 15,
        "notes": "1.42 uL of 1x lysis buffer mixed with each induced droplet. 10 min incubation at room temperature."
      },
      {
        "id": "S10",
        "name": "MUG substrate addition and incubation (single-point)",
        "bb": "BB7",
        "protocol": "P3A - BGL Single-Point Screening",
        "inputs": ["MUG_Substrate (6 mM in 150 mM sodium-citrate)"],
        "substrate_volume_uL": 1.42,
        "operation": "mix + heat",
        "temperature_C": 25,
        "time_points_min": [0, 15, 30, 45, 60],
        "time_points_s": [1, 900, 1800, 2700, 3600],
        "notes": "1.42 uL of 150 mM sodium-citrate + 6 mM MUG added to each lysed droplet. t=0 modelled as 1 s heat (no-op token for compiler). Five time points per strain, 15 assay droplets total."
      },
      {
        "id": "S11",
        "name": "Reaction stop (single-point)",
        "bb": "BB7",
        "protocol": "P3A - BGL Single-Point Screening",
        "inputs": ["GlycineNaOH_Stop (0.4 M)"],
        "stop_volume_uL": 1.42,
        "operation": "mix",
        "duration_s": 5,
        "total_stop_droplets": 15,
        "notes": "0.4 M glycine-NaOH stop solution added to each assay droplet to quench BGL activity and raise pH for enhanced MUF fluorescence."
      },
      {
        "id": "S12",
        "name": "BGL activity fluorescence detection (single-point)",
        "bb": "BB7-BB16",
        "protocol": "P3A - BGL Single-Point Screening",
        "operation": "detect",
        "detection_module": "bglActivityDetection",
        "detection_duration_s": 30,
        "plate_reader": "CLARIOStar (BGM Labtech)",
        "excitation_nm": 368,
        "emission_nm": 449,
        "focal_height_mm": 4.0,
        "gain": 664,
        "results": {
          "BGL1_vs_BGL2": "Nearly identical activity rates",
          "BGL3_vs_BGL1": "At least 6x higher activity rate",
          "hypothesis": "Higher salt concentrations at neutral pH 7.0 induce higher activity in Rhodothermus marinus enzymes; thermostable organisms maintain enzyme function at standard conditions"
        },
        "qc_gates": [
          { "gate": "BGL1", "keyed_on": "stopped_bgl1_t60", "pass_bb": "BB8",  "fail_bb": "BB9",  "join_bb": "BB10" },
          { "gate": "BGL2", "keyed_on": "stopped_bgl2_t60", "pass_bb": "BB11", "fail_bb": "BB12", "join_bb": "BB13" },
          { "gate": "BGL3", "keyed_on": "stopped_bgl3_t60", "pass_bb": "BB14", "fail_bb": "BB15", "join_bb": "BB16" }
        ]
      },
      {
        "id": "S13",
        "name": "BGL3 multi-point induction and incubation",
        "bb": "BB16",
        "protocol": "P3B - BGL3 Multi-Point Optimisation",
        "strains": ["BGL3_Cells"],
        "starting_OD": 0.1,
        "iptg_volume_uL": 2,
        "iptg_concentration_mM": 11,
        "operation": "dispense + mix + heat",
        "post_induction_time_points_h": [0, 2, 3, 5, 6],
        "post_induction_time_points_min": [0, 120, 180, 300, 360],
        "post_induction_time_points_s": [1, 7200, 10800, 18000, 21600],
        "temperature_C": 37,
        "notes": "BGL3 cells induced at low OD (~0.1); OD monitoring loop bypassed for this subroutine. Five subcultures incubated for 0, 2, 3, 5, 6 h before lysis. t=0h modelled as 1 s heat no-op."
      },
      {
        "id": "S14",
        "name": "Cell lysis (multi-point)",
        "bb": "BB16",
        "protocol": "P3B - BGL3 Multi-Point Optimisation",
        "inputs": ["LysisBuffer"],
        "operation": "mix",
        "lysis_volume_uL": 1.42,
        "temperature_C": 25,
        "duration_min": 10,
        "duration_s": 600,
        "total_lysis_droplets": 5
      },
      {
        "id": "S15",
        "name": "MUG substrate addition and incubation (multi-point)",
        "bb": "BB16",
        "protocol": "P3B - BGL3 Multi-Point Optimisation",
        "inputs": ["MUG_Substrate (6 mM in 150 mM sodium-citrate)"],
        "substrate_volume_uL": 1.42,
        "operation": "mix + heat",
        "temperature_C": 25,
        "fixed_mug_incubation_min": 30,
        "fixed_mug_incubation_s": 1800,
        "notes": "All five subcultures incubated with MUG for a fixed 30 min. Paper: 'each droplet was incubated with MUG for 30 min.'"
      },
      {
        "id": "S16",
        "name": "Reaction stop (multi-point)",
        "bb": "BB16",
        "protocol": "P3B - BGL3 Multi-Point Optimisation",
        "inputs": ["GlycineNaOH_Stop (0.4 M)"],
        "stop_volume_uL": 1.42,
        "operation": "mix",
        "duration_s": 5,
        "total_stop_droplets": 5
      },
      {
        "id": "S17",
        "name": "BGL3 multi-point fluorescence detection",
        "bb": "BB16-BB19",
        "protocol": "P3B - BGL3 Multi-Point Optimisation",
        "operation": "detect",
        "detection_module": "bglActivityDetection",
        "detection_duration_s": 30,
        "plate_reader": "CLARIOStar (BGM Labtech)",
        "excitation_nm": 368,
        "emission_nm": 449,
        "focal_height_mm": 4.0,
        "gain": 664,
        "qc_gate_keyed_on": "bgl3mpSignal_t6 (6 h; highest expected expression)",
        "results": {
          "BGL3_6h_vs_0h": "At least 3x higher expression at 6 h",
          "conclusion": "Longer post-induction incubation (>1 h) increases protein folding, accumulation, and productivity in E. coli; 6 h is optimal for BGL3"
        },
        "branch": {
          "pass": { "condition": "bgl3mpSignal_t6 > 0", "action": "dispose all 5 MP droplets", "bb": "BB17" },
          "fail": { "condition": "bgl3mpSignal_t6 <= 0", "action": "drain all 5 MP droplets",   "bb": "BB18" }
        }
      }
    ],

    "volume_comparison": {
      "culture_volume_microscale_uL": 15,
      "culture_volume_macroscale_mL": 150,
      "reduction_fold_culture": 10000,
      "assay_volume_microscale_uL": 5,
      "assay_volume_macroscale_uL": 200,
      "reduction_fold_assay": 40
    },

    "cost_comparison": {
      "multiplexing_5": {
        "macroscale_reagents_USD": 2.52,
        "macroscale_total_USD": 8.02,
        "macroscale_pipetting_steps": 32,
        "macroscale_hands_on_min": 35,
        "AIMS_reagents_USD": 0.01,
        "AIMS_total_USD": 4.51,
        "AIMS_pipetting_steps": 18,
        "AIMS_hands_on_min": 18
      },
      "multiplexing_100_estimated": {
        "macroscale_reagents_USD": 18.83,
        "macroscale_total_USD": 24.33,
        "macroscale_pipetting_steps": 621,
        "macroscale_hands_on_min": 370,
        "AIMS_reagents_USD": 0.24,
        "AIMS_total_USD": 4.74,
        "AIMS_pipetting_steps": 135,
        "AIMS_hands_on_min": 50
      }
    },

    "cfg": {
      "basic_blocks": [
        { "id": "BB1",  "label": "main",          "type": "entry",        "protocol": "P1" },
        { "id": "BB2",  "label": "bsbbif_2_t",    "type": "branch_true",  "condition": "odSignal > 0 (OD >= 0.4)",    "action": "dispose(blankMix); proceed to P2" },
        { "id": "BB3",  "label": "bsbbif_3_f",    "type": "branch_false", "condition": "odSignal <= 0 (OD < 0.4)",   "action": "mix 600s; drain(blankMix)" },
        { "id": "BB4",  "label": "bsbbif_4_j",    "type": "join",         "protocol": "P2" },
        { "id": "BB5",  "label": "bsbbif_5_t",    "type": "branch_true",  "condition": "rfpSignal1 > 0",             "action": "dispose all 5 RFP droplets" },
        { "id": "BB6",  "label": "bsbbif_6_f",    "type": "branch_false", "condition": "rfpSignal1 <= 0",            "action": "drain all 5 RFP droplets" },
        { "id": "BB7",  "label": "bsbbif_7_j",    "type": "join",         "protocol": "P3A" },
        { "id": "BB8",  "label": "bsbbif_8_t",    "type": "branch_true",  "condition": "bgl1Signal > 0",             "action": "dispose all BGL1 t-point droplets" },
        { "id": "BB9",  "label": "bsbbif_9_f",    "type": "branch_false", "condition": "bgl1Signal <= 0",            "action": "drain all BGL1 t-point droplets" },
        { "id": "BB10", "label": "bsbbif_10_j",   "type": "join" },
        { "id": "BB11", "label": "bsbbif_11_t",   "type": "branch_true",  "condition": "bgl2Signal > 0",             "action": "dispose all BGL2 t-point droplets" },
        { "id": "BB12", "label": "bsbbif_12_f",   "type": "branch_false", "condition": "bgl2Signal <= 0",            "action": "drain all BGL2 t-point droplets" },
        { "id": "BB13", "label": "bsbbif_13_j",   "type": "join" },
        { "id": "BB14", "label": "bsbbif_14_t",   "type": "branch_true",  "condition": "bgl3Signal > 0",             "action": "dispose all BGL3 SP t-point droplets" },
        { "id": "BB15", "label": "bsbbif_15_f",   "type": "branch_false", "condition": "bgl3Signal <= 0",            "action": "drain all BGL3 SP t-point droplets" },
        { "id": "BB16", "label": "bsbbif_16_j",   "type": "join",         "protocol": "P3B" },
        { "id": "BB17", "label": "bsbbif_17_t",   "type": "branch_true",  "condition": "bgl3mpSignal_t6 > 0",        "action": "dispose all BGL3 MP droplets" },
        { "id": "BB18", "label": "bsbbif_18_f",   "type": "branch_false", "condition": "bgl3mpSignal_t6 <= 0",       "action": "drain all BGL3 MP droplets" },
        { "id": "BB19", "label": "bsbbif_19_j",   "type": "terminal",     "action": "dispose all MP QC signals; NOP" }
      ],
      "edges": [
        ["BB1","BB2"],  ["BB1","BB3"],
        ["BB2","BB4"],  ["BB3","BB4"],
        ["BB4","BB5"],  ["BB4","BB6"],
        ["BB5","BB7"],  ["BB6","BB7"],
        ["BB7","BB8"],  ["BB7","BB9"],
        ["BB8","BB10"], ["BB9","BB10"],
        ["BB10","BB11"],["BB10","BB12"],
        ["BB11","BB13"],["BB12","BB13"],
        ["BB13","BB14"],["BB13","BB15"],
        ["BB14","BB16"],["BB15","BB16"],
        ["BB16","BB17"],["BB16","BB18"],
        ["BB17","BB19"],["BB18","BB19"]
      ]
    }
  }
}
