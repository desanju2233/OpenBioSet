module mass_spec

manifest magnetic_particles
manifest sample
manifest wash_buffer
manifest elution_buffer

instructions:

// Step 1: Load antibody-functionalized magnetic particles onto the device
beads = dispense 4 units of magnetic_particles

// Steps 3-4: Capture - sample droplet exposed to immobilized particles
// and actively resuspended to bind target analyte (10 min)
smp = dispense 4 units of sample
rxn_capture = mix beads with smp for 600s

// Steps 5-6: Wash cycle - particles washed twice with Tris-HCl buffer
// to remove unbound sample matrix (~3 min per wash)
repeat 2 times {
    wash = dispense 4 units of wash_buffer
    rxn_capture = mix rxn_capture with wash for 180s
}

// Step 7: Elution - particles exposed to citric acid elution buffer (5 min)
elution = dispense 4 units of elution_buffer
rxn_elute = mix rxn_capture with elution for 300s

// Step 8: Recovery of purified target and analysis by mass spectrometry
hsa_reading = detect mass_spec on rxn_elute for 1m
dispose rxn_elute
