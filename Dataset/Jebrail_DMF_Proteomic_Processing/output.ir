bsbbif_2_t:
	dispose(digestedSample1[0])
bsbbif_3_f:
	dispose(digestedSample1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(digestSignal1[0])
	NOP
main:
	proteinDroplet1[0] = dispense(ProteinSample)
	precipitantDroplet1[0] = dispense(TrichloroaceticAcid)
	precipitationMix1[0] = mix(proteinDroplet1[0], precipitantDroplet1[0]) @ 300.0SECOND
	dispose(precipitationMix1[0])
	wash11[0] = dispense(WashBuffer)
	dispose(wash11[0])
	wash21[0] = dispense(WashBuffer)
	dispose(wash21[0])
	wash31[0] = dispense(WashBuffer)
	dispose(wash31[0])
	resolubilizingBuffer1[0] = dispense(ResolubilizingBuffer)
	proteinPrecipitate1[0] = dispense(ProteinSample)
	resolubilizedSample1[0] = mix(proteinPrecipitate1[0], resolubilizingBuffer1[0]) @ 1200.0SECOND
	reductantDroplet1[0] = dispense(TCEP_Reductant)
	reducedSample1[0] = mix(resolubilizedSample1[0], reductantDroplet1[0]) @ 3600.0SECOND
	heat(reducedSample1[0]) @ 25.0CELSIUS @ 3600.0SECOND
	alkylatingDroplet1[0] = dispense(Iodoacetamide)
	alkylatedSample1[0] = mix(reducedSample1[0], alkylatingDroplet1[0]) @ 900.0SECOND
	heat(alkylatedSample1[0]) @ 25.0CELSIUS @ 900.0SECOND
	trypsinDroplet1[0] = dispense(Trypsin)
	digestedSample1[0] = mix(alkylatedSample1[0], trypsinDroplet1[0]) @ 10800.0SECOND
	heat(digestedSample1[0]) @ 37.0CELSIUS @ 10800.0SECOND
	digestSignal1[0] = detect(digestCompletionDetection, digestedSample1[0]) @ 30.0SECOND
	if digestSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
