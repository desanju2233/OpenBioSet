bsbbif_2_t:
	highFitnessDroplet1[0] = mix(reinjectedDroplets1[0], spacerOil1[0]) @ 1.0SECOND
	dispose(highFitnessDroplet1[0])
bsbbif_3_f:
	dispose(reinjectedDroplets1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(gt1Signal1[0])
	gt2Signal1[0] = detect(glucoamylaseDetection, spacerOil1[0]) @ 1.0SECOND
	if gt2Signal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	cellSuspension1[0] = dispense(IDY1_Cells)
	bsaAdditive1[0] = dispense(BSA_Solution)
	cellsWithBSA1[0] = mix(cellSuspension1[0], bsaAdditive1[0]) @ 2.0SECOND
	phosphateBuffer1[0] = dispense(PhosphateBuffer_pH7_5)
	mugSubstrate1[0] = dispense(MUG_Alpha_Substrate)
	assayMix1[0] = mix(mugSubstrate1[0], phosphateBuffer1[0]) @ 5.0SECOND
	oilCarrier1[0] = dispense(HFE7500_Surfactant)
	encapsulatedDroplets1[0] = mix(cellsWithBSA1[0], assayMix1[0]) @ 5.0SECOND
	dropletsInOil1[0] = mix(encapsulatedDroplets1[0], oilCarrier1[0]) @ 2.0SECOND
	heat(dropletsInOil1[0]) @ 30.0CELSIUS @ 172800.0SECOND
	spacerOil1[0] = dispense(SpacerOil)
	reinjectedDroplets1[0] = mix(dropletsInOil1[0], spacerOil1[0]) @ 1.0SECOND
	gt1Signal1[0] = detect(glucoamylaseDetection, reinjectedDroplets1[0]) @ 1.0SECOND
	if gt1Signal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	midFitnessDroplet1[0] = mix(spacerOil1[0], spacerOil1[0]) @ 1.0SECOND
	dispose(midFitnessDroplet1[0])
bsbbif_6_f:
	dispose(spacerOil1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(gt2Signal1[0])
	maltodextrinMedia1[0] = dispense(MaltodextrinMedia)
	ypd_preculture1[0] = dispense(YPD_Media)
	recoveredColony1[0] = mix(maltodextrinMedia1[0], ypd_preculture1[0]) @ 5.0SECOND
	heat(recoveredColony1[0]) @ 30.0CELSIUS @ 172800.0SECOND
	growthSignal1[0] = detect(maltodextrinGrowthDetection, recoveredColony1[0]) @ 30.0SECOND
	if growthSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(recoveredColony1[0])
bsbbif_9_f:
	dispose(recoveredColony1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	syntheticMedia1[0] = dispense(SyntheticBeverageMedia)
	ypd_ferment_pre1[0] = dispense(YPD_Media)
	heat(ypd_ferment_pre1[0]) @ 30.0CELSIUS @ 172800.0SECOND
	fermentationMix1[0] = mix(syntheticMedia1[0], ypd_ferment_pre1[0]) @ 300.0SECOND
	heat(fermentationMix1[0]) @ 20.0CELSIUS @ 79200.0SECOND
	heat(fermentationMix1[0]) @ 30.0CELSIUS @ 180000.0SECOND
	fermentSignal1[0] = detect(fermentationDetection, fermentationMix1[0]) @ 30.0SECOND
	if fermentSignal1[0] > 0	|	true: jump bsbbif_11_t	|	false: jump bsbbif_12_f
bsbbif_11_t:
	dispose(fermentationMix1[0])
bsbbif_12_f:
	dispose(fermentationMix1[0])
	jump: bsbbif_13_j
bsbbif_13_j:
	dispose(growthSignal1[0])
	dispose(fermentSignal1[0])
	NOP
