module mCherryDetection
module geneKnockdownDetection
module geneKnockoutDetection

manifest HEK293T_cells
manifest TargetCells
manifest PluronicF127
manifest pMDLg_pRRE
manifest pRSV_Rev
manifest pMD2g
manifest TransferPlasmid
manifest Lipofectamine3000
manifest P3000_Reagent
manifest OptiMEM
manifest DMEM_Polybrene
manifest TrypsinEDTA
manifest PBS
manifest shRNA_Plasmid
manifest sgRNA_Cas9_Plasmid
manifest ViralSupernatant

instructions:

// ============================================================
// LENGEN: Lentiviral GENeration, packaging, and transduction
// Quach, Little, Shih - Anal. Chem. 2022, 94, 4039-4047
// Protocol: lentiviral production in HEK293T cells, serial
// dilution transduction into breast cancer target cells,
// mCherry fluorescence titer readout.
// Optional branches: shRNA knockdown (ESR1), CRISPR knockout (ESR1)
//
// CFG STRUCTURE:
//   BB1  main         -- entry: producer seeding, mastermix,
//                        transfection, viral harvest, target
//                        seeding, serial dilution, transduction,
//                        mCherry detection
//   BB2  qcPass       -- signal_1_3 > 0: dispose signal droplets
//   BB3  qcFail       -- signal_1_3 <= 0: drain signal droplets
//   BB4  qcJoin       -- join: shRNA branch begins
//   BB5  shrnaPass    -- shrnaSignal > 0: dispose shrnaSignal
//   BB6  shrnaFail    -- shrnaSignal <= 0: drain shrnaSignal
//   BB7  shrnaJoin    -- join: CRISPR branch begins
//   BB8  crisprPass   -- crisprMCherry > 0: dispose crisprMCherry
//   BB9  crisprFail   -- crisprMCherry <= 0: drain crisprMCherry
//   BB10 finalCleanup -- terminal: experiment ends
// ============================================================

// ============================================================
// BB1: main
// ============================================================

// ------------------------------------------------------------
// STEP 1: Seed HEK293T producer cells onto 1.6 mm hydrophilic
//         production spot. Cell density: ~2.5-3.0 x 10^6
//         cells/mL + 0.05% Pluronics F-127. Incubate 24h.
//         heat is void; producerCells remains valid after heat.
// ------------------------------------------------------------

producerCells      = dispense 1 units of HEK293T_cells
pluronic1          = dispense 1 units of PluronicF127
producerSuspension = mix producerCells with pluronic1 for 2s
heat producerSuspension at 37c for 24h

// ------------------------------------------------------------
// STEP 2: Prepare lipofectamine-DNA mastermix for co-transfection
//         Plasmids: 0.75 ug pMDLg/pRRE, 0.75 ug pRSV-Rev,
//                   1.5 ug pMD2.G, 3 ug transfer plasmid
//         Reagents: 12.5 uL Lipofectamine3000 + 12 uL P3000
//                   in OptiMEM + 0.05% Pluronics F-127
// ------------------------------------------------------------

packaging1   = dispense 1 units of pMDLg_pRRE
packaging2   = dispense 1 units of pRSV_Rev
envelope     = dispense 1 units of pMD2g
transfer     = dispense 1 units of TransferPlasmid
lipo         = dispense 1 units of Lipofectamine3000
p3000        = dispense 1 units of P3000_Reagent
optimem      = dispense 1 units of OptiMEM
pluronic2    = dispense 1 units of PluronicF127

plasmidMix1  = mix packaging1 with packaging2 for 5s
plasmidMix2  = mix plasmidMix1 with envelope for 5s
plasmidMix3  = mix plasmidMix2 with transfer for 5s
lipoReagent  = mix lipo with p3000 for 5s
preMastermix = mix plasmidMix3 with lipoReagent for 5s
mastermix    = mix preMastermix with optimem for 5s

// Add Pluronics F-127 and incubate 20 min at 25c for
// DNA-liposomal complex formation (room temperature)
lipoMix = mix mastermix with pluronic2 for 20m
heat lipoMix at 25c for 20m

// ------------------------------------------------------------
// STEP 3: Transfect HEK293T cells - mix lipoMix into
//         producerSuspension; 3 circulations x 1 min on
//         four-prong electrode array (paper: ~1 min mixing)
// ------------------------------------------------------------

transfectionMix = mix lipoMix with producerSuspension for 1m

// ------------------------------------------------------------
// STEP 4: Incubate 24h for lentiviral particle production.
//         Viral supernatant dispensed fresh to model the
//         cell-free harvest step (cells adhere to hydrophilic
//         spot; supernatant collected by electrode actuation).
// ------------------------------------------------------------

heat transfectionMix at 37c for 24h
viralSupernatant = dispense 1 units of ViralSupernatant

// ------------------------------------------------------------
// STEP 5: Seed four independent target cell droplets onto
//         four 1.2 mm transduction sites (one per dilution).
//         Paper uses six sites; four used for dilution series.
//         Each is a separate dispense to satisfy use-once rules.
// ------------------------------------------------------------

targetCellDrop1   = dispense 1 units of TargetCells
pluronic3a        = dispense 1 units of PluronicF127
targetSuspension1 = mix targetCellDrop1 with pluronic3a for 2s
heat targetSuspension1 at 37c for 24h

targetCellDrop2   = dispense 1 units of TargetCells
pluronic3b        = dispense 1 units of PluronicF127
targetSuspension2 = mix targetCellDrop2 with pluronic3b for 2s
heat targetSuspension2 at 37c for 24h

targetCellDrop3   = dispense 1 units of TargetCells
pluronic3c        = dispense 1 units of PluronicF127
targetSuspension3 = mix targetCellDrop3 with pluronic3c for 2s
heat targetSuspension3 at 37c for 24h

targetCellDrop4   = dispense 1 units of TargetCells
pluronic3d        = dispense 1 units of PluronicF127
targetSuspension4 = mix targetCellDrop4 with pluronic3d for 2s
heat targetSuspension4 at 37c for 24h

// ------------------------------------------------------------
// STEP 6: Serial dilutions of viral supernatant (~98% accuracy)
//         Diluent: DMEM + 8 ug/mL polybrene + 0.05% Pluronics
//         1:3  = 1 uL DMEM + 2 uL viral supernatant
//         1:6  = serial dilution of 1:3 product
//         1:12 = serial dilution of 1:6 product
//         1:24 = serial dilution of 1:12 product
// ------------------------------------------------------------

dmem1        = dispense 1 units of DMEM_Polybrene
dilution_1_3 = mix dmem1 with viralSupernatant for 5s

dmem2        = dispense 1 units of DMEM_Polybrene
dilution_1_6 = mix dmem2 with dilution_1_3 for 5s

dmem3         = dispense 1 units of DMEM_Polybrene
dilution_1_12 = mix dmem3 with dilution_1_6 for 5s

dmem4         = dispense 1 units of DMEM_Polybrene
dilution_1_24 = mix dmem4 with dilution_1_12 for 5s

// ------------------------------------------------------------
// STEP 7: Deliver each dilution to its own target cell site
//         via highway track. Device flipped; incubate 24h.
//         Incubation encoded in mix duration (ref. syntax).
// ------------------------------------------------------------

transduction_1_3  = mix dilution_1_3  with targetSuspension1 for 24h
transduction_1_6  = mix dilution_1_6  with targetSuspension2 for 24h
transduction_1_12 = mix dilution_1_12 with targetSuspension3 for 24h
transduction_1_24 = mix dilution_1_24 with targetSuspension4 for 24h

// ------------------------------------------------------------
// STEP 8: Detect mCherry fluorescence to calculate viral titer
//         TU/mL = (#transduced x %fluorescent x dilution) / vol
//         Expected: ~1 x 10^7 TU/mL at 1:3 dilution after 48h
// ------------------------------------------------------------

signal_1_3  = detect mCherryDetection on transduction_1_3  for 30s
signal_1_6  = detect mCherryDetection on transduction_1_6  for 30s
signal_1_12 = detect mCherryDetection on transduction_1_12 for 30s
signal_1_24 = detect mCherryDetection on transduction_1_24 for 30s

// ============================================================
// BB2 / BB3: mCherry QC gate on 1:3 dilution (highest titer)
// Pass (BB2): signal > 0 -> data accepted, dispose droplets
// Fail (BB3): signal <= 0 -> no viable titer, drain droplets
// Both branches converge at BB4 (qcJoin)
// ============================================================

if (signal_1_3 > 0) {
    dispose transduction_1_3
    dispose transduction_1_6
    dispose transduction_1_12
    dispose transduction_1_24
} else {
    drain transduction_1_3
    drain transduction_1_6
    drain transduction_1_12
    drain transduction_1_24
}

// ============================================================
// BB4: qcJoin
// Dispose all main-branch signal droplets regardless of QC.
// Control falls into shRNA branch (BB5/BB6).
// ============================================================

dispose signal_1_3
dispose signal_1_6
dispose signal_1_12
dispose signal_1_24

// ============================================================
// STEP 9 (shRNA knockdown): Replace transfer plasmid with
//         MISSION shRNA plasmid (TRCN00000003300) targeting ESR1
//         Fresh producer cells and target cells for this branch.
//         Cells retrieved by trypsinization -> 7-day outgrowth
//         -> qRT-PCR (DDCq method, ACTB reference gene)
// ============================================================

shrnaTransfer  = dispense 1 units of shRNA_Plasmid
shrnaPkg1      = dispense 1 units of pMDLg_pRRE
shrnaPkg2      = dispense 1 units of pRSV_Rev
shrnaEnv       = dispense 1 units of pMD2g
shrnaLipo      = dispense 1 units of Lipofectamine3000
shrnaP3000     = dispense 1 units of P3000_Reagent
shrnaOptiMEM   = dispense 1 units of OptiMEM
shrnaPluronic  = dispense 1 units of PluronicF127

shrnaPlasmids1 = mix shrnaPkg1 with shrnaPkg2 for 5s
shrnaPlasmids2 = mix shrnaPlasmids1 with shrnaEnv for 5s
shrnaPlasmids3 = mix shrnaPlasmids2 with shrnaTransfer for 5s
shrnaLipoMix1  = mix shrnaLipo with shrnaP3000 for 5s
shrnaPreMix    = mix shrnaPlasmids3 with shrnaLipoMix1 for 5s
shrnaMastermix = mix shrnaPreMix with shrnaOptiMEM for 5s
shrnaLipoMix2  = mix shrnaMastermix with shrnaPluronic for 20m
heat shrnaLipoMix2 at 25c for 20m

shrnaProducerCells = dispense 1 units of HEK293T_cells
shrnaPluronicProd  = dispense 1 units of PluronicF127
shrnaProducerSusp  = mix shrnaProducerCells with shrnaPluronicProd for 2s
heat shrnaProducerSusp at 37c for 24h

shrnaTxMix = mix shrnaLipoMix2 with shrnaProducerSusp for 1m
heat shrnaTxMix at 37c for 24h

shrnaViral       = dispense 1 units of ViralSupernatant
shrnaTargetCells = dispense 1 units of TargetCells
shrnaPluronic2   = dispense 1 units of PluronicF127
shrnaTargetSusp  = mix shrnaTargetCells with shrnaPluronic2 for 2s
heat shrnaTargetSusp at 37c for 24h

shrnaDMEM1        = dispense 1 units of DMEM_Polybrene
shrnaDilution     = mix shrnaDMEM1 with shrnaViral for 5s
shrnaTransduction = mix shrnaDilution with shrnaTargetSusp for 24h

shrnaTrypsin = dispense 1 units of TrypsinEDTA
shrnaPBS     = dispense 1 units of PBS
shrnaWash    = mix shrnaPBS with shrnaTransduction for 5s
shrnaCells   = mix shrnaTrypsin with shrnaWash for 2m

shrnaSignal = detect geneKnockdownDetection on shrnaCells for 30s

// ============================================================
// BB5 / BB6: shRNA QC gate
// Pass (BB5): shrnaSignal > 0 -> knockdown confirmed, dispose
// Fail (BB6): shrnaSignal <= 0 -> assay failed, drain
// Both branches converge at BB7 (shrnaJoin)
// ============================================================

if (shrnaSignal > 0) {
    dispose shrnaCells
} else {
    drain shrnaCells
}

// ============================================================
// BB7: shrnaJoin
// Dispose shrnaSignal; control falls into CRISPR branch.
// ============================================================

dispose shrnaSignal

// ============================================================
// STEP 10 (CRISPR-Cas9 knockout): Replace transfer plasmid
//          with pLentiCRISPR-mCherry-NeoRv2 (LCMNv2), all-in-one
//          Cas9 + sgRNA targeting ESR1. Knockout confirmed by
//          genomic cleavage assay at 7 days post transduction.
//          Fresh producer cells and target cells for this branch.
// ============================================================

crisprTransfer  = dispense 1 units of sgRNA_Cas9_Plasmid
crisprPkg1      = dispense 1 units of pMDLg_pRRE
crisprPkg2      = dispense 1 units of pRSV_Rev
crisprEnv       = dispense 1 units of pMD2g
crisprLipo      = dispense 1 units of Lipofectamine3000
crisprP3000     = dispense 1 units of P3000_Reagent
crisprOptiMEM   = dispense 1 units of OptiMEM
crisprPluronic  = dispense 1 units of PluronicF127

crisprPlasmids1 = mix crisprPkg1 with crisprPkg2 for 5s
crisprPlasmids2 = mix crisprPlasmids1 with crisprEnv for 5s
crisprPlasmids3 = mix crisprPlasmids2 with crisprTransfer for 5s
crisprLipoMix1  = mix crisprLipo with crisprP3000 for 5s
crisprPreMix    = mix crisprPlasmids3 with crisprLipoMix1 for 5s
crisprMastermix = mix crisprPreMix with crisprOptiMEM for 5s
crisprLipoMix2  = mix crisprMastermix with crisprPluronic for 20m
heat crisprLipoMix2 at 25c for 20m

crisprProducerCells = dispense 1 units of HEK293T_cells
crisprPluronicProd  = dispense 1 units of PluronicF127
crisprProducerSusp  = mix crisprProducerCells with crisprPluronicProd for 2s
heat crisprProducerSusp at 37c for 24h

crisprTxMix = mix crisprLipoMix2 with crisprProducerSusp for 1m
heat crisprTxMix at 37c for 24h

crisprViral        = dispense 1 units of ViralSupernatant
crisprTargetCells  = dispense 1 units of TargetCells
crisprPluronic2    = dispense 1 units of PluronicF127
crisprTargetSusp   = mix crisprTargetCells with crisprPluronic2 for 2s
heat crisprTargetSusp at 37c for 24h

crisprDMEM1        = dispense 1 units of DMEM_Polybrene
crisprDilution     = mix crisprDMEM1 with crisprViral for 5s
crisprTransduction = mix crisprDilution with crisprTargetSusp for 24h

crisprTrypsin = dispense 1 units of TrypsinEDTA
crisprPBS     = dispense 1 units of PBS
crisprWash    = mix crisprPBS with crisprTransduction for 5s
crisprCells   = mix crisprTrypsin with crisprWash for 2m

crisprMCherry = detect mCherryDetection on crisprCells for 30s

// ============================================================
// BB8 / BB9: CRISPR QC gate
// Pass (BB8): crisprMCherry > 0 -> transduction confirmed, dispose
// Fail (BB9): crisprMCherry <= 0 -> transduction failed, drain
// Both branches converge at BB10 (finalCleanup)
// ============================================================

if (crisprMCherry > 0) {
    dispose crisprCells
} else {
    drain crisprCells
}

// ============================================================
// BB10: finalCleanup  (terminal -- no successors)
// Dispose final signal droplet; experiment ends.
// ============================================================

dispose crisprMCherry

// [terminal -- no instructions; exit node for CFG]
