main:
	cal_drop1[0] = dispense(calibrant)
	high_cal1[0] = detect(fluorescence, cal_drop1[0]) @ 60.0SECOND
	dispose(cal_drop1[0])
	blank_drop1[0] = dispense(stop_buffer)
	low_cal1[0] = detect(fluorescence, blank_drop1[0]) @ 60.0SECOND
	dispose(blank_drop1[0])
	gaa_bg_sub1[0] = dispense(gaa_reagent)
	gaa_bg_ext1[0] = dispense(extraction_buffer)
	gaa_bg_mix1[0] = mix(gaa_bg_sub1[0], gaa_bg_ext1[0]) @ 15.0SECOND
	gaa_bg_stb1[0] = dispense(stop_buffer)
	gaa_bg_final1[0] = mix(gaa_bg_mix1[0], gaa_bg_stb1[0]) @ 15.0SECOND
	gaa_background1[0] = detect(fluorescence, gaa_bg_final1[0]) @ 60.0SECOND
	dispose(gaa_bg_final1[0])
	gla_bg_sub1[0] = dispense(gla_reagent)
	gla_bg_ext1[0] = dispense(extraction_buffer)
	gla_bg_mix1[0] = mix(gla_bg_sub1[0], gla_bg_ext1[0]) @ 15.0SECOND
	gla_bg_stb1[0] = dispense(stop_buffer)
	gla_bg_final1[0] = mix(gla_bg_mix1[0], gla_bg_stb1[0]) @ 15.0SECOND
	gla_background1[0] = detect(fluorescence, gla_bg_final1[0]) @ 60.0SECOND
	dispose(gla_bg_final1[0])
bsbbr_2_h:
	PHI REPEAT_111 = {REPEAT_111,REPEAT_112,REPEAT_11}
	PHI gaa_rxn1 = {gaa_rxn2,gaa_rxn2,gaa_rxn}
	PHI sample1 = {sample2,sample2,sample}
	PHI gla_t01 = {gla_t02,gla_t02,gla_t0}
	PHI gla_rxn1 = {gla_rxn2,gla_rxn2,gla_rxn}
	PHI gaa_end_mix1 = {gaa_end_mix3,gaa_end_mix3,gaa_end_mix}
	PHI gla_t0_mix1 = {gla_t0_mix2,gla_t0_mix2,gla_t0_mix}
	PHI gaa_sub1 = {gaa_sub2,gaa_sub2,gaa_sub}
	PHI gaa_stb11 = {gaa_stb12,gaa_stb12,gaa_stb1}
	PHI gla_stb01 = {gla_stb02,gla_stb02,gla_stb0}
	PHI gaa_t0_mix1 = {gaa_t0_mix2,gaa_t0_mix2,gaa_t0_mix}
	PHI gla_stb11 = {gla_stb12,gla_stb12,gla_stb1}
	PHI gla_sub1 = {gla_sub2,gla_sub2,gla_sub}
	PHI gaa_endpoint1 = {gaa_endpoint2,gaa_endpoint2,gaa_endpoint}
	PHI gaa_t01 = {gaa_t02,gaa_t02,gaa_t0}
	PHI gla_end_mix1 = {gla_end_mix2,gla_end_mix3,gla_end_mix}
	PHI gla_endpoint1 = {gla_endpoint2,gla_endpoint2,gla_endpoint}
	PHI gaa_stb01 = {gaa_stb02,gaa_stb02,gaa_stb0}
	if REPEAT_111[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_8_f
bsbbr_3_t:
	sample2[0] = dispense(dbs_extract)
	gaa_sub2[0] = dispense(gaa_reagent)
	gaa_rxn2[0] = mix(sample2[0], gaa_sub2[0]) @ 30.0SECOND
	gla_sub2[0] = dispense(gla_reagent)
	gla_rxn2[0] = mix(sample2[0], gla_sub2[0]) @ 30.0SECOND
	gaa_stb02[0] = dispense(stop_buffer)
	gaa_t0_mix2[0] = mix(gaa_rxn2[0], gaa_stb02[0]) @ 15.0SECOND
	gaa_t02[0] = detect(fluorescence, gaa_t0_mix2[0]) @ 60.0SECOND
	dispose(gaa_t0_mix2[0])
	gla_stb02[0] = dispense(stop_buffer)
	gla_t0_mix2[0] = mix(gla_rxn2[0], gla_stb02[0]) @ 15.0SECOND
	gla_t02[0] = detect(fluorescence, gla_t0_mix2[0]) @ 60.0SECOND
	dispose(gla_t0_mix2[0])
	heat(gaa_rxn2[0]) @ 37.0CELSIUS @ 3600.0SECOND
	heat(gla_rxn2[0]) @ 37.0CELSIUS @ 3600.0SECOND
	gaa_stb12[0] = dispense(stop_buffer)
	gaa_end_mix2[0] = mix(gaa_rxn2[0], gaa_stb12[0]) @ 15.0SECOND
	gaa_endpoint2[0] = detect(fluorescence, gaa_end_mix2[0]) @ 60.0SECOND
	gla_stb12[0] = dispense(stop_buffer)
	gla_end_mix2[0] = mix(gla_rxn2[0], gla_stb12[0]) @ 15.0SECOND
	gla_endpoint2[0] = detect(fluorescence, gla_end_mix2[0]) @ 60.0SECOND
	if gaa_endpoint2[0] <= 5	|	true: jump bsbbif_4_t	|	false: jump bsbbif_5_f
bsbbif_4_t:
	dispose(gaa_end_mix2[0])
bsbbif_5_f:
	PHI gaa_end_mix3 = {gaa_end_mix2,gaa_end_mix}
	if gla_endpoint2[0] <= 3	|	true: jump bsbbif_6_t	|	false: jump bsbbif_7_f
	jump: bsbbr_2_h
bsbbif_6_t:
	dispose(gla_end_mix2[0])
bsbbif_7_f:
	PHI gla_end_mix3 = {gla_end_mix2,gla_end_mix}
	dispose(gaa_end_mix3[0])
	dispose(gla_end_mix3[0])
	REPEAT_112[0] = REPEAT_111[0] - 1
	jump: bsbbr_2_h
bsbbr_8_f:
	NOP
