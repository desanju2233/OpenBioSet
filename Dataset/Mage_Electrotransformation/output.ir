main:
	cells1[0] = dispense(ecoli_culture)
	beads1[0] = dispense(magnetic_beads)
	bound1[0] = mix(cells1[0], beads1[0]) @ 900.0SECOND
	milk1[0] = dispense(blocking_agent)
	blocked1[0] = mix(bound1[0], milk1[0]) @ 60.0SECOND
	media1[0] = dispense(growth_medium)
	suspended1[0] = mix(blocked1[0], media1[0]) @ 15.0SECOND
	heat(suspended1[0]) @ 42.0CELSIUS @ 900.0SECOND
bsbbr_2_h:
	PHI wash1 = {wash0,wash2}
	PHI REPEAT_31 = {REPEAT_30,REPEAT_32}
	PHI suspended2 = {suspended1,suspended3}
	if REPEAT_31[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	wash2[0] = dispense(wash_buffer)
	suspended3[0] = mix(suspended2[0], wash2[0]) @ 15.0SECOND
	dispose(suspended3[0])
	REPEAT_32[0] = REPEAT_31[0] - 1
bsbbr_4_f:
	oligo1[0] = dispense(oligo_reagent)
	electrocompetent1[0] = mix(suspended2[0], oligo1[0]) @ 30.0SECOND
	heat(electrocompetent1[0]) @ 4.0CELSIUS @ 60.0SECOND
	heat(electrocompetent1[0]) @ 24.0CELSIUS @ 5.0SECOND
	recovery1[0] = dispense(recovery_medium)
	recovered1[0] = mix(electrocompetent1[0], recovery1[0]) @ 15.0SECOND
	heat(recovered1[0]) @ 30.0CELSIUS @ 9000.0SECOND
	cfu_reading1[0] = detect(fluorescence, recovered1[0]) @ 60.0SECOND
	dispose(recovered1[0])
	NOP
