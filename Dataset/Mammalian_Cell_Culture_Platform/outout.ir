main:
	fn1[0] = dispense(fibronectin)
	heat(fn1[0]) @ 25.0CELSIUS @ 600.0SECOND
	dispose(fn1[0])
	cells1[0] = dispense(cell_suspension)
	media1[0] = dispense(growth_media)
	pad11[0] = mix(cells1[0], media1[0])
	heat(pad11[0]) @ 37.0CELSIUS @ 86400.0SECOND
bsbbr_2_h:
	PHI REPEAT_41 = {REPEAT_40,REPEAT_42}
	PHI REPEAT_31 = {REPEAT_30,REPEAT_32}
	PHI fresh1 = {fresh0,fresh2}
	PHI pad12 = {pad11,pad13}
	if REPEAT_41[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_7_f
bsbbr_3_t:
bsbbr_4_h:
	PHI REPEAT_32 = {REPEAT_31,REPEAT_33}
	PHI fresh2 = {fresh1,fresh3}
	PHI pad13 = {pad12,pad14}
	if REPEAT_32[0] > 0	|	true: jump bsbbr_5_t	|	false: jump bsbbr_6_f
bsbbr_5_t:
	fresh3[0] = dispense(fresh_media)
	pad14[0] = mix(pad13[0], fresh3[0]) @ 5.0SECOND
	dispose(fresh3[0])
	REPEAT_33[0] = REPEAT_32[0] - 1
bsbbr_6_f:
	heat(pad13[0]) @ 37.0CELSIUS @ 86400.0SECOND
	REPEAT_42[0] = REPEAT_41[0] - 1
bsbbr_7_f:
	confluency1[0] = detect(fluorescence, pad12[0]) @ 30.0SECOND
	if confluency1[0] >= 80	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
bsbbif_9_f:
	dispose(pad12[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	PHI gfp_expression2 = {gfp_expression1,gfp_expression}
	PHI fresh33 = {fresh31,fresh3}
	PHI tf2 = {tf1,tf}
	PHI fresh24 = {fresh21,fresh2}
	PHI harvest3 = {harvest1,harvest}
	PHI pad211 = {pad29,pad2}
	PHI collect4 = {collect2,collect}
	PHI tryp3 = {tryp1,tryp}
	PHI REPEAT_45 = {REPEAT_43,REPEAT_4}
	PHI REPEAT_313 = {REPEAT_310,REPEAT_3}
	PHI pad17 = {pad15,pad1}
	NOP
bsbbr_11_h:
	PHI tryp1 = {tryp0,tryp2}
	PHI REPEAT_34 = {REPEAT_31,REPEAT_35}
	PHI pad15 = {pad12,pad16}
	if REPEAT_34[0] > 0	|	true: jump bsbbr_12_t	|	false: jump bsbbr_13_f
bsbbr_12_t:
	tryp2[0] = dispense(trypsin)
	pad16[0] = mix(pad15[0], tryp2[0]) @ 5.0SECOND
	dispose(tryp2[0])
	REPEAT_35[0] = REPEAT_34[0] - 1
bsbbr_13_f:
	heat(pad15[0]) @ 37.0CELSIUS @ 240.0SECOND
	collect1[0] = dispense(harvest_media)
	pad21[0] = mix(collect1[0], pad15[0]) @ 5.0SECOND
bsbbr_14_h:
	PHI harvest1 = {harvest0,harvest2}
	PHI pad22 = {pad21,pad210}
	PHI collect2 = {collect1,collect3}
	PHI REPEAT_36 = {REPEAT_34,REPEAT_312}
	if REPEAT_36[0] > 0	|	true: jump bsbbr_15_t	|	false: jump bsbbr_16_f
bsbbr_15_t:
	collect3[0] = dispense(harvest_media)
	harvest2[0] = mix(collect3[0], pad15[0]) @ 5.0SECOND
	pad210[0] = mix(pad22[0], harvest2[0]) @ 5.0SECOND
	REPEAT_312[0] = REPEAT_36[0] - 1
bsbbr_16_f:
	dispose(pad15[0])
	heat(pad22[0]) @ 37.0CELSIUS @ 259200.0SECOND
bsbbr_17_h:
	PHI fresh21 = {fresh20,fresh22}
	PHI pad23 = {pad22,pad24}
	PHI REPEAT_43 = {REPEAT_41,REPEAT_44}
	PHI REPEAT_37 = {REPEAT_36,REPEAT_38}
	if REPEAT_43[0] > 0	|	true: jump bsbbr_18_t	|	false: jump bsbbr_22_f
bsbbr_18_t:
bsbbr_19_h:
	PHI fresh22 = {fresh21,fresh23}
	PHI pad24 = {pad23,pad25}
	PHI REPEAT_38 = {REPEAT_37,REPEAT_39}
	if REPEAT_38[0] > 0	|	true: jump bsbbr_20_t	|	false: jump bsbbr_21_f
bsbbr_20_t:
	fresh23[0] = dispense(fresh_media)
	pad25[0] = mix(pad24[0], fresh23[0]) @ 5.0SECOND
	dispose(fresh23[0])
	REPEAT_39[0] = REPEAT_38[0] - 1
bsbbr_21_f:
	heat(pad24[0]) @ 37.0CELSIUS @ 86400.0SECOND
	REPEAT_44[0] = REPEAT_43[0] - 1
bsbbr_22_f:
	tf1[0] = dispense(transfection_mix)
	pad26[0] = mix(pad23[0], tf1[0]) @ 5.0SECOND
	heat(pad26[0]) @ 37.0CELSIUS @ 10800.0SECOND
bsbbr_23_h:
	PHI fresh31 = {fresh30,fresh32}
	PHI pad27 = {pad26,pad28}
	PHI REPEAT_310 = {REPEAT_37,REPEAT_311}
	if REPEAT_310[0] > 0	|	true: jump bsbbr_24_t	|	false: jump bsbbr_25_f
bsbbr_24_t:
	fresh32[0] = dispense(fresh_media)
	pad28[0] = mix(pad27[0], fresh32[0]) @ 5.0SECOND
	dispose(fresh32[0])
	REPEAT_311[0] = REPEAT_310[0] - 1
bsbbr_25_f:
	heat(pad27[0]) @ 37.0CELSIUS @ 86400.0SECOND
	gfp_expression1[0] = detect(fluorescence, pad27[0]) @ 60.0SECOND
	if gfp_expression1[0] <= 10	|	true: jump bsbbif_26_t	|	false: jump bsbbif_27_f
bsbbif_26_t:
	dispose(pad27[0])
bsbbif_27_f:
	dispose(pad27[0])
	jump: bsbbif_28_j
bsbbif_28_j:
	jump: bsbbif_10_j
