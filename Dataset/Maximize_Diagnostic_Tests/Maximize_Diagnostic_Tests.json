{
    "title": "Digital Microfluidic G6PD Deficiency Assay Protocol",
    "module": "fluorescence",
    "manifest": [
        "whole_blood",
        "diluent",
        "g6pd_reagent_1",
        "g6pd_reagent_2"
    ],
    "steps": [
        {
            "action": "dispense",
            "reagent": "whole_blood",
            "amount": 20,
            "target": "wb"
        },
        {
            "action": "dispense",
            "reagent": "diluent",
            "amount": 40,
            "target": "d1"
        },
        {
            "action": "mix",
            "target1": "wb",
            "target2": "d1",
            "duration_seconds": 30,
            "output": "lysate"
        },
        {
            "action": "repeat",
            "times": 3,
            "steps": [
                {
                    "action": "dispense",
                    "reagent": "diluent",
                    "amount": 40,
                    "target": "d2"
                },
                {
                    "action": "mix",
                    "target1": "lysate",
                    "target2": "d2",
                    "duration_seconds": 30,
                    "output": "lysate"
                }
            ]
        },
        {
            "action": "dispense",
            "reagent": "g6pd_reagent_1",
            "target": "r1"
        },
        {
            "action": "mix",
            "target1": "lysate",
            "target2": "r1",
            "duration_seconds": 30,
            "output": "rxn1"
        },
        {
            "action": "dispense",
            "reagent": "g6pd_reagent_2",
            "target": "r2"
        },
        {
            "action": "mix",
            "target1": "rxn1",
            "target2": "r2",
            "duration_seconds": 30,
            "output": "g6pd_rxn"
        },
        {
            "action": "heat",
            "target": "g6pd_rxn",
            "temperature_celsius": 37,
            "duration_seconds": 60
        },
        {
            "action": "detect",
            "parameter": "fluorescence",
            "target": "g6pd_rxn",
            "duration_seconds": 10,
            "output": "g6pd_signal"
        },
        {
            "action": "conditional",
            "condition": "g6pd_signal <= 2",
            "true_branch": [
                {
                    "action": "dispose",
                    "target": "g6pd_rxn"
                }
            ]
        },
        {
            "action": "repeat",
            "times": 23,
            "steps": [
                {
                    "action": "detect",
                    "parameter": "fluorescence",
                    "target": "g6pd_rxn",
                    "duration_seconds": 10,
                    "output": "g6pd_signal"
                }
            ]
        },
        {
            "action": "dispose",
            "target": "g6pd_rxn"
        }
    ]
}