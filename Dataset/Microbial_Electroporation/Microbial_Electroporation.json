{
    "title": "Scalable Device for Automated Microbial Electroporation in a Digital Microfluidic Platform",
    "authors": [
        "Andrew C. Madison",
        "Matthew W. Royal",
        "Frederic Vigneault",
        "Liji Chen",
        "Peter B. Griffin",
        "Mark Horowitz",
        "George M. Church",
        "Richard B. Fair"
    ],
    "journal": "ACS Synthetic Biology",
    "year": 2017,
    "doi": "https://doi.org/10.1021/acssynbio.7b00007",
    "pdf_url": "https://pubs.acs.org/asbcd6/article-supplement/683293/pdf/sb7b00007_si_001/",
    "manifest": [
        "ecnr2_culture",
        "wash_buffer",
        "resuspension_buffer",
        "pgerc_plasmid",
        "recovery_media",
        "lb_kan_agar"
    ],
    "phases": [
        {
            "phase_name": "Single Pulse Electroporation Protocol",
            "steps": [
                {
                    "action": "dispense",
                    "reagent": "ecnr2_culture",
                    "amount": 1000
                },
                {
                    "action": "repeat",
                    "times": 2,
                    "steps": [
                        {
                            "action": "dispense",
                            "reagent": "wash_buffer",
                            "amount": 1000
                        },
                        {
                            "action": "mix",
                            "target1": "cells",
                            "target2": "wash",
                            "duration_seconds": 90
                        },
                        {
                            "action": "dispose",
                            "target": "wash"
                        }
                    ]
                },
                {
                    "action": "dispense",
                    "reagent": "resuspension_buffer",
                    "amount": 200
                },
                {
                    "action": "mix",
                    "target1": "cells",
                    "target2": "resusp",
                    "duration_seconds": 10
                },
                {
                    "action": "dispense",
                    "reagent": "pgerc_plasmid",
                    "amount": 5
                },
                {
                    "action": "mix",
                    "target1": "cells",
                    "target2": "plasmid",
                    "duration_seconds": 10
                },
                {
                    "action": "heat",
                    "target": "celldna",
                    "temperature_celsius": 4,
                    "duration_seconds": 900
                },
                {
                    "action": "heat",
                    "target": "celldna",
                    "temperature_celsius": 23,
                    "duration_seconds": 1
                },
                {
                    "action": "dispense",
                    "reagent": "recovery_media",
                    "amount": 200
                },
                {
                    "action": "mix",
                    "target1": "celldna",
                    "target2": "recover",
                    "duration_seconds": 60
                },
                {
                    "action": "heat",
                    "target": "outgrowth",
                    "temperature_celsius": 30,
                    "duration_seconds": 3600
                },
                {
                    "action": "detect",
                    "parameter": "fluorescence",
                    "target": "outgrowth",
                    "duration_seconds": 300
                },
                {
                    "action": "conditional",
                    "condition": "single_pulse_reading <= 80",
                    "true_branch": [
                        {
                            "action": "dispose",
                            "target": "outgrowth"
                        }
                    ]
                },
                {
                    "action": "dispense",
                    "reagent": "lb_kan_agar",
                    "amount": 50
                },
                {
                    "action": "mix",
                    "target1": "outgrowth",
                    "target2": "plate",
                    "duration_seconds": 10
                },
                {
                    "action": "dispose",
                    "target": "colony"
                }
            ]
        },
        {
            "phase_name": "Pulse Train Electroporation Protocol",
            "steps": [
                {
                    "action": "dispense",
                    "reagent": "ecnr2_culture",
                    "amount": 1000
                },
                {
                    "action": "repeat",
                    "times": 2,
                    "steps": [
                        {
                            "action": "dispense",
                            "reagent": "wash_buffer",
                            "amount": 1000
                        },
                        {
                            "action": "mix",
                            "target1": "cells2",
                            "target2": "wash2",
                            "duration_seconds": 90
                        },
                        {
                            "action": "dispose",
                            "target": "wash2"
                        }
                    ]
                },
                {
                    "action": "dispense",
                    "reagent": "resuspension_buffer",
                    "amount": 200
                },
                {
                    "action": "mix",
                    "target1": "cells2",
                    "target2": "resusp2",
                    "duration_seconds": 10
                },
                {
                    "action": "dispense",
                    "reagent": "pgerc_plasmid",
                    "amount": 5
                },
                {
                    "action": "mix",
                    "target1": "cells2",
                    "target2": "plasmid2",
                    "duration_seconds": 10
                },
                {
                    "action": "heat",
                    "target": "celldna2",
                    "temperature_celsius": 4,
                    "duration_seconds": 900
                },
                {
                    "action": "repeat",
                    "times": 10,
                    "steps": [
                        {
                            "action": "heat",
                            "target": "celldna2",
                            "temperature_celsius": 23,
                            "duration_seconds": 1
                        }
                    ]
                },
                {
                    "action": "dispense",
                    "reagent": "recovery_media",
                    "amount": 200
                },
                {
                    "action": "mix",
                    "target1": "celldna2",
                    "target2": "recover2",
                    "duration_seconds": 60
                },
                {
                    "action": "heat",
                    "target": "outgrowth2",
                    "temperature_celsius": 30,
                    "duration_seconds": 3600
                },
                {
                    "action": "detect",
                    "parameter": "fluorescence",
                    "target": "outgrowth2",
                    "duration_seconds": 300
                },
                {
                    "action": "conditional",
                    "condition": "train_pulse_reading <= 80",
                    "true_branch": [
                        {
                            "action": "dispose",
                            "target": "outgrowth2"
                        }
                    ]
                },
                {
                    "action": "dispense",
                    "reagent": "lb_kan_agar",
                    "amount": 50
                },
                {
                    "action": "mix",
                    "target1": "outgrowth2",
                    "target2": "plate2",
                    "duration_seconds": 10
                },
                {
                    "action": "dispose",
                    "target": "colony2"
                }
            ]
        }
    ]
}