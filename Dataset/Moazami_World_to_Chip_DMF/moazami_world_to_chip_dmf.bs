module transformationQC
module endoglucanaseDetection

manifest CompetentCells
manifest pFAB4876
manifest pSB1C3_RFP
manifest CaCl2_Stock
manifest LB_Media
manifest MUC_Substrate
manifest EndoglucanaseEnzyme
manifest QuenchingSolution
manifest Buffer
manifest PluronicF68

// ============================================================
// Integration of World-to-Chip Interfaces with Digital
// Microfluidics for Bacterial Transformation and Enzymatic
// Assays. Moazami et al., Anal. Chem. 2019, 91, 5159-5168.
// DOI: 10.1021/acs.analchem.8b05754
//
// Two protocols are encoded in sequence:
//
// PROTOCOL 1: Microscale Bacterial Co-Transformation (E. coli
//   DH5alpha with pFAB4876 [KanR] and pSB1C3-RFP [CamR]).
//   Heat-shock protocol: 42 C for 60s, then 4 C for 180s.
//   ITO-well-DMF configuration modelled (reagent-well refilling).
//   Three replicate droplets (1 uL each) are merged from:
//   competent cells + DNA plasmids + CaCl2 in equal volumes.
//
// PROTOCOL 2: Enzymatic Endoglucanase Assay.
//   Enzyme: endoglucanase (cleaves beta-1,4 glycosidic bonds).
//   Substrate: 4-methylumbelliferyl beta-D-cellobioside (MUC).
//   Three substrate concentrations (40, 20, 10 uM) dispensed
//   by serial dilution. Assay run at 30 C for 30 min.
//   Quenching: 0.3 M glycine-NaOH pH 11.0.
//   Readout: MUF fluorescence at 449 nm (excitation 368 nm).
//   All solutions contain 0.05% Pluronics F-68 additive.
//
// DROPLET VOLUMES: All unit droplets are ~1 uL, dispensed at
//   160 V_rms, 15 kHz. Reservoir target volume: 7 uL.
//   ITO-well-DMF: 400 uL bulk reagent in 3D-printed well;
//   ancillary reservoir refills main after every dispense.
//
// TEMPERATURE CONTROL: Closed-loop PID TEC (Kp=15, Ki=1.2,
//   Kd=0.5). Heat-shock zone: 42 C; cold zone: 4 C.
//   `heat` statements model TEC actuation.
//
// CFG STRUCTURE:
//   BB1  main             -- device init; transformation protocol
//   BB2  transformPass    -- transformSignal > 0: valid colonies;
//                           dispose and proceed to enzymatic assay
//   BB3  transformFail    -- transformSignal <= 0: no colonies; drain
//   BB4  transformJoin    -- join: enzymatic assay branch begins
//   BB5  assayPass        -- assaySignal > 0: valid fluorescence;
//                           dispose all assay droplets
//   BB6  assayFail        -- assaySignal <= 0: invalid; drain all
//   BB7  finalCleanup     -- terminal: dispose all QC signals
// ============================================================

instructions:

// ============================================================
// BB1: main
// ============================================================

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 1: Dispense competent E. coli DH5alpha
//   cells (thawed on ice for 10 min before use).
//   1 uL unit droplet dispensed from main reservoir (7 uL).
//   In ITO-well-DMF: 400 uL bulk cells loaded in 3D well;
//   ancillary reservoir refills main after each dispense.
//
//   Three reagent droplets are dispensed independently and
//   then merged in steps 3-5.
// ------------------------------------------------------------

cellDroplet    = dispense 1 units of CompetentCells

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 2: Dispense plasmid DNA droplets.
//   pFAB4876: codes for GFP, selects on kanamycin (50 ug/mL).
//   pSB1C3-RFP: selects on chloramphenicol (35 ug/mL).
//   Each diluted to 1 ug/uL; 100 ng per reaction on-chip.
//   Co-transformation: both plasmids present simultaneously.
// ------------------------------------------------------------

dna1Droplet    = dispense 1 units of pFAB4876
dna2Droplet    = dispense 1 units of pSB1C3_RFP

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 3: Dispense CaCl2 solution.
//   Stock: 150 mM. Final concentration on-chip: 75 mM.
//   CaCl2 is critical for chemical competence and DNA uptake.
// ------------------------------------------------------------

cacl2Droplet   = dispense 1 units of CaCl2_Stock

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 4: Merge DNA plasmids first.
//   1 uL pFAB4876 + 1 uL pSB1C3-RFP merged on electrode
//   array at 160 V_rms, 15 kHz.
// ------------------------------------------------------------

dnaMix         = mix dna1Droplet with dna2Droplet for 5s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 5: Merge cells + DNA mix.
//   Combined droplet now contains both plasmids and cells
//   in equal volume ratio (1:1:1:1 for 4-component merge).
// ------------------------------------------------------------

cellDnaMix     = mix cellDroplet with dnaMix for 5s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 6: Add CaCl2 to complete transformation
//   mix. Final droplet (~4 uL) contains cells, pFAB4876,
//   pSB1C3-RFP, CaCl2 at 75 mM. Mixed for 10 s on-chip.
// ------------------------------------------------------------

transformMix   = mix cellDnaMix with cacl2Droplet for 10s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 7: Heat shock - Phase 1 (42 C, 60 s).
//   TEC heats reaction zone to 42 C under closed-loop PID
//   control (Kp=15, Ki=1.2, Kd=0.5). Rise rate: 2.1 C/s.
//   Heat shock drives DNA uptake through transient membrane
//   pores in chemically competent DH5alpha cells.
// ------------------------------------------------------------

heat transformMix at 42c for 60s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 8: Heat shock - Phase 2 (4 C, 180 s).
//   TEC rapidly cools to 4 C (rate: 1.01 C/s) to stop
//   membrane disruption and stabilise DNA-cell complex.
//   180 s = 3 min recovery at cold zone.
// ------------------------------------------------------------

heat transformMix at 4c for 180s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 9: Post-transformation QC detection.
//   transformationQC module abstracts the off-chip colony
//   count step (agar plate with Kan+Cam selection, 37 C
//   overnight). On-chip: the merged droplet is sampled
//   post-heat-shock and checked for cell viability signal
//   as a proxy for transformation success.
//   Expected (PID + well): ~9.27e4 CFU/ug for co-transform.
// ------------------------------------------------------------

transformSignal = detect transformationQC on transformMix for 30s

// ============================================================
// BB2 / BB3: Transformation QC gate
// Pass (BB2): transformSignal > 0 -> viable transformed cells
//             detected; dispose and continue to assay branch.
// Fail (BB3): transformSignal <= 0 -> no viable signal; drain.
// Both branches converge at BB4 (transformJoin).
// ============================================================

if (transformSignal > 0) {
    dispose transformMix
} else {
    drain transformMix
}

// ============================================================
// BB4: transformJoin
// Dispose transformation QC signal. Control falls into
// enzymatic assay branch (BB5/BB6).
// ============================================================

dispose transformSignal

// ============================================================
// PROTOCOL 2: Enzymatic Endoglucanase Assay
// ============================================================

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 1: 40 uM assay droplet (1 unit substrate).
//   Dispensed directly into assay area 1. No dilution needed.
//   Buffer: 50 mM sodium-phosphate pH 7.0.
//   Substrate: 4-methylumbelliferyl beta-D-cellobioside (MUC).
//   In ITO-well-DMF: substrate reservoir refilled from 3D well.
//   All solutions contain 0.05% Pluronics F-68 additive.
// ------------------------------------------------------------

muc40uM_Assay  = dispense 1 units of MUC_Substrate

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 2: 20 uM assay droplet (direct dilution).
//   Dispense 1 unit of 40 uM MUC stock + 1 unit buffer.
//   Mix 1:1 -> 2-unit droplet at 20 uM. No split needed.
//   Concentration: (1 x 40 uM) / 2 units total = 20 uM. Correct.
//
//   NOTE ON COMPILER CONSTRAINT: lilott8/BioScript does not
//   support array zipping (multi-unit dispense does not produce
//   discrete array elements for enzyme/quench matching) and
//   split arrays leave stranded droplets if not fully consumed.
//   Direct dispense + mix avoids both failure modes entirely.
//   All three assay droplets are scalar; all downstream ops
//   are strict 1-to-1 with no array indexing required.
// ------------------------------------------------------------

muc40_for20    = dispense 1 units of MUC_Substrate
buffer_for20   = dispense 1 units of Buffer

muc20uM_Assay  = mix muc40_for20 with buffer_for20 for 5s

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 3: 10 uM assay droplet (direct dilution).
//   Dispense 1 unit of 40 uM MUC stock + 3 units buffer.
//   Mix -> 4-unit droplet at 10 uM. No split needed.
//   Concentration: (1 x 40 uM) / 4 units total = 10 uM. Correct.
// ------------------------------------------------------------

muc40_for10    = dispense 1 units of MUC_Substrate

// Three buffer droplets instantiated explicitly (compiler ignores
// multi-unit volume scalars; chaining is required to accumulate
// 3 units of buffer for the correct 1:3 dilution to 10 uM).
b1             = dispense 1 units of Buffer
b2             = dispense 1 units of Buffer
b3             = dispense 1 units of Buffer

b_mix_2        = mix b1 with b2 for 5s
b_mix_3        = mix b_mix_2 with b3 for 5s

// Final 1:3 dilution: (1 unit x 40 uM) / 4 units total = 10 uM.
muc10uM_Assay  = mix muc40_for10 with b_mix_3 for 5s

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 4: Dispense enzyme droplets.
//   Paper M&M: "a unit droplet of enzyme solution (~1 uL) was
//   dispensed into one of three assay areas." Each assay area
//   receives exactly 1 unit of enzyme regardless of substrate
//   volume. Enzyme concentration is held constant across all
//   three substrate concentration conditions (paper Fig. 5c
//   caption: "enzyme concentration remaining constant").
//   In ITO-well-DMF: enzyme reservoir refilled from 3D well
//   after each dispense (ancillary reservoir refill sequence).
// ------------------------------------------------------------

enzymeDrop40   = dispense 1 units of EndoglucanaseEnzyme
enzymeDrop20   = dispense 1 units of EndoglucanaseEnzyme
enzymeDrop10   = dispense 1 units of EndoglucanaseEnzyme

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 5: Start reactions.
//   Merge enzyme into each substrate assay area.
//   Paper M&M: "all three substrate-containing droplets were
//   simultaneously mixed with the enzyme droplets in the
//   assay areas." TEC activates for closed-loop 30 C control
//   (Kp=15, Ki=1.2, Kd=0.5).
// ------------------------------------------------------------

reaction40uM   = mix muc40uM_Assay with enzymeDrop40 for 5s
reaction20uM   = mix muc20uM_Assay with enzymeDrop20 for 5s
reaction10uM   = mix muc10uM_Assay with enzymeDrop10 for 5s

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 6: Incubate at 30 C for 30 min (1800 s).
//   Endoglucanase cleaves the beta-(1,4) glycosidic bond in
//   MUC, releasing 4-methylumbelliferone (MUF) fluorophore.
//   Closed-loop PID TEC maintains 30 C steady state.
//   All three reactions run concurrently in separate assay
//   areas on the same DMF device.
// ------------------------------------------------------------

heat reaction40uM at 30c for 30m
heat reaction20uM at 30c for 30m
heat reaction10uM at 30c for 30m

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 7: Quench reactions.
//   Quenching solution: 0.3 M glycine-NaOH, pH 11.0.
//   1 uL quench droplet merged with each 1 uL reaction droplet
//   in its assay area. Quenching stops enzymatic activity and
//   enhances MUF fluorescence at alkaline pH.
// ------------------------------------------------------------

// Quench: 1 unit per assay area regardless of substrate volume.
// Paper M&M: "a unit droplet of quenching solution (0.3 M
// glycine-NaOH, pH 11.0) was mixed with each reaction droplet."
quench40       = dispense 1 units of QuenchingSolution
quench20       = dispense 1 units of QuenchingSolution
quench10       = dispense 1 units of QuenchingSolution

quenched40uM   = mix reaction40uM with quench40 for 5s
quenched20uM   = mix reaction20uM with quench20 for 5s
quenched10uM   = mix reaction10uM with quench10 for 5s

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 8: Fluorescence detection.
//   endoglucanaseDetection module abstracts the CLARIOStar
//   plate reader readout (off-chip step; device placed on
//   96-well plate). MUF emission at 449 nm, excitation 368 nm.
//   Well-scan: 15x15 matrix, 6 mm diameter, focal height 4.0 mm.
//   Maximum fluorescence per droplet recorded.
//   QC gate uses 40 uM droplet (highest expected signal).
// ------------------------------------------------------------

assaySignal40  = detect endoglucanaseDetection on quenched40uM for 30s
assaySignal20  = detect endoglucanaseDetection on quenched20uM for 30s
assaySignal10  = detect endoglucanaseDetection on quenched10uM for 30s

// ============================================================
// BB5 / BB6: Assay QC gate (keyed on 40 uM signal; highest)
// Pass (BB5): assaySignal40 > 0 -> valid MUF fluorescence;
//             dispose all three quenched reaction droplets.
// Fail (BB6): assaySignal40 <= 0 -> no signal (enzyme inactive
//             or reagent failure); drain all.
// Both branches converge at BB7 (finalCleanup).
// ============================================================

if (assaySignal40 > 0) {
    dispose quenched40uM
    dispose quenched20uM
    dispose quenched10uM
} else {
    drain quenched40uM
    drain quenched20uM
    drain quenched10uM
}

// ============================================================
// BB7: finalCleanup (terminal)
// Dispose all three assay QC signal droplets.
// Experiment ends.
// ============================================================

dispose assaySignal40
dispose assaySignal20
dispose assaySignal10

// [terminal -- no further instructions; exit node for CFG]
