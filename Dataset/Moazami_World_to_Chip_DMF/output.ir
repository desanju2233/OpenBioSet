bsbbif_2_t:
	dispose(transformMix1[0])
bsbbif_3_f:
	dispose(transformMix1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(transformSignal1[0])
	muc40uM_Assay1[0] = dispense(MUC_Substrate)
	muc40_for201[0] = dispense(MUC_Substrate)
	buffer_for201[0] = dispense(Buffer)
	muc20uM_Assay1[0] = mix(muc40_for201[0], buffer_for201[0]) @ 5.0SECOND
	muc40_for101[0] = dispense(MUC_Substrate)
	b11[0] = dispense(Buffer)
	b21[0] = dispense(Buffer)
	b31[0] = dispense(Buffer)
	b_mix_21[0] = mix(b11[0], b21[0]) @ 5.0SECOND
	b_mix_31[0] = mix(b_mix_21[0], b31[0]) @ 5.0SECOND
	muc10uM_Assay1[0] = mix(muc40_for101[0], b_mix_31[0]) @ 5.0SECOND
	enzymeDrop401[0] = dispense(EndoglucanaseEnzyme)
	enzymeDrop201[0] = dispense(EndoglucanaseEnzyme)
	enzymeDrop101[0] = dispense(EndoglucanaseEnzyme)
	reaction40uM1[0] = mix(muc40uM_Assay1[0], enzymeDrop401[0]) @ 5.0SECOND
	reaction20uM1[0] = mix(muc20uM_Assay1[0], enzymeDrop201[0]) @ 5.0SECOND
	reaction10uM1[0] = mix(muc10uM_Assay1[0], enzymeDrop101[0]) @ 5.0SECOND
	heat(reaction40uM1[0]) @ 30.0CELSIUS @ 1800.0SECOND
	heat(reaction20uM1[0]) @ 30.0CELSIUS @ 1800.0SECOND
	heat(reaction10uM1[0]) @ 30.0CELSIUS @ 1800.0SECOND
	quench401[0] = dispense(QuenchingSolution)
	quench201[0] = dispense(QuenchingSolution)
	quench101[0] = dispense(QuenchingSolution)
	quenched40uM1[0] = mix(reaction40uM1[0], quench401[0]) @ 5.0SECOND
	quenched20uM1[0] = mix(reaction20uM1[0], quench201[0]) @ 5.0SECOND
	quenched10uM1[0] = mix(reaction10uM1[0], quench101[0]) @ 5.0SECOND
	assaySignal401[0] = detect(endoglucanaseDetection, quenched40uM1[0]) @ 30.0SECOND
	assaySignal201[0] = detect(endoglucanaseDetection, quenched20uM1[0]) @ 30.0SECOND
	assaySignal101[0] = detect(endoglucanaseDetection, quenched10uM1[0]) @ 30.0SECOND
	if assaySignal401[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	cellDroplet1[0] = dispense(CompetentCells)
	dna1Droplet1[0] = dispense(pFAB4876)
	dna2Droplet1[0] = dispense(pSB1C3_RFP)
	cacl2Droplet1[0] = dispense(CaCl2_Stock)
	dnaMix1[0] = mix(dna1Droplet1[0], dna2Droplet1[0]) @ 5.0SECOND
	cellDnaMix1[0] = mix(cellDroplet1[0], dnaMix1[0]) @ 5.0SECOND
	transformMix1[0] = mix(cellDnaMix1[0], cacl2Droplet1[0]) @ 10.0SECOND
	heat(transformMix1[0]) @ 42.0CELSIUS @ 60.0SECOND
	heat(transformMix1[0]) @ 4.0CELSIUS @ 180.0SECOND
	transformSignal1[0] = detect(transformationQC, transformMix1[0]) @ 30.0SECOND
	if transformSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(quenched40uM1[0])
	dispose(quenched20uM1[0])
	dispose(quenched10uM1[0])
bsbbif_6_f:
	dispose(quenched40uM1[0])
	dispose(quenched20uM1[0])
	dispose(quenched10uM1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(assaySignal401[0])
	dispose(assaySignal201[0])
	dispose(assaySignal101[0])
	NOP
