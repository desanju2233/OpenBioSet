main:
bsbbr_2_h:
	PHI REPEAT_81 = {REPEAT_80,REPEAT_82}
	PHI cal_reading1 = {cal_reading0,cal_reading2}
	PHI cal1 = {cal0,cal2}
	if REPEAT_81[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	cal2[0] = dispense(calibrant)
	cal_reading2[0] = detect(fluorescence, cal2[0]) @ 60.0SECOND
	dispose(cal2[0])
	REPEAT_82[0] = REPEAT_81[0] - 1
bsbbr_4_f:
	gaa_bg_sample1[0] = dispense(extraction_buffer)
	gaa_bg_reagent1[0] = dispense(gaa_reagent)
	gaa_bg_rxn1[0] = mix(gaa_bg_sample1[0], gaa_bg_reagent1[0]) @ 15.0SECOND
	heat(gaa_bg_rxn1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	gaa_bg_stb1[0] = dispense(stop_buffer)
	gaa_bg_final1[0] = mix(gaa_bg_rxn1[0], gaa_bg_stb1[0]) @ 15.0SECOND
	gaa_background1[0] = detect(fluorescence, gaa_bg_final1[0]) @ 60.0SECOND
	dispose(gaa_bg_final1[0])
	gla_bg_sample1[0] = dispense(extraction_buffer)
	gla_bg_reagent1[0] = dispense(gla_reagent)
	gla_bg_rxn1[0] = mix(gla_bg_sample1[0], gla_bg_reagent1[0]) @ 15.0SECOND
	heat(gla_bg_rxn1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	gla_bg_stb1[0] = dispense(stop_buffer)
	gla_bg_final1[0] = mix(gla_bg_rxn1[0], gla_bg_stb1[0]) @ 15.0SECOND
	gla_background1[0] = detect(fluorescence, gla_bg_final1[0]) @ 60.0SECOND
	dispose(gla_bg_final1[0])
	ids_bg_sample1[0] = dispense(extraction_buffer)
	ids_bg_reagent1[0] = dispense(ids_reagent)
	ids_bg_rxn1[0] = mix(ids_bg_sample1[0], ids_bg_reagent1[0]) @ 15.0SECOND
	heat(ids_bg_rxn1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	ids_bg_stb1[0] = dispense(stop_buffer)
	ids_bg_final1[0] = mix(ids_bg_rxn1[0], ids_bg_stb1[0]) @ 15.0SECOND
	ids_background1[0] = detect(fluorescence, ids_bg_final1[0]) @ 60.0SECOND
	dispose(ids_bg_final1[0])
	gba_bg_sample1[0] = dispense(extraction_buffer)
	gba_bg_reagent1[0] = dispense(gba_reagent)
	gba_bg_rxn1[0] = mix(gba_bg_sample1[0], gba_bg_reagent1[0]) @ 15.0SECOND
	heat(gba_bg_rxn1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	gba_bg_stb1[0] = dispense(stop_buffer)
	gba_bg_final1[0] = mix(gba_bg_rxn1[0], gba_bg_stb1[0]) @ 15.0SECOND
	gba_background1[0] = detect(fluorescence, gba_bg_final1[0]) @ 60.0SECOND
	dispose(gba_bg_final1[0])
	idu_bg_sample1[0] = dispense(extraction_buffer)
	idu_bg_reagent1[0] = dispense(idu_reagent)
	idu_bg_rxn1[0] = mix(idu_bg_sample1[0], idu_bg_reagent1[0]) @ 15.0SECOND
	heat(idu_bg_rxn1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	idu_bg_stb1[0] = dispense(stop_buffer)
	idu_bg_final1[0] = mix(idu_bg_rxn1[0], idu_bg_stb1[0]) @ 15.0SECOND
	idu_background1[0] = detect(fluorescence, idu_bg_final1[0]) @ 60.0SECOND
	dispose(idu_bg_final1[0])
bsbbr_5_h:
	PHI REPEAT_421 = {REPEAT_421,REPEAT_421,REPEAT_421,REPEAT_421,REPEAT_422,REPEAT_42}
	PHI gaa_rxn1 = {gaa_rxn2,gaa_rxn2,gaa_rxn2,gaa_rxn2,gaa_rxn2,gaa_rxn}
	PHI sample1 = {sample2,sample2,sample2,sample2,sample2,sample}
	PHI gaa_stb1 = {gaa_stb2,gaa_stb2,gaa_stb2,gaa_stb2,gaa_stb2,gaa_stb}
	PHI gla_final1 = {gla_final2,gla_final3,gla_final3,gla_final3,gla_final3,gla_final}
	PHI gla_stb1 = {gla_stb2,gla_stb2,gla_stb2,gla_stb2,gla_stb2,gla_stb}
	PHI gla_reagent_drop1 = {gla_reagent_drop2,gla_reagent_drop2,gla_reagent_drop2,gla_reagent_drop2,gla_reagent_drop2,gla_reagent_drop}
	PHI idu_rxn1 = {idu_rxn2,idu_rxn2,idu_rxn2,idu_rxn2,idu_rxn2,idu_rxn}
	PHI ids_activity1 = {ids_activity2,ids_activity2,ids_activity2,ids_activity2,ids_activity2,ids_activity}
	PHI idu_final1 = {idu_final2,idu_final2,idu_final2,idu_final2,idu_final3,idu_final}
	PHI gaa_final1 = {gaa_final3,gaa_final3,gaa_final3,gaa_final3,gaa_final3,gaa_final}
	PHI idu_stb1 = {idu_stb2,idu_stb2,idu_stb2,idu_stb2,idu_stb2,idu_stb}
	PHI ids_stb1 = {ids_stb2,ids_stb2,ids_stb2,ids_stb2,ids_stb2,ids_stb}
	PHI gaa_reagent_drop1 = {gaa_reagent_drop2,gaa_reagent_drop2,gaa_reagent_drop2,gaa_reagent_drop2,gaa_reagent_drop2,gaa_reagent_drop}
	PHI ids_final1 = {ids_final2,ids_final2,ids_final3,ids_final3,ids_final3,ids_final}
	PHI ids_rxn1 = {ids_rxn2,ids_rxn2,ids_rxn2,ids_rxn2,ids_rxn2,ids_rxn}
	PHI gba_rxn1 = {gba_rxn2,gba_rxn2,gba_rxn2,gba_rxn2,gba_rxn2,gba_rxn}
	PHI gla_activity1 = {gla_activity2,gla_activity2,gla_activity2,gla_activity2,gla_activity2,gla_activity}
	PHI gla_rxn1 = {gla_rxn2,gla_rxn2,gla_rxn2,gla_rxn2,gla_rxn2,gla_rxn}
	PHI idu_activity1 = {idu_activity2,idu_activity2,idu_activity2,idu_activity2,idu_activity2,idu_activity}
	PHI gba_final1 = {gba_final2,gba_final2,gba_final2,gba_final3,gba_final3,gba_final}
	PHI ids_reagent_drop1 = {ids_reagent_drop2,ids_reagent_drop2,ids_reagent_drop2,ids_reagent_drop2,ids_reagent_drop2,ids_reagent_drop}
	PHI gaa_activity1 = {gaa_activity2,gaa_activity2,gaa_activity2,gaa_activity2,gaa_activity2,gaa_activity}
	PHI gba_stb1 = {gba_stb2,gba_stb2,gba_stb2,gba_stb2,gba_stb2,gba_stb}
	PHI gba_activity1 = {gba_activity2,gba_activity2,gba_activity2,gba_activity2,gba_activity2,gba_activity}
	PHI idu_reagent_drop1 = {idu_reagent_drop2,idu_reagent_drop2,idu_reagent_drop2,idu_reagent_drop2,idu_reagent_drop2,idu_reagent_drop}
	PHI gba_reagent_drop1 = {gba_reagent_drop2,gba_reagent_drop2,gba_reagent_drop2,gba_reagent_drop2,gba_reagent_drop2,gba_reagent_drop}
	if REPEAT_421[0] > 0	|	true: jump bsbbr_6_t	|	false: jump bsbbr_17_f
bsbbr_6_t:
	sample2[0] = dispense(dbs_extract)
	gaa_reagent_drop2[0] = dispense(gaa_reagent)
	gaa_rxn2[0] = mix(sample2[0], gaa_reagent_drop2[0]) @ 15.0SECOND
	gla_reagent_drop2[0] = dispense(gla_reagent)
	gla_rxn2[0] = mix(sample2[0], gla_reagent_drop2[0]) @ 15.0SECOND
	ids_reagent_drop2[0] = dispense(ids_reagent)
	ids_rxn2[0] = mix(sample2[0], ids_reagent_drop2[0]) @ 15.0SECOND
	gba_reagent_drop2[0] = dispense(gba_reagent)
	gba_rxn2[0] = mix(sample2[0], gba_reagent_drop2[0]) @ 15.0SECOND
	idu_reagent_drop2[0] = dispense(idu_reagent)
	idu_rxn2[0] = mix(sample2[0], idu_reagent_drop2[0]) @ 15.0SECOND
	heat(gaa_rxn2[0]) @ 37.0CELSIUS @ 3600.0SECOND
	heat(gla_rxn2[0]) @ 37.0CELSIUS @ 3600.0SECOND
	heat(ids_rxn2[0]) @ 37.0CELSIUS @ 3600.0SECOND
	heat(gba_rxn2[0]) @ 37.0CELSIUS @ 3600.0SECOND
	heat(idu_rxn2[0]) @ 37.0CELSIUS @ 3600.0SECOND
	gaa_stb2[0] = dispense(stop_buffer)
	gaa_final2[0] = mix(gaa_rxn2[0], gaa_stb2[0]) @ 15.0SECOND
	gaa_activity2[0] = detect(fluorescence, gaa_final2[0]) @ 60.0SECOND
	gla_stb2[0] = dispense(stop_buffer)
	gla_final2[0] = mix(gla_rxn2[0], gla_stb2[0]) @ 15.0SECOND
	gla_activity2[0] = detect(fluorescence, gla_final2[0]) @ 60.0SECOND
	ids_stb2[0] = dispense(stop_buffer)
	ids_final2[0] = mix(ids_rxn2[0], ids_stb2[0]) @ 15.0SECOND
	ids_activity2[0] = detect(fluorescence, ids_final2[0]) @ 60.0SECOND
	gba_stb2[0] = dispense(stop_buffer)
	gba_final2[0] = mix(gba_rxn2[0], gba_stb2[0]) @ 15.0SECOND
	gba_activity2[0] = detect(fluorescence, gba_final2[0]) @ 60.0SECOND
	idu_stb2[0] = dispense(stop_buffer)
	idu_final2[0] = mix(idu_rxn2[0], idu_stb2[0]) @ 15.0SECOND
	idu_activity2[0] = detect(fluorescence, idu_final2[0]) @ 60.0SECOND
	if gaa_activity2[0] <= 8	|	true: jump bsbbif_7_t	|	false: jump bsbbif_8_f
bsbbif_7_t:
	dispose(gaa_final2[0])
bsbbif_8_f:
	PHI gaa_final3 = {gaa_final2,gaa_final}
	if gla_activity2[0] <= 6	|	true: jump bsbbif_9_t	|	false: jump bsbbif_10_f
	jump: bsbbr_5_h
bsbbif_9_t:
	dispose(gla_final2[0])
bsbbif_10_f:
	PHI gla_final3 = {gla_final2,gla_final}
	if ids_activity2[0] <= 6	|	true: jump bsbbif_11_t	|	false: jump bsbbif_12_f
	jump: bsbbr_5_h
bsbbif_11_t:
	dispose(ids_final2[0])
bsbbif_12_f:
	PHI ids_final3 = {ids_final2,ids_final}
	if gba_activity2[0] <= 7	|	true: jump bsbbif_13_t	|	false: jump bsbbif_14_f
	jump: bsbbr_5_h
bsbbif_13_t:
	dispose(gba_final2[0])
bsbbif_14_f:
	PHI gba_final3 = {gba_final2,gba_final}
	if idu_activity2[0] <= 5	|	true: jump bsbbif_15_t	|	false: jump bsbbif_16_f
	jump: bsbbr_5_h
bsbbif_15_t:
	dispose(idu_final2[0])
bsbbif_16_f:
	PHI idu_final3 = {idu_final2,idu_final}
	dispose(gaa_final3[0])
	dispose(gla_final3[0])
	dispose(ids_final3[0])
	dispose(gba_final3[0])
	dispose(idu_final3[0])
	REPEAT_422[0] = REPEAT_421[0] - 1
	jump: bsbbr_5_h
bsbbr_17_f:
	NOP
