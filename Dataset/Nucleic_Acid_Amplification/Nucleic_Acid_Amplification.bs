module fluorescence

manifest silicone_oil
manifest mineral_oil
manifest lamp_buffer

instructions:

// Prime the DMF section with 5 cSt silicone oil to fill the cavity between
// the top and bottom plates without introducing air gaps
dmf_oil = dispense 500 units of silicone_oil

// Prime the DrMF section with mineral oil (containing 0.5% wt/wt Span80
// surfactant) at a low flow rate to slowly expel air without forming bubbles
drmf_oil = dispense 500 units of mineral_oil

// Load LAMP buffer (1x ThermoPol reaction buffer) into the DMF section
// through the top-plate access port above the larger reservoir
buffer = dispense 100 units of lamp_buffer

// Move the LAMP buffer across the DMF electrode array toward the
// DMF-DrMF interfacing electrode by sequential activation/deactivation of
// neighboring electrodes (40 VRMS AC signal at 5 kHz)
moved_buffer = mix buffer with dmf_oil for 5s

// Generate nano-liter droplets at the flow-focusing junction: oil phase is
// pushed into the DrMF section (positive pressure, e.g. 920 nL/min) while
// the LAMP buffer is simultaneously pulled through the DrMF outlet
// (negative pressure, 1000 nL/min), producing ~0.5-2 nL droplets at up to
// 4 droplets/sec traveling at speeds up to ~1540 um/s
droplet = mix moved_buffer with drmf_oil for 1s

// Envisioned downstream application (proposed by the authors as future
// work; not experimentally performed in this device-characterization
// study): heating the droplet population to drive LAMP amplification,
// followed by fluorescence-based detection for droplet digital
// quantification of the initial nucleic acid target
heat droplet at 65c for 30m

amplification_signal = detect fluorescence on droplet for 30s

if (amplification_signal < 50) {
    dispose droplet
}
