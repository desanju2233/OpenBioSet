bsbbif_2_t:
	dispose(dbd_blank1[0])
bsbbif_3_f:
	PHI dbd_blank2 = {dbd_blank1,dbd_blank}
	dispose(dbd_blank2[0])
	rna_low1[0] = dispense(extracted_rna_low)
	mix_low1[0] = dispense(lamp_master_mix)
	amplicon_low1[0] = mix(rna_low1[0], mix_low1[0])
	heat(amplicon_low1[0]) @ 65.0CELSIUS @ 1020.0SECOND
	beads_low1[0] = dispense(capto_beads)
	cleaned_low1[0] = mix(amplicon_low1[0], beads_low1[0]) @ 60.0SECOND
	dye_low1[0] = dispense(sybr_safe)
	dbd_low1[0] = mix(cleaned_low1[0], dye_low1[0]) @ 120.0SECOND
	low_signal1[0] = detect(fluorescence, dbd_low1[0]) @ 300.0SECOND
	if low_signal1[0] <= 20	|	true: jump bsbbif_4_t	|	false: jump bsbbif_5_f
main:
	rna_blank1[0] = dispense(extracted_rna_blank)
	mix_blank1[0] = dispense(lamp_master_mix)
	amplicon_blank1[0] = mix(rna_blank1[0], mix_blank1[0])
	heat(amplicon_blank1[0]) @ 65.0CELSIUS @ 1020.0SECOND
	beads_blank1[0] = dispense(capto_beads)
	cleaned_blank1[0] = mix(amplicon_blank1[0], beads_blank1[0]) @ 60.0SECOND
	dye_blank1[0] = dispense(sybr_safe)
	dbd_blank1[0] = mix(cleaned_blank1[0], dye_blank1[0]) @ 120.0SECOND
	blank_signal1[0] = detect(fluorescence, dbd_blank1[0]) @ 300.0SECOND
	if blank_signal1[0] >= 30	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_4_t:
	dispose(dbd_low1[0])
bsbbif_5_f:
	PHI dbd_low2 = {dbd_low1,dbd_low}
	dispose(dbd_low2[0])
	rna_high1[0] = dispense(extracted_rna_high)
	mix_high1[0] = dispense(lamp_master_mix)
	amplicon_high1[0] = mix(rna_high1[0], mix_high1[0])
	heat(amplicon_high1[0]) @ 65.0CELSIUS @ 1020.0SECOND
	beads_high1[0] = dispense(capto_beads)
	cleaned_high1[0] = mix(amplicon_high1[0], beads_high1[0]) @ 60.0SECOND
	dye_high1[0] = dispense(sybr_safe)
	dbd_high1[0] = mix(cleaned_high1[0], dye_high1[0]) @ 120.0SECOND
	high_signal1[0] = detect(fluorescence, dbd_high1[0]) @ 300.0SECOND
	if high_signal1[0] <= 50	|	true: jump bsbbif_6_t	|	false: jump bsbbif_7_f
bsbbif_6_t:
	dispose(dbd_high1[0])
bsbbif_7_f:
	PHI dbd_high2 = {dbd_high1,dbd_high}
	dispose(dbd_high2[0])
	NOP
