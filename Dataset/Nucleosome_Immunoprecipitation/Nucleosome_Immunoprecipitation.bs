module fluorescence

manifest nucleosome_sample
manifest streptavidin_beads
manifest primary_antibody
manifest secondary_antibody
manifest wash_buffer

instructions:

// Step 1: Mix biotinylated H3K4me2 nucleosome sample with streptavidin-coated magnetic beads;
// incubate 6 h with agitation at 4 C to capture nucleosomes on the beads
nucleosome = dispense nucleosome_sample
beads1 = dispense streptavidin_beads
capture = mix nucleosome with beads1
heat capture at 4c for 360m

// Step 2: Magnetic wash to remove unbound nucleosomes
dispose capture

// Step 3: Separately (in parallel), incubate the primary antibody (anti-H3K4me2) with the
// Alexa Fluor 405-conjugated secondary antibody to form the fluorescent detection complex,
// under the same conditions (6 h, 4 C, agitation)
primary = dispense primary_antibody
secondary = dispense secondary_antibody
detection_complex = mix primary with secondary
heat detection_complex at 4c for 360m

// Step 4: Add the fluorescent detection complex to the washed, nucleosome-bound beads and incubate again
beads2 = dispense streptavidin_beads
labeled = mix beads2 with detection_complex
heat labeled at 4c for 60m

// Step 5: Final magnetic wash to remove unbound antibody
dispose labeled

// Step 6: Re-suspend the washed, labeled beads and detect via fluorescence
// (Alexa Fluor 405: ~395 nm excitation, ~421 nm emission)
beads3 = dispense streptavidin_beads
wbuf = dispense wash_buffer
final_sample = mix beads3 with wbuf
nuip_reading = detect fluorescence on final_sample for 30s

dispose final_sample
