main:
	nucleosome1[0] = dispense(nucleosome_sample)
	beads11[0] = dispense(streptavidin_beads)
	capture1[0] = mix(nucleosome1[0], beads11[0])
	heat(capture1[0]) @ 4.0CELSIUS @ 21600.0SECOND
	dispose(capture1[0])
	primary1[0] = dispense(primary_antibody)
	secondary1[0] = dispense(secondary_antibody)
	detection_complex1[0] = mix(primary1[0], secondary1[0])
	heat(detection_complex1[0]) @ 4.0CELSIUS @ 21600.0SECOND
	beads21[0] = dispense(streptavidin_beads)
	labeled1[0] = mix(beads21[0], detection_complex1[0])
	heat(labeled1[0]) @ 4.0CELSIUS @ 3600.0SECOND
	dispose(labeled1[0])
	beads31[0] = dispense(streptavidin_beads)
	wbuf1[0] = dispense(wash_buffer)
	final_sample1[0] = mix(beads31[0], wbuf1[0])
	nuip_reading1[0] = detect(fluorescence, final_sample1[0]) @ 30.0SECOND
	dispose(final_sample1[0])
	NOP
