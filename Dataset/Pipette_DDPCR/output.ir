main:
	qpcr_mix1[0] = dispense(rt_qpcr_mix)
	primers1[0] = dispense(gapdh_primers_probes)
	f1271[0] = dispense(f127_solution)
	target1[0] = dispense(target_rna)
	water1[0] = dispense(nuclease_free_water)
	combined11[0] = mix(qpcr_mix1[0], primers1[0])
	combined21[0] = mix(combined11[0], f1271[0])
	combined31[0] = mix(combined21[0], target1[0])
	reaction1[0] = mix(combined31[0], water1[0])
	heat(reaction1[0]) @ 52.0CELSIUS @ 600.0SECOND
	heat(reaction1[0]) @ 95.0CELSIUS @ 120.0SECOND
bsbbr_2_h:
	PHI REPEAT_401 = {REPEAT_400,REPEAT_402}
	PHI reaction2 = {reaction1,reaction2}
	if REPEAT_401[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	heat(reaction2[0]) @ 95.0CELSIUS @ 10.0SECOND
	heat(reaction2[0]) @ 60.0CELSIUS @ 30.0SECOND
	REPEAT_402[0] = REPEAT_401[0] - 1
bsbbr_4_f:
	fam_signal1[0] = detect(fluorescence, reaction2[0]) @ 5.0SECOND
	dispose(reaction2[0])
	NOP
