main:
	plasma1[0] = dispense(plasma_sample)
	solvent1[0] = dispense(extraction_solvent)
	extract1[0] = mix(plasma1[0], solvent1[0]) @ 600.0SECOND
	heat(extract1[0]) @ 4.0CELSIUS @ 600.0SECOND
	heat(extract1[0]) @ 25.0CELSIUS @ 600.0SECOND
	heat(extract1[0]) @ 4.0CELSIUS @ 600.0SECOND
	heat(extract1[0]) @ 25.0CELSIUS @ 2400.0SECOND
	derivatize11[0] = dispense(methoxyamine_reagent)
	step11[0] = mix(extract1[0], derivatize11[0])
	heat(step11[0]) @ 30.0CELSIUS @ 5400.0SECOND
	derivatize21[0] = dispense(mstfa_tmcs_reagent)
	step21[0] = mix(step11[0], derivatize21[0])
	heat(step21[0]) @ 60.0CELSIUS @ 5400.0SECOND
	metabolite_reading1[0] = detect(fluorescence, step21[0]) @ 300.0SECOND
	dispose(step21[0])
	NOP
