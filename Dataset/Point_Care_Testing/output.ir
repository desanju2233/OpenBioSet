main:
	tni_sample1[0] = dispense(sample)
	beads1[0] = dispense(capture_antibody_beads)
	reporter1[0] = dispense(reporter_antibody_alp)
	mix11[0] = mix(tni_sample1[0], beads1[0])
	reaction_mix1[0] = mix(mix11[0], reporter1[0])
	heat(reaction_mix1[0]) @ 25.0CELSIUS @ 240.0SECOND
bsbbr_2_h:
	PHI REPEAT_101 = {REPEAT_100,REPEAT_102}
	PHI washed1 = {washed0,washed2}
	PHI wash1 = {wash0,wash2}
	if REPEAT_101[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	wash2[0] = dispense(wash_buffer)
	washed2[0] = mix(reaction_mix1[0], wash2[0])
	dispose(washed2[0])
	REPEAT_102[0] = REPEAT_101[0] - 1
bsbbr_4_f:
	substrate1[0] = dispense(chemiluminescent_substrate)
	detection_mix1[0] = mix(reaction_mix1[0], substrate1[0])
	heat(detection_mix1[0]) @ 25.0CELSIUS @ 120.0SECOND
	tni_signal1[0] = detect(fluorescence, detection_mix1[0]) @ 30.0SECOND
	dispose(detection_mix1[0])
	NOP
