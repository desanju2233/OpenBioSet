module fluorescence

manifest casting_solution
manifest activation_solvent
manifest equilibration_solvent
manifest sample
manifest wash_solvent
manifest elution_solvent

instructions:

// --- PPM disc formation: in situ UV-initiated polymerization ---
// (1 uL casting solution droplet dispensed, driven into position,
//  and cured -- heat step stands in for 100W/365nm UV exposure)
cs = dispense 1 units of casting_solution
heat cs at 25c for 5m

// --- Step 1: Activation ---
act = dispense 5 units of activation_solvent
ppm = mix cs with act for 60s
heat ppm at 25c for 1m

// --- Step 1: Equilibration ---
eq = dispense 5 units of equilibration_solvent
ppm = mix ppm with eq for 60s
heat ppm at 25c for 1m

// --- Step 2: Sample loading ---
s = dispense 1 units of sample
ppm = mix ppm with s for 60s
heat ppm at 25c for 2m

// --- Step 3: Monolith washing (2 x 5 uL wash droplets) ---
repeat 2 times {
    w = dispense 5 units of wash_solvent
    ppm = mix ppm with w for 60s
}

// --- Step 4: Elution (2 x 5 uL elution droplets pooled) ---
repeat 2 times {
    el = dispense 5 units of elution_solvent
    ppm = mix ppm with el for 60s
}

// --- Readout: interrogate eluate for fluorescence intensity ---
extraction_reading = detect fluorescence on ppm for 5m

if (extraction_reading <= 20) {
    dispose ppm
}

dispose ppm
