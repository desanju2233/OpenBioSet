main:
	cs1[0] = dispense(casting_solution)
	heat(cs1[0]) @ 25.0CELSIUS @ 300.0SECOND
	act1[0] = dispense(activation_solvent)
	ppm1[0] = mix(cs1[0], act1[0]) @ 60.0SECOND
	heat(ppm1[0]) @ 25.0CELSIUS @ 60.0SECOND
	eq1[0] = dispense(equilibration_solvent)
	ppm2[0] = mix(ppm1[0], eq1[0]) @ 60.0SECOND
	heat(ppm2[0]) @ 25.0CELSIUS @ 60.0SECOND
	s1[0] = dispense(sample)
	ppm3[0] = mix(ppm2[0], s1[0]) @ 60.0SECOND
	heat(ppm3[0]) @ 25.0CELSIUS @ 120.0SECOND
bsbbr_2_h:
	PHI REPEAT_21 = {REPEAT_20,REPEAT_22}
	PHI w1 = {w0,w2}
	PHI ppm4 = {ppm3,ppm5}
	if REPEAT_21[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	w2[0] = dispense(wash_solvent)
	ppm5[0] = mix(ppm4[0], w2[0]) @ 60.0SECOND
	REPEAT_22[0] = REPEAT_21[0] - 1
bsbbr_4_f:
bsbbr_5_h:
	PHI el1 = {el0,el2}
	PHI REPEAT_23 = {REPEAT_21,REPEAT_24}
	PHI ppm6 = {ppm4,ppm7}
	if REPEAT_23[0] > 0	|	true: jump bsbbr_6_t	|	false: jump bsbbr_7_f
bsbbr_6_t:
	el2[0] = dispense(elution_solvent)
	ppm7[0] = mix(ppm6[0], el2[0]) @ 60.0SECOND
	REPEAT_24[0] = REPEAT_23[0] - 1
bsbbr_7_f:
	extraction_reading1[0] = detect(fluorescence, ppm6[0]) @ 300.0SECOND
	if extraction_reading1[0] <= 20	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(ppm6[0])
bsbbif_9_f:
	PHI ppm8 = {ppm6,ppm}
	dispose(ppm8[0])
	NOP
