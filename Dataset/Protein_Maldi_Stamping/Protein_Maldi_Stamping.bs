module fluorescence

manifest Protein_Sample
manifest Silicone_Oil

instructions:

repeat 6 times {

    // --- droplet formation: unit droplet generated from on-chip reservoir using electrowetting forces ---
    sample = dispense Protein_Sample
    oil = dispense 1 units of Silicone_Oil
    encased = mix sample with oil for 5s

    // --- transport: oil-encased droplet actuated across the electrode array toward the stamping hole ---
    transported = mix encased with oil for 2s

    // --- passive stamping: droplet vertically stamped through the stamping hole onto the MALDI target ---
    stamped = mix transported with oil for 1s

    // --- MALDI-MS analysis: mass spectrum acquired to confirm protein identity/intensity ---
    spectrum = detect fluorescence on stamped for 10s

    dispose stamped
}
