main:
bsbbr_2_h:
	PHI transported1 = {transported0,transported2}
	PHI encased1 = {encased0,encased2}
	PHI spectrum1 = {spectrum0,spectrum2}
	PHI oil1 = {oil0,oil2}
	PHI REPEAT_61 = {REPEAT_60,REPEAT_62}
	PHI sample1 = {sample0,sample2}
	PHI stamped1 = {stamped0,stamped2}
	if REPEAT_61[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	sample2[0] = dispense(Protein_Sample)
	oil2[0] = dispense(Silicone_Oil)
	encased2[0] = mix(sample2[0], oil2[0]) @ 5.0SECOND
	transported2[0] = mix(encased2[0], oil2[0]) @ 2.0SECOND
	stamped2[0] = mix(transported2[0], oil2[0]) @ 1.0SECOND
	spectrum2[0] = detect(fluorescence, stamped2[0]) @ 10.0SECOND
	dispose(stamped2[0])
	REPEAT_62[0] = REPEAT_61[0] - 1
bsbbr_4_f:
	NOP
