main:
	rna1[0] = dispense(RNA_Sample)
	water1[0] = dispense(RNase_Free_Water)
	probemix1[0] = dispense(OneStep_Q_Probe_Mix)
	enzymemix1[0] = dispense(OneStep_Q_Probe_Enzyme_Mix)
	mix11[0] = mix(rna1[0], water1[0])
	mix21[0] = mix(mix11[0], probemix1[0])
	master_mix1[0] = mix(mix21[0], enzymemix1[0])
	mp_probe1[0] = dispense(MP_Primer_Probe)
	mp_mix1[0] = mix(master_mix1[0], mp_probe1[0])
	cp_probe1[0] = dispense(CP_Primer_Probe)
	cp_mix1[0] = mix(master_mix1[0], cp_probe1[0])
