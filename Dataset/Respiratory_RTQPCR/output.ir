	heat(flub_mix1[0]) @ 50.0CELSIUS @ 900.0SECOND
	heat(mp_mix1[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(cp_mix1[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(sp_mix1[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(rsva_mix1[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(adv_mix1[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(hku1_mix1[0]) @ 95.0CELSIUS @ 30.0SECOND
