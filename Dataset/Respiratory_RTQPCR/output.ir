	heat(orf1ab_mix1[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(flua_mix1[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(flub_mix1[0]) @ 95.0CELSIUS @ 30.0SECOND
bsbbr_2_h:
	PHI REPEAT_451 = {REPEAT_450,REPEAT_452}
