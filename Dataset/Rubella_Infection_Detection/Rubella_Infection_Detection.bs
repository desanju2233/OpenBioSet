module fluorescence

manifest rv_particles
manifest wash_buffer
manifest patient_sample
manifest hrp_antihuman_igg
manifest hrp_antihuman_igm
manifest pretreatment_reagent
manifest h2o2
manifest luminol

instructions:

particles_igg = dispense 18 units of rv_particles
sample_igg = dispense 18 units of patient_sample
capture_igg = mix particles_igg with sample_igg for 3m

repeat 4 times {
    wash_igg = dispense 18 units of wash_buffer
    capture_igg = mix capture_igg with wash_igg for 30s
    dispose wash_igg
}

conjugate_igg = dispense 18 units of hrp_antihuman_igg
labeled_igg = mix capture_igg with conjugate_igg for 2m

repeat 4 times {
    wash_igg2 = dispense 18 units of wash_buffer
    labeled_igg = mix labeled_igg with wash_igg2 for 30s
    dispose wash_igg2
}

peroxide_igg = dispense 9 units of h2o2
enhancer_igg = dispense 9 units of luminol
substrate_igg = mix peroxide_igg with enhancer_igg
rxn_igg = mix labeled_igg with substrate_igg for 2m

igg_signal = detect fluorescence on rxn_igg for 10s

if (igg_signal >= 10) {
    dispose rxn_igg
} else {
    dispose rxn_igg
}

pretreat = dispense 9 units of pretreatment_reagent
sample_igm = dispense 18 units of patient_sample
blocked_igm = mix sample_igm with pretreat for 7m

particles_igm = dispense 18 units of rv_particles
capture_igm = mix particles_igm with blocked_igm for 3m

repeat 4 times {
    wash_igm = dispense 18 units of wash_buffer
    capture_igm = mix capture_igm with wash_igm for 30s
    dispose wash_igm
}

conjugate_igm = dispense 18 units of hrp_antihuman_igm
labeled_igm = mix capture_igm with conjugate_igm for 2m

repeat 4 times {
    wash_igm2 = dispense 18 units of wash_buffer
    labeled_igm = mix labeled_igm with wash_igm2 for 30s
    dispose wash_igm2
}

peroxide_igm = dispense 9 units of h2o2
enhancer_igm = dispense 9 units of luminol
substrate_igm = mix peroxide_igm with enhancer_igm
rxn_igm = mix labeled_igm with substrate_igm for 2m

igm_signal = detect fluorescence on rxn_igm for 10s

if (igm_signal >= 1) {
    dispose rxn_igm
} else {
    dispose rxn_igm
}
