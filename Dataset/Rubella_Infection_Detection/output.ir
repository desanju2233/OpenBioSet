main:
	particles_igg1[0] = dispense(rv_particles)
	sample_igg1[0] = dispense(patient_sample)
	capture_igg1[0] = mix(particles_igg1[0], sample_igg1[0]) @ 180.0SECOND
bsbbr_2_h:
	PHI wash_igg1 = {wash_igg0,wash_igg2}
	PHI REPEAT_41 = {REPEAT_40,REPEAT_42}
	PHI capture_igg2 = {capture_igg1,capture_igg3}
	if REPEAT_41[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	wash_igg2[0] = dispense(wash_buffer)
	capture_igg3[0] = mix(capture_igg2[0], wash_igg2[0]) @ 30.0SECOND
	dispose(wash_igg2[0])
	REPEAT_42[0] = REPEAT_41[0] - 1
bsbbr_4_f:
	conjugate_igg1[0] = dispense(hrp_antihuman_igg)
	labeled_igg1[0] = mix(capture_igg2[0], conjugate_igg1[0]) @ 120.0SECOND
bsbbr_5_h:
	PHI wash_igg21 = {wash_igg20,wash_igg22}
	PHI labeled_igg2 = {labeled_igg1,labeled_igg3}
	PHI REPEAT_43 = {REPEAT_41,REPEAT_44}
	if REPEAT_43[0] > 0	|	true: jump bsbbr_6_t	|	false: jump bsbbr_7_f
bsbbr_6_t:
	wash_igg22[0] = dispense(wash_buffer)
	labeled_igg3[0] = mix(labeled_igg2[0], wash_igg22[0]) @ 30.0SECOND
	dispose(wash_igg22[0])
	REPEAT_44[0] = REPEAT_43[0] - 1
bsbbr_7_f:
	peroxide_igg1[0] = dispense(h2o2)
	enhancer_igg1[0] = dispense(luminol)
	substrate_igg1[0] = mix(peroxide_igg1[0], enhancer_igg1[0])
	rxn_igg1[0] = mix(labeled_igg2[0], substrate_igg1[0]) @ 120.0SECOND
	igg_signal1[0] = detect(fluorescence, rxn_igg1[0]) @ 10.0SECOND
	if igg_signal1[0] >= 10	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(rxn_igg1[0])
bsbbif_9_f:
	dispose(rxn_igg1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	pretreat1[0] = dispense(pretreatment_reagent)
	sample_igm1[0] = dispense(patient_sample)
	blocked_igm1[0] = mix(sample_igm1[0], pretreat1[0]) @ 420.0SECOND
	particles_igm1[0] = dispense(rv_particles)
	capture_igm1[0] = mix(particles_igm1[0], blocked_igm1[0]) @ 180.0SECOND
bsbbr_11_h:
	PHI wash_igm1 = {wash_igm0,wash_igm2}
	PHI capture_igm2 = {capture_igm1,capture_igm3}
	PHI REPEAT_45 = {REPEAT_43,REPEAT_46}
	if REPEAT_45[0] > 0	|	true: jump bsbbr_12_t	|	false: jump bsbbr_13_f
bsbbr_12_t:
	wash_igm2[0] = dispense(wash_buffer)
	capture_igm3[0] = mix(capture_igm2[0], wash_igm2[0]) @ 30.0SECOND
	dispose(wash_igm2[0])
	REPEAT_46[0] = REPEAT_45[0] - 1
bsbbr_13_f:
	conjugate_igm1[0] = dispense(hrp_antihuman_igm)
	labeled_igm1[0] = mix(capture_igm2[0], conjugate_igm1[0]) @ 120.0SECOND
bsbbr_14_h:
	PHI wash_igm21 = {wash_igm20,wash_igm22}
	PHI labeled_igm2 = {labeled_igm1,labeled_igm3}
	PHI REPEAT_47 = {REPEAT_45,REPEAT_48}
	if REPEAT_47[0] > 0	|	true: jump bsbbr_15_t	|	false: jump bsbbr_16_f
bsbbr_15_t:
	wash_igm22[0] = dispense(wash_buffer)
	labeled_igm3[0] = mix(labeled_igm2[0], wash_igm22[0]) @ 30.0SECOND
	dispose(wash_igm22[0])
	REPEAT_48[0] = REPEAT_47[0] - 1
bsbbr_16_f:
	peroxide_igm1[0] = dispense(h2o2)
	enhancer_igm1[0] = dispense(luminol)
	substrate_igm1[0] = mix(peroxide_igm1[0], enhancer_igm1[0])
	rxn_igm1[0] = mix(labeled_igm2[0], substrate_igm1[0]) @ 120.0SECOND
	igm_signal1[0] = detect(fluorescence, rxn_igm1[0]) @ 10.0SECOND
	if igm_signal1[0] >= 1	|	true: jump bsbbif_17_t	|	false: jump bsbbif_18_f
bsbbif_17_t:
	dispose(rxn_igm1[0])
bsbbif_18_f:
	dispose(rxn_igm1[0])
	jump: bsbbif_19_j
bsbbif_19_j:
	NOP
