{
  "protocol": {
    "title": "One Cell, One Drop, One Click: Hybrid Microfluidics for Mammalian Single Cell Isolation",
    "source": "Small 2020, 16, 2002400",
    "doi": "10.1002/smll.202002400",
    "platform": "Hybrid DMF (digital microfluidics + droplet-in-channel microfluidics)",
    "cell_lines": ["MCF-7 (breast cancer)", "NCI-H1299 (lung squamous cell carcinoma, eGFP+/Luciferase stable)"],
    "objective": "Hydrodynamic single-cell trapping, deterministic in situ droplet encapsulation, on-demand droplet operations, cell viability assay, and CRISPR-Cas9 isoclone sorting and recovery",

    "device": {
      "layers": [
        "Chromium electrodes on glass (layer i)",
        "SU-8 5 dielectric layer, 7 um thick (layer ii)",
        "PDMS channel layer, 35 um height, 50-75 um width (layer iii)"
      ],
      "sections": ["T-junction on-demand droplet generator", "Serpentine single-cell trapping array"],
      "traps": {
        "total": 12,
        "electrode_equipped": 6,
        "constriction_width_um": 8
      },
      "electrodes": {
        "size_um": 100,
        "area_mm2": 0.06,
        "count_per_trap": 4,
        "actuation_frequency_kHz": 15,
        "actuation_voltage_Vrms": 126
      },
      "inlets": {
        "I1": "Oil and droplets",
        "I2": "Cells and priming",
        "I3": "PBS or media (droplet generator)",
        "I4": "HFE7500 oil (droplet generator)"
      },
      "outlets": {
        "O1": "Waste",
        "O2": "Sample recovery and flow reversal",
        "O3": "Bridge to encapsulation inlet"
      }
    },

    "reagents": {
      "carrier_oil": "3M Novec HFE7500",
      "surfactant": "PEG fluoro-surfactant (Ran Biotechnologies) 2% w/v in HFE7500",
      "wash_oil": "Fluorinert FC-40",
      "priming_agent": "Pluronics F-127 2% in PBS (Ca2+/Mg2+ free)",
      "cell_media": {
        "MCF7": "DMEM + 10% FBS, no antibiotics",
        "H1299": "RPMI-1640 + 10% FBS, no antibiotics"
      },
      "viability_stains": {
        "FDA": { "concentration_ug_mL": 5, "ex_nm": 490, "em_nm": 526, "labels": "live cells" },
        "PI":  { "concentration_ug_mL": 2, "ex_nm": 488, "em_nm": 617, "labels": "dead cells" }
      },
      "transfection_reagent": "Lipofectamine 3000",
      "plasmids": {
        "eGFP_KO": "pCRISPR_eGFP_314 (Cas9 + mCherry reporter + eGFP sgRNA: GCAACTACAAGACCCGCGCCG)",
        "RAF1_KO": "pCRISPR_RAF1_94 (Cas9 + mCherry reporter + RAF1 sgRNA: GCCGCCCGAGAGTCTTAATCG)"
      },
      "recovery_membrane": "0.22 um hydrophobic PTFE membrane",
      "capillary": "Glass capillary pre-filled with HFE7500 2% fluorosurfactant"
    },

    "steps": [
      {
        "id": "S1",
        "name": "Device priming",
        "bb": "BB1",
        "inputs": ["PBS", "Pluronics F-127"],
        "operation": "mix",
        "duration_s": 300,
        "flow_rate_nL_s": "0.8-8",
        "inlet": "I1",
        "notes": "2% Pluronics F-127 in PBS; reduces cell adhesion to PDMS channel walls"
      },
      {
        "id": "S2",
        "name": "Hydrodynamic single-cell trapping",
        "bb": "BB1",
        "cell_line": "MCF-7",
        "cell_concentration_cells_mL": "1e5-1e6",
        "suspension_buffer": "PBS (Ca2+/Mg2+ free)",
        "operation": "flow-through trap (abstracted as mix in BioScript)",
        "flow_rate_nL_s": "1-4",
        "optimal_flow_rate_nL_s": 5,
        "trapping_efficiency_pct": 88.3,
        "inlet": "I1",
        "notes": "8 um constriction prevents multi-cell occupancy; slanted overhang steers flow into trap; Qtrap > Qbypass when trap is empty"
      },
      {
        "id": "S3",
        "name": "In situ deterministic single-cell encapsulation",
        "bb": "BB1",
        "operation": "phase change + electrode actuation",
        "oil": "HFE7500 + 2% fluorosurfactant",
        "oil_flow_rate_nL_s": 4,
        "electrode_frequency_kHz": 15,
        "electrode_voltage_Vrms": 126,
        "droplet_volume_pL": { "mean": 150.3, "sd": 5.6, "n": 11 },
        "electric_field_density_V_m": "~5e6",
        "inlet": "I3/I4 via bridge",
        "notes": "Deterministic encapsulation; no Poisson statistics. Electric field pulls aqueous phase into trap when oil flow shears both ends."
      },
      {
        "id": "S4",
        "name": "On-demand droplet release characterisation",
        "bb": "BB1",
        "operation": "electrode actuation + forward flow",
        "oil_flow_rate_nL_s": "<1",
        "release_probability_pct": ">95",
        "electrode_frequency_kHz": 15,
        "electrode_voltage_Vrms": 126,
        "detection_module": "dropletReleaseDetection",
        "detection_duration_s": 10,
        "branch": {
          "pass": { "condition": "releaseSignal > 0", "action": "dispose", "bb": "BB2" },
          "fail": { "condition": "releaseSignal <= 0", "action": "drain",   "bb": "BB3" }
        },
        "notes": "Characterisation run only (Fig 4A/B). Electrostatic force (Felec) must exceed hydrodynamic pressure (Ph). Without actuation, droplet is never released at any flow rate."
      },
      {
        "id": "S5",
        "name": "Cell viability assay",
        "bb": "BB4",
        "cell_line": "MCF-7",
        "operation": "electrode actuation + fluorescence staining",
        "actuation_duration_s": 30,
        "electrode_frequency_kHz": 15,
        "electrode_voltage_Vrms": 126,
        "stain": "FDA/PI 1X (10 uL PI stock + 2.5 uL FDA stock)",
        "incubation_temperature_C": 25,
        "incubation_duration_s": 600,
        "detection_module": "viabilityDetection",
        "detection_duration_s": 30,
        "results": {
          "control_viability_pct": { "mean": 87.5, "sd": 7.2 },
          "potentiated_viability_pct": { "mean": 82.5, "sd": 8.1 },
          "p_value": 0.6687,
          "n": 3,
          "conclusion": "No significant difference; electrode actuation does not alter viability"
        },
        "branch": {
          "pass": { "condition": "viabilitySignal > 0", "action": "dispose", "bb": "BB5" },
          "fail": { "condition": "viabilitySignal <= 0", "action": "drain",   "bb": "BB6" }
        }
      },
      {
        "id": "S6",
        "name": "Off-chip CRISPR-Cas9 transfection (eGFP KO arm)",
        "bb": "BB7",
        "cell_line": "NCI-H1299",
        "plasmid": "pCRISPR_eGFP_314",
        "dna_per_well_ug": 5,
        "transfection_reagent": "Lipofectamine 3000",
        "plate_format": "24-well",
        "incubation_temperature_C": 37,
        "co2_pct": 5,
        "incubation_duration_s": 172800,
        "transfection_efficiency_pct": 25.3,
        "knockout_efficiency_pct": 4.95,
        "ko_confirmation_method": "Genomic Cleavage Detection assay (GCD)",
        "notes": "Day 0: subculture to 24-well. Day 1: transfect. Day 3: harvest or subculture to 6-well. RAF1 KO is a separate independent experiment (13.7% transfection, 8.3% KO efficiency)."
      },
      {
        "id": "S7",
        "name": "On-chip isoclone trapping, fluorescence screening, and encapsulation",
        "bb": "BB7",
        "cell_line": "NCI-H1299 (post-transfection)",
        "suspension_buffer": "PBS (Ca2+/Mg2+ free)",
        "trapping_flow_rate_nL_s": 4,
        "screening_method": "Fluorescence microscopy",
        "screening_channels": {
          "mCherry": { "ex_nm": 565, "em_nm": null, "indicates": "successful transfection" },
          "eGFP":   { "ex_nm": 460, "em_nm": null, "indicates": "GFP loss = knockout confirmed" }
        },
        "expected_positive_traps_pct": 16.7,
        "encapsulation_oil": "HFE7500 + 2% fluorosurfactant",
        "encapsulation_flow_rate_nL_s": 4,
        "electrode_frequency_kHz": 15,
        "electrode_voltage_Vrms": 126,
        "detection_module": "mCherryGFPDetection",
        "detection_duration_s": 30,
        "total_workflow_duration_min": 45,
        "branch": {
          "pass": { "condition": "knockoutSignal > 0", "action": "recover and expand", "bb": "BB8" },
          "fail": { "condition": "knockoutSignal <= 0", "action": "drain; re-trap at higher flow rate", "bb": "BB9" }
        }
      },
      {
        "id": "S8",
        "name": "Isoclone recovery and clonal expansion",
        "bb": "BB8",
        "condition": "knockoutSignal > 0 only",
        "recovery_steps": [
          "Forward-release droplet on-demand toward outlet",
          "Load droplet into glass capillary pre-filled with HFE7500 2% fluorosurfactant",
          "Transfer capillary onto 20 uL conditioned media on hydrophobic PTFE membrane at 37 C",
          "Flush capillary with 10 uL FC-40 oil to remove HFE7500 and surfactant",
          "Incubate 1 min; aqueous isoclone released into conditioned media droplet",
          "Transfer to 96-well plate with 50 uL conditioned media per well at 37 C"
        ],
        "conditioned_media": "50% collected RPMI-1640 10% FBS 1% pen/strep (from 1-day 80%-confluent H1299) + 50% fresh complete media",
        "expansion": {
          "incubation_temperature_C": 37,
          "co2_pct": 5,
          "incubation_duration_s": 604800,
          "imaging_checkpoints_days": [5, 7],
          "media_change_day": 5,
          "mCherry_reporter_lost_by_day": "2-3 (transient transfection)"
        }
      }
    ],

    "droplet_operations": {
      "keep": {
        "flow_direction": "reverse",
        "max_flow_rate_nL_s": 45.4,
        "keep_probability_pct": ">95",
        "electrode_frequency_kHz": 15,
        "electrode_voltage_Vrms": 126,
        "actuation_duration_s": 10,
        "notes": "4 electrodes activated; field centred at trap opening. Above 45.4 nL/s Ph > Felec and droplet escapes."
      },
      "forward_release": {
        "flow_direction": "forward",
        "optimal_flow_rate_nL_s": "<1",
        "release_probability_pct": ">95",
        "electrode_frequency_kHz": 15,
        "electrode_voltage_Vrms": 126
      },
      "reverse_release": {
        "flow_direction": "reverse",
        "hydrodynamic_threshold_nL_s": ">10.92",
        "on_demand": true,
        "electrode_frequency_kHz": 15,
        "electrode_voltage_Vrms": 126,
        "notes": "With actuation: 100% release at any reverse flow rate tested."
      },
      "on_demand_generation": {
        "configuration": "T-junction",
        "oil_flow_rate_nL_s": "2-2.5",
        "aqueous_flow_rate_nL_s": 0.6,
        "droplet_volume_pL": { "mean": 250.9, "sd": 39 },
        "electrode_frequency_kHz": 15,
        "electrode_voltage_Vrms": 126
      },
      "merge": {
        "type": "on-demand",
        "notes": "Incoming droplets merged with trapped droplets on demand; no stream synchronisation required."
      }
    },

    "cfg": {
      "basic_blocks": [
        { "id": "BB1",  "label": "main",          "type": "entry" },
        { "id": "BB2",  "label": "bsbbif_2_t",    "type": "branch_true",  "condition": "releaseSignal > 0",   "action": "dispose(releasedDroplet)" },
        { "id": "BB3",  "label": "bsbbif_3_f",    "type": "branch_false", "condition": "releaseSignal <= 0",  "action": "drain(releasedDroplet)" },
        { "id": "BB4",  "label": "bsbbif_4_j",    "type": "join" },
        { "id": "BB5",  "label": "bsbbif_5_t",    "type": "branch_true",  "condition": "viabilitySignal > 0", "action": "dispose(stainedCells)" },
        { "id": "BB6",  "label": "bsbbif_6_f",    "type": "branch_false", "condition": "viabilitySignal <= 0","action": "drain(stainedCells)" },
        { "id": "BB7",  "label": "bsbbif_7_j",    "type": "join" },
        { "id": "BB8",  "label": "bsbbif_8_t",    "type": "branch_true",  "condition": "knockoutSignal > 0",  "action": "recover and expand isoclone" },
        { "id": "BB9",  "label": "bsbbif_9_f",    "type": "branch_false", "condition": "knockoutSignal <= 0", "action": "drain(sortedIsoclone)" },
        { "id": "BB10", "label": "bsbbif_10_j",   "type": "terminal" }
      ],
      "edges": [
        ["BB1","BB2"], ["BB1","BB3"],
        ["BB2","BB4"], ["BB3","BB4"],
        ["BB4","BB5"], ["BB4","BB6"],
        ["BB5","BB7"], ["BB6","BB7"],
        ["BB7","BB8"], ["BB7","BB9"],
        ["BB8","BB10"],["BB9","BB10"]
      ]
    }
  }
}
