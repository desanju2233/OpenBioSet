bsbbif_2_t:
	dispose(derivatizedSA1[0])
bsbbif_3_f:
	dispose(derivatizedSA1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(saSignal1[0])
	meoh_aa1[0] = dispense(MeOH)
	dbsPunch21[0] = dispense(DBSPunch)
	aaExtract1[0] = mix(meoh_aa1[0], dbsPunch21[0]) @ 300.0SECOND
	heat(aaExtract1[0]) @ 25.0CELSIUS @ 900.0SECOND
	aaDerivReagent1[0] = dispense(AADerivatizationReagent)
	aaDerivMix1[0] = mix(aaDerivReagent1[0], aaExtract1[0]) @ 5.0SECOND
	heat(aaDerivMix1[0]) @ 75.0CELSIUS @ 900.0SECOND
	aaSolventDrop1[0] = dispense(AASolvent)
	aaReadySample1[0] = mix(aaSolventDrop1[0], aaDerivMix1[0]) @ 60.0SECOND
	aaSignal1[0] = detect(aminoAcidAnalysis, aaReadySample1[0]) @ 200.0SECOND
	if aaSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	meoh11[0] = dispense(MeOH)
	dbsPunch11[0] = dispense(DBSPunch)
	preExtract11[0] = mix(meoh11[0], dbsPunch11[0]) @ 900.0SECOND
	dispose(preExtract11[0])
	meoh21[0] = dispense(MeOH)
	preExtract21[0] = mix(meoh21[0], dbsPunch11[0]) @ 900.0SECOND
	dispose(preExtract21[0])
	meoh31[0] = dispense(MeOH)
	preExtract31[0] = mix(meoh31[0], dbsPunch11[0]) @ 900.0SECOND
	dispose(preExtract31[0])
	hydrazineReagent11[0] = dispense(HydrazineReagent)
	is11[0] = dispense(InternalStandard_13C5_SA)
	extractionMix11[0] = mix(hydrazineReagent11[0], is11[0]) @ 5.0SECOND
	saExtraction11[0] = mix(extractionMix11[0], dbsPunch11[0]) @ 900.0SECOND
	heat(saExtraction11[0]) @ 37.0CELSIUS @ 900.0SECOND
	hydrazineReagent21[0] = dispense(HydrazineReagent)
	is21[0] = dispense(InternalStandard_13C5_SA)
	extractionMix21[0] = mix(hydrazineReagent21[0], is21[0]) @ 5.0SECOND
	derivatizedSA1[0] = mix(extractionMix21[0], saExtraction11[0]) @ 60.0SECOND
	saSignal1[0] = detect(saAnalysis, derivatizedSA1[0]) @ 200.0SECOND
	if saSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(aaReadySample1[0])
bsbbif_6_f:
	dispose(aaReadySample1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(aaSignal1[0])
	NOP
