bsbbif_2_t:
	dispose(assemblyMix1[0])
bsbbif_3_f:
	dispose(assemblyMix1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(assemblySignal1[0])
	cellDroplet1[0] = dispense(CompetentEcoli)
	incubatedPlasmid1[0] = dispense(AssembledPlasmid)
	electroporationMedia1[0] = dispense(ElectroporationMedia)
	cellMix1[0] = mix(cellDroplet1[0], electroporationMedia1[0]) @ 5.0SECOND
	preMix1[0] = mix(incubatedPlasmid1[0], cellMix1[0]) @ 5.0SECOND
	heat(preMix1[0]) @ 37.0CELSIUS @ 60.0SECOND
	recoveryMedia1[0] = dispense(LB_Recovery)
	recoveredCells1[0] = mix(preMix1[0], recoveryMedia1[0]) @ 5.0SECOND
	heat(recoveredCells1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	transformSignal1[0] = detect(transformationQC, recoveredCells1[0]) @ 30.0SECOND
	if transformSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	oilPhase1[0] = dispense(HFE7500_PluronicF127)
	vectorDrop1[0] = dispense(VectorBackbone)
	promoterDrop1[0] = dispense(Promoter1)
	bcdDrop1[0] = dispense(BCD1_gfp)
	ligaseDrop1[0] = dispense(T4_DNA_Ligase)
	dnaMix1[0] = mix(vectorDrop1[0], promoterDrop1[0]) @ 5.0SECOND
	threePartMix1[0] = mix(dnaMix1[0], bcdDrop1[0]) @ 5.0SECOND
	assemblyMix1[0] = mix(threePartMix1[0], ligaseDrop1[0]) @ 10.0SECOND
	heat(assemblyMix1[0]) @ 25.0CELSIUS @ 600.0SECOND
	assemblySignal1[0] = detect(assemblyQC, assemblyMix1[0]) @ 30.0SECOND
	if assemblySignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(recoveredCells1[0])
bsbbif_6_f:
	dispose(recoveredCells1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(transformSignal1[0])
	dispose(oilPhase1[0])
	NOP
