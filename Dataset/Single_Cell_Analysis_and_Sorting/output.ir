bsbbif_2_t:
	dispose(droplet1[0])
bsbbif_3_f:
	PHI droplet2 = {droplet1,droplet}
	NOP
main:
	cells1[0] = dispense(cell_suspension)
	beads1[0] = dispense(bead_detection_reagent)
	droplet1[0] = mix(cells1[0], beads1[0])
	heat(droplet1[0]) @ 4.0CELSIUS @ 60.0SECOND
	heat(droplet1[0]) @ 37.0CELSIUS @ 900.0SECOND
	green_signal1[0] = detect(fluorescence, droplet1[0]) @ 5.0SECOND
	if green_signal1[0] < 1.5	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
