main:
	sample1[0] = dispense(tnf_sample)
	beads1[0] = dispense(simoa_beads)
	dab1[0] = dispense(detection_antibody)
	a1[0] = mix(sample1[0], beads1[0])
	b1[0] = mix(a1[0], dab1[0]) @ 60.0SECOND
	heat(b1[0]) @ 23.0CELSIUS @ 1200.0SECOND
	dispose(b1[0])
bsbbr_2_h:
	PHI c1 = {c2,c}
	PHI beads21 = {beads22,beads2}
	PHI REPEAT_121 = {REPEAT_122,REPEAT_12}
	PHI sample21 = {sample22,sample2}
	if REPEAT_121[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	sample22[0] = dispense(tnf_sample)
	beads22[0] = dispense(simoa_beads)
	c2[0] = mix(sample22[0], beads22[0]) @ 5.0SECOND
	dispose(c2[0])
	REPEAT_122[0] = REPEAT_121[0] - 1
bsbbr_4_f:
bsbbr_5_h:
	PHI d1 = {d0,d2}
	PHI REPEAT_51 = {REPEAT_50,REPEAT_52}
	PHI wash1 = {wash0,wash2}
	PHI beads31 = {beads30,beads32}
	if REPEAT_51[0] > 0	|	true: jump bsbbr_6_t	|	false: jump bsbbr_7_f
bsbbr_6_t:
	wash2[0] = dispense(wash_buffer)
	beads32[0] = dispense(simoa_beads)
	d2[0] = mix(wash2[0], beads32[0]) @ 45.0SECOND
	dispose(d2[0])
	REPEAT_52[0] = REPEAT_51[0] - 1
bsbbr_7_f:
	sbg1[0] = dispense(sbg_reagent)
	beads41[0] = dispense(simoa_beads)
	e1[0] = mix(beads41[0], sbg1[0]) @ 60.0SECOND
	heat(e1[0]) @ 25.0CELSIUS @ 300.0SECOND
bsbbr_8_h:
	PHI f1 = {f0,f2}
	PHI beads51 = {beads50,beads52}
	PHI wash21 = {wash20,wash22}
	PHI REPEAT_53 = {REPEAT_51,REPEAT_54}
	if REPEAT_53[0] > 0	|	true: jump bsbbr_9_t	|	false: jump bsbbr_10_f
bsbbr_9_t:
	wash22[0] = dispense(wash_buffer)
	beads52[0] = dispense(simoa_beads)
	f2[0] = mix(wash22[0], beads52[0]) @ 45.0SECOND
	dispose(f2[0])
	REPEAT_54[0] = REPEAT_53[0] - 1
bsbbr_10_f:
	rgp1[0] = dispense(rgp_substrate)
	beads61[0] = dispense(simoa_beads)
	g1[0] = mix(beads61[0], rgp1[0])
	heat(g1[0]) @ 25.0CELSIUS @ 1800.0SECOND
	tnf_reading1[0] = detect(fluorescence, g1[0]) @ 300.0SECOND
	dispose(g1[0])
	NOP
