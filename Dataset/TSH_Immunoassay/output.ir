main:
	particles1[0] = dispense(paramagnetic_particles)
	sample1[0] = dispense(tsh_standard)
	a1[0] = mix(particles1[0], sample1[0]) @ 180.0SECOND
bsbbr_2_h:
	PHI b1 = {b0,b2}
	PHI REPEAT_41 = {REPEAT_40,REPEAT_42}
	PHI wash1 = {wash0,wash2}
	if REPEAT_41[0] > 0	|	true: jump bsbbr_3_t	|	false: jump bsbbr_4_f
bsbbr_3_t:
	wash2[0] = dispense(wash_buffer)
	b2[0] = mix(a1[0], wash2[0]) @ 30.0SECOND
	dispose(b2[0])
	REPEAT_42[0] = REPEAT_41[0] - 1
bsbbr_4_f:
	conjugate1[0] = dispense(hrp_conjugate)
	c1[0] = mix(a1[0], conjugate1[0]) @ 120.0SECOND
bsbbr_5_h:
	PHI e1 = {e0,e2}
	PHI wash21 = {wash20,wash22}
	PHI REPEAT_43 = {REPEAT_41,REPEAT_44}
	if REPEAT_43[0] > 0	|	true: jump bsbbr_6_t	|	false: jump bsbbr_7_f
bsbbr_6_t:
	wash22[0] = dispense(wash_buffer)
	e2[0] = mix(c1[0], wash22[0]) @ 30.0SECOND
	dispose(e2[0])
	REPEAT_44[0] = REPEAT_43[0] - 1
bsbbr_7_f:
	h2o21[0] = dispense(hydrogen_peroxide)
	luminol1[0] = dispense(luminol_enhancer)
	substrate1[0] = mix(h2o21[0], luminol1[0])
	f1[0] = mix(c1[0], substrate1[0]) @ 240.0SECOND
	heat(f1[0]) @ 25.0CELSIUS @ 10.0SECOND
	tsh_signal1[0] = detect(fluorescence, f1[0]) @ 10.0SECOND
	dispose(f1[0])
	NOP
