bsbbif_2_t:
	dispose(mix_501[0])
	a21[0] = dispense(analyte)
	t21[0] = dispense(titrant)
	mix_751[0] = mix(a21[0], t21[0]) @ 30.0SECOND
	reading_751[0] = detect(fluorescence, mix_751[0]) @ 10.0SECOND
	if reading_751[0] <= 40	|	true: jump bsbbif_4_t	|	false: jump bsbbif_5_f
bsbbif_3_f:
	PHI a33 = {a30,a32}
	PHI t33 = {t30,t32}
	PHI mix_883 = {mix_880,mix_882}
	PHI reading_883 = {reading_880,reading_882}
	PHI a22 = {a20,a21}
	PHI t22 = {t20,t21}
	PHI mix_753 = {mix_750,mix_752}
	PHI reading_752 = {reading_750,reading_751}
	NOP
main:
	a11[0] = dispense(analyte)
	t11[0] = dispense(titrant)
	mix_501[0] = mix(a11[0], t11[0]) @ 30.0SECOND
	reading_501[0] = detect(fluorescence, mix_501[0]) @ 10.0SECOND
	if reading_501[0] <= 40	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_4_t:
	dispose(mix_751[0])
	a31[0] = dispense(analyte)
	t31[0] = dispense(titrant)
	mix_881[0] = mix(a31[0], t31[0]) @ 30.0SECOND
	reading_881[0] = detect(fluorescence, mix_881[0]) @ 10.0SECOND
	dispose(mix_881[0])
bsbbif_5_f:
	PHI a32 = {a30,a3}
	PHI t32 = {t30,t3}
	PHI mix_882 = {mix_880,mix_88}
	PHI reading_882 = {reading_880,reading_88}
	PHI mix_752 = {mix_751,mix_75}
	jump: bsbbif_3_f
