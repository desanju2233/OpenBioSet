bsbbif_2_t:
	dispose(coculture48h1[0])
	dispose(negControl48h1[0])
bsbbif_3_f:
	dispose(coculture48h1[0])
	dispose(negControl48h1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(result24h1[0])
	dispose(result48h1[0])
	dispose(negResult24h1[0])
	dispose(negResult48h1[0])
	NOP
main:
	cellDrop1[0] = dispense(tCells)
	epBuffer11[0] = dispense(electroporationBuffer)
	cellsInBuffer1[0] = mix(cellDrop1[0], epBuffer11[0]) @ 2.0SECOND
	payloadDrop1[0] = dispense(mrnaPayload)
	bufferFlank1[0] = dispense(electroporationBuffer)
	cellPayloadMix1[0] = mix(cellsInBuffer1[0], payloadDrop1[0]) @ 5.0SECOND
	triDropMerged1[0] = mix(cellPayloadMix1[0], bufferFlank1[0]) @ 3.0SECOND
	heat(triDropMerged1[0]) @ 37.0CELSIUS @ 0.01SECOND
	recoveryDrop1[0] = dispense(recoveryBuffer)
	il2Drop1[0] = dispense(il2Media)
	recoveryMix1[0] = mix(recoveryDrop1[0], il2Drop1[0]) @ 5.0SECOND
	recoveredCells1[0] = mix(triDropMerged1[0], recoveryMix1[0]) @ 10.0SECOND
	heat(recoveredCells1[0]) @ 37.0CELSIUS @ 64800.0SECOND
	rcA1[2] = split(recoveredCells1[0], 2)
	rcB1[2] = split(recoveredCells1[0], 2)
	rcA01[2] = split(rcA1, 2)
	rcA11[2] = split(rcA1, 2)
	rcB01[2] = split(rcB1, 2)
	rcB11[2] = split(rcB1, 2)
	rajiDrop11[0] = dispense(rajiCells)
	rajiDrop21[0] = dispense(rajiCells)
	coculture24hDetect1[0] = mix(rcA01[0], rajiDrop11[0]) @ 86400.0SECOND
	coculture24hContinue1[0] = mix(rcA11[0], rajiDrop21[0]) @ 86400.0SECOND
	mcf7Drop11[0] = dispense(mcf7Cells)
	mcf7Drop21[0] = dispense(mcf7Cells)
	negControl24hDetect1[0] = mix(rcB01[0], mcf7Drop11[0]) @ 86400.0SECOND
	negControl24hContinue1[0] = mix(rcB11[0], mcf7Drop21[0]) @ 86400.0SECOND
	result24h1[0] = detect(cytokineDetection, coculture24hDetect1[0]) @ 30.0SECOND
	negResult24h1[0] = detect(cytokineDetection, negControl24hDetect1[0]) @ 30.0SECOND
	il2Extend11[0] = dispense(il2Media)
	il2Extend21[0] = dispense(il2Media)
	coculture48h1[0] = mix(coculture24hContinue1[0], il2Extend11[0]) @ 86400.0SECOND
	negControl48h1[0] = mix(negControl24hContinue1[0], il2Extend21[0]) @ 86400.0SECOND
	result48h1[0] = detect(cytokineDetection, coculture48h1[0]) @ 30.0SECOND
	negResult48h1[0] = detect(cytokineDetection, negControl48h1[0]) @ 30.0SECOND
	if result48h1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
