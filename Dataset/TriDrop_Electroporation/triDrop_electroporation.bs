module electroporationAssay
module cytokineDetection

manifest tCells
manifest electroporationBuffer
manifest mrnaPayload
manifest recoveryBuffer
manifest il2Media
manifest rajiCells
manifest mcf7Cells

// mcf7Cells: CD19-negative specificity control arm (paper Fig. 4a,b)

instructions:

// ============================================================
// STEP 1: Prepare cell droplet in electroporation buffer
// Cell count: 0.5 x 10^5 per reaction (triDrop optimum)
// ============================================================

cellDrop      = dispense 1 units of tCells
epBuffer1     = dispense 1 units of electroporationBuffer
cellsInBuffer = mix cellDrop with epBuffer1 for 2s

// ============================================================
// STEP 2: Prepare mRNA payload droplet (50 ng per reaction)
// ============================================================

payloadDrop = dispense 1 units of mrnaPayload

// ============================================================
// STEP 3: triDrop three-droplet fusion
// Flanking buffer droplet limits electrolytic byproduct
// exposure at electrodes (paper Fig. S8, Little et al. 2023)
// ============================================================

bufferFlank    = dispense 1 units of electroporationBuffer
cellPayloadMix = mix cellsInBuffer with payloadDrop for 5s
triDropMerged  = mix cellPayloadMix with bufferFlank for 3s

// ============================================================
// STEP 4: Electroporation pulse (3 x 1600 V_DC x 10 ms)
// heat is a void statement -- no assignment (BioScript syntax).
// Duration: 10ms (paper M&M: 10 ms in duration for the Neon).
// ============================================================

heat triDropMerged at 37c for 10ms

// ============================================================
// STEP 5: Transfer to IL-2 recovery buffer within 15 min
// Recovery buffer: culture media containing 400 IU/mL IL-2
// ============================================================

recoveryDrop   = dispense 1 units of recoveryBuffer
il2Drop        = dispense 1 units of il2Media
recoveryMix    = mix recoveryDrop with il2Drop for 5s
recoveredCells = mix triDropMerged with recoveryMix for 10s

// ============================================================
// STEP 6: Post-EP incubation 18h at 37c
// heat is void -- recoveredCells variable survives intact.
// triDrop achieves 80-85% viability at 18h post-EP (Fig. 1c).
// ============================================================

heat recoveredCells at 37c for 18h

// ============================================================
// STEP 7: Full binary split tree -- 3 splits, 4 unique leaves
//
// The compiler assigns [0] to EVERY use of a variable when
// multiple same-type operations consume the same split result.
// The only fix: each variable name must appear exactly once
// as an operand in the instructions block.
//
// Binary tree (3 splits -> 4 leaves, each used exactly once):
//   recoveredCells
//     split into 2 -> rcA (-> Raji arm), rcB (-> negCtrl arm)
//       rcA split into 2 -> rcA0 (detect Raji), rcA1 (cont. Raji)
//       rcB split into 2 -> rcB0 (detect neg),  rcB1 (cont. neg)
//
// rcA0, rcA1, rcB0, rcB1 each appear exactly once below.
// ============================================================

rcA  = split recoveredCells into 2
rcB  = split recoveredCells into 2

rcA0 = split rcA into 2
rcA1 = split rcA into 2

rcB0 = split rcB into 2
rcB1 = split rcB into 2

// ============================================================
// STEP 7a: Raji (CD19+) co-culture -- positive arm
// rcA0 -> 24h detect arm (used exactly once)
// rcA1 -> 48h continuation arm (used exactly once)
// ============================================================

rajiDrop1 = dispense 1 units of rajiCells
rajiDrop2 = dispense 1 units of rajiCells

coculture24hDetect   = mix rcA0 with rajiDrop1 for 24h
coculture24hContinue = mix rcA1 with rajiDrop2 for 24h

// ============================================================
// STEP 7b: MCF-7 (CD19-) co-culture -- negative control arm
// rcB0 -> 24h detect arm (used exactly once)
// rcB1 -> 48h continuation arm (used exactly once)
// ============================================================

mcf7Drop1 = dispense 1 units of mcf7Cells
mcf7Drop2 = dispense 1 units of mcf7Cells

negControl24hDetect   = mix rcB0 with mcf7Drop1 for 24h
negControl24hContinue = mix rcB1 with mcf7Drop2 for 24h

// ============================================================
// STEP 8: Detect cytokine secretion at 24h
// Each detect variable feeds exactly one dedicated droplet.
// (IFN-g / TNF-a ELISA readout, paper Fig. 4a,b)
// ============================================================

result24h    = detect cytokineDetection on coculture24hDetect for 30s
negResult24h = detect cytokineDetection on negControl24hDetect for 30s

// ============================================================
// STEP 9: Extend co-culture to 48h
// Each mix consumes exactly one dedicated droplet.
// ============================================================

il2Extend1    = dispense 1 units of il2Media
il2Extend2    = dispense 1 units of il2Media

coculture48h  = mix coculture24hContinue with il2Extend1 for 24h
negControl48h = mix negControl24hContinue with il2Extend2 for 24h

// ============================================================
// STEP 10: Detect cytokine secretion at 48h
// ============================================================

result48h    = detect cytokineDetection on coculture48h for 30s
negResult48h = detect cytokineDetection on negControl48h for 30s

// ============================================================
// STEP 11: Evaluate 48h killing efficiency threshold
// ~85% killing at 4:1 E:T ratio at 48h (paper Fig. 4c).
// QC gate: result48h > 0 confirms valid cytokine signal.
// Pass: dispose (clean experiment end).
// Fail: drain (flag for review).
// ============================================================

if (result48h > 0) {
    dispose coculture48h
    dispose negControl48h
} else {
    drain coculture48h
    drain negControl48h
}

dispose result24h
dispose result48h
dispose negResult24h
dispose negResult48h
