{
  "protocol": {
    "name": "triDrop_electroporation",
    "platform": "Digital Microfluidic (DMF)",
    "method": "Droplet-based electroporation (triDrop three-droplet system)",
    "reference": "Little et al., Anal. Chem. 2025, 97, 11026-11034. DOI: 10.1021/acs.analchem.4c06911",
    "target_cell": "Primary Human T Cells",
    "application": "CAR-T cell therapy production and functional assay",
    "modules": [
      {
        "id": "electroporationAssay",
        "description": "Handles electroporation procedure on DMF platform"
      },
      {
        "id": "cytokineDetection",
        "description": "Handles IFN-g and TNF-a ELISA detection at 24h and 48h"
      }
    ],
    "reagents": [
      {
        "id": "tCells",
        "description": "Primary human T cells",
        "quantity": 50000,
        "quantity_unit": "cells per reaction"
      },
      {
        "id": "electroporationBuffer",
        "description": "Electroporation buffer; cells kept in buffer max 15 min",
        "quantity": 1,
        "quantity_unit": "units"
      },
      {
        "id": "mrnaPayload",
        "description": "mRNA payload for transfection",
        "quantity": 50,
        "quantity_unit": "ng per reaction"
      },
      {
        "id": "recoveryBuffer",
        "description": "Recovery buffer; transferred promptly after pulse",
        "quantity": 1,
        "quantity_unit": "units"
      },
      {
        "id": "il2Media",
        "description": "Culture media containing IL-2 for recovery and co-culture extension",
        "concentration": 400,
        "concentration_unit": "IU/mL",
        "quantity": 1,
        "quantity_unit": "units"
      },
      {
        "id": "rajiCells",
        "description": "Raji cells (CD19-positive target cells) for CAR-T killing assay",
        "quantity": 1,
        "quantity_unit": "units"
      },
      {
        "id": "mcf7Cells",
        "description": "MCF-7 cells (CD19-negative) for specificity control co-culture arm",
        "quantity": 1,
        "quantity_unit": "units"
      }
    ],
    "steps": [
      {
        "step": 1,
        "name": "Prepare cell droplet in electroporation buffer",
        "note": "Cell count: 0.5 x 10^5 per reaction (triDrop optimum)",
        "operations": [
          {
            "op": "dispense",
            "reagent": "tCells",
            "output": "cellDrop"
          },
          {
            "op": "dispense",
            "reagent": "electroporationBuffer",
            "output": "epBuffer1"
          },
          {
            "op": "mix",
            "inputs": ["cellDrop", "epBuffer1"],
            "duration": "2s",
            "output": "cellsInBuffer"
          }
        ]
      },
      {
        "step": 2,
        "name": "Prepare mRNA payload droplet",
        "note": "50 ng per reaction; 10-fold less than Nucleofector requirement",
        "operations": [
          {
            "op": "dispense",
            "reagent": "mrnaPayload",
            "output": "payloadDrop"
          }
        ]
      },
      {
        "step": 3,
        "name": "triDrop three-droplet fusion",
        "note": "Flanking buffer droplet limits electrolytic byproduct exposure at electrodes (joule heating, pH change, metal ions)",
        "operations": [
          {
            "op": "dispense",
            "reagent": "electroporationBuffer",
            "output": "bufferFlank"
          },
          {
            "op": "mix",
            "inputs": ["cellsInBuffer", "payloadDrop"],
            "duration": "5s",
            "output": "cellPayloadMix"
          },
          {
            "op": "mix",
            "inputs": ["cellPayloadMix", "bufferFlank"],
            "duration": "3s",
            "output": "triDropMerged"
          }
        ]
      },
      {
        "step": 4,
        "name": "Electroporation pulse",
        "note": "3 x 1600 V_DC pulses, 10 ms duration each; heat primitive maps to DMF energy delivery step",
        "operations": [
          {
            "op": "heat",
            "input": "triDropMerged",
            "temperature": "37c",
            "duration": "10ms"
          }
        ]
      },
      {
        "step": 5,
        "name": "Transfer to IL-2 recovery buffer",
        "note": "Cells transferred within 15 min post-pulse; recovery buffer contains 400 IU/mL IL-2",
        "operations": [
          {
            "op": "dispense",
            "reagent": "recoveryBuffer",
            "output": "recoveryDrop"
          },
          {
            "op": "dispense",
            "reagent": "il2Media",
            "output": "il2Drop"
          },
          {
            "op": "mix",
            "inputs": ["recoveryDrop", "il2Drop"],
            "duration": "5s",
            "output": "recoveryMix"
          },
          {
            "op": "mix",
            "inputs": ["triDropMerged", "recoveryMix"],
            "duration": "10s",
            "output": "recoveredCells"
          }
        ]
      },
      {
        "step": 6,
        "name": "Post-EP incubation",
        "note": "triDrop achieves 80-85% viability at 18h post-EP (paper Fig. 1c); heat is void in BioScript",
        "operations": [
          {
            "op": "heat",
            "input": "recoveredCells",
            "temperature": "37c",
            "duration": "18h"
          }
        ]
      },
      {
        "step": 7,
        "name": "Binary split tree on recoveredCells for four independent co-culture arms",
        "note": "Each leaf variable used exactly once as operand to avoid compiler greedy index-collision on split arrays. 3 splits produce 4 unique leaves: rcA0, rcA1, rcB0, rcB1.",
        "operations": [
          {
            "op": "split",
            "input": "recoveredCells",
            "n": 2,
            "output": "rcA"
          },
          {
            "op": "split",
            "input": "recoveredCells",
            "n": 2,
            "output": "rcB"
          },
          {
            "op": "split",
            "input": "rcA",
            "n": 2,
            "output": "rcA0"
          },
          {
            "op": "split",
            "input": "rcA",
            "n": 2,
            "output": "rcA1"
          },
          {
            "op": "split",
            "input": "rcB",
            "n": 2,
            "output": "rcB0"
          },
          {
            "op": "split",
            "input": "rcB",
            "n": 2,
            "output": "rcB1"
          }
        ]
      },
      {
        "step": 8,
        "name": "Start Raji (CD19+) co-culture -- positive arm",
        "note": "E:T ratio 1:1 (paper Fig. 4c); rcA0 -> detect arm, rcA1 -> 48h continuation arm",
        "operations": [
          {
            "op": "dispense",
            "reagent": "rajiCells",
            "output": "rajiDrop1"
          },
          {
            "op": "dispense",
            "reagent": "rajiCells",
            "output": "rajiDrop2"
          },
          {
            "op": "mix",
            "inputs": ["rcA0", "rajiDrop1"],
            "duration": "24h",
            "output": "coculture24hDetect"
          },
          {
            "op": "mix",
            "inputs": ["rcA1", "rajiDrop2"],
            "duration": "24h",
            "output": "coculture24hContinue"
          }
        ]
      },
      {
        "step": 9,
        "name": "Start MCF-7 (CD19-) co-culture -- negative control arm",
        "note": "Specificity control; should produce no cytokine signal (paper Fig. 4a,b T/M condition); rcB0 -> detect arm, rcB1 -> 48h continuation arm",
        "operations": [
          {
            "op": "dispense",
            "reagent": "mcf7Cells",
            "output": "mcf7Drop1"
          },
          {
            "op": "dispense",
            "reagent": "mcf7Cells",
            "output": "mcf7Drop2"
          },
          {
            "op": "mix",
            "inputs": ["rcB0", "mcf7Drop1"],
            "duration": "24h",
            "output": "negControl24hDetect"
          },
          {
            "op": "mix",
            "inputs": ["rcB1", "mcf7Drop2"],
            "duration": "24h",
            "output": "negControl24hContinue"
          }
        ]
      },
      {
        "step": 10,
        "name": "Detect cytokine secretion at 24h",
        "note": "IFN-g and TNF-a ELISA readout (paper Fig. 4a,b); each detect consumes one dedicated droplet",
        "operations": [
          {
            "op": "detect",
            "module": "cytokineDetection",
            "input": "coculture24hDetect",
            "duration": "30s",
            "output": "result24h"
          },
          {
            "op": "detect",
            "module": "cytokineDetection",
            "input": "negControl24hDetect",
            "duration": "30s",
            "output": "negResult24h"
          }
        ]
      },
      {
        "step": 11,
        "name": "Extend co-culture to 48h",
        "note": "mix with fresh il2Media used as timed hold primitive; heat is void in BioScript and cannot produce a new fluid variable",
        "operations": [
          {
            "op": "dispense",
            "reagent": "il2Media",
            "output": "il2Extend1"
          },
          {
            "op": "dispense",
            "reagent": "il2Media",
            "output": "il2Extend2"
          },
          {
            "op": "mix",
            "inputs": ["coculture24hContinue", "il2Extend1"],
            "duration": "24h",
            "output": "coculture48h"
          },
          {
            "op": "mix",
            "inputs": ["negControl24hContinue", "il2Extend2"],
            "duration": "24h",
            "output": "negControl48h"
          }
        ]
      },
      {
        "step": 12,
        "name": "Detect cytokine secretion at 48h",
        "note": "IFN-g and TNF-a ELISA readout at 48h timepoint (paper Fig. 4a,b)",
        "operations": [
          {
            "op": "detect",
            "module": "cytokineDetection",
            "input": "coculture48h",
            "duration": "30s",
            "output": "result48h"
          },
          {
            "op": "detect",
            "module": "cytokineDetection",
            "input": "negControl48h",
            "duration": "30s",
            "output": "negResult48h"
          }
        ]
      },
      {
        "step": 13,
        "name": "Evaluate 48h killing efficiency and cleanup",
        "note": "~85% killing at 4:1 E:T ratio at 48h (paper Fig. 4c); result48h > 0 confirms valid cytokine signal",
        "operations": [
          {
            "op": "conditional",
            "condition": "result48h > 0",
            "if_true": [
              {
                "op": "dispose",
                "input": "coculture48h"
              },
              {
                "op": "dispose",
                "input": "negControl48h"
              }
            ],
            "if_false": [
              {
                "op": "drain",
                "input": "coculture48h"
              },
              {
                "op": "drain",
                "input": "negControl48h"
              }
            ]
          },
          {
            "op": "dispose",
            "input": "result24h"
          },
          {
            "op": "dispose",
            "input": "result48h"
          },
          {
            "op": "dispose",
            "input": "negResult24h"
          },
          {
            "op": "dispose",
            "input": "negResult48h"
          }
        ]
      }
    ]
  }
}
