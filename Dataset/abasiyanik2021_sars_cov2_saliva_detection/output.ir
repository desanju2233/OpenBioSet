	ddEmulsion_N21[0] = mix(ddPCR_rxn_N21[0], ddOil_N21[0]) @ 120.0SECOND
	ddEmulsion_RnaseP1[0] = mix(ddPCR_rxn_RnaseP1[0], ddOil_RnaseP1[0]) @ 120.0SECOND
	heat(ddEmulsion_N11[0]) @ 25.0CELSIUS @ 120.0SECOND
	heat(ddEmulsion_N11[0]) @ 50.0CELSIUS @ 3600.0SECOND
	heat(ddEmulsion_N11[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(ddEmulsion_N11[0]) @ 55.0CELSIUS @ 2700.0SECOND
	heat(ddEmulsion_N11[0]) @ 98.0CELSIUS @ 600.0SECOND
	heat(ddEmulsion_N11[0]) @ 4.0CELSIUS @ 3600.0SECOND
	heat(ddEmulsion_N21[0]) @ 25.0CELSIUS @ 120.0SECOND
	heat(ddEmulsion_N21[0]) @ 50.0CELSIUS @ 3600.0SECOND
	heat(ddEmulsion_N21[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(ddEmulsion_N21[0]) @ 55.0CELSIUS @ 2700.0SECOND
	heat(ddEmulsion_N21[0]) @ 98.0CELSIUS @ 600.0SECOND
	heat(ddEmulsion_N21[0]) @ 4.0CELSIUS @ 3600.0SECOND
	heat(ddEmulsion_RnaseP1[0]) @ 25.0CELSIUS @ 120.0SECOND
	heat(ddEmulsion_RnaseP1[0]) @ 50.0CELSIUS @ 3600.0SECOND
	heat(ddEmulsion_RnaseP1[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(ddEmulsion_RnaseP1[0]) @ 55.0CELSIUS @ 2700.0SECOND
	heat(ddEmulsion_RnaseP1[0]) @ 98.0CELSIUS @ 600.0SECOND
	heat(ddEmulsion_RnaseP1[0]) @ 4.0CELSIUS @ 3600.0SECOND
