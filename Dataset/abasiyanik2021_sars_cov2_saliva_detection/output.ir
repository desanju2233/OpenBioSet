bsbbif_2_t:
	dispose(rtPCR_rxn_N11[0])
	dispose(rtPCR_rxn_N21[0])
	dispose(rtPCR_rxn_RnaseP1[0])
bsbbif_3_f:
	dispose(rtPCR_rxn_N11[0])
	dispose(rtPCR_rxn_N21[0])
	dispose(rtPCR_rxn_RnaseP1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(rtPCR_N1_Signal1[0])
	dispose(rtPCR_N2_Signal1[0])
	dispose(rtPCR_RnaseP_Signal1[0])
