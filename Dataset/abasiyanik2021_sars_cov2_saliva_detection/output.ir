	ddPCR_N2_Signal1[0] = detect(ddPCR_N2_Detection, ddEmulsion_N21[0]) @ 30.0SECOND
	ddPCR_RnaseP_Signal1[0] = detect(ddPCR_RnaseP_Detection, ddEmulsion_RnaseP1[0]) @ 30.0SECOND
	if ddPCR_N1_Signal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	salivaSpecimen1[0] = dispense(SalivaSpecimen)
	trizolReagent1[0] = dispense(TrizolLS_Reagent)
	trizolLysate1[0] = mix(salivaSpecimen1[0], trizolReagent1[0]) @ 30.0SECOND
	chloroformVol1[0] = dispense(Chloroform)
	phaseMixture1[0] = mix(trizolLysate1[0], chloroformVol1[0]) @ 15.0SECOND
	heat(phaseMixture1[0]) @ 4.0CELSIUS @ 900.0SECOND
	aqueousPhase1[0] = dispense(RNaseFreeWater)
	isopropanolVol1[0] = dispense(Isopropanol)
	glycogenVol1[0] = dispense(Glycogen)
	rnaPrecipMix11[0] = mix(phaseMixture1[0], isopropanolVol1[0]) @ 10.0SECOND
	rnaPrecipMix21[0] = mix(rnaPrecipMix11[0], glycogenVol1[0]) @ 10.0SECOND
	heat(rnaPrecipMix21[0]) @ 4.0CELSIUS @ 43200.0SECOND
	heat(rnaPrecipMix21[0]) @ 4.0CELSIUS @ 600.0SECOND
	ethanolWash1[0] = dispense(Ethanol_75pct)
	rnaEthanolWash1[0] = mix(rnaPrecipMix21[0], ethanolWash1[0]) @ 30.0SECOND
	heat(rnaEthanolWash1[0]) @ 4.0CELSIUS @ 300.0SECOND
	heat(rnaEthanolWash1[0]) @ 25.0CELSIUS @ 600.0SECOND
	rnaseFreWater21[0] = dispense(RNaseFreeWater)
	rnaExtract1[0] = mix(rnaEthanolWash1[0], rnaseFreWater21[0]) @ 120.0SECOND
	qubitReagent1[0] = dispense(QubitRNA_HS_Reagent)
	rnaQcMix1[0] = mix(rnaExtract1[0], qubitReagent1[0]) @ 120.0SECOND
	rnaQcSignal1[0] = detect(ddPCR_RnaseP_Detection, rnaQcMix1[0]) @ 30.0SECOND
	dispose(rnaQcMix1[0])
	rnaAliquot_rtN11[0] = dispense(SalivaSpecimen)
	rnaAliquot_rtN21[0] = dispense(SalivaSpecimen)
	rnaAliquot_rtRnaseP1[0] = dispense(SalivaSpecimen)
	masterMix_N11[0] = dispense(TaqPath_MasterMix)
	masterMix_N21[0] = dispense(TaqPath_MasterMix)
	masterMix_RnaseP1[0] = dispense(TaqPath_MasterMix)
	primerSet_N11[0] = dispense(N1_ProbePrimerSet)
	primerSet_N21[0] = dispense(N2_ProbePrimerSet)
	primerSet_RnaseP1[0] = dispense(RnaseP_ProbePrimerSet)
	rtDye_N11[0] = dispense(PrecisionBlue_RTDye)
	rtDye_N21[0] = dispense(PrecisionBlue_RTDye)
	rtDye_RnaseP1[0] = dispense(PrecisionBlue_RTDye)
	rtPCR_rxn_N1_step11[0] = mix(masterMix_N11[0], primerSet_N11[0]) @ 5.0SECOND
	rtPCR_rxn_N1_step21[0] = mix(rtPCR_rxn_N1_step11[0], rtDye_N11[0]) @ 5.0SECOND
	rtPCR_rxn_N11[0] = mix(rtPCR_rxn_N1_step21[0], rnaAliquot_rtN11[0]) @ 10.0SECOND
	rtPCR_rxn_N2_step11[0] = mix(masterMix_N21[0], primerSet_N21[0]) @ 5.0SECOND
	rtPCR_rxn_N2_step21[0] = mix(rtPCR_rxn_N2_step11[0], rtDye_N21[0]) @ 5.0SECOND
	rtPCR_rxn_N21[0] = mix(rtPCR_rxn_N2_step21[0], rnaAliquot_rtN21[0]) @ 10.0SECOND
	rtPCR_rxn_RnaseP_step11[0] = mix(masterMix_RnaseP1[0], primerSet_RnaseP1[0]) @ 5.0SECOND
	rtPCR_rxn_RnaseP_step21[0] = mix(rtPCR_rxn_RnaseP_step11[0], rtDye_RnaseP1[0]) @ 5.0SECOND
	rtPCR_rxn_RnaseP1[0] = mix(rtPCR_rxn_RnaseP_step21[0], rnaAliquot_rtRnaseP1[0]) @ 10.0SECOND
	heat(rtPCR_rxn_N11[0]) @ 25.0CELSIUS @ 120.0SECOND
	heat(rtPCR_rxn_N11[0]) @ 50.0CELSIUS @ 900.0SECOND
	heat(rtPCR_rxn_N11[0]) @ 95.0CELSIUS @ 120.0SECOND
	heat(rtPCR_rxn_N11[0]) @ 55.0CELSIUS @ 2700.0SECOND
	heat(rtPCR_rxn_N21[0]) @ 25.0CELSIUS @ 120.0SECOND
	heat(rtPCR_rxn_N21[0]) @ 50.0CELSIUS @ 900.0SECOND
	heat(rtPCR_rxn_N21[0]) @ 95.0CELSIUS @ 120.0SECOND
	heat(rtPCR_rxn_N21[0]) @ 55.0CELSIUS @ 2700.0SECOND
	heat(rtPCR_rxn_RnaseP1[0]) @ 25.0CELSIUS @ 120.0SECOND
	heat(rtPCR_rxn_RnaseP1[0]) @ 50.0CELSIUS @ 900.0SECOND
	heat(rtPCR_rxn_RnaseP1[0]) @ 95.0CELSIUS @ 120.0SECOND
	heat(rtPCR_rxn_RnaseP1[0]) @ 55.0CELSIUS @ 2700.0SECOND
	rtPCR_N1_Signal1[0] = detect(rtPCR_N1_Detection, rtPCR_rxn_N11[0]) @ 30.0SECOND
	rtPCR_N2_Signal1[0] = detect(rtPCR_N2_Detection, rtPCR_rxn_N21[0]) @ 30.0SECOND
	rtPCR_RnaseP_Signal1[0] = detect(rtPCR_RnaseP_Detection, rtPCR_rxn_RnaseP1[0]) @ 30.0SECOND
	if rtPCR_N1_Signal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(ddEmulsion_N11[0])
	dispose(ddEmulsion_N21[0])
	dispose(ddEmulsion_RnaseP1[0])
bsbbif_6_f:
