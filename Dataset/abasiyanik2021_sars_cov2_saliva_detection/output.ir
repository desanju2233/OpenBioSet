	ddPCR_rxn_N1_step21[0] = mix(ddPCR_rxn_N1_step11[0], ddPrimerSet_N11[0]) @ 5.0SECOND
	ddPCR_rxn_N11[0] = mix(ddPCR_rxn_N1_step21[0], rnaAliquot_ddN11[0]) @ 10.0SECOND
	ddPCR_rxn_N2_step11[0] = mix(ddSupermix_N21[0], ddRT_DTT_N21[0]) @ 5.0SECOND
	ddPCR_rxn_N2_step21[0] = mix(ddPCR_rxn_N2_step11[0], ddPrimerSet_N21[0]) @ 5.0SECOND
	ddPCR_rxn_N21[0] = mix(ddPCR_rxn_N2_step21[0], rnaAliquot_ddN21[0]) @ 10.0SECOND
	ddPCR_rxn_RnaseP_step11[0] = mix(ddSupermix_RnaseP1[0], ddRT_DTT_RnaseP1[0]) @ 5.0SECOND
	ddPCR_rxn_RnaseP_step21[0] = mix(ddPCR_rxn_RnaseP_step11[0], ddPrimerSet_RnaseP1[0]) @ 5.0SECOND
	ddPCR_rxn_RnaseP1[0] = mix(ddPCR_rxn_RnaseP_step21[0], rnaAliquot_ddRnaseP1[0]) @ 10.0SECOND
	ddOil_N11[0] = dispense(DropletGeneratorOil)
	ddOil_N21[0] = dispense(DropletGeneratorOil)
	ddOil_RnaseP1[0] = dispense(DropletGeneratorOil)
