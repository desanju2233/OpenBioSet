bsbbif_2_t:
	dispose(il6ReactionMix1[0])
bsbbif_3_f:
	dispose(il6ReactionMix1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(il6Signal1[0])
	plasmaSampleTNFa1[0] = dispense(HumanPlasma_Sample)
	hmbBuffer1[0] = dispense(HMB_Buffer)
	dilutedSampleTNFa1[0] = mix(plasmaSampleTNFa1[0], hmbBuffer1[0]) @ 5.0SECOND
	tnfaProbeA1[0] = dispense(TNFa_ProximalProbeA)
	tnfaProbeB1[0] = dispense(TNFa_ProximalProbeB)
	tnfaProbesMix1[0] = mix(tnfaProbeA1[0], tnfaProbeB1[0]) @ 5.0SECOND
	tnfaProbeSample1[0] = mix(dilutedSampleTNFa1[0], tnfaProbesMix1[0]) @ 5.0SECOND
	heat(tnfaProbeSample1[0]) @ 4.0CELSIUS @ 43200.0SECOND
	ligationSolutionTNFa1[0] = dispense(LigationSolution)
	tnfaLigationMix1[0] = mix(tnfaProbeSample1[0], ligationSolutionTNFa1[0]) @ 5.0SECOND
	heat(tnfaLigationMix1[0]) @ 37.0CELSIUS @ 600.0SECOND
	heat(tnfaLigationMix1[0]) @ 37.0CELSIUS @ 600.0SECOND
	heat(tnfaLigationMix1[0]) @ 95.0CELSIUS @ 900.0SECOND
	ddpcrSupermixTNFa1[0] = dispense(ddPCR_Supermix)
	universalPCRTNFa1[0] = dispense(Universal_PCR_Assay)
	tnfaddPCRMix1[0] = mix(tnfaLigationMix1[0], ddpcrSupermixTNFa1[0]) @ 5.0SECOND
	tnfaReactionMix1[0] = mix(tnfaddPCRMix1[0], universalPCRTNFa1[0]) @ 5.0SECOND
	heat(tnfaReactionMix1[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(tnfaReactionMix1[0]) @ 94.0CELSIUS @ 3600.0SECOND
	heat(tnfaReactionMix1[0]) @ 98.0CELSIUS @ 600.0SECOND
	tnfaSignal1[0] = detect(dplaDetection, tnfaReactionMix1[0]) @ 600.0SECOND
	if tnfaSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	plasmaOrBALF1[0] = dispense(HumanPlasma_Sample)
	pbsForExtraction1[0] = dispense(PBS)
	extractionKit1[0] = dispense(DNA_ExtractionKit)
	lysateMix1[0] = mix(plasmaOrBALF1[0], pbsForExtraction1[0]) @ 5.0SECOND
	extractedLysate1[0] = mix(lysateMix1[0], extractionKit1[0]) @ 900.0SECOND
	avEluent1[0] = dispense(NucleaseFreeWater)
	extractedDNA1[0] = mix(extractedLysate1[0], avEluent1[0]) @ 60.0SECOND
	plasmaSampleIL61[0] = dispense(HumanPlasma_Sample)
	sdbIIBuffer1[0] = dispense(SDB_II_Buffer)
	dilutedSampleIL61[0] = mix(plasmaSampleIL61[0], sdbIIBuffer1[0]) @ 5.0SECOND
	il6ProbeA1[0] = dispense(IL6_ProximalProbeA)
	il6ProbeB1[0] = dispense(IL6_ProximalProbeB)
	il6ProbesMix1[0] = mix(il6ProbeA1[0], il6ProbeB1[0]) @ 5.0SECOND
	il6ProbeSample1[0] = mix(dilutedSampleIL61[0], il6ProbesMix1[0]) @ 5.0SECOND
	heat(il6ProbeSample1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	ligationSolutionIL61[0] = dispense(LigationSolution)
	il6LigationMix1[0] = mix(il6ProbeSample1[0], ligationSolutionIL61[0]) @ 5.0SECOND
	heat(il6LigationMix1[0]) @ 37.0CELSIUS @ 600.0SECOND
	heat(il6LigationMix1[0]) @ 95.0CELSIUS @ 300.0SECOND
	ddpcrSupermixIL61[0] = dispense(ddPCR_Supermix)
	universalPCRIL61[0] = dispense(Universal_PCR_Assay)
	il6ddPCRMix1[0] = mix(il6LigationMix1[0], ddpcrSupermixIL61[0]) @ 5.0SECOND
	il6ReactionMix1[0] = mix(il6ddPCRMix1[0], universalPCRIL61[0]) @ 5.0SECOND
	heat(il6ReactionMix1[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(il6ReactionMix1[0]) @ 94.0CELSIUS @ 3600.0SECOND
	heat(il6ReactionMix1[0]) @ 98.0CELSIUS @ 600.0SECOND
	il6Signal1[0] = detect(dplaDetection, il6ReactionMix1[0]) @ 600.0SECOND
	if il6Signal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(tnfaReactionMix1[0])
bsbbif_6_f:
	dispose(tnfaReactionMix1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(tnfaSignal1[0])
	gnPrimersProbe1[0] = dispense(GN_16S_Primers_Probe)
	gpPrimersProbe1[0] = dispense(GP_16S_Primers_Probe)
	blatEmPrimersProbe1[0] = dispense(blaTEM_Primers_Probe)
	ddpcrSupermixDNA1[0] = dispense(ddPCR_Supermix)
	primersMix1[0] = mix(gnPrimersProbe1[0], gpPrimersProbe1[0]) @ 5.0SECOND
	allPrimersMix1[0] = mix(primersMix1[0], blatEmPrimersProbe1[0]) @ 5.0SECOND
	dnaReactionBase1[0] = mix(ddpcrSupermixDNA1[0], allPrimersMix1[0]) @ 5.0SECOND
	triplexReactionMix1[0] = mix(dnaReactionBase1[0], extractedDNA1[0]) @ 5.0SECOND
	heat(triplexReactionMix1[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(triplexReactionMix1[0]) @ 94.0CELSIUS @ 3600.0SECOND
	heat(triplexReactionMix1[0]) @ 98.0CELSIUS @ 600.0SECOND
	ddpcrSignal1[0] = detect(ddpcrDetection, triplexReactionMix1[0]) @ 600.0SECOND
	if ddpcrSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	classifierSignal1[0] = detect(decisionTreeClassification, ddpcrSignal1[0]) @ 30.0SECOND
	if classifierSignal1[0] > 0	|	true: jump bsbbif_11_t	|	false: jump bsbbif_12_f
bsbbif_9_f:
	dispose(triplexReactionMix1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(ddpcrSignal1[0])
	NOP
bsbbif_11_t:
	dispose(triplexReactionMix1[0])
bsbbif_12_f:
	dispose(triplexReactionMix1[0])
	jump: bsbbif_13_j
bsbbif_13_j:
	dispose(classifierSignal1[0])
	jump: bsbbif_10_j
