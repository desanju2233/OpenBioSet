bsbbif_2_t:
	sortedTargetDroplets1[0] = mix(targetCellDroplets1[0], oilPhase11[0]) @ 1.0SECOND
bsbbif_3_f:
	dispose(targetCellDroplets1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	PHI targetCellDroplets2 = {targetCellDroplets1,targetCellDroplets}
	PHI sortedTargetDroplets2 = {sortedTargetDroplets1,sortedTargetDroplets}
	dispose(sortSignal1[0])
	hybridoamCells_raw1[0] = dispense(HybridomaCells)
	calceinStain1[0] = dispense(CalceinAM_RedOrange)
	stainedHybridoma1[0] = mix(hybridoamCells_raw1[0], calceinStain1[0]) @ 5.0SECOND
	heat(stainedHybridoma1[0]) @ 37.0CELSIUS @ 1200.0SECOND
	washPBS21[0] = dispense(PBS)
