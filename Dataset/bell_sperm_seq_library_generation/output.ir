bsbbif_2_t:
	dispose(stainedSperm1[0])
bsbbif_3_f:
	dispose(stainedSperm1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(spermCountSignal1[0])
	dilutionWater1[0] = dispense(UltrapureWater)
	spermDiluted1[0] = mix(spermDecondensed1[0], dilutionWater1[0]) @ 30.0SECOND
	reagentMix1[0] = dispense(GemCodeReagentMix)
	primerAgent1[0] = dispense(PrimerReleaseAgent)
	polymerase1[0] = dispense(GemCodePolymerase)
	mmWater1[0] = dispense(UltrapureWater)
	mmStep11[0] = mix(reagentMix1[0], primerAgent1[0]) @ 5.0SECOND
	mmStep21[0] = mix(mmStep11[0], polymerase1[0]) @ 5.0SECOND
	masterMix1[0] = mix(mmStep21[0], mmWater1[0]) @ 10.0SECOND
	spermMasterMix1[0] = mix(spermDiluted1[0], masterMix1[0]) @ 30.0SECOND
	gemBeads1[0] = dispense(GemCodeBeads)
	beadDilWater11[0] = dispense(UltrapureWater)
	beadDilWater21[0] = dispense(UltrapureWater)
	beadMix11[0] = mix(gemBeads1[0], beadDilWater11[0]) @ 25.0SECOND
	beadsDiluted1[0] = mix(beadMix11[0], beadDilWater21[0]) @ 10.0SECOND
	dropletOil1[0] = dispense(DropletGenerationOil)
	chipInput11[0] = mix(spermMasterMix1[0], beadsDiluted1[0]) @ 10.0SECOND
	chipLoaded1[0] = mix(chipInput11[0], dropletOil1[0]) @ 10.0SECOND
	heat(chipLoaded1[0]) @ 37.0CELSIUS @ 10800.0SECOND
	libraryQCSignal1[0] = detect(libraryQCDetection, chipLoaded1[0]) @ 30.0SECOND
	if libraryQCSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	spermRaw1[0] = dispense(SpermAliquot)
	pbsWash11[0] = dispense(PBS)
	spermPellet11[0] = mix(spermRaw1[0], pbsWash11[0]) @ 30.0SECOND
	heat(spermPellet11[0]) @ 4.0CELSIUS @ 600.0SECOND
	pbsWash21[0] = dispense(PBS)
	spermPellet21[0] = mix(spermPellet11[0], pbsWash21[0]) @ 30.0SECOND
	heat(spermPellet21[0]) @ 4.0CELSIUS @ 600.0SECOND
	bufferSMT1[0] = dispense(BufferSMT)
	spermInSMT1[0] = mix(spermPellet21[0], bufferSMT1[0]) @ 30.0SECOND
	heat(spermInSMT1[0]) @ 4.0CELSIUS @ 10.0SECOND
	heat(spermInSMT1[0]) @ 37.0CELSIUS @ 30.0SECOND
	heat(spermInSMT1[0]) @ 4.0CELSIUS @ 10.0SECOND
	heat(spermInSMT1[0]) @ 37.0CELSIUS @ 30.0SECOND
	heat(spermInSMT1[0]) @ 4.0CELSIUS @ 10.0SECOND
	heat(spermInSMT1[0]) @ 37.0CELSIUS @ 30.0SECOND
	bufferDBBase1[0] = dispense(BufferDB_Base)
	heparinStock1[0] = dispense(Heparin_10mM)
	bufferDBHep1[0] = mix(bufferDBBase1[0], heparinStock1[0]) @ 10.0SECOND
	bmeStock1[0] = dispense(BME_100mM)
	bufferDBReady1[0] = mix(bufferDBHep1[0], bmeStock1[0]) @ 10.0SECOND
	spermDecondensing1[0] = mix(spermInSMT1[0], bufferDBReady1[0]) @ 30.0SECOND
	heat(spermDecondensing1[0]) @ 37.0CELSIUS @ 2700.0SECOND
	heparinaseEnz1[0] = dispense(Heparinase)
	spermDecondensed1[0] = mix(spermDecondensing1[0], heparinaseEnz1[0]) @ 10.0SECOND
	heat(spermDecondensed1[0]) @ 25.0CELSIUS @ 7200.0SECOND
	sybrGreen1[0] = dispense(SYBRGreenI_10X)
	pbsForStain1[0] = dispense(PBS)
	sybrDiluent1[0] = mix(sybrGreen1[0], pbsForStain1[0]) @ 10.0SECOND
	countAliquot1[0] = dispense(SpermCountAliquot_Decondensed)
	stainedSperm1[0] = mix(countAliquot1[0], sybrDiluent1[0]) @ 420.0SECOND
	spermCountSignal1[0] = detect(spermCountDetection, stainedSperm1[0]) @ 300.0SECOND
	if spermCountSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(chipLoaded1[0])
bsbbif_6_f:
	dispose(chipLoaded1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(libraryQCSignal1[0])
	NOP
