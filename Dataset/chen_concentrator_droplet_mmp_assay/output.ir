bsbbif_2_t:
	dispose(dropletHigh1[0])
	dispose(dropletMid1[0])
	dispose(dropletLow1[0])
bsbbif_3_f:
	dispose(dropletHigh1[0])
	dispose(dropletMid1[0])
	dispose(dropletLow1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(assaySignal1[0])
	dispose(tracerSignal1[0])
	cellBufStim1[0] = dispense(MMPBuffer)
	cellBufUntrt1[0] = dispense(MMPBuffer)
	tracerStim1[0] = dispense(AlexaFluor546_Tracer)
	tracerUntrt1[0] = dispense(AlexaFluor546_Tracer)
	stimSample1[0] = dispense(CellularSupernatant_Stimulated)
	untrtSample1[0] = dispense(CellularSupernatant_Untreated)
	stimStream1[0] = mix(stimSample1[0], tracerStim1[0]) @ 5.0SECOND
	stimStream2[0] = mix(stimStream1[0], cellBufStim1[0]) @ 5.0SECOND
	untrtStream1[0] = mix(untrtSample1[0], tracerUntrt1[0]) @ 5.0SECOND
	untrtStream2[0] = mix(untrtStream1[0], cellBufUntrt1[0]) @ 5.0SECOND
	bufCellLeft11[0] = dispense(PBS)
	bufCellRight11[0] = dispense(PBS)
	bufCellLeft21[0] = dispense(PBS)
	bufCellRight21[0] = dispense(PBS)
	stimJunction1[0] = mix(stimStream2[0], bufCellLeft11[0]) @ 5.0SECOND
	stimConcIn1[0] = mix(stimJunction1[0], bufCellRight11[0]) @ 5.0SECOND
	heat(stimConcIn1[0]) @ 25.0CELSIUS @ 600.0SECOND
	untrtJunction1[0] = mix(untrtStream2[0], bufCellLeft21[0]) @ 5.0SECOND
	untrtConcIn1[0] = mix(untrtJunction1[0], bufCellRight21[0]) @ 5.0SECOND
	heat(untrtConcIn1[0]) @ 25.0CELSIUS @ 600.0SECOND
	subStim1[0] = dispense(FRET_MMP_Substrate)
	subUntrt1[0] = dispense(FRET_MMP_Substrate)
	oilStim1[0] = dispense(HFE7500_FluorocarbonOil)
	oilUntrt1[0] = dispense(HFE7500_FluorocarbonOil)
	surfStim1[0] = dispense(FluorocarbonSurfactant)
	surfUntrt1[0] = dispense(FluorocarbonSurfactant)
	stimAssayMix1[0] = mix(stimConcIn1[0], subStim1[0]) @ 5.0SECOND
	oilPhaseStim1[0] = mix(oilStim1[0], surfStim1[0]) @ 5.0SECOND
	dropletStim1[0] = mix(stimAssayMix1[0], oilPhaseStim1[0]) @ 2.0SECOND
	untrtAssayMix1[0] = mix(untrtConcIn1[0], subUntrt1[0]) @ 5.0SECOND
	oilPhaseUntrt1[0] = mix(oilUntrt1[0], surfUntrt1[0]) @ 5.0SECOND
	dropletUntrt1[0] = mix(untrtAssayMix1[0], oilPhaseUntrt1[0]) @ 2.0SECOND
	heat(dropletStim1[0]) @ 37.0CELSIUS @ 300.0SECOND
	heat(dropletUntrt1[0]) @ 37.0CELSIUS @ 300.0SECOND
	cellSignal1[0] = detect(mmpActivityDetection, dropletStim1[0]) @ 300.0SECOND
	if cellSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	primingPBS1[0] = dispense(PBS)
	primingPluronic1[0] = dispense(PluronicF127)
	primingMix1[0] = mix(primingPBS1[0], primingPluronic1[0]) @ 300.0SECOND
	mmpBuffer1[0] = dispense(MMPBuffer)
	mmp9Enzyme1[0] = dispense(MMP9_Enzyme)
	tracerDye1[0] = dispense(AlexaFluor546_Tracer)
	enzymeSample1[0] = mix(mmp9Enzyme1[0], tracerDye1[0]) @ 5.0SECOND
	enzymeStream1[0] = mix(enzymeSample1[0], mmpBuffer1[0]) @ 5.0SECOND
	substrateLeft1[0] = dispense(FRET_MMP_Substrate)
	substrateRight1[0] = dispense(FRET_MMP_Substrate)
	bufferSideLeft1[0] = dispense(PBS)
	bufferSideRight1[0] = dispense(PBS)
	junctionMix1[0] = mix(enzymeStream1[0], bufferSideLeft1[0]) @ 5.0SECOND
	concentratorIn1[0] = mix(junctionMix1[0], bufferSideRight1[0]) @ 5.0SECOND
	heat(concentratorIn1[0]) @ 25.0CELSIUS @ 600.0SECOND
	assayMixLeft1[0] = mix(concentratorIn1[0], substrateLeft1[0]) @ 5.0SECOND
	assayMixFull1[0] = mix(assayMixLeft1[0], substrateRight1[0]) @ 5.0SECOND
	oilCarrier1[0] = dispense(HFE7500_FluorocarbonOil)
	surfactantOil1[0] = dispense(FluorocarbonSurfactant)
	carrierPhase1[0] = mix(oilCarrier1[0], surfactantOil1[0]) @ 5.0SECOND
	dropletHigh1[0] = mix(assayMixFull1[0], carrierPhase1[0]) @ 2.0SECOND
	assayMidSample1[0] = dispense(MMP9_Enzyme)
	assayMidTracer1[0] = dispense(AlexaFluor546_Tracer)
	assayMidBuf1[0] = dispense(MMPBuffer)
	assayMidSub1[0] = dispense(FRET_MMP_Substrate)
	assayMidOil1[0] = dispense(HFE7500_FluorocarbonOil)
	midEnzyme1[0] = mix(assayMidSample1[0], assayMidTracer1[0]) @ 5.0SECOND
	midAssay1[0] = mix(midEnzyme1[0], assayMidBuf1[0]) @ 5.0SECOND
	midMix1[0] = mix(midAssay1[0], assayMidSub1[0]) @ 5.0SECOND
	dropletMid1[0] = mix(midMix1[0], assayMidOil1[0]) @ 2.0SECOND
	assayLowSample1[0] = dispense(MMP9_Enzyme)
	assayLowTracer1[0] = dispense(AlexaFluor546_Tracer)
	assayLowBuf1[0] = dispense(MMPBuffer)
	assayLowSub1[0] = dispense(FRET_MMP_Substrate)
	assayLowOil1[0] = dispense(HFE7500_FluorocarbonOil)
	lowEnzyme1[0] = mix(assayLowSample1[0], assayLowTracer1[0]) @ 5.0SECOND
	lowAssay1[0] = mix(lowEnzyme1[0], assayLowBuf1[0]) @ 5.0SECOND
	lowMix1[0] = mix(lowAssay1[0], assayLowBuf1[0]) @ 5.0SECOND
	dropletLow1[0] = mix(lowMix1[0], assayLowOil1[0]) @ 2.0SECOND
	heat(dropletHigh1[0]) @ 37.0CELSIUS @ 2100.0SECOND
	heat(dropletMid1[0]) @ 37.0CELSIUS @ 2100.0SECOND
	heat(dropletLow1[0]) @ 37.0CELSIUS @ 2100.0SECOND
	assaySignal1[0] = detect(mmpActivityDetection, dropletHigh1[0]) @ 2100.0SECOND
	tracerSignal1[0] = detect(tracerFluorescenceDetection, dropletHigh1[0]) @ 30.0SECOND
	if assaySignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(dropletStim1[0])
	dispose(dropletUntrt1[0])
bsbbif_6_f:
	dispose(dropletStim1[0])
	dispose(dropletUntrt1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(cellSignal1[0])
	NOP
