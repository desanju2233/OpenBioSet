bsbbif_2_t:
	dispose(particlesWashed1[0])
bsbbif_3_f:
	dispose(particlesWashed1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(washSignal1[0])
	conjugateDrop1[0] = dispense(HRP_AntiTSH_Conjugate)
	conjugateIncub1[0] = mix(wash4a1[0], conjugateDrop1[0]) @ 120.0SECOND
	cwash1a1[0] = dispense(WashBuffer)
	cwash1b1[0] = mix(conjugateIncub1[0], cwash1a1[0]) @ 30.0SECOND
	cwashSup11[0] = dispense(WashBuffer)
	cwash1c1[0] = mix(cwash1b1[0], cwashSup11[0]) @ 10.0SECOND
	dispose(cwash1c1[0])
	cwash2a1[0] = dispense(WashBuffer)
	cwash2b1[0] = mix(cwash1a1[0], cwash2a1[0]) @ 30.0SECOND
	cwashSup21[0] = dispense(WashBuffer)
	cwash2c1[0] = mix(cwash2b1[0], cwashSup21[0]) @ 10.0SECOND
	dispose(cwash2c1[0])
	cwash3a1[0] = dispense(WashBuffer)
	cwash3b1[0] = mix(cwash2a1[0], cwash3a1[0]) @ 30.0SECOND
	cwashSup31[0] = dispense(WashBuffer)
	cwash3c1[0] = mix(cwash3b1[0], cwashSup31[0]) @ 10.0SECOND
	dispose(cwash3c1[0])
	cwash4a1[0] = dispense(WashBuffer)
	cwash4b1[0] = mix(cwash3a1[0], cwash4a1[0]) @ 30.0SECOND
	cwashSup41[0] = dispense(WashBuffer)
	cwash4c1[0] = mix(cwash4b1[0], cwashSup41[0]) @ 10.0SECOND
	dispose(cwash4c1[0])
	h2o2Drop1[0] = dispense(H2O2_StablePeroxide)
	particlesInH2O21[0] = mix(cwash4a1[0], h2o2Drop1[0]) @ 10.0SECOND
	luminolDrop1[0] = dispense(LuminolEnhancer)
	substratePool1[0] = mix(particlesInH2O21[0], luminolDrop1[0]) @ 240.0SECOND
	detectionSignal1[0] = detect(chemiluminescenceDetection, substratePool1[0]) @ 10.0SECOND
	if detectionSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	particleDrop1[0] = dispense(ParamagneticParticles)
	tsh11[0] = dispense(TSH_Standard)
	tsh21[0] = dispense(TSH_Standard)
	tsh31[0] = dispense(TSH_Standard)
	tsh41[0] = dispense(TSH_Standard)
	tsh51[0] = dispense(TSH_Standard)
	tshPool_21[0] = mix(tsh11[0], tsh21[0]) @ 5.0SECOND
	tshPool_31[0] = mix(tshPool_21[0], tsh31[0]) @ 5.0SECOND
	tshPool_41[0] = mix(tshPool_31[0], tsh41[0]) @ 5.0SECOND
	tshSample1[0] = mix(tshPool_41[0], tsh51[0]) @ 5.0SECOND
	sampleIncubation1[0] = mix(tshSample1[0], particleDrop1[0]) @ 180.0SECOND
	wash1a1[0] = dispense(WashBuffer)
	wash1b1[0] = mix(sampleIncubation1[0], wash1a1[0]) @ 30.0SECOND
	washSup11[0] = dispense(WashBuffer)
	wash1c1[0] = mix(wash1b1[0], washSup11[0]) @ 10.0SECOND
	dispose(wash1c1[0])
	wash2a1[0] = dispense(WashBuffer)
	wash2b1[0] = mix(wash1a1[0], wash2a1[0]) @ 30.0SECOND
	washSup21[0] = dispense(WashBuffer)
	wash2c1[0] = mix(wash2b1[0], washSup21[0]) @ 10.0SECOND
	dispose(wash2c1[0])
	wash3a1[0] = dispense(WashBuffer)
	wash3b1[0] = mix(wash2a1[0], wash3a1[0]) @ 30.0SECOND
	washSup31[0] = dispense(WashBuffer)
	wash3c1[0] = mix(wash3b1[0], washSup31[0]) @ 10.0SECOND
	dispose(wash3c1[0])
	wash4a1[0] = dispense(WashBuffer)
	wash4b1[0] = mix(wash3a1[0], wash4a1[0]) @ 30.0SECOND
	washSup41[0] = dispense(WashBuffer)
	particlesWashed1[0] = mix(wash4b1[0], washSup41[0]) @ 10.0SECOND
	washSignal1[0] = detect(chemiluminescenceDetection, particlesWashed1[0]) @ 5.0SECOND
	if washSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(substratePool1[0])
bsbbif_6_f:
	dispose(substratePool1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(detectionSignal1[0])
	NOP
