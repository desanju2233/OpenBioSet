bsbbif_2_t:
	dispose(gelRunReady1[0])
bsbbif_3_f:
	dispose(gelRunReady1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(gelSignal1[0])
	fwdPrimer1001[0] = dispense(ForwardPrimer_100uM)
	revPrimer1001[0] = dispense(ReversePrimer_100uM)
	targetProbeFAM1[0] = dispense(TargetProbe_FAM)
	h2o_probe1[0] = dispense(RNaseDNaseFreeH2O)
	probeStep11[0] = mix(fwdPrimer1001[0], revPrimer1001[0]) @ 15.0SECOND
	probeStep21[0] = mix(probeStep11[0], targetProbeFAM1[0]) @ 15.0SECOND
	targetPrimersProbe1[0] = mix(probeStep21[0], h2o_probe1[0]) @ 15.0SECOND
	ddpcrSupermix1[0] = dispense(ddPCR_Supermix_NoUTP)
	refPrimersHEX1[0] = dispense(ReferencePrimersProbe_HEX)
	h2o_ddpcr1[0] = dispense(RNaseDNaseFreeH2O)
	dnaSample1[0] = dispense(Cells)
	extractSoln21[0] = dispense(QuickExtract)
	pbsWash21[0] = dispense(PBS)
	washedCells21[0] = mix(dnaSample1[0], pbsWash21[0]) @ 15.0SECOND
	dispose(pbsWash21[0])
	rawDNA1[0] = mix(washedCells21[0], extractSoln21[0]) @ 15.0SECOND
	heat(rawDNA1[0]) @ 65.0CELSIUS @ 360.0SECOND
	heat(rawDNA1[0]) @ 25.0CELSIUS @ 15.0SECOND
	heat(rawDNA1[0]) @ 98.0CELSIUS @ 120.0SECOND
	ddmmStep11[0] = mix(ddpcrSupermix1[0], targetPrimersProbe1[0]) @ 15.0SECOND
	ddmmStep21[0] = mix(ddmmStep11[0], refPrimersHEX1[0]) @ 15.0SECOND
	ddmmStep31[0] = mix(ddmmStep21[0], h2o_ddpcr1[0]) @ 15.0SECOND
	ddpcrReaction1[0] = mix(ddmmStep31[0], rawDNA1[0]) @ 15.0SECOND
	genOil1[0] = dispense(GenerationOil)
	dropletEmulsion1[0] = mix(ddpcrReaction1[0], genOil1[0]) @ 60.0SECOND
	foilSeal1[0] = dispense(FoilSealSheet)
	sealedPlate1[0] = mix(dropletEmulsion1[0], foilSeal1[0]) @ 30.0SECOND
	heat(sealedPlate1[0]) @ 180.0CELSIUS @ 5.0SECOND
	heat(sealedPlate1[0]) @ 94.0CELSIUS @ 600.0SECOND
	heat(sealedPlate1[0]) @ 94.0CELSIUS @ 30.0SECOND
	heat(sealedPlate1[0]) @ 57.0CELSIUS @ 60.0SECOND
	heat(sealedPlate1[0]) @ 98.0CELSIUS @ 600.0SECOND
	heat(sealedPlate1[0]) @ 4.0CELSIUS @ 1.0SECOND
	heat(sealedPlate1[0]) @ 25.0CELSIUS @ 120.0SECOND
	ddpcrSignal1[0] = detect(dropletReadoutDetection, sealedPlate1[0]) @ 1800.0SECOND
	if ddpcrSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	cellSample1[0] = dispense(Cells)
	pbsWash1[0] = dispense(PBS)
	quickExtractSoln1[0] = dispense(QuickExtract)
	washedCells1[0] = mix(cellSample1[0], pbsWash1[0]) @ 15.0SECOND
	dispose(pbsWash1[0])
	scrapedCells1[0] = mix(washedCells1[0], quickExtractSoln1[0]) @ 15.0SECOND
	heat(scrapedCells1[0]) @ 65.0CELSIUS @ 360.0SECOND
	heat(scrapedCells1[0]) @ 25.0CELSIUS @ 15.0SECOND
	heat(scrapedCells1[0]) @ 98.0CELSIUS @ 120.0SECOND
	biomixRed1[0] = dispense(BioMixRed)
	dmso1[0] = dispense(DMSO)
	fwdPrimer1[0] = dispense(ForwardPrimer_10uM)
	revPrimer1[0] = dispense(ReversePrimer_10uM)
	h2o_pcr1[0] = dispense(RNaseDNaseFreeH2O)
	mmStep11[0] = mix(biomixRed1[0], dmso1[0]) @ 5.0SECOND
	mmStep21[0] = mix(mmStep11[0], fwdPrimer1[0]) @ 5.0SECOND
	mmStep31[0] = mix(mmStep21[0], revPrimer1[0]) @ 5.0SECOND
	masterMix1[0] = mix(mmStep31[0], h2o_pcr1[0]) @ 5.0SECOND
	pcrReaction1[0] = mix(masterMix1[0], scrapedCells1[0]) @ 5.0SECOND
	heat(pcrReaction1[0]) @ 94.0CELSIUS @ 180.0SECOND
	heat(pcrReaction1[0]) @ 94.0CELSIUS @ 30.0SECOND
	heat(pcrReaction1[0]) @ 57.0CELSIUS @ 30.0SECOND
	heat(pcrReaction1[0]) @ 72.0CELSIUS @ 60.0SECOND
	heat(pcrReaction1[0]) @ 72.0CELSIUS @ 300.0SECOND
	heat(pcrReaction1[0]) @ 4.0CELSIUS @ 1.0SECOND
	gelMatrix1[0] = dispense(AgaroseGel_1pct5to2pct)
	taeBuffer1[0] = dispense(TAE_Buffer_1X)
	sybrStain1[0] = dispense(SYBR_Safe_Stain)
	dnaLadder1[0] = dispense(DNALadder)
	gelInBuffer1[0] = mix(gelMatrix1[0], taeBuffer1[0]) @ 300.0SECOND
	gelWithStain1[0] = mix(gelInBuffer1[0], sybrStain1[0]) @ 30.0SECOND
	gelLoaded1[0] = mix(gelWithStain1[0], dnaLadder1[0]) @ 15.0SECOND
	gelRunReady1[0] = mix(gelLoaded1[0], pcrReaction1[0]) @ 15.0SECOND
	heat(gelRunReady1[0]) @ 25.0CELSIUS @ 2400.0SECOND
	gelSignal1[0] = detect(gelElectrophoresisDetection, gelRunReady1[0]) @ 300.0SECOND
	if gelSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(sealedPlate1[0])
bsbbif_6_f:
	dispose(sealedPlate1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(ddpcrSignal1[0])
	NOP
