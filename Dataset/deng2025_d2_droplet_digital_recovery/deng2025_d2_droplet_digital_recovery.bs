module fluorescenceActivatedDropletSorting
module singleBeadDetection
module singleCellGFPDetection
module antibodyBindingDetection
module viabilityDetection

manifest PBS
manifest DMEM_Complete
manifest IMDM_Complete
manifest IMDM_NoPhenolRed
manifest HFE7500_Surfactant
manifest OptiPrep
manifest GFP_HEK293_Cells
manifest WT_HEK293_Cells
manifest FluoroSpheres_10um
manifest CalceinAM_RedOrange
manifest CellTrace_Blue
manifest AlexaFluor488_AntiMouse
manifest HybridomaSpecific_Cells
manifest HybridomaNonSpecific_Cells
manifest TargetCells
manifest SYTOX_Blue
manifest ConditionedMedia_HEK
manifest RecoveryBuffer_PBS
manifest RecoveryBuffer_DMEM
manifest RecoveryBuffer_IMDM
manifest IL6_Supplement

// ============================================================
// Recovery of Phenotypically Sorted Cells Using
// Droplet-Digital Microfluidics
// Deng, Perry, Weiss, Genth, Autour, Merten, Shih
// Lab on a Chip, 2025, 25, 4410-4421
// DOI: 10.1039/d5lc00415b
//
// Platform: Droplet-Digital (D2) Microfluidic Device
//   - Three-layer device: Cr-electrode / PDMS dielectric /
//     PDMS channel layer
//   - Integrated flow-focusing droplet generator
//   - Fiber-optic PMT detection (470 nm excitation, ~520 nm
//     emission for GFP/beads; 488 nm for Alexa Fluor 488)
//   - DMF binary sorter (patterned electrodes beneath channel,
//     AC 140 Vrms, 15 kHz) -- significantly lower than
//     conventional DEP systems (200-1200 V)
//   - Semicircular open-access collection outlet (3 mm punch)
//   - On-demand 3 uL recovery buffer droplet generated by
//     500 uL gastight syringe at 1 uL/s
//   - Sorted 1 nL droplet merges with recovery buffer via
//     electrode actuation (3x, 500 ms/actuation)
//     after a 7-9 s delay post-sorting
//   - Merged contents manually pipetted (~5 uL P20) into
//     individual wells of a 96-well plate
//   - Droplet generation rate: ~50 Hz
//   - Monodisperse droplet size: ~1 nL
//   - Oil: 2% 008-fluoro-surfactant in HFE7500
//   - Oil flow rate: 0.15 uL/s
//   - Aqueous (cell/bead) flow rate: 0.05 uL/s
//   - Waste withdrawal: -0.15 uL/s
//
// THREE PROTOCOLS ARE ENCODED IN SEQUENCE:
//
// PROTOCOL 1: Single fluorescent bead recovery
//   - FluoSpheres 10 um blue-green (430/465) beads
//   - Sorting threshold: 7e3 to 2e4 photon counts
//   - Single recovery: 1 droplet -> 1 well (50 events)
//   - D2 mean single-bead recovery: ~87%
//   - D2 pooled recovery: ~93.5% (vs 78.5% tubing)
//   - D2 SD: 5.29% (vs 26.1% for tubing)
//
// PROTOCOL 2: Low-input rare single GFP HEK293 cell recovery
//   - GFP:WT spiked ratios of 1:400 and 1:1000
//   - Total cell inputs: 1e4 and 1e5
//   - Sorting threshold: 1e3 to 2.5e3 photon counts
//   - D2 recovery rates: >80% across all conditions
//   - Post-sort viability: ~90% over 7 days
//   - Cells exhibit spreading (positive viability indicator)
//
// PROTOCOL 3: Rare specific-antibody-secreting hybridoma
//   cell screening and recovery (antibody discovery assay)
//   - Two hybridoma lines: specific-Ab producer (calcein-AM
//     red-orange stained) and non-specific-Ab producer
//   - Target cells: antigen-overexpressing line (CellTrace Blue)
//   - Secondary detection: Alexa Fluor 488 goat anti-mouse IgG
//   - Co-encapsulation (separate chip): 5-10% double-cell
//     occupancy by Poisson statistics
//   - Off-chip incubation: 2 h at 37 C / 5% CO2
//   - Sorting threshold (green channel): 1.8e4 to 3e4 counts
//   - Spike-in ratios: 1:400 (0.25%) and 1:1000 (0.1%)
//   - Recovery rate 1:400 ratio: ~88%
//   - Recovery rate 1:1000 ratio: ~78%
//
// NOTE ON ABSTRACTION OF DMF ELECTRODE ACTUATION:
//   The `mix` primitive abstracts on-chip DMF electrode
//   actuation sequences (AC 140 Vrms, 15 kHz) used for
//   droplet merging at the collection site. The `heat`
//   primitive models incubation in a mammalian cell incubator
//   (37 C / 5% CO2). BioScript has no duration token for
//   hours beyond minutes (m); all incubation times are
//   expressed in minutes (m) or seconds (s).
//
// NOTE ON CONDITIONED MEDIA (PROTOCOL 2):
//   The conditioned media used for the first 24 h post-sort
//   is 30% spent eGFP HEK cell supernatant (0.22 um filtered)
//   mixed 70% with fresh DMEM + 10% FBS + 1% P/S. This is
//   abstracted as ConditionedMedia_HEK in the manifest.
//   Subsequent media changes (every 48 h) use fresh DMEM.
//
// CFG STRUCTURE:
//   BB1  main                -- device priming; bead encapsulation,
//                               sorting, and single recovery
//   BB2  beadSortPass        -- beadSignal > 0: bead in threshold
//                               window; merge with recovery buffer
//   BB3  beadSortFail        -- beadSignal <= 0: no bead / multi-bead;
//                               drain
//   BB4  beadSortJoin        -- join: proceed to cell protocols
//   BB5  cellSortPass        -- cellSignal > 0: GFP cell detected;
//                               merge with cell recovery buffer
//   BB6  cellSortFail        -- cellSignal <= 0: no target cell; drain
//   BB7  cellSortJoin        -- join: proceed to viability check
//   BB8  viabilityPass       -- viabilitySignal > 0: cell viable (>80%);
//                               expand and dispose
//   BB9  viabilityFail       -- viabilitySignal <= 0: non-viable; drain
//   BB10 viabilityJoin       -- join: proceed to antibody assay protocol
//   BB11 antibodySortPass    -- abSignal > 0: specific-Ab hybridoma
//                               detected; merge and recover
//   BB12 antibodySortFail    -- abSignal <= 0: non-specific or empty;
//                               drain
//   BB13 finalCleanup        -- terminal: dispose all QC signals
// ============================================================

instructions:

// ============================================================
// BB1: main
// ============================================================

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 1: Prime device channels with HFE7500 oil
//   containing 2% 008-fluoro-surfactant. Oil injected at
//   0.15 uL/s. Waste syringe set to -0.15 uL/s to ensure
//   all droplets default to the waste channel prior to sorting.
//   This establishes the baseline droplet flow direction.
// ------------------------------------------------------------

oilPrime = dispense 1 units of HFE7500_Surfactant

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 2: Prepare fluorescent bead suspension.
//   FluoSpheres polystyrene 10 um blue-green (430/465 nm)
//   beads washed 3x with PBS, diluted to 1e6 beads/mL.
//   16% OptiPrep added to prevent bead clumping and
//   sedimentation during chip operation.
//   OptiPrep is an iodixanol-based density gradient medium.
// ------------------------------------------------------------

beadSuspension  = dispense 1 units of FluoroSpheres_10um
optiprepBead    = dispense 1 units of OptiPrep
beadMix         = mix beadSuspension with optiprepBead for 5s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 3: Encapsulate beads in ~1 nL droplets.
//   Aqueous (bead) phase injected at 0.05 uL/s into
//   flow-focusing junction against 0.15 uL/s HFE7500 oil.
//   Generates monodisperse ~1 nL droplets at ~50 Hz.
//   Bead encapsulation follows Poisson statistics;
//   sorting threshold (7e3 to 2e4 photon counts) selects
//   for single-bead-containing droplets specifically.
//   NOTE: `mix` abstracts the flow-focusing encapsulation
//   event, not a DMF electrode mixing step.
// ------------------------------------------------------------

oilEncapsulate  = dispense 1 units of HFE7500_Surfactant
beadDroplets    = mix beadMix with oilEncapsulate for 2s

// ------------------------------------------------------------
// PROTOCOL 1 - STEP 4: Fiber-optic PMT detection.
//   470 nm excitation light cast at detection fiber region.
//   Blue-green bead fluorescence (~520 nm emission) measured
//   by photon counting head (Hamamatsu H11890).
//   Sorting threshold window: 7e3 to 2e4 photon counts.
//   Peaks above lower bound and below upper bound (multi-bead
//   exclusion) trigger electrode actuation at sorting junction.
//   PMT, fluid flow, and electrode actuation controlled via
//   in-house Python GUI (uflowcontrol).
// ------------------------------------------------------------

beadSignal = detect singleBeadDetection on beadDroplets for 10s

// ============================================================
// BB2 / BB3: Bead sorting QC gate
// Pass (BB2): beadSignal > 0 -> single bead detected within
//             threshold window (7e3-2e4 counts); electrode
//             actuated to divert droplet to collection channel.
//             3 uL PBS recovery buffer pre-generated and
//             'parked' at collection outlet at 1 uL/s.
//             After 7 s delay, sorted 1 nL droplet arrives
//             and merges with recovery buffer via 3x electrode
//             actuation (500 ms/actuation). Merged ~4 uL
//             volume pipetted (P20, 5 uL) into individual
//             well of 96-well plate (pre-filled: 100 uL PBS).
// Fail (BB3): beadSignal <= 0 -> no bead, multi-bead droplet,
//             or signal outside threshold window; droplet
//             diverted to waste by default flow direction.
// Both branches converge at BB4 (beadSortJoin).
// ============================================================

if (beadSignal > 0) {
    // Generate 3 uL recovery buffer at collection outlet.
    // Injected at 1 uL/s from 500 uL gastight syringe via
    // 1/32" PEEK tubing. Buffer 'parked' at semicircular
    // outlet before sorted droplet arrives.
    recoveryBufferBead = dispense 1 units of RecoveryBuffer_PBS

    // Electrode actuation merges sorted droplet with buffer.
    // 7 s delay post-sort allows droplet to travel from
    // sorting junction to collection outlet (~6 electrode
    // pairs arrest droplet in transit). 3x actuation
    // at 140 Vrms, 15 kHz, 500 ms per actuation.
    // NOTE: `mix` abstracts DMF electrode merging event.
    mergedBeadDrop = mix beadDroplets with recoveryBufferBead for 2s

    // Transfer merged contents (~4 uL) to individual well
    // of 96-well plate pre-loaded with 100 uL PBS per well.
    // Manual P20 pipette set to 5 uL collects all media.
    // Each transfer operation: ~10 s.
    dispose mergedBeadDrop
} else {
    drain beadDroplets
}

// ============================================================
// BB4: beadSortJoin
// Dispose bead detection signal. Control falls into
// GFP HEK293 cell sorting branch (BB5/BB6).
// ============================================================

dispose beadSignal

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 1: Prepare rare GFP HEK293 cell mixture.
//   GFP-expressing HEK293 and WT HEK293 cells both adjusted
//   to 1e6 cells/mL. Spiked at 1:400 and 1:1000 (GFP:WT)
//   ratios. Total volumes: 10,000 cells (400 uL) and
//   100,000 cells (400 uL) per tube.
//   80 uL OptiPrep added per 400 uL cell suspension to
//   improve density matching and reduce sedimentation.
//   Cells resuspended in PBS, loaded into 1 mL BD syringes.
//   NOTE: This step models the 1:1000 ratio condition
//   (rarest condition, 0.1% target frequency) as the
//   representative case for the CFG branch.
// ------------------------------------------------------------

gfpCells        = dispense 1 units of GFP_HEK293_Cells
wtCells         = dispense 1 units of WT_HEK293_Cells
optiprepCell    = dispense 1 units of OptiPrep

// Prepare spiked mixture: GFP cells diluted into WT background.
// Mix abstracts the tube-level spiking and vortex step.
spikeMix        = mix gfpCells with wtCells for 5s
cellSuspension  = mix spikeMix with optiprepCell for 5s

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 2: Encapsulate rare GFP cells in ~1 nL
//   droplets using the same flow-focusing D2 device.
//   Aqueous cell phase at 0.05 uL/s; oil phase at 0.15 uL/s.
//   Cell encapsulation follows Poisson statistics. Sorting
//   threshold set at 1e3 to 2.5e3 photon counts for single
//   GFP cell detection (lower than bead threshold due to
//   lower fluorescence intensity of single GFP-expressing cells).
//   Well plate pre-filled: 100 uL DMEM per well.
// ------------------------------------------------------------

oilCell         = dispense 1 units of HFE7500_Surfactant
cellDroplets    = mix cellSuspension with oilCell for 2s

// Fiber-optic PMT detection: 470 nm excitation, ~520 nm GFP
// emission. Sorting threshold: 1e3 to 2.5e3 photon counts.
cellSignal      = detect singleCellGFPDetection on cellDroplets for 10s

// ============================================================
// BB5 / BB6: GFP cell sorting QC gate
// Pass (BB5): cellSignal > 0 -> single GFP cell in threshold
//             window; electrode actuation diverts to collection.
//             3 uL DMEM recovery buffer pre-generated at outlet.
//             7 s delay; 3x electrode actuation (500 ms each)
//             merges droplet with recovery buffer.
//             Merged volume pipetted to individual well.
// Fail (BB6): cellSignal <= 0 -> WT cell, empty droplet, or
//             multi-cell droplet; routed to waste.
// Both branches converge at BB7 (cellSortJoin).
// ============================================================

if (cellSignal > 0) {
    recoveryBufferCell = dispense 1 units of RecoveryBuffer_DMEM
    mergedCellDrop     = mix cellDroplets with recoveryBufferCell for 2s
    dispose mergedCellDrop
} else {
    drain cellDroplets
}

// ============================================================
// BB7: cellSortJoin
// Dispose cell detection signal. Control falls into
// post-sort viability assay branch (BB8/BB9).
// ============================================================

dispose cellSignal

// ------------------------------------------------------------
// PROTOCOL 2 - STEP 3: Post-sort cell culture and viability.
//   After recovery into 96-well plate:
//   - First 24 h: 150 uL conditioned media per well
//     (30% spent eGFP HEK supernatant, 0.22 um filtered,
//     + 70% fresh DMEM + 10% FBS + 1% P/S).
//   - Subsequent additions: 50 uL fresh DMEM + 10% FBS
//     + 1% P/S every 48 h for 7 days.
//   - Viability monitored every 24 h using SYTOX Blue
//     dead cell stain (10 wells per time point).
//   - Proliferation imaged every 24 h (EVOS M5000).
//   - Incubation: 37 C / 5% CO2.
//   NOTE: 7 days = 10080 min; BioScript supports only s/m.
//
//   BUG FIX: mergedCellDrop is disposed inside the BB5 pass
//   branch (after pipetting into the well). It cannot be
//   referenced again in BB7. The viability assay acts on
//   the well contents AFTER the cell has been deposited and
//   cultured. A fresh DMEM_Complete droplet is dispensed
//   here to represent the well environment (pre-loaded
//   100 uL DMEM + 10% FBS + 1% P/S) into which the
//   recovered cell was placed. This correctly models the
//   post-sort culture step without referencing a disposed
//   variable.
// ------------------------------------------------------------

wellEnvironment     = dispense 1 units of DMEM_Complete
conditionedMediaHEK = dispense 1 units of ConditionedMedia_HEK
sytoxBlue           = dispense 1 units of SYTOX_Blue

// 24 h conditioned media incubation (= 1440 min).
// wellEnvironment represents the 96-well plate contents
// (pre-loaded DMEM) combined with conditioned media top-up.
cellCultureInit     = mix wellEnvironment with conditionedMediaHEK for 1440m
heat cellCultureInit at 37c for 1440m

// SYTOX Blue viability stain applied at 24 h intervals.
// Live cells exclude SYTOX Blue (non-blue = viable).
// Dead cells stain blue under fluorescence.
// Viability = (non-blue wells) / (total stained wells) x 100.
stainedCells        = mix cellCultureInit with sytoxBlue for 30s
viabilitySignal     = detect viabilityDetection on stainedCells for 60s

// ============================================================
// BB8 / BB9: Post-sort viability QC gate
// Pass (BB8): viabilitySignal > 0 -> cell viable (~90%);
//             continue 7-day expansion (10080 min total,
//             subtracting 1440 min already elapsed = 8640 min).
//             Cells exhibit spreading (positive viability
//             indicator). Dispose after full expansion.
// Fail (BB9): viabilitySignal <= 0 -> non-viable cell; drain.
// Both branches converge at BB10 (viabilityJoin).
// ============================================================

if (viabilitySignal > 0) {
    // Continue clonal expansion: 6 days remaining = 8640 min.
    // Fresh DMEM + 10% FBS + 1% P/S added every 48 h.
    // Proliferation images taken every 24 h (EVOS M5000).
    freshDMEM    = dispense 1 units of DMEM_Complete
    expandedCell = mix stainedCells with freshDMEM for 8640m
    heat expandedCell at 37c for 8640m
    dispose expandedCell
} else {
    drain stainedCells
}

// ============================================================
// BB10: viabilityJoin
// Dispose viability signal. Control falls into hybridoma
// antibody assay branch (BB11/BB12).
// ============================================================

dispose viabilitySignal

// ------------------------------------------------------------
// PROTOCOL 3 - STEP 1: Prepare hybridoma cell mixtures.
//   Two hybridoma lines:
//   (A) Specific-Ab producer: secretes mAbs that bind to
//       surface antigen of target cells. Stained with
//       calcein-AM red-orange (per manufacturer protocol).
//   (B) Non-specific-Ab producer: secretes mAbs that do
//       not bind target cell surface. Unstained.
//   Mixed at 1:400 (0.25%) and 1:1000 (0.1%) specific:non-
//   specific ratios to model rare antigen-specific B cells
//   (0.1-2% of isolated B cells in literature).
//   Final concentration: 1e6 cells/mL in IMDM (no phenol
//   red) + 10% FBS + 1 ng/mL IL-6 (no antibiotics).
//   11% (w/v) OptiPrep added for density matching.
//   NOTE: 1:1000 ratio modelled as representative rare case.
// ------------------------------------------------------------

specificHybridoma    = dispense 1 units of HybridomaSpecific_Cells
nonspecificHybridoma = dispense 1 units of HybridomaNonSpecific_Cells
calceingAM           = dispense 1 units of CalceinAM_RedOrange
il6Supplement        = dispense 1 units of IL6_Supplement
optiprepHybrid       = dispense 1 units of OptiPrep

// Stain specific hybridoma cells with calcein-AM red-orange.
stainedSpecific = mix specificHybridoma with calceingAM for 30m

// Prepare spiked hybridoma mixture (1:1000 specific:nonspecific).
hybridomaMixRaw  = mix stainedSpecific with nonspecificHybridoma for 5s
hybridomaMix     = mix hybridomaMixRaw with optiprepHybrid for 5s
hybridomaFinal   = mix hybridomaMix with il6Supplement for 5s

// ------------------------------------------------------------
// PROTOCOL 3 - STEP 2: Prepare target cells for co-encapsulation.
//   Target cells: antigen-overexpressing line.
//   Dissociated with non-enzymatic cell dissociation solution
//   (1x, pre-warmed 37 C) to preserve surface antigen.
//   Resuspended at 3e6 cells/mL in IMDM (no phenol red) +
//   10% FBS + 1 ng/mL IL-6.
//   Stained with CellTrace Blue (per manufacturer protocol).
//   Alexa Fluor 488 goat anti-mouse IgG secondary antibodies
//   added at 2.5 ug/mL to detect specific mAb binding.
//   11% OptiPrep added for density matching.
//   Flow rate: 0.3 uL/s from dedicated co-encapsulation inlet.
// ------------------------------------------------------------

targetCells       = dispense 1 units of TargetCells
cellTraceBlue     = dispense 1 units of CellTrace_Blue
alexaFluor488     = dispense 1 units of AlexaFluor488_AntiMouse
optiprepTarget    = dispense 1 units of OptiPrep

// Stain target cells with CellTrace Blue.
stainedTargets    = mix targetCells with cellTraceBlue for 20m

// Add Alexa Fluor 488 secondary antibody to target cell suspension.
// Enables detection of specific mAb binding via green fluorescence
// accumulation on target cell surface after co-incubation.
targetWithAb      = mix stainedTargets with alexaFluor488 for 5s
targetFinal       = mix targetWithAb with optiprepTarget for 5s

// ------------------------------------------------------------
// PROTOCOL 3 - STEP 3: Co-encapsulation (off-chip co-encap device).
//   A separate co-encapsulation chip (flow-focusing, two cell
//   inlets) is used to generate double-cell droplets.
//   Hybridoma mixture inlet: 0.3 uL/s.
//   Target cell + secondary Ab inlet: 0.3 uL/s.
//   HFE7500 + 2% surfactant oil phase: 0.8 uL/s.
//   Withdrawal syringe (BD 1 mL plastic): 1.4 uL/s.
//   Target occupancy: 5-10% double-cell droplets
//   (hybridoma + target pair) by Poisson statistics.
//   Droplets collected in withdrawal syringe for off-chip
//   incubation. `mix` abstracts co-encapsulation flow event.
// ------------------------------------------------------------

oilCoEncap        = dispense 1 units of HFE7500_Surfactant
coEncapDroplets   = mix hybridomaFinal with targetFinal for 5s
encapsulatedPairs = mix coEncapDroplets with oilCoEncap for 2s

// ------------------------------------------------------------
// PROTOCOL 3 - STEP 4: Off-chip incubation of co-encapsulated
//   droplets at 37 C / 5% CO2 for 2 hours (= 120 min).
//   During incubation, specific mAbs secreted by hybridoma
//   cells bind to the surface antigen of co-encapsulated
//   target cells. Alexa Fluor 488 secondary antibodies then
//   bind to any surface-bound primary mAb, generating a sharp,
//   high-intensity green fluorescence signal (>18,000 photon
//   counts) unique to specific-Ab-secreting + target cell pairs.
//   Droplets with only non-specific hybridoma cells emit medium
//   fluorescence; droplets with only target cells emit background.
// ------------------------------------------------------------

heat encapsulatedPairs at 37c for 120m

// ------------------------------------------------------------
// PROTOCOL 3 - STEP 5: Re-injection into D2 sorting device.
//   Off-chip incubated droplets re-injected into the D2
//   sorting chip at 0.02 uL/s (slower to maintain droplet
//   integrity during re-injection).
//   Spacing oil: 0.15 uL/s.
//   Waste syringe: -0.12 uL/s.
//   Green channel (Alexa Fluor 488) fluorescence detected
//   at PMT. Sorting threshold: 1.8e4 to 3e4 photon counts.
//   Only droplets exceeding 18,000 photon count threshold
//   (specific mAb + target cell doublets) are sorted.
//   NOTE: All droplets contain identical background level of
//   Alexa Fluor 488 secondary antibody in solution; the
//   threshold distinguishes surface-accumulated (bound) signal
//   from free-floating secondary antibody baseline.
// ------------------------------------------------------------

oilReinject       = dispense 1 units of HFE7500_Surfactant
reinjectedDroplets = mix encapsulatedPairs with oilReinject for 2s

abSignal = detect antibodyBindingDetection on reinjectedDroplets for 10s

// ============================================================
// BB11 / BB12: Antibody binding sorting QC gate
// Pass (BB11): abSignal > 0 -> droplet fluorescence in
//              1.8e4 to 3e4 photon count window;
//              specific-Ab-secreting hybridoma + target cell
//              doublet confirmed.
//              3 uL IMDM recovery buffer (10% FBS, 1 ng/mL
//              IL-6) pre-generated at collection outlet at
//              1 uL/s. 7-9 s delay post-sort; 3x electrode
//              actuation (140 Vrms, 15 kHz, 500 ms/actuation)
//              merges sorted droplet with recovery buffer.
//              Merged contents pipetted (P20, 5 uL) to
//              individual well of 96-well plate pre-loaded
//              with 100 uL IMDM (10% FBS, 1 ng/mL IL-6,
//              1% P/S). Plate moved to incubator immediately.
//              Recovery rate: ~88% at 1:400; ~78% at 1:1000.
// Fail (BB12): abSignal <= 0 -> non-specific hybridoma,
//              target-only, or empty droplet; routed to waste.
// Both branches converge at BB13 (finalCleanup).
// ============================================================

if (abSignal > 0) {
    // Generate 3 uL IMDM recovery buffer at collection outlet.
    // IMDM: 10% FBS, 1 ng/mL IL-6, 1% P/S (no phenol red).
    recoveryBufferIMDM = dispense 1 units of RecoveryBuffer_IMDM

    // Merge sorted ~1 nL droplet with 3 uL recovery buffer.
    // 7-9 s delay allows droplet to travel to collection site.
    // 3x electrode actuation at 140 Vrms, 15 kHz (500 ms each).
    // NOTE: `mix` abstracts DMF electrode actuation for merging.
    mergedAbDrop = mix reinjectedDroplets with recoveryBufferIMDM for 3s

    // Pipette merged contents to 96-well plate for downstream
    // analysis. Plate pre-loaded with IMDM culture medium.
    // Well plate imaged using EVOS M5000 imaging system.
    // Specific-Ab hybridoma identified by: calcein-AM red
    // fluorescence (hybridoma) + CellTrace Blue (target cell) +
    // Alexa Fluor 488 green (bound antibody) co-localisation.
    dispose mergedAbDrop
} else {
    drain reinjectedDroplets
}

// ============================================================
// BB13: finalCleanup (terminal)
// Dispose all QC detection signal droplets.
// All three experimental protocols complete.
// Experiment ends.
// ============================================================

dispose abSignal

// [terminal -- no further instructions; exit node for CFG]
