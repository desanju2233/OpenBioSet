bsbbif_2_t:
	dispose(mcsfFeedR1[0])
bsbbif_3_f:
	dispose(mcsfFeedR1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(differentiationSignal1[0])
	freshGMPs1[0] = dispense(LysM_GFP_GMPs)
	antibodyMedia1[0] = dispense(AntiF480_APC_Antibody)
	mcsfForAb1[0] = dispense(MCSF_Media)
	mcsfWithAb1[0] = mix(antibodyMedia1[0], mcsfForAb1[0]) @ 5.0SECOND
	sfemMedia21[0] = dispense(StemSpanSFEM)
	antibodyChamber1[0] = mix(freshGMPs1[0], sfemMedia21[0]) @ 2.0SECOND
	permissiveBase1[0] = dispense(SCF_IL3_IL6_Media)
	abFeedBaseL1[0] = mix(antibodyChamber1[0], permissiveBase1[0]) @ 5.0SECOND
	permissiveBase21[0] = dispense(SCF_IL3_IL6_Media)
	abFeedBaseR1[0] = mix(abFeedBaseL1[0], permissiveBase21[0]) @ 5.0SECOND
	heat(abFeedBaseR1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	mcsfAb1[0] = dispense(AntiF480_APC_Antibody)
	mcsfAbFeedL1[0] = mix(abFeedBaseR1[0], mcsfAb1[0]) @ 5.0SECOND
	mcsfAb21[0] = dispense(AntiF480_APC_Antibody)
	mcsfAbFeedR1[0] = mix(mcsfAbFeedL1[0], mcsfAb21[0]) @ 5.0SECOND
	heat(mcsfAbFeedR1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	f480Signal1[0] = detect(f480_MacrophageDetection, mcsfAbFeedR1[0]) @ 30.0SECOND
	if f480Signal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	primingPBS1[0] = dispense(PBS)
	fibronectinCoat1[0] = dispense(Fibronectin)
	coatedDevice1[0] = mix(primingPBS1[0], fibronectinCoat1[0]) @ 180.0SECOND
	heat(coatedDevice1[0]) @ 25.0CELSIUS @ 10800.0SECOND
	pbsWash1[0] = dispense(PBS)
	washedDevice1[0] = mix(coatedDevice1[0], pbsWash1[0]) @ 5.0SECOND
	beads1[0] = dispense(PolystyrenBeads_10um)
	rhodamineDextran1[0] = dispense(RhodamineDextran_40kDa)
	beadValidation1[0] = mix(beads1[0], washedDevice1[0]) @ 15.0SECOND
	diffusionCalib1[0] = mix(rhodamineDextran1[0], washedDevice1[0]) @ 1800.0SECOND
	validationSignal1[0] = detect(cellTrackingDetection, beadValidation1[0]) @ 15.0SECOND
	gmpCells1[0] = dispense(LysM_GFP_GMPs)
	sfemMedia1[0] = dispense(StemSpanSFEM)
	seededChamber1[0] = mix(gmpCells1[0], sfemMedia1[0]) @ 2.0SECOND
	permissiveMedia1[0] = dispense(SCF_IL3_IL6_Media)
	feedCycle1L1[0] = mix(seededChamber1[0], permissiveMedia1[0]) @ 5.0SECOND
	permissiveMedia21[0] = dispense(SCF_IL3_IL6_Media)
	feedCycle1R1[0] = mix(feedCycle1L1[0], permissiveMedia21[0]) @ 5.0SECOND
	heat(feedCycle1R1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	mcsfMedia1[0] = dispense(MCSF_Media)
	mcsfFeedL1[0] = mix(feedCycle1R1[0], mcsfMedia1[0]) @ 5.0SECOND
	mcsfMedia21[0] = dispense(MCSF_Media)
	mcsfFeedR1[0] = mix(mcsfFeedL1[0], mcsfMedia21[0]) @ 5.0SECOND
	heat(mcsfFeedR1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	differentiationSignal1[0] = detect(lysM_GFP_Detection, mcsfFeedR1[0]) @ 30.0SECOND
	if differentiationSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(mcsfAbFeedR1[0])
bsbbif_6_f:
	dispose(mcsfAbFeedR1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(f480Signal1[0])
	muESCells1[0] = dispense(MuESC_ERKKTR)
	selfRenewMedia1[0] = dispense(DMEM_SelfRenewing)
	escChamber1[0] = mix(muESCells1[0], selfRenewMedia1[0]) @ 2.0SECOND
	selfRenewMedia21[0] = dispense(DMEM_SelfRenewing)
	escFeedL1[0] = mix(escChamber1[0], selfRenewMedia21[0]) @ 5.0SECOND
	selfRenewMedia31[0] = dispense(DMEM_SelfRenewing)
	escFeedR1[0] = mix(escFeedL1[0], selfRenewMedia31[0]) @ 5.0SECOND
	heat(escFeedR1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	starvationMedia1[0] = dispense(DMEM_Starvation)
	starvFeedL1[0] = mix(escFeedR1[0], starvationMedia1[0]) @ 5.0SECOND
	starvationMedia21[0] = dispense(DMEM_Starvation)
	starvFeedR1[0] = mix(starvFeedL1[0], starvationMedia21[0]) @ 5.0SECOND
	heat(starvFeedR1[0]) @ 37.0CELSIUS @ 57600.0SECOND
	fgf1Media1[0] = dispense(FGF1_StarvationMedia)
	fgf1FeedL_C11[0] = mix(starvFeedR1[0], fgf1Media1[0]) @ 5.0SECOND
	heat(fgf1FeedL_C11[0]) @ 37.0CELSIUS @ 1920.0SECOND
	washMedia11[0] = dispense(DMEM_Starvation)
	washFeedR_C11[0] = mix(fgf1FeedL_C11[0], washMedia11[0]) @ 2.0SECOND
	heat(washFeedR_C11[0]) @ 37.0CELSIUS @ 900.0SECOND
	fgf1Media21[0] = dispense(FGF1_StarvationMedia)
	fgf1FeedL_C21[0] = mix(washFeedR_C11[0], fgf1Media21[0]) @ 5.0SECOND
	heat(fgf1FeedL_C21[0]) @ 37.0CELSIUS @ 1920.0SECOND
	washMedia21[0] = dispense(DMEM_Starvation)
	washFeedR_C21[0] = mix(fgf1FeedL_C21[0], washMedia21[0]) @ 2.0SECOND
	heat(washFeedR_C21[0]) @ 37.0CELSIUS @ 900.0SECOND
	fgf1Media31[0] = dispense(FGF1_StarvationMedia)
	fgf1FeedL_C31[0] = mix(washFeedR_C21[0], fgf1Media31[0]) @ 5.0SECOND
	heat(fgf1FeedL_C31[0]) @ 37.0CELSIUS @ 1920.0SECOND
	washMedia31[0] = dispense(DMEM_Starvation)
	washFeedR_C31[0] = mix(fgf1FeedL_C31[0], washMedia31[0]) @ 2.0SECOND
	heat(washFeedR_C31[0]) @ 37.0CELSIUS @ 900.0SECOND
	erkSignal1[0] = detect(erkktr_ERKDetection, washFeedR_C31[0]) @ 180.0SECOND
	if erkSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(washFeedR_C31[0])
bsbbif_9_f:
	dispose(washFeedR_C31[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(erkSignal1[0])
	dispose(validationSignal1[0])
	dispose(diffusionCalib1[0])
	NOP
