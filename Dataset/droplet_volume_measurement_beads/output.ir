bsbbif_2_t:
	dispose(combinedFluid1[0])
bsbbif_3_f:
	dispose(combinedFluid1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(beadSignal1[0])
	NOP
main:
	beadSuspension1[0] = dispense(PolyBeads_LysisBuffer)
	pbsFlow1[0] = dispense(PBS)
	combinedFluid1[0] = mix(beadSuspension1[0], pbsFlow1[0]) @ 30.0SECOND
	beadSignal1[0] = detect(beadCountDetection, combinedFluid1[0]) @ 60.0SECOND
	if beadSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
