main:
	pluronic11[0] = dispense(PluronicL64)
	pbs11[0] = dispense(PBS)
	diluent11[0] = mix(pbs11[0], pluronic11[0]) @ 5.0SECOND
	pluronic21[0] = dispense(PluronicL64)
	pbs21[0] = dispense(PBS)
	diluent21[0] = mix(pbs21[0], pluronic21[0]) @ 5.0SECOND
