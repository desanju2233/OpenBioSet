	hrpSignal2x1[0] = detect(chemiluminescenceDetection, rxn2x1[0]) @ 30.0SECOND
	hrpSignal4x1[0] = detect(chemiluminescenceDetection, rxn4x1[0]) @ 30.0SECOND
	if hrpSignal1x1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
