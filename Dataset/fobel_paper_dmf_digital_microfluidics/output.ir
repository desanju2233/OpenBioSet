	substrate2x1[0] = dispense(SuperSignalSubstrate)
	substrate4x1[0] = dispense(SuperSignalSubstrate)
	rxn1x1[0] = mix(hrp1x1[0], substrate1x1[0]) @ 60.0SECOND
	rxn2x1[0] = mix(hrp2x1[0], substrate2x1[0]) @ 60.0SECOND
	rxn4x1[0] = mix(hrp4x1[0], substrate4x1[0]) @ 60.0SECOND
	heat(rxn1x1[0]) @ 25.0CELSIUS @ 120.0SECOND
	heat(rxn2x1[0]) @ 25.0CELSIUS @ 120.0SECOND
	heat(rxn4x1[0]) @ 25.0CELSIUS @ 120.0SECOND
