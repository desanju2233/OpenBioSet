	diluent4ab1[0] = mix(diluent4a1[0], diluent4b1[0]) @ 5.0SECOND
	diluent41[0] = mix(diluent4ab1[0], diluent31[0]) @ 5.0SECOND
	hrp4x1[0] = mix(hrpStock31[0], diluent41[0]) @ 5.0SECOND
