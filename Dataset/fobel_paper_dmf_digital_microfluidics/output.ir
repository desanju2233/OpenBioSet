	hrpStock21[0] = dispense(HRP_Standard)
	hrpStock31[0] = dispense(HRP_Standard)
	hrp1x1[0] = mix(hrpStock11[0], diluent11[0]) @ 5.0SECOND
	hrp2x1[0] = mix(hrpStock21[0], diluent21[0]) @ 5.0SECOND
