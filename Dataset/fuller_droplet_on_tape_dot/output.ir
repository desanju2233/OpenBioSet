bsbbif_2_t:
	ejectedDroplet1[0] = mix(adeLoaded1[0], couplingWater1[0]) @ 1.0SECOND
	dispose(ejectedDroplet1[0])
bsbbif_3_f:
	dispose(adeLoaded1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(echoSignal1[0])
	experimentDrop1[0] = dispense(ProteinCrystalSlurry)
	heliumFlow1[0] = dispense(HeliumGas)
	laserZoneDrop1[0] = mix(experimentDrop1[0], heliumFlow1[0]) @ 5.0SECOND
	laserHitSignal1[0] = detect(dropletHitDetection, laserZoneDrop1[0]) @ 30.0SECOND
	if laserHitSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	mqWaterBath1[0] = dispense(MQWater)
	isopropBath1[0] = dispense(Isopropanol)
	sonicatedBelt1[0] = mix(mqWaterBath1[0], isopropBath1[0]) @ 600.0SECOND
	heat(sonicatedBelt1[0]) @ 50.0CELSIUS @ 3600.0SECOND
	fasSolution1[0] = dispense(FAS_NOctane)
	treatedBelt1[0] = mix(sonicatedBelt1[0], fasSolution1[0]) @ 7200.0SECOND
	heat(treatedBelt1[0]) @ 150.0CELSIUS @ 10800.0SECOND
	sampleReservoir1[0] = dispense(SampleSolution)
	couplingWater1[0] = dispense(CouplingWater)
	adeLoaded1[0] = mix(sampleReservoir1[0], couplingWater1[0]) @ 2.0SECOND
	echoSignal1[0] = detect(echoLevelDetection, adeLoaded1[0]) @ 10.0SECOND
	if echoSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(laserZoneDrop1[0])
bsbbif_6_f:
	dispose(laserZoneDrop1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(laserHitSignal1[0])
	productionSample1[0] = dispense(ProteinCrystalSlurry)
	heliumFlow21[0] = dispense(HeliumGas)
	xfelDrop1[0] = mix(productionSample1[0], heliumFlow21[0]) @ 5.0SECOND
	xrdSignal1[0] = detect(xrdSignalDetection, xfelDrop1[0]) @ 30.0SECOND
	if xrdSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(xfelDrop1[0])
bsbbif_9_f:
	dispose(xfelDrop1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(xrdSignal1[0])
	xesSample1[0] = dispense(ProteinCrystalSlurry)
	heliumFlow31[0] = dispense(HeliumGas)
	xesDrop1[0] = mix(xesSample1[0], heliumFlow31[0]) @ 5.0SECOND
	xesSignal1[0] = detect(xesSignalDetection, xesDrop1[0]) @ 30.0SECOND
	if xesSignal1[0] > 0	|	true: jump bsbbif_11_t	|	false: jump bsbbif_12_f
bsbbif_11_t:
	dispose(xesDrop1[0])
bsbbif_12_f:
	dispose(xesDrop1[0])
	jump: bsbbif_13_j
bsbbif_13_j:
	dispose(xesSignal1[0])
	cleaningWater1[0] = dispense(MQWater)
	beltCleanRun1[0] = mix(treatedBelt1[0], cleaningWater1[0]) @ 300.0SECOND
	heliumDry1[0] = dispense(HeliumGas)
	driedBelt1[0] = mix(beltCleanRun1[0], heliumDry1[0]) @ 120.0SECOND
	residueSignal1[0] = detect(residueDetection, driedBelt1[0]) @ 30.0SECOND
	if residueSignal1[0] > 0	|	true: jump bsbbif_14_t	|	false: jump bsbbif_15_f
bsbbif_14_t:
	dispose(driedBelt1[0])
bsbbif_15_f:
	dispose(driedBelt1[0])
	jump: bsbbif_16_j
bsbbif_16_j:
	dispose(residueSignal1[0])
	NOP
