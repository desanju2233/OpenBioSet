bsbbif_2_t:
	dispose(dxmNimsArray1[0])
bsbbif_3_f:
	dispose(dxmNimsArray1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(depositionSignal1[0])
	ph6_buf11[0] = dispense(PhosphateBuffer_pH6)
	ph6_buf21[0] = dispense(PhosphateBuffer_pH6)
	ph6_buf31[0] = dispense(PhosphateBuffer_pH6)
	ph6_buf41[0] = dispense(PhosphateBuffer_pH6)
	ph6_buf_121[0] = mix(ph6_buf11[0], ph6_buf21[0]) @ 5.0SECOND
	ph6_buf_341[0] = mix(ph6_buf31[0], ph6_buf41[0]) @ 5.0SECOND
	ph6_bufBulk1[0] = mix(ph6_buf_121[0], ph6_buf_341[0]) @ 5.0SECOND
	ph6_substrate1[0] = dispense(G4_Substrate_Probe)
	ph6_enzyme1[0] = dispense(CelE_CBM3a_Enzyme)
	ph6_subBuf1[0] = mix(ph6_substrate1[0], ph6_bufBulk1[0]) @ 10.0SECOND
	ph6_reactionCocktail1[0] = mix(ph6_subBuf1[0], ph6_enzyme1[0]) @ 10.0SECOND
	oilPhase_pH61[0] = dispense(HFE7500_Surfactant)
	ph6_dropletsInOil1[0] = mix(ph6_reactionCocktail1[0], oilPhase_pH61[0]) @ 5.0SECOND
	heat(ph6_dropletsInOil1[0]) @ 25.0CELSIUS @ 600.0SECOND
	heat(ph6_dropletsInOil1[0]) @ 25.0CELSIUS @ 600.0SECOND
	heat(ph6_dropletsInOil1[0]) @ 25.0CELSIUS @ 600.0SECOND
	heat(ph6_dropletsInOil1[0]) @ 25.0CELSIUS @ 600.0SECOND
	heat(ph6_dropletsInOil1[0]) @ 25.0CELSIUS @ 600.0SECOND
	maldiMatrix_pH61[0] = dispense(UniversalMALDI_Matrix)
	ph6_nimsArray1[0] = mix(ph6_dropletsInOil1[0], maldiMatrix_pH61[0]) @ 60.0SECOND
	ph6Signal1[0] = detect(nimsImagingDetection, ph6_nimsArray1[0]) @ 30.0SECOND
	if ph6Signal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	oilPhase1[0] = dispense(HFE7500_Surfactant)
	dxmDroplet1[0] = dispense(DextromethorphanStandard)
	dxmDropletInOil1[0] = mix(dxmDroplet1[0], oilPhase1[0]) @ 5.0SECOND
	heat(dxmDropletInOil1[0]) @ 25.0CELSIUS @ 600.0SECOND
	maldiMatrix1[0] = dispense(UniversalMALDI_Matrix)
	dxmNimsArray1[0] = mix(dxmDropletInOil1[0], maldiMatrix1[0]) @ 60.0SECOND
	depositionSignal1[0] = detect(nimsImagingDetection, dxmNimsArray1[0]) @ 30.0SECOND
	if depositionSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(ph6_nimsArray1[0])
bsbbif_6_f:
	dispose(ph6_nimsArray1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(ph6Signal1[0])
	ph5_buf11[0] = dispense(AcetateBuffer_pH5)
	ph5_buf21[0] = dispense(AcetateBuffer_pH5)
	ph5_buf31[0] = dispense(AcetateBuffer_pH5)
	ph5_buf41[0] = dispense(AcetateBuffer_pH5)
	ph5_buf_121[0] = mix(ph5_buf11[0], ph5_buf21[0]) @ 5.0SECOND
	ph5_buf_341[0] = mix(ph5_buf31[0], ph5_buf41[0]) @ 5.0SECOND
	ph5_bufBulk1[0] = mix(ph5_buf_121[0], ph5_buf_341[0]) @ 5.0SECOND
	ph5_substrate1[0] = dispense(G4_Substrate_Probe)
	ph5_enzyme1[0] = dispense(CelE_CBM3a_Enzyme)
	ph5_subBuf1[0] = mix(ph5_substrate1[0], ph5_bufBulk1[0]) @ 10.0SECOND
	ph5_reactionCocktail1[0] = mix(ph5_subBuf1[0], ph5_enzyme1[0]) @ 10.0SECOND
	oilPhase_pH51[0] = dispense(HFE7500_Surfactant)
	ph5_dropletsInOil1[0] = mix(ph5_reactionCocktail1[0], oilPhase_pH51[0]) @ 5.0SECOND
	heat(ph5_dropletsInOil1[0]) @ 25.0CELSIUS @ 600.0SECOND
	heat(ph5_dropletsInOil1[0]) @ 25.0CELSIUS @ 600.0SECOND
	heat(ph5_dropletsInOil1[0]) @ 25.0CELSIUS @ 1200.0SECOND
	maldiMatrix_pH51[0] = dispense(UniversalMALDI_Matrix)
	ph5_nimsArray1[0] = mix(ph5_dropletsInOil1[0], maldiMatrix_pH51[0]) @ 60.0SECOND
	ph5Signal1[0] = detect(nimsImagingDetection, ph5_nimsArray1[0]) @ 30.0SECOND
	if ph5Signal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(ph5_nimsArray1[0])
bsbbif_9_f:
	dispose(ph5_nimsArray1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(ph5Signal1[0])
	NOP
