{
  "protocol": {
    "title": "Combinatorial Synthesis of Peptidomimetics Using Digital Microfluidics",
    "source": "J. Flow Chem. 2012, 2(3), 103-107",
    "doi": "10.1556/JFC-D-12-00012",
    "authors": ["Mais J. Jebrail", "Naila Assem", "Jared M. Mudrik", "Michael D.M. Dryden", "Kaixiang Lin", "Andrei K. Yudin", "Aaron R. Wheeler"],
    "affiliation": "Department of Chemistry, University of Toronto, Toronto ON M5S-3H6, Canada",
    "platform": "Digital microfluidics (DMF) -- two-plate electrowetting-on-dielectric (EWOD) device",
    "objective": "Combinatorial chemical synthesis of peptidomimetics via thioacid-aziridine ligation and on-chip desulfurization with integrated magnetic catalyst separation",

    "device": {
      "configuration": "Two-plate DMF (bottom chromium electrode array + top ITO plate)",
      "bottom_plate": {
        "electrodes": "Patterned chromium",
        "actuation_electrodes": {
          "count": 88,
          "size_mm": "2.2 x 2.2",
          "border": "140 um peak-to-peak sinusoid interdigitated"
        },
        "reservoir_electrodes": {
          "count": 10,
          "size_mm": "5 x 5"
        }
      },
      "top_plate": "Contiguous indium tin oxide (ITO) electrode",
      "spacer": {
        "material": "Double-sided tape (2 layers)",
        "thickness_um": 180
      },
      "droplet_volumes": {
        "unit_droplet_nL": 900,
        "reservoir_droplet_uL": 4.5
      },
      "actuation": {
        "voltage_Vrms": "70-100",
        "frequency_kHz": 18,
        "waveform": "sine wave",
        "generator": "Agilent function generator + amplifier"
      },
      "reagent_capacity": 6,
      "reagents_loaded": ["Boc-Ala-SH (A1)", "Boc-Val-SH (A2)", "Az-Ala-An (B1)", "Az-Pro-An (B2)", "Raney Nickel (RaNi)", "Methanol (MeOH)"]
    },

    "reagents": {
      "starting_materials": {
        "A1": {
          "name": "Boc-Ala-SH",
          "full_name": "Boc-Ala-Cys-rAla-Anilide precursor (thioacid peptide)",
          "type": "thioacid peptide",
          "concentration_M": 0.1,
          "solvent": "MeOH (HPLC-grade)"
        },
        "A2": {
          "name": "Boc-Val-SH",
          "full_name": "Boc-Val-Cys-rAla-Anilide precursor (thioacid peptide)",
          "type": "thioacid peptide",
          "concentration_M": 0.1,
          "solvent": "MeOH (HPLC-grade)"
        },
        "B1": {
          "name": "Az-Ala-An",
          "full_name": "NH aziridine-terminated Ala-Anilide amino acid",
          "type": "NH aziridine-terminated amino acid",
          "concentration_M": 0.1,
          "solvent": "MeOH (HPLC-grade)",
          "notes": "Synthesised from commercially available amphoteric aziridine aldehydes"
        },
        "B2": {
          "name": "Az-Pro-An",
          "full_name": "NH aziridine-terminated Pro-Anilide amino acid",
          "type": "NH aziridine-terminated amino acid",
          "concentration_M": 0.1,
          "solvent": "MeOH (HPLC-grade)",
          "notes": "Synthesised from commercially available amphoteric aziridine aldehydes"
        }
      },
      "catalyst": {
        "name": "Raney Nickel (RaNi)",
        "composition": "Nickel-aluminium alloy grains (ferromagnetic)",
        "amount_per_droplet_mg": 5,
        "solvent": "MeOH",
        "droplet_volume_uL": 4.5,
        "purpose": "Desulfurization catalyst; magnetically recoverable"
      },
      "solvent": {
        "name": "Methanol (MeOH)",
        "grade": "HPLC-grade",
        "deuterated_for_NMR": "MeOH-d4 (Cambridge Isotope Laboratories, Andover MA)"
      },
      "other": {
        "formic_acid": "0.1% in MeOH (for MS sample preparation)"
      }
    },

    "products": {
      "peptidomimetics": [
        { "id": "A1-B1", "name": "Boc-Ala-Cys-rAla-Anilide", "mz_ligation": 425, "mz_desulfurized": 393 },
        { "id": "A1-B2", "name": "Boc-Ala-Cys-rPro-Anilide", "mz_ligation": 451, "mz_desulfurized": 419 },
        { "id": "A2-B1", "name": "Boc-Val-Cys-rAla-Anilide", "mz_ligation": 452, "mz_desulfurized": 421 },
        { "id": "A2-B2", "name": "Boc-Val-Cys-rPro-Anilide", "mz_ligation": 479, "mz_desulfurized": 447 }
      ],
      "total_products": 8,
      "total_processing_steps": 32
    },

    "steps": [
      {
        "id": "S1",
        "name": "Dispense starting material droplets",
        "part": "PART 1 -- Combinatorial Ligation",
        "bb": "BB1",
        "operation": "dispense",
        "inputs": ["Boc_Ala_SH", "Boc_Val_SH", "Az_Ala_An", "Az_Pro_An"],
        "droplets_per_reagent": 2,
        "total_droplets": 8,
        "droplet_volume_nL": 900,
        "concentration_M": 0.1,
        "solvent": "MeOH (HPLC-grade)",
        "actuation_voltage_Vrms": "70-100",
        "actuation_frequency_kHz": 18,
        "notes": "Two droplets of each A1, A2, B1, B2 dispensed from respective reservoirs by pinch-off actuation. Reservoir volume 4.5 uL."
      },
      {
        "id": "S2",
        "name": "Merge reagent pairs (combinatorial pairing)",
        "part": "PART 1 -- Combinatorial Ligation",
        "bb": "BB1",
        "operation": "mix",
        "pairs": [
          { "reaction": "A1-B1", "inputs": ["a1_drop1", "b1_drop1"] },
          { "reaction": "A1-B2", "inputs": ["a1_drop2", "b2_drop1"] },
          { "reaction": "A2-B1", "inputs": ["a2_drop1", "b1_drop2"] },
          { "reaction": "A2-B2", "inputs": ["a2_drop2", "b2_drop2"] }
        ],
        "duration_s": 5,
        "actuation_voltage_Vrms": "70-100",
        "actuation_frequency_kHz": 18,
        "notes": "Droplets merged by sequential electrode actuation; coalescence when two droplets share an electrode."
      },
      {
        "id": "S3",
        "name": "Circular mixing and N2 atmosphere ligation incubation",
        "part": "PART 1 -- Combinatorial Ligation",
        "bb": "BB1",
        "operation": "mix + heat",
        "mixing_duration_s": 60,
        "mixing_pattern": "circular actuation on 4 electrodes",
        "incubation_temperature_C": 25,
        "incubation_duration_s": 3600,
        "atmosphere": "N2",
        "glovebox": {
          "type": "miniaturised Petri-dish glovebox",
          "dimensions": "150 mm o.d. x 15 mm h (polystyrene Petri dish)",
          "purge_gas": "N2",
          "purge_flow_rate_mL_min": 50,
          "purge_duration_min": 2,
          "seal": "parafilm"
        },
        "reaction_chemistry": "Thioacid-aziridine ligation; installs peptide bond isostere with thiol sidechain",
        "bioscript_abstraction": "heat at 25c for 60m (RT incubation under N2; no glovebox primitive in BioScript)",
        "products_expected": [
          { "id": "A1-B1", "mz": 425 },
          { "id": "A1-B2", "mz": 451 },
          { "id": "A2-B1", "mz": 452 },
          { "id": "A2-B2", "mz": 479 }
        ]
      },
      {
        "id": "S4",
        "name": "Solvent evaporation -- ligation product isolation",
        "part": "PART 1 -- Combinatorial Ligation",
        "bb": "BB1",
        "operation": "heat (evaporation abstraction)",
        "temperature_C": 25,
        "duration_min": 15,
        "procedure": "Top plate removed; MeOH allowed to evaporate at RT; dried peptidomimetic solids remain on bottom plate electrode surface",
        "bioscript_abstraction": "heat at 25c for 15m (no evaporation primitive in BioScript)"
      },
      {
        "id": "QC1",
        "name": "Ligation QC -- ESI-MS detection",
        "part": "PART 1 -- QC Gate",
        "bb": "BB1 -> BB2/BB3",
        "operation": "detect",
        "module": "msDetection",
        "sentinel_product": "A1-B1",
        "detection_duration_s": 30,
        "ms_parameters": {
          "instrument": "Agilent 1200 series quadrupole MS",
          "ion_mode": "positive",
          "applied_voltage_V": 50,
          "capillary_temperature_C": 100,
          "flow_rate_mL_min": 0.5,
          "sample_concentration_mM": 2.3,
          "sample_solvent": "MeOH + 0.1% formic acid",
          "acquisitions_averaged": 67,
          "replicates": 3
        },
        "branch": {
          "pass": { "condition": "ligationSignal > 0", "action": "dispose all 4 ligation products", "bb": "BB2" },
          "fail": { "condition": "ligationSignal <= 0", "action": "drain all 4 ligation products", "bb": "BB3" }
        }
      },
      {
        "id": "S5",
        "name": "Re-dissolve peptidomimetic products in MeOH",
        "part": "PART 2 -- Desulfurization",
        "bb": "BB4",
        "operation": "dispense + mix",
        "inputs": ["MeOH"],
        "droplet_volume_nL": 900,
        "duration_s": 5,
        "procedure": "Top plate replaced; 900-nL MeOH droplet dispensed and driven to each dried product spot by electrode actuation to re-solubilise",
        "products_re_dissolved": ["A1-B1 (m/z 425)", "A1-B2 (m/z 451)", "A2-B1 (m/z 452)", "A2-B2 (m/z 479)"],
        "notes": "900-nL droplets sufficient to dissolve each peptidomimetic solid; larger volumes (up to hundreds of uL) possible depending on compound solubility"
      },
      {
        "id": "S6",
        "name": "Dispense and merge RaNi catalyst with product droplets",
        "part": "PART 2 -- Desulfurization",
        "bb": "BB4",
        "operation": "dispense + mix",
        "catalyst": "RaneyNickel",
        "catalyst_amount_mg": 5,
        "catalyst_droplet_volume_uL": 4.5,
        "duration_s": 5,
        "reaction_chemistry": "Raney Nickel (Ni-Al alloy) catalyses desulfurization: removes -SH from cysteine-like sulfa backbone yielding reduced amide bond",
        "pairs": [
          { "product": "A1-B1 dissolved", "catalyst": "rani_a1b1" },
          { "product": "A1-B2 dissolved", "catalyst": "rani_a1b2" },
          { "product": "A2-B1 dissolved", "catalyst": "rani_a2b1" },
          { "product": "A2-B2 dissolved", "catalyst": "rani_a2b2" }
        ]
      },
      {
        "id": "S7",
        "name": "Circular mixing and RT desulfurization incubation",
        "part": "PART 2 -- Desulfurization",
        "bb": "BB4",
        "operation": "mix + heat",
        "mixing_duration_s": 60,
        "mixing_pattern": "circular electrode actuation",
        "incubation_temperature_C": 25,
        "incubation_duration_min": 15,
        "bioscript_abstraction": "heat at 25c for 15m",
        "products_expected": [
          { "id": "desulf-A1-B1", "mz": 393 },
          { "id": "desulf-A1-B2", "mz": 419 },
          { "id": "desulf-A2-B1", "mz": 421 },
          { "id": "desulf-A2-B2", "mz": 447 }
        ]
      },
      {
        "id": "S8",
        "name": "Magnetic RaNi immobilisation and product isolation",
        "part": "PART 2 -- Desulfurization",
        "bb": "BB4",
        "operation": "drain + heat (evaporation abstraction)",
        "magnet": {
          "type": "Neodymium Iron Boron (NdFeB)",
          "supplier": "Main Electronics, BC",
          "placement": "beneath device bottom plate"
        },
        "procedure": [
          "NdFeB magnet placed beneath device; RaNi grains immobilised to bottom plate surface",
          "Supernatant (desulfurized product in MeOH, RaNi-free) driven away by electrode actuation",
          "Top plate removed; MeOH evaporated at RT for 30 min",
          "Desulfurized product remains as dried solid for off-chip analysis"
        ],
        "evaporation_duration_min": 30,
        "bioscript_abstraction": "drain (magnetic separation) + heat at 25c for 30m (solvent evaporation). NOTE: lilott8/BioScript maps drain to same IR opcode as dispose; magnetic-separation semantic preserved in source comments only.",
        "nmr_verification": {
          "instrument": "Varian UnityPlus 500 MHz (DMF) / Varian Mercury 400 MHz (macroscale)",
          "solvent": "CD3OD",
          "frequency_MHz": 400,
          "sample_tube": "capillary tube 100 um i.d. in 3-mm Norell S400 NMR tube",
          "sample_concentration_mM": 1.2,
          "scans": 512,
          "reference": "MeOH-d4 (3.31 ppm)",
          "key_peaks_ppm": {
            "reduced_amide_bond": [4.05, 4.29],
            "boc_protecting_group": 1.44,
            "phenyl_group": "7.60-7.17"
          },
          "conclusion": "DMF-synthesised spectra nearly identical to macroscale bench synthesis"
        }
      },
      {
        "id": "QC2",
        "name": "Desulfurization QC -- ESI-MS and NMR detection",
        "part": "PART 2 -- QC Gate",
        "bb": "BB4 -> BB5/BB6",
        "operation": "detect",
        "module": "nmrDetection",
        "sentinel_product": "desulf-A1-B1",
        "detection_duration_s": 30,
        "branch": {
          "pass": { "condition": "desulfSignal > 0", "action": "dispose all 4 desulfurized product droplets", "bb": "BB5" },
          "fail": { "condition": "desulfSignal <= 0", "action": "drain all 4 desulfurized product droplets", "bb": "BB6" }
        }
      }
    ],

    "cfg": {
      "basic_blocks": [
        { "id": "BB1", "label": "main",         "type": "entry",        "description": "Dispense, merge, mix, ligate (N2, 1h), evaporate; detect A1-B1 by MS" },
        { "id": "BB2", "label": "bsbbif_2_t",   "type": "branch_true",  "condition": "ligationSignal > 0",  "action": "dispose(a1b1_mixed, a1b2_mixed, a2b1_mixed, a2b2_mixed)" },
        { "id": "BB3", "label": "bsbbif_3_f",   "type": "branch_false", "condition": "ligationSignal <= 0", "action": "drain(a1b1_mixed, a1b2_mixed, a2b1_mixed, a2b2_mixed)" },
        { "id": "BB4", "label": "bsbbif_4_j",   "type": "join",         "description": "dispose(ligationSignal); re-dissolve, merge RaNi, desulfurize, magnetic separation, evaporate; detect desulf-A1-B1" },
        { "id": "BB5", "label": "bsbbif_5_t",   "type": "branch_true",  "condition": "desulfSignal > 0",   "action": "dispose(meoh_prod_a1b1, meoh_prod_a1b2, meoh_prod_a2b1, meoh_prod_a2b2)" },
        { "id": "BB6", "label": "bsbbif_6_f",   "type": "branch_false", "condition": "desulfSignal <= 0",  "action": "drain(meoh_prod_a1b1, meoh_prod_a1b2, meoh_prod_a2b1, meoh_prod_a2b2)" },
        { "id": "BB7", "label": "bsbbif_7_j",   "type": "terminal",     "description": "dispose(desulfSignal); NOP -- experiment ends" }
      ],
      "edges": [
        ["BB1", "BB2"], ["BB1", "BB3"],
        ["BB2", "BB4"], ["BB3", "BB4"],
        ["BB4", "BB5"], ["BB4", "BB6"],
        ["BB5", "BB7"], ["BB6", "BB7"]
      ],
      "total_nodes": 7,
      "total_edges": 8
    },

    "bioscript_compiler_notes": {
      "bioscript_file": "jebrail_combinatorial_peptidomimetics_dmf.bs",
      "compiler": "lilott8/BioScript (ANTLR4-based)",
      "ir_output": "jebrail_combinatorial_peptidomimetics_dmf.ir",
      "dag_output": "jebrail_combinatorial_peptidomimetics_dmf_main_dag.dot",
      "duration_units": "s (seconds) and m (minutes) only; h token not supported",
      "duration_conversions": {
        "ligation_incubation": "1h -> 60m (IR: 3600.0 SECOND)",
        "ligation_evaporation": "15min -> 15m (IR: 900.0 SECOND)",
        "desulfurization_incubation": "15min -> 15m (IR: 900.0 SECOND)",
        "desulfurization_evaporation": "30min -> 30m (IR: 1800.0 SECOND)"
      },
      "modules": ["msDetection", "nmrDetection"],
      "manifests": ["Boc_Ala_SH", "Boc_Val_SH", "Az_Ala_An", "Az_Pro_An", "RaneyNickel", "MeOH"],
      "known_abstractions": {
        "glovebox_N2_atmosphere": "heat at 25c for 60m (no glovebox primitive)",
        "circular_mixing": "mix x with x for 60s (self-mix; models circular electrode actuation)",
        "solvent_evaporation": "heat at 25c for 15m or 30m (no evaporation primitive)",
        "magnetic_separation": "drain (collapses to dispose() in IR; semantic preserved in comments only)"
      },
      "known_compiler_behaviours": {
        "drain_maps_to_dispose": "lilott8/BioScript maps drain to the same IR opcode as dispose. Magnetic-separation and waste-routing semantics are source-level only.",
        "self_mix_accepted": "mix x with x for Ns compiles without error; used to model on-device circular mixing actuation."
      },
      "bugs_fixed": [
        {
          "id": "Bug1",
          "description": "a1b1_dissolved was mixing with a1b2_mixed (wrong source variable -- typo)",
          "fix": "Changed a1b2_mixed to a1b1_mixed in the re-dissolution step for a1b1_dissolved"
        },
        {
          "id": "Bug2",
          "description": "drain collapses to dispose() in IR; magnetic separation semantic lost at IR level",
          "fix": "No code change; documented as known compiler behaviour in source comments and this JSON"
        },
        {
          "id": "Bug3",
          "description": "Ligation pass branch (BB2) only disposed a1b1_mixed; a1b2_mixed, a2b1_mixed, a2b2_mixed left dangling",
          "fix": "Added dispose a1b2_mixed, dispose a2b1_mixed, dispose a2b2_mixed to the if-true branch"
        }
      ]
    },

    "characterisation": {
      "mass_spectrometry": {
        "instrument": "Agilent 1200 series quadrupole MS",
        "ionisation": "ESI",
        "ion_mode": "positive",
        "applied_voltage_V": 50,
        "capillary_temperature_C": 100,
        "flow_rate_mL_min": 0.5,
        "sample_concentration_mM": 2.3,
        "sample_solvent": "MeOH + 0.1% formic acid",
        "acquisitions_averaged": 67,
        "replicates": 3
      },
      "nmr": {
        "instrument_dmf": "Varian UnityPlus 500 MHz",
        "instrument_macroscale": "Varian Mercury 400 MHz",
        "solvent": "MeOH-d4 (Cambridge Isotope Laboratories, Andover MA)",
        "sample_tube_dmf": "capillary tube 100 um i.d., sealed with butane torch, in 3-mm Norell S400 NMR tube",
        "sample_concentration_mM": 1.2,
        "pulse": "90 degree (7.3 us)",
        "spectral_width_ppm": 16,
        "recycle_delay_s": 1,
        "steady_states": 1,
        "scans": 512,
        "reference_ppm": "MeOH-d4 at 3.31 ppm",
        "temperature_C": 25,
        "replicates": 3
      }
    },

    "advantages_over_macroscale": [
      "Greater than 1000-fold reduction in reagent use (uL vs mL)",
      "Faster reactions (short diffusion distances, rapid heat exchange)",
      "No stir bars, stir plates, rotary evaporators, or traditional gloveboxes required",
      "Small device footprint enables miniaturised glovebox for inert atmosphere",
      "First reported combinatorial synthesis on a DMF platform",
      "First reported magnetic isolation of inorganic catalysts by microfluidics (any format)",
      "Straightforward parallel scaling by increasing device footprint or running multiple devices"
    ]
  }
}
