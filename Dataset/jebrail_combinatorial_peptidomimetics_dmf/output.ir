bsbbif_2_t:
	dispose(a1b1_mixed1[0])
	dispose(a1b2_mixed1[0])
	dispose(a2b1_mixed1[0])
	dispose(a2b2_mixed1[0])
bsbbif_3_f:
	dispose(a1b1_mixed1[0])
	dispose(a1b2_mixed1[0])
	dispose(a2b1_mixed1[0])
	dispose(a2b2_mixed1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(ligationSignal1[0])
	meoh_a1b11[0] = dispense(MeOH)
	meoh_a1b21[0] = dispense(MeOH)
	meoh_a2b11[0] = dispense(MeOH)
	meoh_a2b21[0] = dispense(MeOH)
	a1b1_dissolved1[0] = mix(meoh_a1b11[0], a1b1_mixed2[0]) @ 5.0SECOND
	a1b2_dissolved1[0] = mix(meoh_a1b21[0], a1b2_mixed2[0]) @ 5.0SECOND
	a2b1_dissolved1[0] = mix(meoh_a2b11[0], a2b1_mixed2[0]) @ 5.0SECOND
	a2b2_dissolved1[0] = mix(meoh_a2b21[0], a2b2_mixed2[0]) @ 5.0SECOND
	rani_a1b11[0] = dispense(RaneyNickel)
	rani_a1b21[0] = dispense(RaneyNickel)
	rani_a2b11[0] = dispense(RaneyNickel)
	rani_a2b21[0] = dispense(RaneyNickel)
	desulf_a1b1_raw1[0] = mix(a1b1_dissolved1[0], rani_a1b11[0]) @ 5.0SECOND
	desulf_a1b2_raw1[0] = mix(a1b2_dissolved1[0], rani_a1b21[0]) @ 5.0SECOND
	desulf_a2b1_raw1[0] = mix(a2b1_dissolved1[0], rani_a2b11[0]) @ 5.0SECOND
	desulf_a2b2_raw1[0] = mix(a2b2_dissolved1[0], rani_a2b21[0]) @ 5.0SECOND
	desulf_a1b1_mixed1[0] = mix(desulf_a1b1_raw1[0], desulf_a1b1_raw1[0]) @ 60.0SECOND
	desulf_a1b2_mixed1[0] = mix(desulf_a1b2_raw1[0], desulf_a1b2_raw1[0]) @ 60.0SECOND
	desulf_a2b1_mixed1[0] = mix(desulf_a2b1_raw1[0], desulf_a2b1_raw1[0]) @ 60.0SECOND
	desulf_a2b2_mixed1[0] = mix(desulf_a2b2_raw1[0], desulf_a2b2_raw1[0]) @ 60.0SECOND
	heat(desulf_a1b1_mixed1[0]) @ 25.0CELSIUS @ 900.0SECOND
	heat(desulf_a1b2_mixed1[0]) @ 25.0CELSIUS @ 900.0SECOND
	heat(desulf_a2b1_mixed1[0]) @ 25.0CELSIUS @ 900.0SECOND
	heat(desulf_a2b2_mixed1[0]) @ 25.0CELSIUS @ 900.0SECOND
	dispose(desulf_a1b1_mixed1[0])
	dispose(desulf_a1b2_mixed1[0])
	dispose(desulf_a2b1_mixed1[0])
	dispose(desulf_a2b2_mixed1[0])
	meoh_prod_a1b11[0] = dispense(MeOH)
	meoh_prod_a1b21[0] = dispense(MeOH)
	meoh_prod_a2b11[0] = dispense(MeOH)
	meoh_prod_a2b21[0] = dispense(MeOH)
	heat(meoh_prod_a1b11[0]) @ 25.0CELSIUS @ 1800.0SECOND
	heat(meoh_prod_a1b21[0]) @ 25.0CELSIUS @ 1800.0SECOND
	heat(meoh_prod_a2b11[0]) @ 25.0CELSIUS @ 1800.0SECOND
	heat(meoh_prod_a2b21[0]) @ 25.0CELSIUS @ 1800.0SECOND
	desulfSignal1[0] = detect(nmrDetection, meoh_prod_a1b11[0]) @ 30.0SECOND
	if desulfSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	a1_drop11[0] = dispense(Boc_Ala_SH)
	a1_drop21[0] = dispense(Boc_Ala_SH)
	a2_drop11[0] = dispense(Boc_Val_SH)
	a2_drop21[0] = dispense(Boc_Val_SH)
	b1_drop11[0] = dispense(Az_Ala_An)
	b1_drop21[0] = dispense(Az_Ala_An)
	b2_drop11[0] = dispense(Az_Pro_An)
	b2_drop21[0] = dispense(Az_Pro_An)
	a1b1_merge1[0] = mix(a1_drop11[0], b1_drop11[0]) @ 5.0SECOND
	a1b2_merge1[0] = mix(a1_drop21[0], b2_drop11[0]) @ 5.0SECOND
	a2b1_merge1[0] = mix(a2_drop11[0], b1_drop21[0]) @ 5.0SECOND
	a2b2_merge1[0] = mix(a2_drop21[0], b2_drop21[0]) @ 5.0SECOND
	a1b1_mixed1[0] = mix(a1b1_merge1[0], a1b1_merge1[0]) @ 60.0SECOND
	a1b2_mixed1[0] = mix(a1b2_merge1[0], a1b2_merge1[0]) @ 60.0SECOND
	a2b1_mixed1[0] = mix(a2b1_merge1[0], a2b1_merge1[0]) @ 60.0SECOND
	a2b2_mixed1[0] = mix(a2b2_merge1[0], a2b2_merge1[0]) @ 60.0SECOND
	heat(a1b1_mixed1[0]) @ 25.0CELSIUS @ 3600.0SECOND
	heat(a1b2_mixed1[0]) @ 25.0CELSIUS @ 3600.0SECOND
	heat(a2b1_mixed1[0]) @ 25.0CELSIUS @ 3600.0SECOND
	heat(a2b2_mixed1[0]) @ 25.0CELSIUS @ 3600.0SECOND
	heat(a1b1_mixed1[0]) @ 25.0CELSIUS @ 900.0SECOND
	heat(a1b2_mixed1[0]) @ 25.0CELSIUS @ 900.0SECOND
	heat(a2b1_mixed1[0]) @ 25.0CELSIUS @ 900.0SECOND
	heat(a2b2_mixed1[0]) @ 25.0CELSIUS @ 900.0SECOND
	ligationSignal1[0] = detect(msDetection, a1b1_mixed1[0]) @ 30.0SECOND
	if ligationSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(meoh_prod_a1b11[0])
	dispose(meoh_prod_a1b21[0])
	dispose(meoh_prod_a2b11[0])
	dispose(meoh_prod_a2b21[0])
bsbbif_6_f:
	dispose(meoh_prod_a1b11[0])
	dispose(meoh_prod_a1b21[0])
	dispose(meoh_prod_a2b11[0])
	dispose(meoh_prod_a2b21[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(desulfSignal1[0])
	NOP
