{
  "protocol": {
    "title": "Digital Microfluidic Method for Protein Extraction by Precipitation",
    "source": "Analytical Chemistry, 2009, Vol. 81, No. 1, pp. 330-335",
    "source_link": "https://microfluidics.utoronto.ca/papers/precipitation.pdf",
    "doi": "https://doi.org/10.1021/ac8021554",
    "authors": ["Mais J. Jebrail", "Aaron R. Wheeler"],
    "journal": "Analytical Chemistry",
    "year": 2009,
    "volume": 81,
    "issue": 1,
    "pages": "330-335",
    "platform": "Digital Microfluidics (DMF) on Parylene-C / Teflon-AF coated glass",
    "objective": "Automated DMF-based protein extraction by precipitation, rinsing, and resolubilization from heterogeneous fluids including protein standards (BSA, Mb, Fb), fetal bovine serum (FBS), and Jurkat T-cell lysate (CL). No centrifugation required. Extraction time ~15 min vs. ~30 min conventional.",

    "device": {
      "geometry": "Double-T (double cross) electrode layout",
      "substrate": "Glass wafer",
      "electrodes": {
        "material": "Chromium, 250 nm",
        "patterning": "Photolithography",
        "actuation_electrodes_mm": ["1x1", "1.5x1.5"],
        "reservoir_electrodes_mm": ["2.5x2.5", "3.0x3.0"],
        "interelectrode_gap_um": 40,
        "actuation_frequency_kHz": 18,
        "actuation_voltage_Vrms": "70-100"
      },
      "dielectric": "Parylene-C, 2.5 um (vapor deposition)",
      "hydrophobic_coating": "Teflon-AF, 50 nm (1% wt/wt in Fluorinert FC-40; 2000 rpm / 60 s; post-baked 160 C / 10 min)",
      "top_plate": "Unpatterned ITO-coated glass + Teflon-AF (50 nm)",
      "spacer": {
        "material": "Double-sided tape",
        "thickness_um": [70, 140],
        "note": "70 um used for cell lysate (viscous); 140 um standard"
      },
      "key_electrode": "Extraction electrode -- precipitation, rinsing, and resolubilization all occur on its surface",
      "reservoirs": {
        "count": 5,
        "types": ["Sample", "Precipitant", "Rinse solution", "Resolubilizing buffer", "Waste"]
      }
    },

    "droplet_volumes": {
      "sample_and_precipitant_nL": 140,
      "rinse_and_resolubilization_nL": 315,
      "cell_lysate_sample_nL": 70,
      "cell_lysate_rinse_resolubilization_nL": 158,
      "note": "Electrode dimensions chosen so normal droplets are 140 nL (sample/precipitant) and 315 nL (rinse/resolubilization)"
    },

    "reagents": {
      "carrier_fluid": "Fluorinert FC-40",
      "surface_blocking_agent": "Pluronics F-127, 0.08% w/v in 10 mM borate buffer pH 8.5",
      "protein_working_buffer": "10 mM borate buffer pH 8.5 + 0.08% Pluronics F127 (w/v)",
      "precipitants": {
        "ACN": {
          "full_name": "Acetonitrile",
          "used_for": ["Myoglobin (Mb)", "Fibrinogen (Fb)", "Mb/PC mixture (primary)"],
          "role": "primary"
        },
        "AmmoniumSulfate_Saturated": {
          "full_name": "Saturated ammonium sulfate in DI water",
          "used_for": ["Mb/PC mixture"],
          "role": "secondary",
          "note": "Required at low Mb concentration (0.71 mM); ACN alone insufficient below ~1 mM"
        },
        "TCA_20percent": {
          "full_name": "20% trichloroacetic acid in DI water",
          "used_for": ["BSA", "FBS", "Cell lysate"],
          "role": "primary",
          "note": "Best precipitant for large proteins and complex mixtures"
        }
      },
      "rinse_solutions": {
        "Chloroform_ACN_70_30": {
          "composition": "70/30 v/v chloroform/acetonitrile",
          "used_for": ["Mb", "Fb", "Mb/PC mixture", "BSA"],
          "note": "Neat chloroform not actuatable at low driving potentials; 70/30 mixture is readily movable"
        },
        "Acetone": {
          "used_for": ["FBS"],
          "note": "Removes TCA traces; neat acetone dissolves some CL precipitate so not used for CL"
        },
        "Chloroform_Acetone_60_40": {
          "composition": "60/40 v/v chloroform/acetone",
          "used_for": ["Cell lysate"],
          "note": "Neat acetone dissolves some CL precipitate; this mixture avoids that"
        }
      },
      "resolubilization_buffers": {
        "BoratBuffer_pH85_1percentSDS": {
          "composition": "10 mM borate buffer pH 8.5 + 1% SDS",
          "used_for": ["Mb (qualitative)", "Mb (quantitative)", "Fb", "BSA"]
        },
        "BoratBuffer_pH85_10percentSDS": {
          "composition": "100 mM borate buffer pH 8.5 + 10% SDS",
          "used_for": ["FBS", "Cell lysate"]
        }
      },
      "fluorescence_assay_reagent": {
        "name": "Fluorescamine",
        "concentration": "5 mg/mL in acetone",
        "excitation_nm": 390,
        "emission_nm": 510,
        "mechanism": "Non-fluorescent until reacts with primary amines at protein N-terminus; reaction immediate",
        "platform": "Pherastar plate reader (BMG Labtech), 384-well low-volume microplate"
      }
    },

    "protein_standards": [
      {
        "name": "BSA",
        "full_name": "Bovine serum albumin",
        "mw_kDa": 66,
        "pI": 4.7,
        "concentration_mg_mL": 50,
        "precipitant": "TCA_20percent",
        "secondary_precipitant": null,
        "rinse": "Chloroform_ACN_70_30",
        "resolubilization": "BoratBuffer_pH85_1percentSDS",
        "bake_before_resolubilization": true,
        "bake_temp_C": 95,
        "bake_duration_s": 300,
        "recovery_pct": ">80",
        "assay_concentration_for_linearity": "50 mg/mL"
      },
      {
        "name": "Mb",
        "full_name": "Myoglobin",
        "mw_kDa": 17,
        "pI": 7.3,
        "concentration_mg_mL": 30,
        "precipitant": "Acetonitrile",
        "secondary_precipitant": null,
        "rinse": "Chloroform_ACN_70_30",
        "resolubilization": "BoratBuffer_pH85_1percentSDS",
        "bake_before_resolubilization": false,
        "dry_temp_C": 25,
        "dry_duration_s": 300,
        "recovery_pct": ">80",
        "assay_concentration_for_linearity": "30 mg/mL"
      },
      {
        "name": "Fb",
        "full_name": "Fibrinogen",
        "mw_kDa": 340,
        "pI": 5.5,
        "concentration_mg_mL": 20,
        "precipitant": "Acetonitrile",
        "secondary_precipitant": null,
        "rinse": "Chloroform_ACN_70_30",
        "resolubilization": "BoratBuffer_pH85_1percentSDS",
        "bake_before_resolubilization": false,
        "dry_temp_C": 25,
        "dry_duration_s": 300,
        "recovery_pct": ">80",
        "assay_concentration_for_linearity": "20 mg/mL"
      }
    ],

    "complex_mixtures": [
      {
        "name": "FBS",
        "full_name": "Fetal bovine serum",
        "source": "Invitrogen Canada",
        "precipitant": "TCA_20percent",
        "rinse": "Acetone",
        "resolubilization": "BoratBuffer_pH85_10percentSDS",
        "bake_before_resolubilization": true,
        "bake_temp_C": 95,
        "bake_duration_s": 300,
        "sample_volume_nL": 140,
        "rinse_volume_nL": 315,
        "resolubilization_volume_nL": 315,
        "recovery_pct": { "mean": 84.0, "sd": 7.8, "n": 4 },
        "notes": "Supplemental rinse strategy used for sticky precipitates: rinse solvent dispensed to extraction electrode; combined rinse+supernatant driven to waste."
      },
      {
        "name": "CellLysate",
        "full_name": "Jurkat T-cell lysate",
        "cell_line": "Jurkat T-cells",
        "culture": "RPMI 1640 + 10% FBS + penicillin (100 IU/mL) + streptomycin (100 ug/mL); 37 C, 5% CO2",
        "lysis_buffer": "PBS + 0.08% F127 + 1% Triton X-100 + 1 mM PMSF",
        "lysis_protocol": "Wash 1x PBS; suspend 6e7 cells/mL in lysis buffer; incubate on ice 30 min; centrifuge 13000 rpm 5 min; collect supernatant; store -80 C",
        "precipitant": "TCA_20percent",
        "rinse": "Chloroform_Acetone_60_40",
        "resolubilization": "BoratBuffer_pH85_10percentSDS",
        "bake_before_resolubilization": true,
        "bake_temp_C": 95,
        "bake_duration_s": 300,
        "interplate_spacing_um": 70,
        "sample_volume_nL": 70,
        "rinse_volume_nL": 158,
        "resolubilization_volume_nL": 158,
        "recovery_pct": { "mean": 82.4, "sd": 11.5, "n": 4 },
        "notes": "Interplate spacing reduced from 140 to 70 um to handle high viscosity of lysate. Supplemental rinse strategy applied for sticky precipitates."
      }
    ],

    "qualitative_model_system": {
      "analyte": { "name": "Mb", "concentration_mM": 0.71 },
      "contaminant": { "name": "PC (1,2-dibutyroyl-sn-glycero-3-phosphocholine)", "concentration_mM": 62, "molar_excess": "80:1" },
      "precipitants": ["Acetonitrile (primary)", "Saturated ammonium sulfate (secondary)"],
      "rinse": "70/30 v/v chloroform/ACN",
      "resolubilization": "10 mM borate pH 8.5 + 1% SDS",
      "analysis": {
        "instrument": "LTQ linear ion trap mass spectrometer (Thermo Fischer Scientific)",
        "mode": "ESI positive ion",
        "sample_prep": "315 nL diluted into 50 uL 50/50 water/ACN + 0.1% formic acid",
        "flow_rate_uL_min": 0.5,
        "voltage_kV": "1.7-1.9",
        "capillary_temp_C": 170,
        "acquisitions_averaged": 50,
        "replicates": 3,
        "pass_criteria": "Mb multiply charged ions at m/z 600-1800 (charges +27 to +10) detected; PC ions at m/z 398, 795 suppressed"
      }
    },

    "steps": [
      {
        "id": "S1",
        "name": "Device priming",
        "bb": "BB1",
        "inputs": ["PluronicF127_PBS"],
        "operation": "heat",
        "temperature_C": 25,
        "duration_s": 300,
        "bs_variable": "primingDrop",
        "notes": "0.08% Pluronics F127 in borate buffer; coats Teflon-AF to reduce non-specific protein adsorption"
      },
      {
        "id": "S2",
        "name": "Qualitative extraction -- sample and primary precipitant dispensing",
        "bb": "BB1",
        "inputs": ["Mb_PC_Mixture", "Acetonitrile"],
        "operation": "mix",
        "duration_s": 300,
        "sample_volume_nL": 140,
        "precipitant_volume_nL": 140,
        "bs_variables": { "sample": "mbPcSample", "precipitant": "precipitant1_Mb", "product": "mbPcPrecip1" },
        "notes": "Mb 0.71 mM + PC 62 mM; merged on extraction electrode; incubate ~5 min at RT"
      },
      {
        "id": "S3",
        "name": "Qualitative extraction -- secondary precipitant addition",
        "bb": "BB1",
        "inputs": ["AmmoniumSulfate_Saturated"],
        "operation": "mix",
        "duration_s": 300,
        "precipitant_volume_nL": 140,
        "bs_variables": { "precipitant": "precipitant2_Mb", "product": "mbPcPrecipFull" },
        "notes": "Required at low Mb concentration; saturated ammonium sulfate drives precipitation"
      },
      {
        "id": "S4",
        "name": "Supernatant removal",
        "bb": "BB1",
        "operation": "drain",
        "bs_variables": { "supernatant": "supernatant1" },
        "notes": "Actuate supernatant to waste reservoir; precipitate adheres to Teflon-AF; no centrifugation"
      },
      {
        "id": "S5",
        "name": "Rinsing (x3)",
        "bb": "BB1",
        "inputs": ["Chloroform_ACN_70_30"],
        "operation": "mix then drain",
        "rinse_volume_nL": 315,
        "duration_per_rinse_s": 30,
        "cycles": 3,
        "bs_variables": {
          "rinse_droplets": ["rinse1_Mb", "rinse2_Mb", "rinse3_Mb"],
          "rinsed_products": ["rinsed1_Mb", "rinsed2_Mb", "rinsed3_Mb"]
        },
        "notes": "Each rinse driven across extraction electrode to waste; removes PC lipid contamination"
      },
      {
        "id": "S6",
        "name": "Drying",
        "bb": "BB1",
        "operation": "heat",
        "temperature_C": 25,
        "duration_s": 300,
        "bs_variable": "mbPcPrecipFull",
        "notes": "Air dry at room temperature; no bake required for chloroform/ACN rinse"
      },
      {
        "id": "S7",
        "name": "Resolubilization (qualitative)",
        "bb": "BB1",
        "inputs": ["BoratBuffer_pH85_1percentSDS"],
        "operation": "mix",
        "duration_s": 300,
        "resolubilization_volume_nL": 315,
        "bs_variables": { "buffer": "resolubBuffer_Mb", "product": "resolubMb" },
        "notes": "10 mM borate pH 8.5 + 1% SDS dispensed to extraction electrode; dissolves precipitate"
      },
      {
        "id": "S8",
        "name": "Qualitative QC -- ESI-MS detection",
        "bb": "BB1",
        "operation": "detect",
        "module": "precipitationDetection",
        "duration_s": 30,
        "bs_variable": "precipitationSignal",
        "branch": {
          "pass": { "condition": "precipitationSignal > 0", "action": "dispose(resolubMb)", "bb": "BB2" },
          "fail": { "condition": "precipitationSignal <= 0", "action": "drain(resolubMb)", "bb": "BB3" }
        }
      },
      {
        "id": "S9a",
        "name": "BSA extraction (quantitative)",
        "bb": "BB4",
        "inputs": ["BSA", "TCA_20percent", "Chloroform_ACN_70_30", "BoratBuffer_pH85_1percentSDS"],
        "sample_volume_nL": 140,
        "precipitant_volume_nL": 140,
        "rinse_volume_nL": 315,
        "rinse_cycles": 3,
        "rinse_duration_s": 30,
        "bake_temp_C": 95,
        "bake_duration_s": 300,
        "resolubilization_volume_nL": 315,
        "resolubilization_duration_s": 300,
        "bs_variables": {
          "sample": "bsaSample", "precipitant": "tcaDrop_BSA", "precip_product": "bsaPrecip",
          "resolub_buffer": "bsaResolub", "resolub_product": "resolubBSA"
        }
      },
      {
        "id": "S9b",
        "name": "Mb extraction (quantitative)",
        "bb": "BB4",
        "inputs": ["Myoglobin_Mb", "Acetonitrile", "Chloroform_ACN_70_30", "BoratBuffer_pH85_1percentSDS"],
        "sample_volume_nL": 140,
        "precipitant_volume_nL": 140,
        "rinse_volume_nL": 315,
        "rinse_cycles": 3,
        "rinse_duration_s": 30,
        "dry_temp_C": 25,
        "dry_duration_s": 300,
        "resolubilization_volume_nL": 315,
        "resolubilization_duration_s": 300,
        "bs_variables": {
          "sample": "mbSample", "precipitant": "acnDrop_Mb", "precip_product": "mbPrecip",
          "resolub_buffer": "mbResolub", "resolub_product": "resolubMbQuant"
        }
      },
      {
        "id": "S9c",
        "name": "Fb extraction (quantitative)",
        "bb": "BB4",
        "inputs": ["Fibrinogen_Fb", "Acetonitrile", "Chloroform_ACN_70_30", "BoratBuffer_pH85_1percentSDS"],
        "sample_volume_nL": 140,
        "precipitant_volume_nL": 140,
        "rinse_volume_nL": 315,
        "rinse_cycles": 3,
        "rinse_duration_s": 30,
        "dry_temp_C": 25,
        "dry_duration_s": 300,
        "resolubilization_volume_nL": 315,
        "resolubilization_duration_s": 300,
        "bs_variables": {
          "sample": "fbSample", "precipitant": "acnDrop_Fb", "precip_product": "fbPrecip",
          "resolub_buffer": "fbResolub", "resolub_product": "resolubFb"
        }
      },
      {
        "id": "S9d",
        "name": "Fluorescamine assay (quantitative QC)",
        "bb": "BB4",
        "inputs": ["Fluorescamine"],
        "operation": "mix then heat then detect",
        "reaction_duration_s": 60,
        "incubation_temp_C": 25,
        "incubation_duration_s": 120,
        "detection_module": "fluorescenceDetection",
        "detection_duration_s": 30,
        "qc_gate_keyed_on": "BSA signal (assayBSA)",
        "bs_variables": {
          "fluorescamine": ["fluorescamine_BSA", "fluorescamine_Mb", "fluorescamine_Fb"],
          "assay_products": ["assayBSA", "assayMb", "assayFb"],
          "signal": "fluorSignal"
        },
        "branch": {
          "pass": { "condition": "fluorSignal > 0", "action": "dispose(assayBSA, assayMb, assayFb)", "bb": "BB5" },
          "fail": { "condition": "fluorSignal <= 0", "action": "dispose(assayBSA, assayMb, assayFb)", "bb": "BB6",
                    "compiler_note": "drain replaced with dispose; lilott8/BioScript collapses drain to dispose in IR" }
        }
      },
      {
        "id": "S10a",
        "name": "FBS extraction (complex mixture)",
        "bb": "BB7",
        "inputs": ["FBS", "TCA_20percent", "Acetone", "BoratBuffer_pH85_10percentSDS"],
        "sample_volume_nL": 140,
        "precipitant_volume_nL": 140,
        "rinse_volume_nL": 315,
        "rinse_cycles": 3,
        "rinse_duration_s": 30,
        "bake_temp_C": 95,
        "bake_duration_s": 300,
        "resolubilization_volume_nL": 315,
        "resolubilization_duration_s": 300,
        "bs_variables": {
          "sample": "fbsSample", "precipitant": "tcaDrop_FBS", "precip_product": "fbsPrecip",
          "resolub_buffer": "fbsResolub", "resolub_product": "resolubFBS"
        },
        "notes": "Supplemental rinse strategy: rinse solvent merged with residual supernatant at extraction electrode; driven to waste together"
      },
      {
        "id": "S10b",
        "name": "Cell lysate extraction (complex mixture)",
        "bb": "BB7",
        "inputs": ["CellLysate", "TCA_20percent", "Chloroform_Acetone_60_40", "BoratBuffer_pH85_10percentSDS"],
        "sample_volume_nL": 70,
        "precipitant_volume_nL": 70,
        "rinse_volume_nL": 158,
        "rinse_cycles": 3,
        "rinse_duration_s": 30,
        "bake_temp_C": 95,
        "bake_duration_s": 300,
        "resolubilization_volume_nL": 158,
        "resolubilization_duration_s": 300,
        "interplate_spacing_um": 70,
        "bs_variables": {
          "sample": "clSample", "precipitant": "tcaDrop_CL", "precip_product": "clPrecip",
          "resolub_buffer": "clResolub", "resolub_product": "resolubCL"
        },
        "notes": "Interplate spacing reduced to 70 um for viscous lysate. Chloroform/acetone 60/40 used instead of acetone to prevent precipitate dissolution."
      },
      {
        "id": "S10c",
        "name": "Fluorescamine assay (complex mixture QC)",
        "bb": "BB7",
        "inputs": ["Fluorescamine"],
        "operation": "mix then heat then detect",
        "reaction_duration_s": 60,
        "incubation_temp_C": 25,
        "incubation_duration_s": 120,
        "detection_module": "fluorescenceDetection",
        "detection_duration_s": 30,
        "qc_gate_keyed_on": "FBS signal (assayFBS)",
        "bs_variables": {
          "fluorescamine": ["fluorescamine_FBS", "fluorescamine_CL"],
          "assay_products": ["assayFBS", "assayCL"],
          "signal": "complexSignal"
        },
        "branch": {
          "pass": { "condition": "complexSignal > 0", "action": "dispose(assayFBS, assayCL)", "bb": "BB8" },
          "fail": { "condition": "complexSignal <= 0", "action": "dispose(assayFBS, assayCL)", "bb": "BB9",
                    "compiler_note": "drain replaced with dispose; lilott8/BioScript collapses drain to dispose in IR" }
        }
      }
    ],

    "cfg": {
      "basic_blocks": [
        { "id": "BB1",  "label": "main",             "ir_label": "main",          "type": "entry",
          "description": "Device priming; qualitative Mb/PC extraction (ESI-MS model)" },
        { "id": "BB2",  "label": "qualitativePass",   "ir_label": "bsbbif_2_t",   "type": "branch_true",
          "condition": "precipitationSignal > 0", "action": "dispose(resolubMb)" },
        { "id": "BB3",  "label": "qualitativeFail",   "ir_label": "bsbbif_3_f",   "type": "branch_false",
          "condition": "precipitationSignal <= 0", "action": "drain(resolubMb)",
          "ir_action": "dispose(resolubMb)",
          "compiler_note": "drain collapses to dispose in IR; acceptable for this branch" },
        { "id": "BB4",  "label": "qualitativeJoin",   "ir_label": "bsbbif_4_j",   "type": "join",
          "description": "Dispose precipitationSignal; begin protein standard quantitative branch" },
        { "id": "BB5",  "label": "quantPass",         "ir_label": "bsbbif_5_t",   "type": "branch_true",
          "condition": "fluorSignal > 0", "action": "dispose(assayBSA, assayMb, assayFb)" },
        { "id": "BB6",  "label": "quantFail",         "ir_label": "bsbbif_6_f",   "type": "branch_false",
          "condition": "fluorSignal <= 0", "action": "dispose(assayBSA, assayMb, assayFb)",
          "compiler_note": "drain replaced with dispose explicitly; compiler fix applied in .bs file" },
        { "id": "BB7",  "label": "quantJoin",         "ir_label": "bsbbif_7_j",   "type": "join",
          "description": "Dispose fluorSignal; begin complex mixture (FBS/CL) branch" },
        { "id": "BB8",  "label": "complexPass",       "ir_label": "bsbbif_8_t",   "type": "branch_true",
          "condition": "complexSignal > 0", "action": "dispose(assayFBS, assayCL)" },
        { "id": "BB9",  "label": "complexFail",       "ir_label": "bsbbif_9_f",   "type": "branch_false",
          "condition": "complexSignal <= 0", "action": "dispose(assayFBS, assayCL)",
          "compiler_note": "drain replaced with dispose explicitly; compiler fix applied in .bs file" },
        { "id": "BB10", "label": "finalCleanup",      "ir_label": "bsbbif_10_j",  "type": "terminal",
          "description": "Dispose complexSignal; NOP; experiment ends" }
      ],
      "edges": [
        ["BB1","BB2"], ["BB1","BB3"],
        ["BB2","BB4"], ["BB3","BB4"],
        ["BB4","BB5"], ["BB4","BB6"],
        ["BB5","BB7"], ["BB6","BB7"],
        ["BB7","BB8"], ["BB7","BB9"],
        ["BB8","BB10"],["BB9","BB10"]
      ],
      "total_basic_blocks": 10,
      "total_edges": 12,
      "if_else_gates": 3
    },

    "bioscript_compiler_notes": {
      "bs_file": "jebrail_dmf_protein_precipitation.bs",
      "compiler": "lilott8/BioScript (ANTLR4-based)",
      "ir_file": "jebrail_dmf_protein_precipitation.ir",
      "dag_file": "jebrail_dmf_protein_precipitation_main_dag.dot",
      "supported_duration_units": ["s", "m"],
      "duration_conversions": {
        "5m_precipitation_resolubilization": "300.0SECOND",
        "30s_rinsing": "30.0SECOND",
        "5m_drying_baking": "300.0SECOND",
        "1m_fluorescamine_reaction": "60.0SECOND",
        "2m_incubation_settle": "120.0SECOND",
        "30s_detection": "30.0SECOND"
      },
      "modules": ["precipitationDetection", "fluorescenceDetection"],
      "compiler_quirks": [
        {
          "issue": "drain collapses to dispose in IR output",
          "affected_blocks": ["BB6 (bsbbif_6_f)", "BB9 (bsbbif_9_f)"],
          "fix": "drain replaced with explicit dispose in both else-branches in .bs file",
          "status": "resolved in v2 of .bs file"
        },
        {
          "issue": "BB3 (qualitativeFail) drain also collapses to dispose in IR",
          "affected_blocks": ["BB3 (bsbbif_3_f)"],
          "fix": "none applied; drain retained in .bs source; IR shows dispose which is acceptable",
