bsbbif_2_t:
	dispose(yieldSignal1[0])
bsbbif_3_f:
	dispose(yieldSignal1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	puritySignal1[0] = detect(rnaPurityDetection, elutionMix1[0]) @ 30.0SECOND
	if puritySignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	fillerFluid1[0] = dispense(FluorinertFC40)
	surfactant1[0] = dispense(PluronicF127)
	devicePrime1[0] = mix(fillerFluid1[0], surfactant1[0]) @ 30.0SECOND
	wash1Reservoir1[0] = dispense(Wash1Solution)
	wash2Reservoir1[0] = dispense(Wash2Solution)
	elutionReservoir1[0] = dispense(ElutionBuffer)
	bloodSpecimen1[0] = dispense(WholeBlood)
	lysisSolution1[0] = dispense(LysisSolution)
	bloodLysate1[0] = mix(bloodSpecimen1[0], lysisSolution1[0]) @ 30.0SECOND
	rnaBeads1[0] = dispense(RNABindingBeads)
	beadLysateMix1[0] = mix(bloodLysate1[0], rnaBeads1[0]) @ 30.0SECOND
	heat(beadLysateMix1[0]) @ 25.0CELSIUS @ 300.0SECOND
	bridgingDroplet11[0] = mix(beadLysateMix1[0], devicePrime1[0]) @ 5.0SECOND
	heat(bridgingDroplet11[0]) @ 25.0CELSIUS @ 60.0SECOND
	bridgingDroplet21[0] = mix(bridgingDroplet11[0], devicePrime1[0]) @ 5.0SECOND
	heat(bridgingDroplet21[0]) @ 25.0CELSIUS @ 60.0SECOND
	bridgingDroplet31[0] = mix(bridgingDroplet21[0], devicePrime1[0]) @ 5.0SECOND
	heat(bridgingDroplet31[0]) @ 25.0CELSIUS @ 60.0SECOND
	beadCapture1[0] = mix(bridgingDroplet31[0], devicePrime1[0]) @ 5.0SECOND
	heat(beadCapture1[0]) @ 25.0CELSIUS @ 10.0SECOND
	heat(wash1Reservoir1[0]) @ 25.0CELSIUS @ 10.0SECOND
	wash1Mix1[0] = mix(wash1Reservoir1[0], beadCapture1[0]) @ 30.0SECOND
	heat(wash1Mix1[0]) @ 25.0CELSIUS @ 30.0SECOND
	wash1Beads1[0] = mix(wash1Mix1[0], devicePrime1[0]) @ 5.0SECOND
	dispose(wash1Mix1[0])
	heat(wash2Reservoir1[0]) @ 25.0CELSIUS @ 10.0SECOND
	wash2Mix1[0] = mix(wash2Reservoir1[0], wash1Beads1[0]) @ 30.0SECOND
	heat(wash2Mix1[0]) @ 25.0CELSIUS @ 30.0SECOND
	wash2Beads1[0] = mix(wash2Mix1[0], devicePrime1[0]) @ 5.0SECOND
	dispose(wash2Mix1[0])
	heat(elutionReservoir1[0]) @ 25.0CELSIUS @ 10.0SECOND
	elutionMix1[0] = mix(elutionReservoir1[0], wash2Beads1[0]) @ 30.0SECOND
	heat(elutionMix1[0]) @ 25.0CELSIUS @ 120.0SECOND
	heat(elutionMix1[0]) @ 25.0CELSIUS @ 30.0SECOND
	yieldSignal1[0] = detect(rnaYieldDetection, elutionMix1[0]) @ 30.0SECOND
	if yieldSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(elutionMix1[0])
bsbbif_6_f:
	dispose(elutionMix1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(puritySignal1[0])
	NOP
