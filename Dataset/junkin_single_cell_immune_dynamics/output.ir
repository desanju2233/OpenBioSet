bsbbif_2_t:
	dispose(sandwichDone1[0])
bsbbif_3_f:
	dispose(sandwichDone1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(nfkbSignal1[0])
	tnfSignal1[0] = detect(tnfSecretionDetection, bead1Washed1[0]) @ 30.0SECOND
	if tnfSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	pluronicSol1[0] = dispense(PluronicF127)
	pbsRinse1[0] = dispense(PBS)
	devicePrimed1[0] = mix(pluronicSol1[0], pbsRinse1[0]) @ 43200.0SECOND
	macrophages1[0] = dispense(RAW2647_Macrophages)
	cellsLoaded1[0] = mix(macrophages1[0], devicePrimed1[0]) @ 600.0SECOND
	medEq1[0] = dispense(CultureMedium)
	cellsEq1[0] = mix(cellsLoaded1[0], medEq1[0]) @ 600.0SECOND
	heat(cellsEq1[0]) @ 37.0CELSIUS @ 7200.0SECOND
	medT01[0] = dispense(CultureMedium)
	sampleT01[0] = mix(cellsEq1[0], medT01[0]) @ 7200.0SECOND
	bead11[0] = dispense(TNF_CaptureBeads)
	pbt11[0] = dispense(PBSTween)
	bead1Bound1[0] = mix(sampleT01[0], bead11[0]) @ 5400.0SECOND
	bead1Washed1[0] = mix(bead1Bound1[0], pbt11[0]) @ 300.0SECOND
	lpsInput1[0] = dispense(LPS_500ngmL)
	cellsStim1[0] = mix(bead1Washed1[0], lpsInput1[0]) @ 7200.0SECOND
	heat(cellsStim1[0]) @ 37.0CELSIUS @ 7200.0SECOND
	medWash1[0] = dispense(CultureMedium)
	cellsWashed1[0] = mix(cellsStim1[0], medWash1[0]) @ 600.0SECOND
	medTP11[0] = dispense(CultureMedium)
	sampleTP11[0] = mix(cellsWashed1[0], medTP11[0]) @ 7200.0SECOND
	bead21[0] = dispense(TNF_CaptureBeads)
	pbt21[0] = dispense(PBSTween)
	bead2Bound1[0] = mix(sampleTP11[0], bead21[0]) @ 5400.0SECOND
	bead2Washed1[0] = mix(bead2Bound1[0], pbt21[0]) @ 300.0SECOND
	heat(bead2Washed1[0]) @ 37.0CELSIUS @ 7200.0SECOND
	medTP21[0] = dispense(CultureMedium)
	sampleTP21[0] = mix(bead2Washed1[0], medTP21[0]) @ 7200.0SECOND
	bead31[0] = dispense(TNF_CaptureBeads)
	pbt31[0] = dispense(PBSTween)
	bead3Bound1[0] = mix(sampleTP21[0], bead31[0]) @ 5400.0SECOND
	bead3Washed1[0] = mix(bead3Bound1[0], pbt31[0]) @ 300.0SECOND
	heat(bead3Washed1[0]) @ 37.0CELSIUS @ 7200.0SECOND
	medTP31[0] = dispense(CultureMedium)
	sampleTP31[0] = mix(bead3Washed1[0], medTP31[0]) @ 7200.0SECOND
	bead41[0] = dispense(TNF_CaptureBeads)
	pbt41[0] = dispense(PBSTween)
	bead4Bound1[0] = mix(sampleTP31[0], bead41[0]) @ 5400.0SECOND
	bead4Washed1[0] = mix(bead4Bound1[0], pbt41[0]) @ 300.0SECOND
	heat(bead4Washed1[0]) @ 37.0CELSIUS @ 7200.0SECOND
	medTP41[0] = dispense(CultureMedium)
	sampleTP41[0] = mix(bead4Washed1[0], medTP41[0]) @ 7200.0SECOND
	bead51[0] = dispense(TNF_CaptureBeads)
	pbt51[0] = dispense(PBSTween)
	bead5Bound1[0] = mix(sampleTP41[0], bead51[0]) @ 5400.0SECOND
	bead5Washed1[0] = mix(bead5Bound1[0], pbt51[0]) @ 300.0SECOND
	heat(bead5Washed1[0]) @ 37.0CELSIUS @ 7200.0SECOND
	medTP51[0] = dispense(CultureMedium)
	sampleTP51[0] = mix(bead5Washed1[0], medTP51[0]) @ 7200.0SECOND
	bead61[0] = dispense(TNF_CaptureBeads)
	pbt61[0] = dispense(PBSTween)
	bead6Bound1[0] = mix(sampleTP51[0], bead61[0]) @ 5400.0SECOND
	bead6Washed1[0] = mix(bead6Bound1[0], pbt61[0]) @ 300.0SECOND
	heat(bead6Washed1[0]) @ 37.0CELSIUS @ 7200.0SECOND
	medTP61[0] = dispense(CultureMedium)
	sampleTP61[0] = mix(bead6Washed1[0], medTP61[0]) @ 7200.0SECOND
	bead71[0] = dispense(TNF_CaptureBeads)
	pbt71[0] = dispense(PBSTween)
	bead7Bound1[0] = mix(sampleTP61[0], bead71[0]) @ 5400.0SECOND
	bead7Washed1[0] = mix(bead7Bound1[0], pbt71[0]) @ 300.0SECOND
	detAb1[0] = dispense(TNF_DetectionAntibody)
	secAb1[0] = dispense(SecondaryFluorescentAntibody)
	detStep1[0] = mix(bead7Washed1[0], detAb1[0]) @ 1800.0SECOND
	sandwichDone1[0] = mix(detStep1[0], secAb1[0]) @ 1800.0SECOND
	nfkbSignal1[0] = detect(nfkbLocalizationDetection, sandwichDone1[0]) @ 30.0SECOND
	if nfkbSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(bead1Washed1[0])
bsbbif_6_f:
	dispose(bead1Washed1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(tnfSignal1[0])
	NOP
