bsbbif_2_t:
	primingFlush1[0] = dispense(SupplementedDMEM)
	primedCulture1[0] = mix(culture_d91[0], primingFlush1[0]) @ 120.0SECOND
	drugCh01[0] = dispense(SupplementedDMEM)
	drugCh11[0] = dispense(DoxorubicinStock)
	drugCh21[0] = dispense(DoxorubicinStock)
	drugCh31[0] = dispense(DoxorubicinStock)
	drugCh41[0] = dispense(DoxorubicinStock)
	drugCh51[0] = dispense(DoxorubicinStock)
	drugCh61[0] = dispense(DoxorubicinStock)
	drugCh71[0] = dispense(DoxorubicinStock)
	culture_ch01[0] = mix(primedCulture1[0], drugCh01[0]) @ 300.0SECOND
	culture_ch11[0] = mix(drugCh11[0], drugCh21[0]) @ 300.0SECOND
	culture_ch21[0] = mix(drugCh31[0], drugCh41[0]) @ 300.0SECOND
	culture_ch31[0] = mix(drugCh51[0], drugCh61[0]) @ 300.0SECOND
	culture_ch41[0] = mix(culture_ch11[0], culture_ch21[0]) @ 300.0SECOND
	culture_ch51[0] = mix(culture_ch31[0], drugCh71[0]) @ 300.0SECOND
	drug_all1[0] = mix(culture_ch41[0], culture_ch51[0]) @ 300.0SECOND
	heat(culture_ch01[0]) @ 37.0CELSIUS @ 259200.0SECOND
	heat(drug_all1[0]) @ 37.0CELSIUS @ 259200.0SECOND
	stainCtrl1[0] = dispense(CalceinAM_EtBr_CD45APC_Stain)
	stainDrug1[0] = dispense(CalceinAM_EtBr_CD45APC_Stain)
	stained_ctrl1[0] = mix(culture_ch01[0], stainCtrl1[0]) @ 2700.0SECOND
	stained_drug1[0] = mix(drug_all1[0], stainDrug1[0]) @ 2700.0SECOND
	viabilitySignal1[0] = detect(ctcViabilityDetection, stained_ctrl1[0]) @ 2700.0SECOND
	if viabilitySignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
bsbbif_3_f:
	dispose(culture_d91[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	PHI culture_d92 = {culture_d91,culture_d9}
	PHI culture_ch42 = {culture_ch41,culture_ch4}
	PHI stained_ctrl3 = {stained_ctrl2,stained_ctrl}
	PHI viabilitySignal3 = {viabilitySignal2,viabilitySignal}
	PHI stainDrug2 = {stainDrug1,stainDrug}
	PHI drugCh62 = {drugCh61,drugCh6}
	PHI stained_drug3 = {stained_drug2,stained_drug}
	PHI stainCtrl2 = {stainCtrl1,stainCtrl}
	PHI culture_ch22 = {culture_ch21,culture_ch2}
	PHI culture_ch02 = {culture_ch01,culture_ch0}
	PHI drugCh02 = {drugCh01,drugCh0}
	PHI primingFlush2 = {primingFlush1,primingFlush}
	PHI drugCh12 = {drugCh11,drugCh1}
	PHI drugCh72 = {drugCh71,drugCh7}
	PHI drugCh42 = {drugCh41,drugCh4}
	PHI drugCh22 = {drugCh21,drugCh2}
	PHI drugCh32 = {drugCh31,drugCh3}
	PHI culture_ch52 = {culture_ch51,culture_ch5}
	PHI drugCh52 = {drugCh51,drugCh5}
	PHI drug_all2 = {drug_all1,drug_all}
	PHI primedCulture2 = {primedCulture1,primedCulture}
	PHI culture_ch32 = {culture_ch31,culture_ch3}
	PHI culture_ch12 = {culture_ch11,culture_ch1}
	dispose(clusterSignal1[0])
	NOP
main:
	bloodSample1[0] = dispense(WholeBlood)
	lysisBuffer1[0] = dispense(RBC_LysisBuffer)
	lysateMix1[0] = mix(bloodSample1[0], lysisBuffer1[0]) @ 300.0SECOND
	heat(lysateMix1[0]) @ 25.0CELSIUS @ 300.0SECOND
	pbsWash1[0] = dispense(PBS)
	washedCells1[0] = mix(lysateMix1[0], pbsWash1[0]) @ 120.0SECOND
	seedingMedia1[0] = dispense(SupplementedDMEM)
	seededCulture1[0] = mix(washedCells1[0], seedingMedia1[0]) @ 300.0SECOND
	heat(seededCulture1[0]) @ 37.0CELSIUS @ 259200.0SECOND
	freshMedia11[0] = dispense(SupplementedDMEM)
	culture_d31[0] = mix(seededCulture1[0], freshMedia11[0]) @ 120.0SECOND
	heat(culture_d31[0]) @ 37.0CELSIUS @ 259200.0SECOND
	freshMedia21[0] = dispense(SupplementedDMEM)
	culture_d61[0] = mix(culture_d31[0], freshMedia21[0]) @ 120.0SECOND
	heat(culture_d61[0]) @ 37.0CELSIUS @ 259200.0SECOND
	freshMedia31[0] = dispense(SupplementedDMEM)
	culture_d91[0] = mix(culture_d61[0], freshMedia31[0]) @ 120.0SECOND
	heat(culture_d91[0]) @ 37.0CELSIUS @ 172800.0SECOND
	clusterSignal1[0] = detect(clusterDetection, culture_d91[0]) @ 30.0SECOND
	if clusterSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(stained_ctrl1[0])
	dispose(stained_drug1[0])
	dispose(viabilitySignal1[0])
bsbbif_6_f:
	dispose(stained_ctrl1[0])
	dispose(stained_drug1[0])
	dispose(viabilitySignal1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	jump: bsbbif_4_j
