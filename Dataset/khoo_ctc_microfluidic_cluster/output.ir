bsbbif_2_t:
	dispose(culturedDay31[0])
bsbbif_3_f:
	dispose(culturedDay31[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(clusterSignal1[0])
	doxorubicin1[0] = dispense(Doxorubicin)
	dmemForDrug1[0] = dispense(SupplementedDMEM)
	drugSolution1[0] = mix(doxorubicin1[0], dmemForDrug1[0]) @ 5.0SECOND
	heat(drugSolution1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	calceinAM1[0] = dispense(CalceinAM)
	piStain1[0] = dispense(PropidiumIodide)
	viabilityStain1[0] = mix(calceinAM1[0], piStain1[0]) @ 60.0SECOND
	druggedClusters1[0] = mix(drugSolution1[0], viabilityStain1[0]) @ 900.0SECOND
	drugSignal1[0] = detect(drugEfficacyDetection, druggedClusters1[0]) @ 30.0SECOND
	if drugSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	ethanolA1[0] = dispense(Ethanol70)
	ethanolB1[0] = dispense(Ethanol70)
	primingEthanol1[0] = mix(ethanolA1[0], ethanolB1[0]) @ 300.0SECOND
	pbsWashA1[0] = dispense(PBS)
	pbsWashB1[0] = dispense(PBS)
	primingPBS1[0] = mix(pbsWashA1[0], pbsWashB1[0]) @ 300.0SECOND
	dispose(primingEthanol1[0])
	dispose(primingPBS1[0])
	fitcDye251[0] = dispense(FITCDye)
	diWater251[0] = dispense(DIWater)
	gradMix251[0] = mix(fitcDye251[0], diWater251[0]) @ 1800.0SECOND
	calibSig251[0] = detect(clusterFormationDetection, gradMix251[0]) @ 30.0SECOND
	dispose(gradMix251[0])
	dispose(calibSig251[0])
	fitcDye501[0] = dispense(FITCDye)
	diWater501[0] = dispense(DIWater)
	gradMix501[0] = mix(fitcDye501[0], diWater501[0]) @ 1800.0SECOND
	calibSig501[0] = detect(clusterFormationDetection, gradMix501[0]) @ 30.0SECOND
	dispose(gradMix501[0])
	dispose(calibSig501[0])
	fitcDye1001[0] = dispense(FITCDye)
	diWater1001[0] = dispense(DIWater)
	gradMix1001[0] = mix(fitcDye1001[0], diWater1001[0]) @ 1800.0SECOND
	calibSig1001[0] = detect(clusterFormationDetection, gradMix1001[0]) @ 30.0SECOND
	dispose(gradMix1001[0])
	dispose(calibSig1001[0])
	fitcDye1501[0] = dispense(FITCDye)
	diWater1501[0] = dispense(DIWater)
	gradMix1501[0] = mix(fitcDye1501[0], diWater1501[0]) @ 1800.0SECOND
	calibSig1501[0] = detect(clusterFormationDetection, gradMix1501[0]) @ 30.0SECOND
	dispose(gradMix1501[0])
	dispose(calibSig1501[0])
	fitcDye2001[0] = dispense(FITCDye)
	diWater2001[0] = dispense(DIWater)
	gradMix2001[0] = mix(fitcDye2001[0], diWater2001[0]) @ 1800.0SECOND
	calibSig2001[0] = detect(clusterFormationDetection, gradMix2001[0]) @ 30.0SECOND
	dispose(gradMix2001[0])
	dispose(calibSig2001[0])
	pbsFlushA1[0] = dispense(PBS)
	pbsFlushB1[0] = dispense(PBS)
	pbsFlush1[0] = mix(pbsFlushA1[0], pbsFlushB1[0]) @ 300.0SECOND
	dispose(pbsFlush1[0])
	patientBlood1[0] = dispense(PatientBlood)
	rbcBuffer1[0] = dispense(RBCLysisBuffer)
	lysedBlood1[0] = mix(patientBlood1[0], rbcBuffer1[0]) @ 180.0SECOND
	heat(lysedBlood1[0]) @ 25.0CELSIUS @ 180.0SECOND
	dispose(lysedBlood1[0])
	pelletWashPBS1[0] = dispense(PBS)
	pelletWash1[0] = mix(pelletWashPBS1[0], pelletWashPBS1[0]) @ 180.0SECOND
	dispose(pelletWash1[0])
	resuspMedia1[0] = dispense(SupplementedDMEM)
	cellSuspension1[0] = mix(resuspMedia1[0], pelletWashPBS1[0]) @ 60.0SECOND
	freshBloodFeed1[0] = dispense(PatientBlood)
	seededDevice1[0] = mix(cellSuspension1[0], freshBloodFeed1[0]) @ 120.0SECOND
	heat(seededDevice1[0]) @ 37.0CELSIUS @ 259200.0SECOND
	dispose(seededDevice1[0])
	freshMedia11[0] = dispense(SupplementedDMEM)
	culturedDay31[0] = mix(seededDevice1[0], freshMedia11[0]) @ 60.0SECOND
	heat(culturedDay31[0]) @ 37.0CELSIUS @ 950400.0SECOND
	clusterSignal1[0] = detect(clusterFormationDetection, culturedDay31[0]) @ 30.0SECOND
	if clusterSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(druggedClusters1[0])
bsbbif_6_f:
	dispose(druggedClusters1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(drugSignal1[0])
	harvestPBS1[0] = dispense(PBS)
	trypsinEDTA1[0] = dispense(TrypsinEDTA)
	trypsinMix1[0] = mix(harvestPBS1[0], trypsinEDTA1[0]) @ 180.0SECOND
	heat(trypsinMix1[0]) @ 37.0CELSIUS @ 180.0SECOND
	freshMedia21[0] = dispense(SupplementedDMEM)
	neutralisedCells1[0] = mix(trypsinMix1[0], freshMedia21[0]) @ 60.0SECOND
	dispose(neutralisedCells1[0])
	resuspPBS1[0] = dispense(PBS)
	harvestedCells1[0] = mix(resuspPBS1[0], neutralisedCells1[0]) @ 60.0SECOND
	pfaFixative1[0] = dispense(ParaformaldehydeFixative)
	fixedCells1[0] = mix(harvestedCells1[0], pfaFixative1[0]) @ 600.0SECOND
	heat(fixedCells1[0]) @ 4.0CELSIUS @ 600.0SECOND
	bsaBlock1[0] = dispense(BSA)
	blockedCells1[0] = mix(fixedCells1[0], bsaBlock1[0]) @ 1800.0SECOND
	heat(blockedCells1[0]) @ 4.0CELSIUS @ 1800.0SECOND
	tritonX1[0] = dispense(TritonX100)
	permCells1[0] = mix(blockedCells1[0], tritonX1[0]) @ 60.0SECOND
	heat(permCells1[0]) @ 4.0CELSIUS @ 60.0SECOND
	pbsWash21[0] = dispense(PBS)
	washedCells1[0] = mix(permCells1[0], pbsWash21[0]) @ 180.0SECOND
	dispose(washedCells1[0])
	panCKAb1[0] = dispense(PanCytokeratinAb)
	cd45Ab1[0] = dispense(CD45Ab)
	hoechst1[0] = dispense(HoechstDye)
	abMix11[0] = mix(panCKAb1[0], cd45Ab1[0]) @ 5.0SECOND
	abMix1[0] = mix(abMix11[0], hoechst1[0]) @ 5.0SECOND
	stainedCells1[0] = mix(washedCells1[0], abMix1[0]) @ 1800.0SECOND
	heat(stainedCells1[0]) @ 4.0CELSIUS @ 1800.0SECOND
	finalWashPBS1[0] = dispense(PBS)
	imagingCells1[0] = mix(stainedCells1[0], finalWashPBS1[0]) @ 180.0SECOND
	stainingSignal1[0] = detect(immunostainingDetection, imagingCells1[0]) @ 30.0SECOND
	if stainingSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(imagingCells1[0])
bsbbif_9_f:
	dispose(imagingCells1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(stainingSignal1[0])
	NOP
