bsbbif_2_t:
	dispose(dnaLibrary1[0])
bsbbif_3_f:
	dispose(dnaLibrary1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(librarySignal1[0])
	NOP
main:
	gdnaDroplet1[0] = dispense(GenomicDNA)
	nexteraEnzyme1[0] = dispense(NexteraEnzymeMix)
	tagmentationMix1[0] = mix(gdnaDroplet1[0], nexteraEnzyme1[0]) @ 30.0SECOND
	heat(tagmentationMix1[0]) @ 55.0CELSIUS @ 300.0SECOND
	cleanupBeads1[0] = dispense(MagneticBeads_SPRI)
	tagmentedBead1[0] = mix(tagmentationMix1[0], cleanupBeads1[0]) @ 30.0SECOND
	dispose(tagmentedBead1[0])
	ethanolWash11[0] = dispense(EthanolWash)
	ethanolBolus11[0] = mix(ethanolWash11[0], ethanolWash11[0]) @ 30.0SECOND
	dispose(ethanolBolus11[0])
	ethanolWash21[0] = dispense(EthanolWash)
	ethanolBolus21[0] = mix(ethanolWash21[0], ethanolWash21[0]) @ 30.0SECOND
	dispose(ethanolBolus21[0])
	ethanolWash31[0] = dispense(EthanolWash)
	ethanolBolus31[0] = mix(ethanolWash31[0], ethanolWash31[0]) @ 30.0SECOND
	dispose(ethanolBolus31[0])
	elutionBuf11[0] = dispense(ElutionBuffer)
	cleanedDNA1[0] = mix(elutionBuf11[0], elutionBuf11[0]) @ 30.0SECOND
	pcrMix1[0] = dispense(PCRMixture)
	prePCRDroplet1[0] = mix(cleanedDNA1[0], pcrMix1[0]) @ 30.0SECOND
	heat(prePCRDroplet1[0]) @ 72.0CELSIUS @ 180.0SECOND
	heat(prePCRDroplet1[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(prePCRDroplet1[0]) @ 62.0CELSIUS @ 2200.0SECOND
	sizeSelBeads11[0] = dispense(MagneticBeads_SPRI)
	sizeSelMix11[0] = mix(prePCRDroplet1[0], sizeSelBeads11[0]) @ 30.0SECOND
	librarySuper1[0] = mix(sizeSelMix11[0], sizeSelMix11[0]) @ 10.0SECOND
	dispose(sizeSelMix11[0])
	sizeSelBeads21[0] = dispense(MagneticBeads_SPRI)
	sizeSelMix21[0] = mix(librarySuper1[0], sizeSelBeads21[0]) @ 30.0SECOND
	ethanolSS1[0] = dispense(EthanolWash)
	sizeSelWash1[0] = mix(sizeSelMix21[0], ethanolSS1[0]) @ 30.0SECOND
	dispose(sizeSelWash1[0])
	elutionBuf21[0] = dispense(ElutionBuffer)
	dnaLibrary1[0] = mix(elutionBuf21[0], elutionBuf21[0]) @ 30.0SECOND
	librarySignal1[0] = detect(libraryQC, dnaLibrary1[0]) @ 30.0SECOND
	if librarySignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
