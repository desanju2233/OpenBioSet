{
  "protocol": {
    "title": "Discovery of New States of Immunomodulation for Vaccine Adjuvants via High Throughput Screening: Expanding Innate Responses to PRRs",
    "source": "ACS Central Science 2023, 9, 427-439",
    "doi": "10.1021/acscentsci.2c01351",
    "platform": "High-throughput robotic liquid handling (384-well plate, pin-drop dispenser, plate reader, AlphaLISA); in vivo murine vaccination model",
    "cell_lines": [
      "RAW-Dual macrophages (murine; dual NF-kB SEAP / IRF luciferase reporter)",
      "THP-1 monocytes (human; cytokine secretion panel)",
      "BMDC (murine bone-marrow-derived dendritic cells; lead compound validation)"
    ],
    "objective": "Identify small-molecule immunomodulators that alter PRR-driven NF-kB and IRF innate immune signalling pathways; downselect via cytokine vaccine score; validate lead compounds in murine vaccination models",

    "screening_library": {
      "primary_library_size": 3147,
      "composition": {
        "NF_kB_IRF_inhibitors": 246,
        "pathway_specific_inhibitors": 2895
      },
      "compound_concentration_uM": 10,
      "solvent": "DMSO",
      "final_DMSO_vol_pct": "<0.05",
      "addition_method": "pin-drop (robotic)",
      "downselected_secondary_library_size": 720,
      "downselection_method": "PCA (NF-kB + IRF, 16 variables, 8 agonists); retain compounds outside radius 1.75 centred at origin"
    },

    "PRR_agonists": {
      "primary_screen_count": 13,
      "majority_class": "Toll-like receptors (TLRs)",
      "representative_agonists": [
        { "name": "Pam3CSK4", "receptor": "TLR2/1" },
        { "name": "Pam2CSK4", "receptor": "TLR2/6" },
        { "name": "Poly I:C", "receptor": "TLR3" },
        { "name": "LPS",      "receptor": "TLR4" },
        { "name": "MPLA",     "receptor": "TLR4" },
        { "name": "Flagellin","receptor": "TLR5" },
        { "name": "Imiquimod","receptor": "TLR7" },
        { "name": "TL8-506",  "receptor": "TLR8" },
        { "name": "ODN 1826", "receptor": "TLR9" },
        { "name": "3'3'-cGAMP", "receptor": "STING" },
        { "name": "Tri-DAP",  "receptor": "NOD1" },
        { "name": "MDP",      "receptor": "NOD2" },
        { "name": "mIFN-B",   "receptor": "IFNAR1/2" }
      ],
      "agonist_concentration": "EC50 per agonist (SI Appendix Table S2)",
      "secondary_screen_count": 7,
      "secondary_subset": ["Pam3CSK4","Pam2CSK4","Poly I:C","LPS","Flagellin","R848","3'3'-cGAMP"]
    },

    "reagents": {
      "primary_screen": {
        "cells": "RAW-Dual macrophages",
        "cell_culture_media": "DMEM + 10% FBS",
        "plate_format": "384-well",
        "NF_kB_readout_reagent": "QUANTI-Blue (absorbance 620 nm; SEAP reporter)",
        "IRF_readout_reagent": "QUANTI-Luc (luminescence; luciferase reporter)"
      },
      "secondary_screen": {
        "cells": "THP-1 monocytes",
        "cell_culture_media": "RPMI-1640 + 10% FBS",
        "plate_format": "384-well",
        "detection_platform": "AlphaLISA (PerkinElmer)",
        "cytokines_measured": [
          { "name": "IL-1beta",  "role": "endogenous pyrogen; partially outside direct NF-kB regulation" },
          { "name": "IL-12p40", "role": "activates NK cells; Th1/Th17 polarisation" },
          { "name": "IP-10 (CXCL10)", "role": "chemoattractant for T cells and DCs; early adjuvant signal" },
          { "name": "CCL4",    "role": "chemoattractant for monocytes and NK cells; tolerability correlate" },
          { "name": "TNF-alpha","role": "baseline generalised inflammation; endogenous pyrogen" },
          { "name": "IFN-beta", "role": "antiviral type I interferon; strong IRF pathway correlate" }
        ],
        "AlphaLISA_excitation_nm": 680,
        "AlphaLISA_emission_nm": 615,
        "replicates": "triplicate duplexed measurements"
      },
      "in_vivo": {
        "mouse_strain": "C57/B6",
        "injection_route": "intramuscular (i.m.)",
        "modulator_dose_umol": 1.5,
        "vehicle": "DMSO:Addavax 1:1 v/v",
        "commercial_vaccines": [
          {
            "name": "Fluzone 2021-2022",
            "type": "inactivated quadrivalent influenza vaccine",
            "readout": "anti-HA IgG (A/Victoria/2570/2019 and B/Phuket/3073/2013) at Day 49; log AUC by ELISA"
          },
          {
            "name": "Typhim-Vi",
            "type": "carbohydrate-based typhoid vaccine",
            "readout": "systemic TNF-alpha at 1 h post-injection (pg/mL)"
          }
        ],
        "subunit_model_antigen": "Ovalbumin (OVA)",
        "subunit_model_adjuvants": ["R848 (TLR7/8)", "Flagellin (TLR5)", "CpG 1826 (TLR9)"],
        "prime_boost_schedule_days": [0, 21],
        "antibody_titer_days": [35, 49],
        "early_cytokine_timepoint_h": 1,
        "n_per_group": 4
      }
    },

    "viability_qc": {
      "method": "live-cell imaging + digital confluency masking",
      "software": "digital analysis (confluency masks)",
      "purpose": "Remove toxic modulator/agonist combinations before transcription factor readout",
      "reference": "SI Appendix Figure S3"
    },

    "vaccine_scoring": {
      "description": "Quantitative weighted score normalising each cytokine fold-change to [-1, 1] range per agonist dynamic range; summed across agonists for generalist score",
      "cytokine_weights": {
        "IFN-beta": "positive (enhance)",
        "IP-10":    "positive (enhance)",
        "CCL4":     "positive (enhance)",
        "IL-12p40": "positive (enhance)",
        "TNF-alpha": "negative (suppress)",
        "IL-1beta":  "negative (suppress)"
      },
      "specialist_score": "single agonist-modulator combination",
      "generalist_score": "sum of specialist scores across all agonists (N=720 pool)",
      "top_generalist_score_range": "6 to 10",
      "reference": "SI Appendix Figure S9"
    },

    "lead_modulators": [
      { "id": "PME-564",  "class": "tyrosine kinase inhibitor (Lyn kinase)",  "generalist_score": "~8-10", "in_vivo_effect": "antibody enhancer; ~4-fold log AUC increase with Fluzone; 2-6x OVA IgG increase" },
      { "id": "PME-397",  "class": "not disclosed",                            "generalist_score": "high",  "in_vivo_effect": "cytokine reducer; decreases TNF-alpha for CpG/R848" },
      { "id": "PME-1226", "class": "not disclosed",                            "generalist_score": "high",  "in_vivo_effect": "cytokine reducer; decreases TNF-alpha for CpG" },
      { "id": "PME-2809", "class": "not disclosed",                            "generalist_score": "high",  "in_vivo_effect": "antibody enhancer; increases late NF-kB AUC" },
      { "id": "PME-378",  "class": "not disclosed",                            "generalist_score": "moderate", "in_vivo_effect": "reduces inflammation to ~half for R848" },
      { "id": "PME-2834", "class": "pan-WNK kinase inhibitor",                 "generalist_score": "high",  "in_vivo_effect": "antibody enhancer with Fluzone" },
      { "id": "PME-2988", "class": "not disclosed",                            "generalist_score": "~-20 (negative control)", "in_vivo_effect": "eliminates IL-12/IFN-beta/IP-10; enhances IL-1beta and TNF-alpha ~100x" },
      { "id": "PME-2539", "class": "not disclosed",                            "generalist_score": "moderate positive", "in_vivo_effect": "candidate for cancer immunotherapy; enhances TNF-alpha ~36x with cGAMP" }
    ],

    "steps": [
      {
        "id": "S1",
        "name": "Primary screen — cell seeding",
        "phase": "primary",
        "bb": "BB1",
        "inputs": ["RAW-Dual macrophages", "CellCultureMedia"],
        "operation": "dispense + mix (robotic seeding)",
        "plate_format": "384-well",
        "incubation_temperature_C": 37,
        "incubation_duration_h": 24,
        "incubation_duration_min": 1440,
        "notes": "Cells seeded at optimised density for consistent NF-kB/IRF dynamic range (SI Appendix Figure S1); adherence step before compound addition"
      },
      {
        "id": "S2",
        "name": "Primary screen — immunomodulator pin-drop addition",
        "phase": "primary",
        "bb": "BB1",
        "inputs": ["Immunomodulator_DMSO_Stock"],
        "operation": "pin-drop dispense (~23 nL of 10 mM DMSO stock into 230 uL well)",
        "final_concentration_uM": 10,
        "final_DMSO_pct": "<0.05",
        "pre_incubation_before_agonist_h": 1,
        "pre_incubation_before_agonist_min": 60,
        "incubation_temperature_C": 37,
        "notes": "Modulator added 1 h before agonist to allow uptake/equilibration"
      },
      {
        "id": "S3",
        "name": "Primary screen — PRR agonist addition",
        "phase": "primary",
        "bb": "BB1",
        "inputs": ["PRR_Agonist_Pam3CSK4","PRR_Agonist_LPS","PRR_Agonist_R848","PRR_Agonist_CpG1826"],
        "operation": "robotic dispense at EC50 per agonist",
        "agonist_count_primary": 13,
        "agonist_concentration": "EC50 (SI Appendix Table S2)",
        "notes": "Agonist added after modulator pre-incubation; four representative agonists instantiated in BioScript; 13 used in paper"
      },
      {
        "id": "S4",
        "name": "Primary screen — 24 h co-incubation",
        "phase": "primary",
        "bb": "BB1",
        "operation": "heat (incubator)",
        "incubation_temperature_C": 37,
        "co2_pct": 5,
        "incubation_duration_h": 24,
        "incubation_duration_min": 1440,
        "notes": "Transcription factor activity develops over 24 h; supernatant drawn after incubation"
      },
      {
        "id": "S5",
        "name": "Primary screen — cell viability QC (confluency imaging)",
        "phase": "primary",
        "bb": "BB1",
        "operation": "detect (viabilityDetection module)",
        "method": "live-cell imaging + digital confluency mask",
        "detection_duration_s": 30,
        "purpose": "Remove toxic compounds before transcription factor readout",
        "reference": "SI Appendix Figure S3"
      },
      {
        "id": "S6",
        "name": "Primary screen — dual NF-kB/IRF transcription factor readout",
        "phase": "primary",
        "bb": "BB1",
        "operation": "detect (nfkbIrfDetection module)",
        "NF_kB_method": "SEAP reporter; QUANTI-Blue; absorbance 620 nm",
        "IRF_method": "luciferase reporter; QUANTI-Luc; luminescence",
        "detection_duration_s": 60,
        "report_as": "fold change vs agonist-alone control",
        "downselection": "PCA on 16 variables (NF-kB + IRF across 8 high-z-factor agonists); retain outside radius 1.75; 3147 -> 720",
        "branch": {
          "pass": { "condition": "primarySignalLPS > 0", "action": "dispose all wells", "bb": "BB2" },
          "fail": { "condition": "primarySignalLPS <= 0", "action": "drain all wells",   "bb": "BB3" }
        },
        "reference": "SI Appendix Figure S4"
      },
      {
        "id": "S7",
        "name": "Secondary screen — THP-1 cell seeding",
        "phase": "secondary",
        "bb": "BB4",
        "inputs": ["THP1_Monocytes","CellCultureMedia"],
        "operation": "dispense + mix (robotic seeding)",
        "rationale": "Switch from RAW-Dual (murine) to THP-1 (human) for human AlphaLISA reagent compatibility and higher cytokine multiplexing",
        "incubation_temperature_C": 37,
        "incubation_duration_h": 24,
        "incubation_duration_min": 1440
      },
      {
        "id": "S8",
        "name": "Secondary screen — re-apply lead modulator",
        "phase": "secondary",
        "bb": "BB4",
        "inputs": ["Immunomodulator_DMSO_Stock"],
        "operation": "pin-drop dispense",
        "final_concentration_uM": 10,
        "pre_incubation_before_agonist_min": 60,
        "incubation_temperature_C": 37,
        "compounds_screened": 720,
        "agonists_per_compound": 7
      },
      {
        "id": "S9",
        "name": "Secondary screen — PRR agonist addition and 24 h incubation",
        "phase": "secondary",
        "bb": "BB4",
        "inputs": ["PRR_Agonist_R848"],
        "operation": "dispense + mix + heat",
        "incubation_temperature_C": 37,
        "co2_pct": 5,
        "incubation_duration_h": 24,
        "incubation_duration_min": 1440
      },
      {
        "id": "S10",
        "name": "Secondary screen — AlphaLISA cytokine detection",
        "phase": "secondary",
        "bb": "BB4",
        "inputs": ["AlphaLISA_Reagent"],
        "operation": "mix + heat (bead equilibration) + detect",
        "AlphaLISA_bead_equilibration_temperature_C": 25,
        "AlphaLISA_bead_equilibration_duration_min": 60,
        "AlphaLISA_excitation_nm": 680,
        "AlphaLISA_emission_nm": 615,
        "detection_duration_s": 60,
        "crosstalk_correction": true,
        "standard_curves": "per cytokine per agonist (SI Appendix Table S5)",
        "report_as": "fold change vs agonist-alone; normalised to [-1,1] for vaccine score",
        "branch": {
          "pass": { "condition": "secondarySignal > 0 (vaccine score >= 6)", "action": "dispose detectionWell; proceed to BMDC validation", "bb": "BB5" },
          "fail": { "condition": "secondarySignal <= 0",                      "action": "drain detectionWell",                                "bb": "BB6" }
        },
        "reference": "SI Appendix Figure S5"
      },
      {
        "id": "S11",
        "name": "BMDC validation (off-chip; lead compounds only)",
        "phase": "secondary",
        "bb": "BB5",
        "inputs": ["BMDC_Cells"],
        "operation": "cytokine production + cell surface marker assay (off-chip)",
        "purpose": "Confirm lead modulators in murine primary DCs before in vivo dosing",
        "reference": "SI Appendix Figure S10"
      },
      {
        "id": "S12",
        "name": "In vivo — prime injection (Day 0)",
        "phase": "in_vivo",
        "bb": "BB7",
        "inputs": ["Immunomodulator_DMSO_Stock","DMSO_Vehicle","Fluzone_Vaccine","TyphimVi_Vaccine","OVA_Antigen","PRR_Agonist_R848"],
        "operation": "mix (i.m. co-formulation) + inject",
        "modulator_dose_umol": 1.5,
        "vehicle": "DMSO:Addavax 1:1 v/v",
        "injection_route": "intramuscular",
        "arms": [
          "Arm A: Fluzone 2021-2022 + modulator (antibody titer endpoint)",
          "Arm B: Typhim-Vi + modulator (cytokine tolerability endpoint)",
          "Arm C: OVA + R848/Flagellin/CpG + modulator (mechanistic characterisation)"
        ],
        "early_cytokine_timepoint_h": 1,
        "early_cytokine_readout": "systemic TNF-alpha (pg/mL) by AlphaLISA or ELISA"
      },
      {
        "id": "S13",
        "name": "In vivo — boost injection (Day 21)",
        "phase": "in_vivo",
        "bb": "BB7",
        "operation": "heat (Day 0 to Day 21 interval) + mix (boost formulation) + inject",
        "interval_days": 21,
        "interval_min": 30240,
        "modulator_dose_umol": 1.5,
        "vehicle": "DMSO:Addavax 1:1 v/v"
      },
      {
        "id": "S14",
        "name": "In vivo — antibody titer readout (Day 35 and Day 49)",
        "phase": "in_vivo",
        "bb": "BB7",
        "operation": "heat (Day 21 to Day 49 interval) + detect (vaccinationQC module)",
        "interval_days": 28,
        "interval_min": 40320,
        "detection_duration_s": 60,
        "method": "ELISA; log AUC reported",
        "Fluzone_targets": ["A/Victoria/2570/2019 HA", "B/Phuket/3073/2013 HA"],
        "OVA_target": "anti-OVA IgG (D49 n=4)",
        "primary_endpoint_day": 49,
        "branch": {
          "pass": { "condition": "vaccinationSignal > 0 (significant IgG increase OR TNF-alpha reduction)", "action": "dispose all vaccination samples", "bb": "BB8" },
          "fail": { "condition": "vaccinationSignal <= 0",                                                   "action": "drain all vaccination samples",   "bb": "BB9" }
        }
      }
    ],

    "cfg": {
      "basic_blocks": [
        { "id": "BB1",  "label": "main",          "type": "entry",        "phase": "primary screen" },
        { "id": "BB2",  "label": "bsbbif_2_t",    "type": "branch_true",  "condition": "primarySignalLPS > 0",       "action": "dispose all agonist wells" },
        { "id": "BB3",  "label": "bsbbif_3_f",    "type": "branch_false", "condition": "primarySignalLPS <= 0",      "action": "drain all agonist wells" },
        { "id": "BB4",  "label": "bsbbif_4_j",    "type": "join",         "phase": "secondary screen begins" },
        { "id": "BB5",  "label": "bsbbif_5_t",    "type": "branch_true",  "condition": "secondarySignal > 0",        "action": "dispose detectionWell; BMDC validation" },
        { "id": "BB6",  "label": "bsbbif_6_f",    "type": "branch_false", "condition": "secondarySignal <= 0",       "action": "drain detectionWell" },
        { "id": "BB7",  "label": "bsbbif_7_j",    "type": "join",         "phase": "in vivo validation begins" },
        { "id": "BB8",  "label": "bsbbif_8_t",    "type": "branch_true",  "condition": "vaccinationSignal > 0",      "action": "dispose all vaccination samples; lead modulator validated" },
        { "id": "BB9",  "label": "bsbbif_9_f",    "type": "branch_false", "condition": "vaccinationSignal <= 0",     "action": "drain all vaccination samples" },
        { "id": "BB10", "label": "bsbbif_10_j",   "type": "terminal",     "phase": "pipeline complete" }
      ],
      "edges": [
        ["BB1","BB2"],  ["BB1","BB3"],
        ["BB2","BB4"],  ["BB3","BB4"],
        ["BB4","BB5"],  ["BB4","BB6"],
        ["BB5","BB7"],  ["BB6","BB7"],
        ["BB7","BB8"],  ["BB7","BB9"],
        ["BB8","BB10"], ["BB9","BB10"]
      ]
    }
  }
}
