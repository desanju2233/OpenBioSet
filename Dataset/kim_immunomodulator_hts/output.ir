	heat(wellLPS1[0]) @ 37.0CELSIUS @ 86400.0SECOND
	heat(wellR8481[0]) @ 37.0CELSIUS @ 86400.0SECOND
	heat(wellCpG1[0]) @ 37.0CELSIUS @ 86400.0SECOND
	viabilityCheckLPS1[0] = detect(viabilityDetection, wellLPS1[0]) @ 30.0SECOND
	primarySignalPam31[0] = detect(nfkbIrfDetection, wellPam3CSK41[0]) @ 60.0SECOND
	primarySignalLPS1[0] = detect(nfkbIrfDetection, wellLPS1[0]) @ 60.0SECOND
	primarySignalR8481[0] = detect(nfkbIrfDetection, wellR8481[0]) @ 60.0SECOND
	primarySignalCpG1[0] = detect(nfkbIrfDetection, wellCpG1[0]) @ 60.0SECOND
	if primarySignalLPS1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
