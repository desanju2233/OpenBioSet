	secondarySignal1[0] = detect(cytokineDetection, detectionWell1[0]) @ 60.0SECOND
	if secondarySignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	rawCells1[0] = dispense(RAWDual_Macrophages)
	seedingMedia1[0] = dispense(CellCultureMedia)
	seededPlate1[0] = mix(rawCells1[0], seedingMedia1[0]) @ 5.0SECOND
