	heat(modCells1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	agonistPam3CSK41[0] = dispense(PRR_Agonist_Pam3CSK4)
	agonistLPS1[0] = dispense(PRR_Agonist_LPS)
	agonistR8481[0] = dispense(PRR_Agonist_R848)
	agonistCpG1[0] = dispense(PRR_Agonist_CpG1826)
	wellPam3CSK41[0] = mix(modCells1[0], agonistPam3CSK41[0]) @ 5.0SECOND
	wellLPS1[0] = mix(modCells1[0], agonistLPS1[0]) @ 5.0SECOND
	wellR8481[0] = mix(modCells1[0], agonistR8481[0]) @ 5.0SECOND
	wellCpG1[0] = mix(modCells1[0], agonistCpG1[0]) @ 5.0SECOND
