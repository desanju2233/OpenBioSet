	iggOVA1[0] = detect(vaccinationQC, ovaBoost1[0]) @ 60.0SECOND
	vaccinationSignal1[0] = detect(vaccinationQC, iggFluzone1[0]) @ 30.0SECOND
	if vaccinationSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
