bsbbif_2_t:
	dispose(detectCh161[0])
bsbbif_3_f:
	dispose(detectCh161[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(bindingSignal1[0])
	if ch1Signal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	beads1[0] = dispense(StreptavidinBeads)
	antiCRP1[0] = dispense(BiotinAntiCRP)
	functionalizedBeads1[0] = mix(beads1[0], antiCRP1[0]) @ 10.0SECOND
	heat(functionalizedBeads1[0]) @ 25.0CELSIUS @ 64800.0SECOND
	pbs_w11[0] = dispense(PBS)
	wash1Out1[0] = mix(functionalizedBeads1[0], pbs_w11[0]) @ 5.0SECOND
	dispose(wash1Out1[0])
	pellet21[0] = dispense(StreptavidinBeads)
	pbs_w21[0] = dispense(PBS)
	wash2Out1[0] = mix(pellet21[0], pbs_w21[0]) @ 5.0SECOND
	dispose(wash2Out1[0])
	pellet31[0] = dispense(StreptavidinBeads)
	pbs_w31[0] = dispense(PBS)
	wash3Out1[0] = mix(pellet31[0], pbs_w31[0]) @ 5.0SECOND
	dispose(wash3Out1[0])
	pellet41[0] = dispense(StreptavidinBeads)
	antiCRPFinal1[0] = dispense(BiotinAntiCRP)
	reboundBeads1[0] = mix(pellet41[0], antiCRPFinal1[0]) @ 5.0SECOND
	diluentPBS1[0] = dispense(PBS)
	readyBeads1[0] = mix(reboundBeads1[0], diluentPBS1[0]) @ 5.0SECOND
	bsaBlock1[0] = dispense(BSA_Block)
	blockingStep1[0] = mix(bsaBlock1[0], readyBeads1[0]) @ 10.0SECOND
	heat(blockingStep1[0]) @ 25.0CELSIUS @ 600.0SECOND
	buf_pre11[0] = dispense(Buffer)
	prewash11[0] = mix(blockingStep1[0], buf_pre11[0]) @ 5.0SECOND
	buf_pre21[0] = dispense(Buffer)
	prewash21[0] = mix(prewash11[0], buf_pre21[0]) @ 5.0SECOND
	buf_pre31[0] = dispense(Buffer)
	prewash31[0] = mix(prewash21[0], buf_pre31[0]) @ 5.0SECOND
	dispose(prewash31[0])
	beadsLoad1[0] = dispense(StreptavidinBeads)
	antiCRPLoad1[0] = dispense(BiotinAntiCRP)
	beadMix1[0] = mix(beadsLoad1[0], antiCRPLoad1[0]) @ 5.0SECOND
	buf_loadCath1[0] = dispense(Buffer)
	trappedBeads1[0] = mix(beadMix1[0], buf_loadCath1[0]) @ 5.0SECOND
	buf_cl11[0] = dispense(Buffer)
	clwash11[0] = mix(trappedBeads1[0], buf_cl11[0]) @ 5.0SECOND
	buf_cl21[0] = dispense(Buffer)
	clwash21[0] = mix(clwash11[0], buf_cl21[0]) @ 5.0SECOND
	buf_cl31[0] = dispense(Buffer)
	clwash31[0] = mix(clwash21[0], buf_cl31[0]) @ 5.0SECOND
	dispose(clwash31[0])
	pellet51[0] = dispense(StreptavidinBeads)
	buf_final11[0] = dispense(Buffer)
	finalwash11[0] = mix(pellet51[0], buf_final11[0]) @ 5.0SECOND
	buf_final21[0] = dispense(Buffer)
	finalwash21[0] = mix(finalwash11[0], buf_final21[0]) @ 5.0SECOND
	buf_final31[0] = dispense(Buffer)
	finalwash31[0] = mix(finalwash21[0], buf_final31[0]) @ 5.0SECOND
	dispose(finalwash31[0])
	crpCh161[0] = dispense(AlexaCRP)
	buf_ch161[0] = dispense(Buffer)
	fillCh161[0] = mix(crpCh161[0], buf_ch161[0]) @ 5.0SECOND
	crpCh11[0] = dispense(AlexaCRP)
	buf_ch11[0] = dispense(Buffer)
	fillCh11[0] = mix(crpCh11[0], buf_ch11[0]) @ 5.0SECOND
	heat(fillCh161[0]) @ 25.0CELSIUS @ 1800.0SECOND
	heat(fillCh11[0]) @ 25.0CELSIUS @ 1800.0SECOND
	buf_pw16a1[0] = dispense(Buffer)
	pwash16a1[0] = mix(fillCh161[0], buf_pw16a1[0]) @ 5.0SECOND
	buf_pw16b1[0] = dispense(Buffer)
	pwash16b1[0] = mix(pwash16a1[0], buf_pw16b1[0]) @ 5.0SECOND
	buf_pw16c1[0] = dispense(Buffer)
	pwash16c1[0] = mix(pwash16b1[0], buf_pw16c1[0]) @ 5.0SECOND
	dispose(pwash16c1[0])
	buf_pw1a1[0] = dispense(Buffer)
	pwash1a1[0] = mix(fillCh11[0], buf_pw1a1[0]) @ 5.0SECOND
	buf_pw1b1[0] = dispense(Buffer)
	pwash1b1[0] = mix(pwash1a1[0], buf_pw1b1[0]) @ 5.0SECOND
	buf_pw1c1[0] = dispense(Buffer)
	pwash1c1[0] = mix(pwash1b1[0], buf_pw1c1[0]) @ 5.0SECOND
	dispose(pwash1c1[0])
	detectCh161[0] = dispense(AlexaCRP)
	detectCh11[0] = dispense(AlexaCRP)
	bindingSignal1[0] = detect(crpBindingDetection, detectCh161[0]) @ 30.0SECOND
	ch1Signal1[0] = detect(crpBindingDetection, detectCh11[0]) @ 30.0SECOND
	if bindingSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(detectCh11[0])
bsbbif_6_f:
	dispose(detectCh11[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(ch1Signal1[0])
	NOP
