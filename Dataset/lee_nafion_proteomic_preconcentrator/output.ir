bsbbif_2_t:
	dispose(concentratedPlug1[0])
bsbbif_3_f:
	dispose(concentratedPlug1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(concenSignal1[0])
	NOP
main:
	nafionResin1[0] = dispense(NafionResin)
	nafionCured1[0] = mix(nafionResin1[0], nafionResin1[0]) @ 60.0SECOND
	heat(nafionCured1[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(nafionCured1[0]) @ 70.0CELSIUS @ 43200.0SECOND
	bufferLeft1[0] = dispense(PhosphateBuffer)
	bufferRight1[0] = dispense(PhosphateBuffer)
	bufferDual1[0] = mix(bufferLeft1[0], bufferRight1[0]) @ 30.0SECOND
	proteinSample1[0] = dispense(BetaPhycoerythrin_Sample)
	loadedSample1[0] = mix(proteinSample1[0], bufferDual1[0]) @ 30.0SECOND
	depletedSample1[0] = mix(loadedSample1[0], bufferDual1[0]) @ 60.0SECOND
	heat(depletedSample1[0]) @ 50.0CELSIUS @ 60.0SECOND
	concentratedPlug1[0] = mix(depletedSample1[0], bufferDual1[0]) @ 300.0SECOND
	heat(concentratedPlug1[0]) @ 25.0CELSIUS @ 300.0SECOND
	concenSignal1[0] = detect(preconcentrationDetection, concentratedPlug1[0]) @ 300.0SECOND
	if concenSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
