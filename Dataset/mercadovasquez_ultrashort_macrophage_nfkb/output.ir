bsbbif_2_t:
	dispose(imagingPool_all1[0])
bsbbif_3_f:
	dispose(imagingPool_all1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(nfkbSignal1[0])
	NOP
main:
	rawBoneMarrow1[0] = dispense(BoneMarrowCells)
	mCSF_Media1[0] = dispense(mCSF_DifferentiationMedia)
	differentiatingBMDMs1[0] = mix(rawBoneMarrow1[0], mCSF_Media1[0]) @ 5.0SECOND
	heat(differentiatingBMDMs1[0]) @ 37.0CELSIUS @ 777600.0SECOND
	fibronectin1[0] = dispense(FibronectinSolution)
	pbsPrime1[0] = dispense(PBS)
	coatedChamber1[0] = mix(fibronectin1[0], pbsPrime1[0]) @ 300.0SECOND
	harvestedBMDMs1[0] = mix(differentiatingBMDMs1[0], coatedChamber1[0]) @ 60.0SECOND
	heat(harvestedBMDMs1[0]) @ 37.0CELSIUS @ 21600.0SECOND
	hoechstStain1[0] = dispense(Hoechst33342)
	completeRPMI_Stain1[0] = dispense(CompleteRPMI)
	stainedBMDMs1[0] = mix(harvestedBMDMs1[0], hoechstStain1[0]) @ 60.0SECOND
	equilibratedBMDMs1[0] = mix(stainedBMDMs1[0], completeRPMI_Stain1[0]) @ 300.0SECOND
	tnfStimulus1[0] = dispense(TNFalpha)
	tnfStimulatedCells1[0] = mix(equilibratedBMDMs1[0], tnfStimulus1[0]) @ 1.0SECOND
	lipidAStimulus1[0] = dispense(LipidA)
	lipidAStimulatedCells1[0] = mix(equilibratedBMDMs1[0], lipidAStimulus1[0]) @ 1.0SECOND
	pam2csk4Stimulus1[0] = dispense(Pam2CSK4)
	pamStimulatedCells1[0] = mix(equilibratedBMDMs1[0], pam2csk4Stimulus1[0]) @ 1.0SECOND
	r848Stimulus1[0] = dispense(R848_Resiquimod)
	r848StimulatedCells1[0] = mix(equilibratedBMDMs1[0], r848Stimulus1[0]) @ 1.0SECOND
	cpgStimulus1[0] = dispense(CpG_ODN1668)
	cpgStimulatedCells1[0] = mix(equilibratedBMDMs1[0], cpgStimulus1[0]) @ 1.0SECOND
	imagingPool_ab1[0] = mix(tnfStimulatedCells1[0], lipidAStimulatedCells1[0]) @ 60.0SECOND
	imagingPool_abc1[0] = mix(imagingPool_ab1[0], pamStimulatedCells1[0]) @ 60.0SECOND
	imagingPool_abcd1[0] = mix(imagingPool_abc1[0], r848StimulatedCells1[0]) @ 60.0SECOND
	imagingPool_all1[0] = mix(imagingPool_abcd1[0], cpgStimulatedCells1[0]) @ 60.0SECOND
	heat(imagingPool_all1[0]) @ 37.0CELSIUS @ 21600.0SECOND
	nfkbSignal1[0] = detect(nfkbTranslocationDetection, imagingPool_all1[0]) @ 21600.0SECOND
	if nfkbSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
