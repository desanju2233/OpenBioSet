bsbbif_2_t:
	dispose(rinseStep21[0])
bsbbif_3_f:
	dispose(rinseStep21[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(assaySignal1[0])
	NOP
main:
	sampleDroplet1[0] = dispense(HumanIgG_Sample)
	captureSpot1[0] = dispense(AntiHumanIgG_Capture)
	antigenBound1[0] = mix(sampleDroplet1[0], captureSpot1[0]) @ 600.0SECOND
	dispose(antigenBound1[0])
	rinseBuffer11[0] = dispense(PluronicF127_RinseBuffer)
	rinseStep11[0] = mix(rinseBuffer11[0], captureSpot1[0]) @ 120.0SECOND
	dispose(rinseStep11[0])
	detectionAntibody1[0] = dispense(FITC_AntiHumanIgG_Detection)
	sandwichComplex1[0] = mix(detectionAntibody1[0], captureSpot1[0]) @ 600.0SECOND
	dispose(sandwichComplex1[0])
	rinseBuffer21[0] = dispense(PluronicF127_RinseBuffer)
	rinseStep21[0] = mix(rinseBuffer21[0], captureSpot1[0]) @ 120.0SECOND
	dispose(rinseStep21[0])
	assaySignal1[0] = detect(immunoassayDetection, rinseStep21[0]) @ 30.0SECOND
	if assaySignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
