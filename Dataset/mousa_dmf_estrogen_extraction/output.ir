bsbbif_2_t:
	dispose(pooledExtract1[0])
bsbbif_3_f:
	dispose(pooledExtract1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(extractionSignal1[0])
	estradiolStd1[0] = dispense(EstradiolStandard)
	msSignal1[0] = detect(estradiolMSDetection, estradiolStd1[0]) @ 192.0SECOND
	if msSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	bloodSample1[0] = dispense(BloodSample)
	heat(bloodSample1[0]) @ 25.0CELSIUS @ 60.0SECOND
	lysisSolvent11[0] = dispense(DCM_Acetone_8020)
	lysate11[0] = mix(bloodSample1[0], lysisSolvent11[0]) @ 60.0SECOND
	lysisSolvent21[0] = dispense(DCM_Acetone_8020)
	lysate21[0] = mix(lysate11[0], lysisSolvent21[0]) @ 60.0SECOND
	lysisSolvent31[0] = dispense(DCM_Acetone_8020)
	driedLysate1[0] = mix(lysate21[0], lysisSolvent31[0]) @ 60.0SECOND
	methanol11[0] = dispense(Methanol)
	dissolvedSample11[0] = mix(driedLysate1[0], methanol11[0]) @ 10.0SECOND
	isooctane11[0] = dispense(Isooctane)
	extractDrop11[0] = mix(dissolvedSample11[0], isooctane11[0]) @ 10.0SECOND
	heat(extractDrop11[0]) @ 25.0CELSIUS @ 20.0SECOND
	methanol21[0] = dispense(Methanol)
	dissolvedSample21[0] = mix(extractDrop11[0], methanol21[0]) @ 10.0SECOND
	isooctane21[0] = dispense(Isooctane)
	extractDrop21[0] = mix(dissolvedSample21[0], isooctane21[0]) @ 10.0SECOND
	heat(extractDrop21[0]) @ 25.0CELSIUS @ 20.0SECOND
	methanol31[0] = dispense(Methanol)
	dissolvedSample31[0] = mix(extractDrop21[0], methanol31[0]) @ 10.0SECOND
	isooctane31[0] = dispense(Isooctane)
	extractDrop31[0] = mix(dissolvedSample31[0], isooctane31[0]) @ 10.0SECOND
	heat(extractDrop31[0]) @ 25.0CELSIUS @ 20.0SECOND
	estrogenFreeSerumDiluent1[0] = dispense(EstrogenFreeSerum)
	pooledExtract1[0] = mix(extractDrop31[0], estrogenFreeSerumDiluent1[0]) @ 5.0SECOND
	heat(pooledExtract1[0]) @ 25.0CELSIUS @ 300.0SECOND
	extractionSignal1[0] = detect(estradiolExtractionQC, pooledExtract1[0]) @ 30.0SECOND
	if extractionSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(estradiolStd1[0])
bsbbif_6_f:
	dispose(estradiolStd1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(msSignal1[0])
	NOP
