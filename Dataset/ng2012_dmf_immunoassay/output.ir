bsbbif_2_t:
	dispose(e2_detectionMix1[0])
bsbbif_3_f:
	dispose(e2_detectionMix1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(e2Signal1[0])
	tsh_particles1[0] = dispense(MagneticParticles)
	tsh_pluronic1[0] = dispense(PluronicL64)
	tsh_particleMix1[0] = mix(tsh_particles1[0], tsh_pluronic1[0]) @ 5.0SECOND
	tsh_sample11[0] = dispense(Sample_TSH)
	tsh_sample21[0] = dispense(Sample_TSH)
	tsh_sample31[0] = dispense(Sample_TSH)
	tsh_sampleMix11[0] = mix(tsh_particleMix1[0], tsh_sample11[0]) @ 360.0SECOND
	tsh_sampleMix21[0] = mix(tsh_sampleMix11[0], tsh_sample21[0]) @ 1.0SECOND
	tsh_sampleMix31[0] = mix(tsh_sampleMix21[0], tsh_sample31[0]) @ 1.0SECOND
	tsh_wash1_buf1[0] = dispense(WashBuffer)
	tsh_wash2_buf1[0] = dispense(WashBuffer)
	tsh_wash3_buf1[0] = dispense(WashBuffer)
	tsh_wash4_buf1[0] = dispense(WashBuffer)
	tsh_washed11[0] = mix(tsh_sampleMix31[0], tsh_wash1_buf1[0]) @ 5.0SECOND
	tsh_washed21[0] = mix(tsh_washed11[0], tsh_wash2_buf1[0]) @ 5.0SECOND
	tsh_washed31[0] = mix(tsh_washed21[0], tsh_wash3_buf1[0]) @ 5.0SECOND
	tsh_washed41[0] = mix(tsh_washed31[0], tsh_wash4_buf1[0]) @ 5.0SECOND
	tsh_conjugate1[0] = dispense(ConjugateAntiTSH_HRP)
	tsh_conjugateMix1[0] = mix(tsh_washed41[0], tsh_conjugate1[0]) @ 120.0SECOND
	tsh_cwash1_buf1[0] = dispense(WashBuffer)
	tsh_cwash2_buf1[0] = dispense(WashBuffer)
	tsh_cwash3_buf1[0] = dispense(WashBuffer)
	tsh_cwash4_buf1[0] = dispense(WashBuffer)
	tsh_cwashed11[0] = mix(tsh_conjugateMix1[0], tsh_cwash1_buf1[0]) @ 5.0SECOND
	tsh_cwashed21[0] = mix(tsh_cwashed11[0], tsh_cwash2_buf1[0]) @ 5.0SECOND
	tsh_cwashed31[0] = mix(tsh_cwashed21[0], tsh_cwash3_buf1[0]) @ 5.0SECOND
	tsh_cwashed41[0] = mix(tsh_cwashed31[0], tsh_cwash4_buf1[0]) @ 5.0SECOND
	tsh_h2o2wash11[0] = dispense(H2O2)
	tsh_h2o2wash21[0] = dispense(H2O2)
	tsh_h2owashed11[0] = mix(tsh_cwashed41[0], tsh_h2o2wash11[0]) @ 5.0SECOND
	tsh_h2owashed21[0] = mix(tsh_h2owashed11[0], tsh_h2o2wash21[0]) @ 5.0SECOND
	tsh_h2o2_substrate1[0] = dispense(H2O2)
	tsh_h2o2Mix1[0] = mix(tsh_h2owashed21[0], tsh_h2o2_substrate1[0]) @ 120.0SECOND
	tsh_luminol1[0] = dispense(Luminol_Enhancer)
	tsh_detectionMix1[0] = mix(tsh_h2o2Mix1[0], tsh_luminol1[0]) @ 60.0SECOND
	tshSignal1[0] = detect(chemiluminescenceDetection, tsh_detectionMix1[0]) @ 60.0SECOND
	if tshSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	e2_particles1[0] = dispense(MagneticParticles)
	e2_pluronic1[0] = dispense(PluronicL64)
	e2_particleMix1[0] = mix(e2_particles1[0], e2_pluronic1[0]) @ 5.0SECOND
	e2_sample11[0] = dispense(Sample_E2)
	e2_sample21[0] = dispense(Sample_E2)
	e2_sample31[0] = dispense(Sample_E2)
	e2_sampleMix11[0] = mix(e2_particleMix1[0], e2_sample11[0]) @ 360.0SECOND
	e2_sampleMix21[0] = mix(e2_sampleMix11[0], e2_sample21[0]) @ 1.0SECOND
	e2_sampleMix31[0] = mix(e2_sampleMix21[0], e2_sample31[0]) @ 1.0SECOND
	e2_wash1_buf1[0] = dispense(WashBuffer)
	e2_wash2_buf1[0] = dispense(WashBuffer)
	e2_wash3_buf1[0] = dispense(WashBuffer)
	e2_wash4_buf1[0] = dispense(WashBuffer)
	e2_washed11[0] = mix(e2_sampleMix31[0], e2_wash1_buf1[0]) @ 5.0SECOND
	e2_washed21[0] = mix(e2_washed11[0], e2_wash2_buf1[0]) @ 5.0SECOND
	e2_washed31[0] = mix(e2_washed21[0], e2_wash3_buf1[0]) @ 5.0SECOND
	e2_washed41[0] = mix(e2_washed31[0], e2_wash4_buf1[0]) @ 5.0SECOND
	e2_conjugate1[0] = dispense(ConjugateE2_HRP)
	e2_conjugateMix1[0] = mix(e2_washed41[0], e2_conjugate1[0]) @ 120.0SECOND
	e2_cwash1_buf1[0] = dispense(WashBuffer)
	e2_cwash2_buf1[0] = dispense(WashBuffer)
	e2_cwash3_buf1[0] = dispense(WashBuffer)
	e2_cwash4_buf1[0] = dispense(WashBuffer)
	e2_cwashed11[0] = mix(e2_conjugateMix1[0], e2_cwash1_buf1[0]) @ 5.0SECOND
	e2_cwashed21[0] = mix(e2_cwashed11[0], e2_cwash2_buf1[0]) @ 5.0SECOND
	e2_cwashed31[0] = mix(e2_cwashed21[0], e2_cwash3_buf1[0]) @ 5.0SECOND
	e2_cwashed41[0] = mix(e2_cwashed31[0], e2_cwash4_buf1[0]) @ 5.0SECOND
	e2_h2o2wash11[0] = dispense(H2O2)
	e2_h2o2wash21[0] = dispense(H2O2)
	e2_h2owashed11[0] = mix(e2_cwashed41[0], e2_h2o2wash11[0]) @ 5.0SECOND
	e2_h2owashed21[0] = mix(e2_h2owashed11[0], e2_h2o2wash21[0]) @ 5.0SECOND
	e2_h2o2_substrate1[0] = dispense(H2O2)
	e2_h2o2Mix1[0] = mix(e2_h2owashed21[0], e2_h2o2_substrate1[0]) @ 120.0SECOND
	e2_luminol1[0] = dispense(Luminol_Enhancer)
	e2_detectionMix1[0] = mix(e2_h2o2Mix1[0], e2_luminol1[0]) @ 60.0SECOND
	e2Signal1[0] = detect(chemiluminescenceDetection, e2_detectionMix1[0]) @ 60.0SECOND
	if e2Signal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(tsh_detectionMix1[0])
bsbbif_6_f:
	dispose(tsh_detectionMix1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(tshSignal1[0])
	NOP
