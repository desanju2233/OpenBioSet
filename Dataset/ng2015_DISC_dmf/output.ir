bsbbif_2_t:
	dispose(secondaryStained1[0])
bsbbif_3_f:
	dispose(secondaryStained1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(stimulusSignal1[0])
	aktCellSusp1[0] = dispense(NIH3T3_Cells)
	aktCultureDrop1[0] = dispense(CultureMedia)
	aktSeededVM1[0] = mix(aktCellSusp1[0], aktCultureDrop1[0]) @ 5.0SECOND
	heat(aktSeededVM1[0]) @ 37.0CELSIUS @ 86400.0SECOND
	aktStarvedDrop1[0] = dispense(StarvedMedia)
	aktStarvedVM1[0] = mix(aktSeededVM1[0], aktStarvedDrop1[0]) @ 5.0SECOND
	heat(aktStarvedVM1[0]) @ 37.0CELSIUS @ 86400.0SECOND
	aktRinseDrop1[0] = dispense(SeumFreeMedia)
	aktRinsedVM1[0] = mix(aktStarvedVM1[0], aktRinseDrop1[0]) @ 5.0SECOND
	aktLigandDrop1[0] = dispense(PDGFBB_Ligand)
	aktStimulated1[0] = mix(aktRinsedVM1[0], aktLigandDrop1[0]) @ 300.0SECOND
	aktPfaDrop1[0] = dispense(Paraformaldehyde)
	aktFixedVM1[0] = mix(aktStimulated1[0], aktPfaDrop1[0]) @ 600.0SECOND
	aktWash11[0] = dispense(WashBuffer1)
	aktWashedVM11[0] = mix(aktFixedVM1[0], aktWash11[0]) @ 5.0SECOND
	aktTween201[0] = dispense(Tween20)
	aktPermVM1[0] = mix(aktWashedVM11[0], aktTween201[0]) @ 600.0SECOND
	aktWash21[0] = dispense(WashBuffer2)
	aktWashedVM21[0] = mix(aktPermVM1[0], aktWash21[0]) @ 5.0SECOND
	aktBlockDrop1[0] = dispense(BlockingSolution)
	aktBlockedVM1[0] = mix(aktWashedVM21[0], aktBlockDrop1[0]) @ 3600.0SECOND
	aktPrimary_Akt1[0] = dispense(PrimaryAntibody_Akt)
	aktPrimary_pS4731[0] = dispense(PrimaryAntibody_pAkt_S473)
	aktPrimaryMix1[0] = mix(aktPrimary_Akt1[0], aktPrimary_pS4731[0]) @ 5.0SECOND
	aktPrimStained1[0] = mix(aktBlockedVM1[0], aktPrimaryMix1[0]) @ 43200.0SECOND
	heat(aktPrimStained1[0]) @ 4.0CELSIUS @ 43200.0SECOND
	aktWash31[0] = dispense(WashBuffer2)
	aktWashedVM31[0] = mix(aktPrimStained1[0], aktWash31[0]) @ 5.0SECOND
	aktSec6471[0] = dispense(SecondaryAntibody_AlexaFluor647)
	aktSec5551[0] = dispense(SecondaryAntibody_AlexaFluor555)
	aktSecondaryMix1[0] = mix(aktSec6471[0], aktSec5551[0]) @ 5.0SECOND
	aktSecStained1[0] = mix(aktWashedVM31[0], aktSecondaryMix1[0]) @ 7200.0SECOND
	heat(aktSecStained1[0]) @ 25.0CELSIUS @ 7200.0SECOND
	aktSignal1[0] = detect(phosphorylationDetection, aktSecStained1[0]) @ 30.0SECOND
	if aktSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	cellSuspension1[0] = dispense(NIH3T3_Cells)
	cultureDrop1[0] = dispense(CultureMedia)
	seededVM1[0] = mix(cellSuspension1[0], cultureDrop1[0]) @ 5.0SECOND
	heat(seededVM1[0]) @ 37.0CELSIUS @ 86400.0SECOND
	starvedDrop1[0] = dispense(StarvedMedia)
	starvedVM1[0] = mix(seededVM1[0], starvedDrop1[0]) @ 5.0SECOND
	heat(starvedVM1[0]) @ 37.0CELSIUS @ 86400.0SECOND
	serumFreeDrop1[0] = dispense(SeumFreeMedia)
	rinsedVM1[0] = mix(starvedVM1[0], serumFreeDrop1[0]) @ 5.0SECOND
	ligandDrop1[0] = dispense(PDGFBB_Ligand)
	stimulatedVM1[0] = mix(rinsedVM1[0], ligandDrop1[0]) @ 120.0SECOND
	pfaDrop1[0] = dispense(Paraformaldehyde)
	fixedVM1[0] = mix(stimulatedVM1[0], pfaDrop1[0]) @ 600.0SECOND
	wash1Drop1[0] = dispense(WashBuffer1)
	washedVM11[0] = mix(fixedVM1[0], wash1Drop1[0]) @ 5.0SECOND
	tween20Drop1[0] = dispense(Tween20)
	permeabilisedVM1[0] = mix(washedVM11[0], tween20Drop1[0]) @ 600.0SECOND
	wash2Drop1[0] = dispense(WashBuffer2)
	washedVM21[0] = mix(permeabilisedVM1[0], wash2Drop1[0]) @ 5.0SECOND
	blockDrop1[0] = dispense(BlockingSolution)
	blockedVM1[0] = mix(washedVM21[0], blockDrop1[0]) @ 3600.0SECOND
	primary_PDGFR1[0] = dispense(PrimaryAntibody_PDGFR)
	primary_pY8571[0] = dispense(PrimaryAntibody_pPDGFR_Y857)
	primaryMix1[0] = mix(primary_PDGFR1[0], primary_pY8571[0]) @ 5.0SECOND
	primary_Akt1[0] = dispense(PrimaryAntibody_Akt)
	primary_pS4731[0] = dispense(PrimaryAntibody_pAkt_S473)
	primaryMix_Akt1[0] = mix(primary_Akt1[0], primary_pS4731[0]) @ 5.0SECOND
	combinedPrimary1[0] = mix(primaryMix1[0], primaryMix_Akt1[0]) @ 5.0SECOND
	primaryStainedVM1[0] = mix(blockedVM1[0], combinedPrimary1[0]) @ 43200.0SECOND
	heat(primaryStainedVM1[0]) @ 4.0CELSIUS @ 43200.0SECOND
	wash3Drop1[0] = dispense(WashBuffer2)
	washedVM31[0] = mix(primaryStainedVM1[0], wash3Drop1[0]) @ 5.0SECOND
	secondary_6471[0] = dispense(SecondaryAntibody_AlexaFluor647)
	secondary_5551[0] = dispense(SecondaryAntibody_AlexaFluor555)
	secondaryMix1[0] = mix(secondary_6471[0], secondary_5551[0]) @ 5.0SECOND
	secondaryStained1[0] = mix(washedVM31[0], secondaryMix1[0]) @ 7200.0SECOND
	heat(secondaryStained1[0]) @ 25.0CELSIUS @ 7200.0SECOND
	stimulusSignal1[0] = detect(phosphorylationDetection, secondaryStained1[0]) @ 30.0SECOND
	if stimulusSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(aktSecStained1[0])
bsbbif_6_f:
	dispose(aktSecStained1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(aktSignal1[0])
	qcCarrier1[0] = dispense(WashBuffer2)
	immunoSignal1[0] = detect(cellViabilityDetection, qcCarrier1[0]) @ 30.0SECOND
	if immunoSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(qcCarrier1[0])
bsbbif_9_f:
	dispose(qcCarrier1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(immunoSignal1[0])
	NOP
