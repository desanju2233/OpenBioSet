module rvIgGDetection
module rvIgMDetection

manifest VirusCoatedParticles
manifest WashBuffer
manifest HRPConjugateIgG
manifest HRPConjugateIgM
manifest H2O2
manifest LuminolEnhancer
manifest PretreatmentReagent
manifest SampleIgG
manifest SampleIgM
manifest SampleIgGplusIgM
manifest DiluentPBSBSA
manifest PluronicL64

// ============================================================
// Digital Microfluidic Platform for the Detection of
// Rubella Infection and Immunity: A Proof of Concept
// Ng, Lee, Choi, Fischer, Robinson, Wheeler
// Clinical Chemistry 61:2, 420-429 (2015)
// DOI: 10.1373/clinchem.2014.232181
//
// Two protocols are encoded in sequence:
//
// PROTOCOL 1: RV IgG Immunoassay (7-step indirect ELISA)
//   Detects rubella-virus-specific IgG from patient serum or
//   plasma. Virus-coated paramagnetic particles (1.5e8/mL in
//   Superblock) capture analyte; HRP-conjugated antihuman IgG
//   transduces binding to chemiluminescent signal (HRP +
//   H2O2/luminol-enhancer). PMT reads RLUs over 10 s.
//   Sample volume per assay: 1.8 uL. Four parallel assays
//   run simultaneously by on-chip aliquoting.
//   Run time: ~25 min per quadruplicate set.
//   LOD: 0.03 IU/mL; LOQ: 0.1 IU/mL; clinical cutoff: 10 IU/mL.
//   Intraassay CVs: 0.3-6.5%.
//   On-chip dilution sub-protocol (serial 2x steps) evaluated
//   for samples >linear range (>250 IU/mL) and for whole blood.
//
// PROTOCOL 2: RV IgM Immunoassay (7-step indirect ELISA
//   + on-chip IgG blocking pretreatment)
//   Critical test for diagnosing active rubella infection and
//   identifying pregnancies at risk for CRS. RV IgM binds to
//   RV-coated particles; HRP-conjugated antihuman IgM detects.
//   Pretreatment: 1.8 uL sample + 0.9 uL goat antihuman IgG
//   (pretreatment reagent) mixed for 7 min on-chip to block
//   endogenous RV IgG and RF IgM interference.
//   Run time: ~35 min per quadruplicate set (including pretreatment).
//   Intraassay CVs: 1.5-13.4%.
//   Cutoff defined by RV IgM Cal 1 (Abbott Architect kit).
//
// DROPLET VOLUMES:
//   Unit droplet (actuation electrode area x gap): ~900 nL
//   Gap between top/bottom plates: ~140 um
//   Electrode array: 80 actuation electrodes (2.54 x 2.54 mm)
//   Actuation: 80-100 V_rms, 10 kHz sine wave
//   Particle immobilisation force: >=600 uN (magnetic lens)
//   Minimum release threshold: ~500 uN
//
// REAGENT ADDITIVES:
//   All reagents supplemented with 0.05% Pluronic L64 to reduce
//   protein adsorption and prevent cross-contamination in
//   air-filled DMF device.
//
// TEMPERATURE:
//   All assay steps performed at room temperature.
//   No active thermal control required.
//
// CFG STRUCTURE:
//   BB1  main              -- entry: RV IgG immunoassay (Protocol 1)
//   BB2  igGPass           -- igGSignal > 0: IgG detected (positive),
//                             dispose particles
//   BB3  igGFail           -- igGSignal <= 0: IgG not detected
//                             (negative/equivocal), drain particles
//   BB4  igGJoin           -- join: RV IgM pretreatment branch begins
//   BB5  igMPass           -- igMSignal > 0: IgM detected (positive),
//                             dispose particles
//   BB6  igMFail           -- igMSignal <= 0: IgM not detected
//                             (negative/equivocal), drain particles
//   BB7  finalCleanup      -- terminal: dispose QC signals,
//                             experiment ends
//
// DIAGNOSTIC PERFORMANCE (25-sample commercial panel, PTR201):
//   RV IgG: sensitivity 100% (95% CI 98.6-100%),
//            specificity 100% (95% CI 95.5-100%), AUC = 1.00
//   RV IgM: sensitivity 100% (95% CI 97.4-100%),
//            specificity 100% (95% CI 98.4-100%), AUC = 1.00
//   Reference standard: Abbott EIA (Seracare PTR201 panel)
// ============================================================

instructions:

// ============================================================
// BB1: main
// ============================================================

// ============================================================
// PROTOCOL 1: RV IgG IMMUNOASSAY
// ============================================================

// ------------------------------------------------------------
// STEP 1a: Dispense virus-coated paramagnetic particle
//   suspension (1.8 uL; 1.5e8 particles/mL in Superblock).
//   Particles were pre-washed 2x in Superblock and
//   resuspended at ~10x stock concentration before loading.
//   Particle droplet is dispensed from reservoir onto the
//   electrode array where the magnetic lens (positioned
//   ~150 um below device) immobilises them in the separation
//   zone.
// ------------------------------------------------------------

igGParticles     = dispense 2 units of VirusCoatedParticles

// Magnetic separation: particles pellet in separation zone;
// supernatant (diluent) is actuated away to waste.
// `mix` here abstracts the electrode-actuation resuspension
// sequence used throughout this protocol for particle
// handling; `dispose` models the supernatant removal step.
// Particle pellet remains on-chip for subsequent operations.
igGParticleSep   = mix igGParticles with igGParticles for 5s
dispose igGParticleSep

// ------------------------------------------------------------
// STEP 1b: Sample incubation.
//   1.8 uL of patient sample (pre-diluted 10x in DPBS/4% BSA
//   before loading) is dispensed and delivered to the
//   particle pellet. Droplet is mixed in circular motion for
//   3 min; RV IgG from the sample binds to RV-coated
//   particle surface. Magnetic lens re-activates to
//   immobilise particles; supernatant is removed to waste.
// ------------------------------------------------------------

igGSample        = dispense 2 units of SampleIgG
igGCapture       = mix igGSample with igGParticles for 3m
dispose igGCapture

// ------------------------------------------------------------
// STEP 1c: Wash cycle x4 (4 x 1.8 uL wash buffer).
//   Each wash: a fresh wash buffer droplet is moved over the
//   particle pellet, mixed, magnetic lens activated,
//   supernatant removed. Repeated 4 times to eliminate
//   unbound antibody and reduce background signal.
//   Wash buffer: custom DMF-compatible formulation +
//   0.05% Pluronic L64.
// ------------------------------------------------------------

igGWash1         = dispense 2 units of WashBuffer
igGWashStep1     = mix igGParticles with igGWash1 for 30s
dispose igGWashStep1

igGWash2         = dispense 2 units of WashBuffer
igGWashStep2     = mix igGParticles with igGWash2 for 30s
dispose igGWashStep2

igGWash3         = dispense 2 units of WashBuffer
igGWashStep3     = mix igGParticles with igGWash3 for 30s
dispose igGWashStep3

igGWash4         = dispense 2 units of WashBuffer
igGWashStep4     = mix igGParticles with igGWash4 for 30s
dispose igGWashStep4

// ------------------------------------------------------------
// STEP 1d: Conjugate incubation (1.8 uL).
//   HRP-conjugated goat polyclonal antihuman IgG (21 ng/mL
//   in conjugate diluent + 0.05% Pluronic L64) delivered to
//   particle pellet. Mixed for 2 min. HRP-anti-IgG binds to
//   sample RV IgG captured on the particles, forming the
//   immunocomplex. Magnetic lens re-activates; unbound
//   conjugate removed to waste.
// ------------------------------------------------------------

igGConjugate     = dispense 2 units of HRPConjugateIgG
igGConjugateStep = mix igGParticles with igGConjugate for 2m
dispose igGConjugateStep

// ------------------------------------------------------------
// STEP 1e: Second wash cycle x4 (4 x 1.8 uL wash buffer).
//   Identical to STEP 1c. Removes excess/unbound HRP
//   conjugate before substrate addition to minimise
//   background chemiluminescence.
// ------------------------------------------------------------

igGWash5         = dispense 2 units of WashBuffer
igGWashStep5     = mix igGParticles with igGWash5 for 30s
dispose igGWashStep5

igGWash6         = dispense 2 units of WashBuffer
igGWashStep6     = mix igGParticles with igGWash6 for 30s
dispose igGWashStep6

igGWash7         = dispense 2 units of WashBuffer
igGWashStep7     = mix igGParticles with igGWash7 for 30s
dispose igGWashStep7

igGWash8         = dispense 2 units of WashBuffer
igGWashStep8     = mix igGParticles with igGWash8 for 30s
dispose igGWashStep8

// ------------------------------------------------------------
// STEP 1f: Chemiluminescent substrate addition and detection.
//   900 nL H2O2 (stable peroxide) + 900 nL luminol-enhancer
//   solution (SuperSignal ELISA Femto) dispensed and merged
//   with particle pellet. Mixed for 2 min. HRP catalyses
//   oxidation of luminol in the presence of H2O2, generating
//   photons detected by the motorised PMT (positioned ~few
//   hundred um above device droplet centre).
//   Mean signal integrated over 10 s; reported as RLUs.
//   Result interpreted against calibration curve:
//     s/co >= 1.0    -> positive
//     s/co 0.69-0.99 -> equivocal (gray zone)
//     s/co < 0.69    -> negative
//
//   NOTE ON UNIT VOLUMES: H2O2 and luminol are each 900 nL
//   (1 unit = ~900 nL on the actuation electrode). They are
//   dispensed as separate 1-unit droplets and merged with the
//   particle pellet. `mix ... for 2m` models the 2 min
//   incubation; `detect` models the 10 s PMT integration.
// ------------------------------------------------------------

igGH2O2          = dispense 1 units of H2O2
igGLuminol       = dispense 1 units of LuminolEnhancer

igGSubstrateMix  = mix igGH2O2 with igGLuminol for 5s
igGReaction      = mix igGParticles with igGSubstrateMix for 2m

igGSignal        = detect rvIgGDetection on igGReaction for 10s

// ============================================================
// BB2 / BB3: RV IgG diagnostic gate
// Pass (BB2): igGSignal > 0 -> IgG detected; s/co >= 1 implies
//             rubella immunity or current/past infection.
//             Dispose reaction droplet (particles + substrate).
// Fail (BB3): igGSignal <= 0 -> IgG not detected; patient
//             susceptible to rubella. Drain reaction droplet.
// Both branches converge at BB4 (igGJoin).
// ============================================================

if (igGSignal > 0) {
    dispose igGReaction
} else {
    drain igGReaction
}

// ============================================================
// BB4: igGJoin
// Dispose IgG QC signal droplet. Control falls through to
// RV IgM pretreatment and immunoassay branch (BB5/BB6).
// ============================================================

dispose igGSignal

// ============================================================
// PROTOCOL 2: RV IgM IMMUNOASSAY (+ ON-CHIP IgG BLOCKING)
// ============================================================

// ------------------------------------------------------------
// STEP 2a: On-chip sample pretreatment (IgG blocking).
//   1.8 uL of patient sample (pre-diluted 10x in DPBS/4% BSA)
//   + 900 nL pretreatment reagent (3x dilution of Abbott
//   Architect goat antihuman IgG in conjugate diluent) are
//   merged on-chip and mixed for 7 min.
//   Purpose: the exogenous antihuman IgG blocks:
//     (i)  endogenous RV IgG from competing for binding sites
//          on the RV-coated particles (prevents false negatives)
//     (ii) RV IgG / RF IgM immunocomplexes from binding
//          non-specifically to the particles (prevents false
//          positives from rheumatoid factor IgM cross-reaction)
//   Significance: pretreatment statistically suppresses
//   nonspecific signal in IgG+IgM samples (P=0.0003),
//   while leaving pure IgG (P=0.5) or pure IgM (P=0.6)
//   samples unaffected.
//
//   NOTE ON VOLUMES: 1.8 uL sample = 2 units; 900 nL
//   pretreatment = 1 unit (at 900 nL per unit electrode).
// ------------------------------------------------------------

igMSampleRaw     = dispense 2 units of SampleIgM
igMPretreat      = dispense 1 units of PretreatmentReagent
igMPretreatedSample = mix igMSampleRaw with igMPretreat for 7m

// ------------------------------------------------------------
// STEP 2b: Dispense virus-coated paramagnetic particle
//   suspension (1.8 uL; identical particle stock as Protocol 1).
//   Particles magnetically separated from diluent; pellet
//   retained in separation zone for sample delivery.
// ------------------------------------------------------------

igMParticles     = dispense 2 units of VirusCoatedParticles
igMParticleSep   = mix igMParticles with igMParticles for 5s
dispose igMParticleSep

// ------------------------------------------------------------
// STEP 2c: Pretreated sample incubation.
//   Pretreated sample droplet delivered to particle pellet.
//   Mixed for 3 min. RV IgM antibodies from sample bind to
//   RV-coated particles; competing IgG/RF IgM complexes
//   blocked by pretreatment. Magnetic lens re-activates;
//   supernatant removed to waste.
// ------------------------------------------------------------

igMCapture       = mix igMPretreatedSample with igMParticles for 3m
dispose igMCapture

// ------------------------------------------------------------
// STEP 2d: Wash cycle x4 (4 x 1.8 uL wash buffer).
//   Identical procedure to Protocol 1 STEP 1c. Removes
//   unbound antibody and pretreatment components.
// ------------------------------------------------------------

igMWash1         = dispense 2 units of WashBuffer
igMWashStep1     = mix igMParticles with igMWash1 for 30s
dispose igMWashStep1

igMWash2         = dispense 2 units of WashBuffer
igMWashStep2     = mix igMParticles with igMWash2 for 30s
dispose igMWashStep2

igMWash3         = dispense 2 units of WashBuffer
igMWashStep3     = mix igMParticles with igMWash3 for 30s
dispose igMWashStep3

igMWash4         = dispense 2 units of WashBuffer
igMWashStep4     = mix igMParticles with igMWash4 for 30s
dispose igMWashStep4

// ------------------------------------------------------------
// STEP 2e: Conjugate incubation (1.8 uL).
//   HRP-conjugated goat antihuman IgM (23 ng/mL in conjugate
//   diluent + 0.05% Pluronic L64) delivered to particle
//   pellet. Mixed for 2 min. HRP-anti-IgM binds selectively
//   to RV IgM captured on particles. Magnetic lens
//   re-activates; unbound conjugate removed to waste.
//   Note: IgM-specific conjugate distinguishes this step
//   from Protocol 1 STEP 1d (antihuman IgG conjugate).
// ------------------------------------------------------------

igMConjugate     = dispense 2 units of HRPConjugateIgM
igMConjugateStep = mix igMParticles with igMConjugate for 2m
dispose igMConjugateStep

// ------------------------------------------------------------
// STEP 2f: Second wash cycle x4 (4 x 1.8 uL wash buffer).
//   Identical to STEP 2d. Removes excess HRP-anti-IgM
//   conjugate before substrate addition.
// ------------------------------------------------------------

igMWash5         = dispense 2 units of WashBuffer
igMWashStep5     = mix igMParticles with igMWash5 for 30s
dispose igMWashStep5

igMWash6         = dispense 2 units of WashBuffer
igMWashStep6     = mix igMParticles with igMWash6 for 30s
dispose igMWashStep6

igMWash7         = dispense 2 units of WashBuffer
igMWashStep7     = mix igMParticles with igMWash7 for 30s
dispose igMWashStep7

igMWash8         = dispense 2 units of WashBuffer
igMWashStep8     = mix igMParticles with igMWash8 for 30s
dispose igMWashStep8

// ------------------------------------------------------------
// STEP 2g: Chemiluminescent substrate addition and detection.
//   Identical substrate system to Protocol 1 STEP 1f:
//   900 nL H2O2 + 900 nL luminol-enhancer merged with particle
//   pellet and mixed for 2 min. Motorised PMT collects
//   photons over 10 s; signal reported as RLUs.
//   Result interpreted against RV IgM cutoff calibrator
//   (Cal 1, adapted from Abbott Architect rubella IgM kit):
//     s/co >= 1.0    -> positive (active rubella infection)
//     s/co 0.75-0.99 -> equivocal (gray zone; retest required)
//     s/co < 0.75    -> negative
//   Cal 1 defines the s/co = 1 cutoff; its RF IgM content
//   (27.0 IU/mL) makes on-chip pretreatment essential for
//   accurate cutoff calibration (Fig. 3C of paper).
// ------------------------------------------------------------

igMH2O2          = dispense 1 units of H2O2
igMLuminol       = dispense 1 units of LuminolEnhancer

igMSubstrateMix  = mix igMH2O2 with igMLuminol for 5s
igMReaction      = mix igMParticles with igMSubstrateMix for 2m

igMSignal        = detect rvIgMDetection on igMReaction for 10s

// ============================================================
// BB5 / BB6: RV IgM diagnostic gate
// Pass (BB5): igMSignal > 0 -> IgM detected; s/co >= 1 implies
//             active rubella infection; patient (especially
//             if pregnant) at risk of CRS.
//             Dispose reaction droplet (particles + substrate).
// Fail (BB6): igMSignal <= 0 -> IgM not detected;
//             no evidence of acute rubella infection.
//             Drain reaction droplet.
// Both branches converge at BB7 (finalCleanup).
//
// NOTE ON EQUIVOCAL RESULTS: In clinical practice, equivocal
// results (s/co 0.75-0.99) are interpreted as positive for
// diagnostic performance calculations (WHO guidance) and
// referred for retest. Two of 25 panel samples produced
// positive-equivocal discrepancies between DMF and Abbott EIA
// at s/co near the cutoff; attributed to assay variability
// (CV ~15%) and sample age (~20 years). These did not affect
// the final 100% sensitivity and 100% specificity calculations.
// ============================================================

if (igMSignal > 0) {
    dispose igMReaction
} else {
    drain igMReaction
}

// ============================================================
// BB7: finalCleanup (terminal)
// Dispose both assay QC signal droplets.
// Experiment ends.
// ============================================================

dispose igMSignal

// [terminal -- no further instructions; exit node for CFG]
