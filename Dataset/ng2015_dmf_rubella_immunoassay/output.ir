bsbbif_2_t:
	dispose(igGReaction1[0])
bsbbif_3_f:
	dispose(igGReaction1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(igGSignal1[0])
	igMSampleRaw1[0] = dispense(SampleIgM)
	igMPretreat1[0] = dispense(PretreatmentReagent)
	igMPretreatedSample1[0] = mix(igMSampleRaw1[0], igMPretreat1[0]) @ 420.0SECOND
	igMParticles1[0] = dispense(VirusCoatedParticles)
	igMParticleSep1[0] = mix(igMParticles1[0], igMParticles1[0]) @ 5.0SECOND
	dispose(igMParticleSep1[0])
	igMCapture1[0] = mix(igMPretreatedSample1[0], igMParticles1[0]) @ 180.0SECOND
	dispose(igMCapture1[0])
	igMWash11[0] = dispense(WashBuffer)
	igMWashStep11[0] = mix(igMParticles1[0], igMWash11[0]) @ 30.0SECOND
	dispose(igMWashStep11[0])
	igMWash21[0] = dispense(WashBuffer)
	igMWashStep21[0] = mix(igMParticles1[0], igMWash21[0]) @ 30.0SECOND
	dispose(igMWashStep21[0])
	igMWash31[0] = dispense(WashBuffer)
	igMWashStep31[0] = mix(igMParticles1[0], igMWash31[0]) @ 30.0SECOND
	dispose(igMWashStep31[0])
	igMWash41[0] = dispense(WashBuffer)
	igMWashStep41[0] = mix(igMParticles1[0], igMWash41[0]) @ 30.0SECOND
	dispose(igMWashStep41[0])
	igMConjugate1[0] = dispense(HRPConjugateIgM)
	igMConjugateStep1[0] = mix(igMParticles1[0], igMConjugate1[0]) @ 120.0SECOND
	dispose(igMConjugateStep1[0])
	igMWash51[0] = dispense(WashBuffer)
	igMWashStep51[0] = mix(igMParticles1[0], igMWash51[0]) @ 30.0SECOND
	dispose(igMWashStep51[0])
	igMWash61[0] = dispense(WashBuffer)
	igMWashStep61[0] = mix(igMParticles1[0], igMWash61[0]) @ 30.0SECOND
	dispose(igMWashStep61[0])
	igMWash71[0] = dispense(WashBuffer)
	igMWashStep71[0] = mix(igMParticles1[0], igMWash71[0]) @ 30.0SECOND
	dispose(igMWashStep71[0])
	igMWash81[0] = dispense(WashBuffer)
	igMWashStep81[0] = mix(igMParticles1[0], igMWash81[0]) @ 30.0SECOND
	dispose(igMWashStep81[0])
	igMH2O21[0] = dispense(H2O2)
	igMLuminol1[0] = dispense(LuminolEnhancer)
	igMSubstrateMix1[0] = mix(igMH2O21[0], igMLuminol1[0]) @ 5.0SECOND
	igMReaction1[0] = mix(igMParticles1[0], igMSubstrateMix1[0]) @ 120.0SECOND
	igMSignal1[0] = detect(rvIgMDetection, igMReaction1[0]) @ 10.0SECOND
	if igMSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	igGParticles1[0] = dispense(VirusCoatedParticles)
	igGParticleSep1[0] = mix(igGParticles1[0], igGParticles1[0]) @ 5.0SECOND
	dispose(igGParticleSep1[0])
	igGSample1[0] = dispense(SampleIgG)
	igGCapture1[0] = mix(igGSample1[0], igGParticles1[0]) @ 180.0SECOND
	dispose(igGCapture1[0])
	igGWash11[0] = dispense(WashBuffer)
	igGWashStep11[0] = mix(igGParticles1[0], igGWash11[0]) @ 30.0SECOND
	dispose(igGWashStep11[0])
	igGWash21[0] = dispense(WashBuffer)
	igGWashStep21[0] = mix(igGParticles1[0], igGWash21[0]) @ 30.0SECOND
	dispose(igGWashStep21[0])
	igGWash31[0] = dispense(WashBuffer)
	igGWashStep31[0] = mix(igGParticles1[0], igGWash31[0]) @ 30.0SECOND
	dispose(igGWashStep31[0])
	igGWash41[0] = dispense(WashBuffer)
	igGWashStep41[0] = mix(igGParticles1[0], igGWash41[0]) @ 30.0SECOND
	dispose(igGWashStep41[0])
	igGConjugate1[0] = dispense(HRPConjugateIgG)
	igGConjugateStep1[0] = mix(igGParticles1[0], igGConjugate1[0]) @ 120.0SECOND
	dispose(igGConjugateStep1[0])
	igGWash51[0] = dispense(WashBuffer)
	igGWashStep51[0] = mix(igGParticles1[0], igGWash51[0]) @ 30.0SECOND
	dispose(igGWashStep51[0])
	igGWash61[0] = dispense(WashBuffer)
	igGWashStep61[0] = mix(igGParticles1[0], igGWash61[0]) @ 30.0SECOND
	dispose(igGWashStep61[0])
	igGWash71[0] = dispense(WashBuffer)
	igGWashStep71[0] = mix(igGParticles1[0], igGWash71[0]) @ 30.0SECOND
	dispose(igGWashStep71[0])
	igGWash81[0] = dispense(WashBuffer)
	igGWashStep81[0] = mix(igGParticles1[0], igGWash81[0]) @ 30.0SECOND
	dispose(igGWashStep81[0])
	igGH2O21[0] = dispense(H2O2)
	igGLuminol1[0] = dispense(LuminolEnhancer)
	igGSubstrateMix1[0] = mix(igGH2O21[0], igGLuminol1[0]) @ 5.0SECOND
	igGReaction1[0] = mix(igGParticles1[0], igGSubstrateMix1[0]) @ 120.0SECOND
	igGSignal1[0] = detect(rvIgGDetection, igGReaction1[0]) @ 10.0SECOND
	if igGSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(igMReaction1[0])
bsbbif_6_f:
	dispose(igMReaction1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(igMSignal1[0])
	NOP
