{
  "protocol": {
    "title": "Clathrate Nanostructures for Mass Spectrometry",
    "source": "Nature 2007, 449, 1033-1036",
    "doi": "10.1038/nature06195",
    "platform": "Nanostructure-Initiator Mass Spectrometry (NIMS) -- porous silicon surface with trapped perfluorinated siloxane initiator; laser (337 nm N2) and ion (Bi3+) irradiation modes",
    "applications": [
      "Peptide/protein tryptic digest detection (BSA, 500 amol, 55% sequence coverage)",
      "Small molecule detection (verapamil, 700 ymol; 1-palmitoyllysophosphatidylcholine, 50 amol)",
      "Single cancer cell metabolite profiling (MDA-MB-231, endogenous phospholipids)",
      "Peptide microarray characterisation by ion-NIMS (Bi3+, 1 fmol sensitivity, 150 nm lateral resolution)",
      "Mouse embryo tissue imaging by laser-NIMS (glycerophosphatidylcholine m/z 782)",
      "Direct biofluid analysis without sample preparation (1 uL blood and urine)"
    ],

    "surface": {
      "substrate": "P-type boron-doped silicon wafer, <100> orientation",
      "resistivity_Ohm_cm": "0.01-0.02",
      "wafer_thickness_um": "525 +/- 25",
      "wafer_diameter_mm": 100,
      "supplier": "Silicon Valley Microelectronics",
      "pore_size_nm": 10,
      "pore_confirmed_by": "SEM (Fig 1c)",
      "etch_conditions": {
        "etchant": "25% hydrofluoric acid in ethanol",
        "current_density_mA_cm2": 48,
        "duration_s": 1800,
        "temperature_C": 25,
        "caution": "HF is acutely hazardous; certified fume hood and PPE required"
      },
      "initiator_loading": {
        "laser_NIMS_initiator": "bis(tridecafluoro-1,1,2,2-tetrahydrooctyl)tetramethyldisiloxane (undiluted)",
        "ion_NIMS_initiator": "14-kDa poly(3,3,3-trifluoropropylmethylsiloxanes)",
        "application_temperature_C": 25,
        "application_duration_min": "30-60",
        "excess_removal": "nitrogen jet",
        "ion_NIMS_bake_temperature_C": 100,
        "ion_NIMS_bake_duration": "overnight",
        "ion_NIMS_rinse": "tert-butyl methyl ether"
      }
    },

    "instrumentation": {
      "laser_NIMS": {
        "instrument": "Voyager DE STR (Applied Biosystems)",
        "laser_wavelength_nm": 337,
        "laser_type": "pulsed nitrogen",
        "mode": "reflector, positive polarity",
        "acceleration_voltage_kV": 20,
        "first_grid_voltage_pct": 60,
        "guide_wire_voltage_pct": 0.15,
        "extraction_delay_ns": 100,
        "shots_averaged": 100
      },
      "ion_NIMS": {
        "instrument": "ION-TOF IV TOF-SIMS (IONTOF GmbH)",
        "primary_ion_source": "polyatomic Bi3+",
        "beam_energy_kV": 25,
        "incident_angle_deg": 45,
        "pulse_width_ns": 50,
        "dose": "below static limit",
        "sample_voltage_kV": 2.5,
        "extraction_lens_voltage_kV": -4.5,
        "lateral_resolution_nm": 150
      },
      "fluorescence": {
        "instrument": "Nikon TE2000 inverted fluorescence microscope",
        "objectives": ["20x Plan Fluor NA 0.45", "60x oil Plan Apo NA 1.40"],
        "filter_set": "61000V2 (Chroma); DAPI, FITC, TRITC triple band",
        "camera": "Retiga EXi Fast 1394 Mono Cooled (Qimaging)"
      }
    },

    "reagents": {
      "analytes": {
        "BSA_tryptic_digest": {
          "amount": "500 amol",
          "preparation": "Reduced (DTT), alkylated (iodoacetamide), digested with mass-spec-grade porcine trypsin (Promega)",
          "solvent": "1:1 acetonitrile/water + 0.1% TFA",
          "result": "55% sequence coverage (Fig 1d upper right)"
        },
        "verapamil": {
          "amount": "700 ymol",
          "notes": "Calcium antagonist drug, MW 454.6 Da; ~420 molecules on surface (Fig 1d lower left)"
        },
        "beta_lactoglobulin": {
          "amount": "50 nmol",
          "notes": "Multiply charged protein detection analogous to ESI (Fig 1d upper left)"
        },
        "LysoPPC": {
          "amount": "50 amol",
          "full_name": "1-palmitoyllysophosphatidylcholine",
          "notes": "Endogenous metabolite detection (Fig 1d lower right)"
        },
        "bradykinin_1_7": { "MW_Da": 757, "amount_array": "1 fmol", "amount_spectrum": "1 pmol" },
        "bradykinin_2_9": { "MW_Da": 904, "amount_array": "1 fmol" },
        "neurotensin":    { "MW_Da": 1673, "amount_array": "1 fmol" }
      },
      "cell_lines": {
        "MDA_MB_231": {
          "description": "Highly metastatic human breast cancer (ATCC HTB-26)",
          "medium": "Leibovitz's L-15 + 2 mM L-glutamine + 10% calf bovine serum",
          "temperature_C": 37,
          "harvest": "trypsin-EDTA",
          "use": "Single-cell phospholipid profiling (Section III)"
        }
      },
      "tissue": {
        "species": "C57Bl/6J mouse",
        "stage": "embryonic day 16.5",
        "section_thickness_um": 12,
        "sectioning_instrument": "Leica CM3050 S cryostat",
        "embedding": "OCT compound (VWR International)",
        "mounting": "thaw-mount directly onto NIMS chip"
      },
      "biofluids": {
        "blood": { "volume_uL": 1, "preparation": "direct spot; laser-etch before NIMS analysis" },
        "urine": {
          "volume_uL": 1,
          "preparation": "direct spot; no etch step",
          "initiators_compared": [
            "bis(heptadecafluoro-1,1,2,2-tetrahydrodecyl)tetramethyldisiloxane (perfluorinated; lipid-selective)",
            "1,3-bis(hydroxybutyl)tetramethyldisiloxane (hydroxylated; small metabolite-selective)"
          ],
          "unique_ions_polar_initiator_pct": 86,
          "codeine_quantitation": {
            "linear_range_ng_mL": "up to 15",
            "conventional_LOD_ng_mL": "75-250",
            "reference": "Ref 28"
          }
        }
      },
      "stains": {
        "FDA": { "concentration_ug_mL": 5, "ex_nm": 490, "em_nm": 526, "labels": "live cells (green)" },
        "PI":  { "concentration_ug_mL": 2, "ex_nm": 488, "em_nm": 617, "labels": "dead cells (red)" },
        "DAPI": { "use": "nuclear counterstain" },
        "Alexa555_anti_Pan_cytokeratin": { "use": "cell identity post-MS immunofluorescence" }
      }
    },

    "steps": [
      {
        "id": "S1",
        "name": "NIMS surface fabrication -- anodic etching",
        "bb": "BB1 (main)",
        "section": "I",
        "inputs": ["BoronSilicon", "HydrofluoricAcid_Ethanol"],
        "operations": [
          { "op": "dispense", "output": "siliconWafer1[0]", "reagent": "BoronSilicon" },
          { "op": "dispense", "output": "etchSolution1[0]", "reagent": "HydrofluoricAcid_Ethanol" },
          { "op": "mix",      "output": "etchedSurface1[0]", "inputs": ["siliconWafer1[0]", "etchSolution1[0]"], "duration_s": 1800 },
          { "op": "heat",     "target": "etchedSurface1[0]", "temperature_C": 25, "duration_s": 1800 }
        ],
        "ir_durations_s": { "mix": 1800.0, "heat": 1800.0 },
        "notes": "48 mA.cm^-2 anodic etch in 25% HF/ethanol for 30 min at 25 deg C. Produces ~10 nm pores (SEM confirmed, Fig 1c). heat@25C abstracts room-temperature electrochemical etch."
      },
      {
        "id": "S2",
        "name": "Initiator loading and N2 jet removal",
        "bb": "BB1 (main)",
        "section": "I",
        "inputs": ["PerfluorinatedSiloxane_Initiator", "Nitrogen_Gas"],
        "operations": [
          { "op": "dispense", "output": "initiator1[0]",      "reagent": "PerfluorinatedSiloxane_Initiator" },
          { "op": "dispense", "output": "nitrogenJet1[0]",    "reagent": "Nitrogen_Gas" },
          { "op": "mix",      "output": "loadedSurface1[0]",  "inputs": ["etchedSurface1[0]", "initiator1[0]"], "duration_s": 2700 },
          { "op": "heat",     "target": "loadedSurface1[0]",  "temperature_C": 25, "duration_s": 2700 },
          { "op": "mix",      "output": "nimsSurface1[0]",    "inputs": ["loadedSurface1[0]", "nitrogenJet1[0]"], "duration_s": 30 }
        ],
        "ir_durations_s": { "mix_load": 2700.0, "heat_load": 2700.0, "mix_N2": 30.0 },
        "notes": "Undiluted bis(tridecafluoro-1,1,2,2-tetrahydrooctyl)tetramethyldisiloxane applied at 25 deg C for 30-60 min (45 min midpoint encoded). Initiator migrates into pores by capillary force (Supplementary Movie 1). Excess removed by N2 jet."
      },
      {
        "id": "S3",
        "name": "NIMS surface quality control",
        "bb": "BB1 (main) -> branch BB2/BB3",
        "section": "I",
        "inputs": ["nimsSurface1[0]"],
        "operations": [
          { "op": "detect", "module": "nimsLaserDetection", "target": "nimsSurface1[0]", "output": "surfaceQC1[0]", "duration_s": 10 },
          { "op": "if",     "condition": "surfaceQC1[0] > 0", "true_jump": "bsbbif_2_t", "false_jump": "bsbbif_3_f" }
        ],
        "branch": {
          "pass": { "condition": "surfaceQC > 0", "action": "dispose(nimsSurface1[0])", "bb": "BB2 (bsbbif_2_t)", "interpretation": "test laser shot confirms initiator background ions; surface ready" },
          "fail": { "condition": "surfaceQC <= 0", "action": "drain(nimsSurface1[0])",  "bb": "BB3 (bsbbif_3_f)", "interpretation": "no initiator signal; etching or loading failed; repeat surface prep" }
        }
      },
      {
        "id": "S4",
        "name": "BSA tryptic digest and small molecule detection by laser-NIMS",
        "bb": "BB4 (bsbbif_4_j) -> branch BB5/BB6",
        "section": "II",
        "figure": "Fig 1d",
        "inputs": ["BSA_TrypticDigest", "Verapamil", "AcetonitrileWater_01TFA", "nimsSurface2[0]"],
        "operations": [
          { "op": "dispense", "output": "bsaDigest1[0]",      "reagent": "BSA_TrypticDigest" },
          { "op": "dispense", "output": "bsaSolvent1[0]",     "reagent": "AcetonitrileWater_01TFA" },
          { "op": "mix",      "output": "bsaSpot1[0]",        "inputs": ["bsaDigest1[0]", "bsaSolvent1[0]"], "duration_s": 10 },
          { "op": "heat",     "target": "bsaSpot1[0]",        "temperature_C": 25, "duration_s": 300, "notes": "solvent evaporation before laser irradiation" },
          { "op": "mix",      "output": "bsaSpot_nims1[0]",   "inputs": ["bsaSpot1[0]", "nimsSurface2[0]"], "duration_s": 5 },
          { "op": "detect",   "module": "nimsLaserDetection", "target": "bsaSpot_nims1[0]", "output": "peptideSignal1[0]", "duration_s": 30 },
          { "op": "dispense", "output": "verapamilDrop1[0]",  "reagent": "Verapamil" },
          { "op": "mix",      "output": "verapamilSpot1[0]",  "inputs": ["verapamilDrop1[0]", "nimsSurface2[0]"], "duration_s": 5 },
          { "op": "heat",     "target": "verapamilSpot1[0]",  "temperature_C": 25, "duration_s": 300 },
          { "op": "if",       "condition": "peptideSignal1[0] > 0", "true_jump": "bsbbif_5_t", "false_jump": "bsbbif_6_f" }
        ],
        "ir_durations_s": { "bsaSpot_mix": 10.0, "bsaSpot_heat": 300.0, "bsaSpot_nims_mix": 5.0, "detect_bsa": 30.0, "verapamil_mix": 5.0, "verapamil_heat": 300.0 },
        "expected_results": {
          "BSA_sequence_coverage_pct": 55,
          "BSA_amount": "500 amol",
          "verapamil_amount": "700 ymol (~420 molecules)",
          "detection_mode": "337 nm laser, reflector mode, +20 kV, 100-shot average"
        },
        "branch": {
          "pass": { "condition": "peptideSignal > 0", "action": "dispose(bsaSpot_nims1[0]), dispose(verapamilSpot1[0])", "bb": "BB5 (bsbbif_5_t)" },
          "fail": { "condition": "peptideSignal <= 0", "action": "drain(bsaSpot_nims1[0]),  drain(verapamilSpot1[0])",  "bb": "BB6 (bsbbif_6_f)" }
        }
      },
      {
        "id": "S5",
        "name": "Single cancer cell metabolite profiling by laser-NIMS",
        "bb": "BB7 (bsbbif_7_j) -> branch BB8/BB9",
        "section": "III",
        "figure": "Fig 2",
        "cell_line": "MDA-MB-231 (ATCC HTB-26)",
        "inputs": ["MCF7_Cells_MDA_MB231", "FDA_PI_Stain", "nimsSurface2[0]"],
        "operations": [
          { "op": "dispense", "output": "singleCell1[0]",     "reagent": "MCF7_Cells_MDA_MB231" },
          { "op": "mix",      "output": "cellOnSurface1[0]",  "inputs": ["singleCell1[0]", "nimsSurface2[0]"], "duration_s": 2, "notes": "micromanipulator (MINJ-PD; Tritech Research) cell deposition abstracted as mix" },
          { "op": "heat",     "target": "cellOnSurface1[0]",  "temperature_C": 25, "duration_s": 300, "notes": "cell drying before MS analysis" },
          { "op": "detect",   "module": "nimsLaserDetection", "target": "cellOnSurface1[0]", "output": "cellSignal1[0]", "duration_s": 30 },
          { "op": "dispense", "output": "fdaPiStain1[0]",     "reagent": "FDA_PI_Stain" },
          { "op": "mix",      "output": "stainedCell1[0]",    "inputs": ["cellOnSurface1[0]", "fdaPiStain1[0]"], "duration_s": 600, "notes": "post-MS: 2% paraformaldehyde fixation, cold methanol permeabilisation, DAPI + Alexa555-cytokeratin staining" },
          { "op": "detect",   "module": "nimsFluorescenceDetection", "target": "stainedCell1[0]", "output": "fluoroSignal1[0]", "duration_s": 30 },
          { "op": "if",       "condition": "cellSignal1[0] > 0", "true_jump": "bsbbif_8_t", "false_jump": "bsbbif_9_f" }
        ],
        "ir_durations_s": { "cell_deposition_mix": 2.0, "drying_heat": 300.0, "detect_cell_ms": 30.0, "staining_mix": 600.0, "detect_fluoro": 30.0 },
        "expected_results": {
          "analytes": "Endogenous phospholipids (m/z 400-900), e.g. 1-palmitoyllysophosphatidylcholine",
          "complexity": "Superior to hundreds of cells measured by nanoESI, MALDI, or ion-NIMS (Fig 2c)",
          "initiator_calibrants": ["Na+", "K+", "phosphocholine", "1-palmitoyllysophosphatidylcholine"]
        },
        "branch": {
          "pass": { "condition": "cellSignal > 0", "action": "dispose(stainedCell1[0]), dispose(fluoroSignal1[0])", "bb": "BB8 (bsbbif_8_t)" },
          "fail": { "condition": "cellSignal <= 0", "action": "drain(stainedCell1[0]),  drain(fluoroSignal1[0])",  "bb": "BB9 (bsbbif_9_f)" }
        }
      },
      {
        "id": "S6",
        "name": "Peptide microarray characterisation by ion-NIMS (Bi3+)",
        "bb": "BB10 (bsbbif_10_j) -> branch BB11/BB12",
        "section": "IV",
        "figure": "Fig 3",
        "inputs": ["Bradykinin_2_9", "Bradykinin_1_7", "Neurotensin", "AcetonitrileWater_01TFA", "nimsSurface2[0]"],
        "printing": {
          "method": "robotic contact printing",
          "instrument": "custom arrayer, ArrayIt contact printing head",
          "drop_volume_nL": 1.4,
          "solvent": "1:1 acetonitrile/water + 0.1% TFA"
        },
        "operations": [
          { "op": "dispense", "output": "bk27_solution1[0]",  "reagent": "Bradykinin_2_9" },
          { "op": "dispense", "output": "bk17_solution1[0]",  "reagent": "Bradykinin_1_7" },
          { "op": "dispense", "output": "nt_solution1[0]",    "reagent": "Neurotensin" },
          { "op": "dispense", "output": "arraySolvent1[0]",   "reagent": "AcetonitrileWater_01TFA" },
          { "op": "mix",      "output": "bk27_spot1[0]",      "inputs": ["bk27_solution1[0]", "arraySolvent1[0]"], "duration_s": 5 },
          { "op": "mix",      "output": "bk17_spot1[0]",      "inputs": ["bk17_solution1[0]", "arraySolvent1[0]"], "duration_s": 5 },
          { "op": "mix",      "output": "nt_spot1[0]",        "inputs": ["nt_solution1[0]",   "arraySolvent1[0]"], "duration_s": 5 },
          { "op": "mix",      "output": "peptideArray1[0]",   "inputs": ["bk27_spot1[0]", "nimsSurface2[0]"],     "duration_s": 5 },
          { "op": "mix",      "output": "peptideArray2[0]",   "inputs": ["bk17_spot1[0]", "peptideArray1[0]"],    "duration_s": 5 },
          { "op": "mix",      "output": "peptideArray3[0]",   "inputs": ["nt_spot1[0]",   "peptideArray2[0]"],    "duration_s": 5 },
          { "op": "heat",     "target": "peptideArray3[0]",   "temperature_C": 25, "duration_s": 300, "notes": "array drying before Bi3+ ion analysis" },
          { "op": "detect",   "module": "nimsIonDetection",   "target": "peptideArray3[0]", "output": "arraySignal1[0]", "duration_s": 30 },
          { "op": "if",       "condition": "arraySignal1[0] > 0", "true_jump": "bsbbif_11_t", "false_jump": "bsbbif_12_f" }
        ],
        "ir_durations_s": { "each_peptide_mix": 5.0, "each_array_mix": 5.0, "array_heat": 300.0, "detect_ion": 30.0 },
        "expected_results": {
          "BK_2_9_m_z": 904, "neurotensin_m_z": 1673, "BK_1_7_m_z": 757,
          "sensitivity": "1 fmol per peptide",
          "sensitivity_improvement_over_TOFSIMS": "1000-fold (Ref 16, 21)",
          "mass_range_improvement": "doubles vs cluster sources (Ref 15)",
          "lateral_resolution_nm": 150,
          "spatial_localisation": "BK peptides localise to centre of printed spot (Fig 3c)"
        },
        "branch": {
          "pass": { "condition": "arraySignal > 0", "action": "dispose(peptideArray3[0])", "bb": "BB11 (bsbbif_11_t)" },
          "fail": { "condition": "arraySignal <= 0", "action": "drain(peptideArray3[0])",  "bb": "BB12 (bsbbif_12_f)" }
        }
      },
      {
        "id": "S7",
        "name": "Mouse embryo tissue imaging by laser-NIMS",
        "bb": "BB13 (bsbbif_13_j) -> branch BB14/BB15",
        "section": "V",
        "figure": "Fig 4",
        "inputs": ["MouseEmbryoTissueSection", "nimsSurface2[0]"],
        "tissue_prep": {
          "species": "C57Bl/6J mouse, embryonic day 16.5",
          "sectioning": "12 um cryosections, Leica CM3050 S",
          "embedding": "OCT compound (VWR International)",
          "mounting": "thaw-mount directly onto NIMS chip"
        },
        "operations": [
          { "op": "dispense", "output": "tissueSection1[0]",  "reagent": "MouseEmbryoTissueSection" },
          { "op": "mix",      "output": "mountedTissue1[0]",  "inputs": ["tissueSection1[0]", "nimsSurface2[0]"], "duration_s": 30, "notes": "thaw-mount step abstracted as mix" },
          { "op": "heat",     "target": "mountedTissue1[0]",  "temperature_C": 25, "duration_s": 120, "notes": "laser etching phase: ~0.4 J.cm^-2 per pulse ablates 12 um tissue to expose NIMS surface interface; heat@25C abstracts pulsed photothermal ablation" },
          { "op": "detect",   "module": "nimsLaserDetection", "target": "mountedTissue1[0]", "output": "tissueSignal1[0]", "duration_s": 30, "notes": "NIMS imaging phase: ~0.01 J.cm^-2 per pulse; 100-shot average per raster point; 20 um step size; 15 um beam diameter" },
          { "op": "if",       "condition": "tissueSignal1[0] > 0", "true_jump": "bsbbif_14_t", "false_jump": "bsbbif_15_f" }
        ],
        "ir_durations_s": { "mount_mix": 30.0, "etch_heat": 120.0, "detect_tissue": 30.0 },
        "imaging_parameters": {
          "laser_etch_energy_J_cm2": 0.4,
          "nims_imaging_energy_J_cm2": 0.01,
          "step_size_um": 20,
          "beam_diameter_um": 15,
          "image_width_um": 300,
          "initiator": "bis(heptadecafluoro-1,1,2,2-tetrahydrodecyl)tetramethyldisiloxane"
        },
        "expected_results": {
          "target_lipid": "glycerophosphatidylcholine, m/z 782",
          "localisation": "around developing vertebra (Fig 4b)",
          "image": "300 um-wide false-colour mass intensity map; higher signal (red/yellow/cyan) vs vertebra (dark blue)",
          "also_detected": ["phosphatidylethanolamine (post-source decay)", "gangliosides (with polar initiator)"],
          "scale_bar_mm": 1
        },
        "branch": {
          "pass": { "condition": "tissueSignal > 0", "action": "dispose(mountedTissue1[0])", "bb": "BB14 (bsbbif_14_t)" },
          "fail": { "condition": "tissueSignal <= 0", "action": "drain(mountedTissue1[0])",  "bb": "BB15 (bsbbif_15_f)" }
        }
      },
      {
        "id": "S8",
        "name": "Direct biofluid analysis (blood and urine) by laser-NIMS",
        "bb": "BB16 (bsbbif_16_j) -> branch BB17/BB18",
        "section": "VI",
        "figure": "Fig 5",
        "inputs": ["FreshBlood", "FreshUrine", "Nitrogen_Gas", "nimsSurface2[0]"],
        "operations": [
          { "op": "dispense", "output": "bloodSample1[0]",       "reagent": "FreshBlood" },
          { "op": "dispense", "output": "nitrogenBlowOff1[0]",   "reagent": "Nitrogen_Gas" },
          { "op": "mix",      "output": "bloodOnSurface1[0]",    "inputs": ["bloodSample1[0]", "nimsSurface2[0]"], "duration_s": 30, "notes": "1 uL fresh blood spotted directly; held 30 s" },
          { "op": "mix",      "output": "bloodExcess1[0]",       "inputs": ["bloodOnSurface1[0]", "nitrogenBlowOff1[0]"], "duration_s": 5, "notes": "excess blown off with N2 stream" },
          { "op": "heat",     "target": "bloodExcess1[0]",       "temperature_C": 25, "duration_s": 60, "notes": "laser-etch phase (~0.4 J.cm^-2) to ablate cellular blood matrix; heat@25C abstracts pulsed ablation" },
          { "op": "mix",      "output": "bloodNIMS1[0]",         "inputs": ["bloodExcess1[0]", "nimsSurface2[0]"], "duration_s": 5, "notes": "NIMS interrogation of etched blood surface layer" },
          { "op": "dispense", "output": "urineSample1[0]",       "reagent": "FreshUrine" },
          { "op": "dispense", "output": "nitrogenBlowOff21[0]",  "reagent": "Nitrogen_Gas" },
          { "op": "mix",      "output": "urineOnSurface1[0]",    "inputs": ["urineSample1[0]", "nimsSurface2[0]"], "duration_s": 30, "notes": "1 uL fresh urine spotted; no etch step for urine" },
          { "op": "mix",      "output": "urineExcess1[0]",       "inputs": ["urineOnSurface1[0]", "nitrogenBlowOff21[0]"], "duration_s": 5 },
          { "op": "mix",      "output": "urineNIMS1[0]",         "inputs": ["urineExcess1[0]", "nimsSurface2[0]"], "duration_s": 5 },
          { "op": "detect",   "module": "nimsLaserDetection",    "target": "bloodNIMS1[0]",  "output": "biofluidSignal1[0]", "duration_s": 30 },
          { "op": "detect",   "module": "nimsLaserDetection",    "target": "urineNIMS1[0]",  "output": "urineSignal1[0]",   "duration_s": 30 },
          { "op": "if",       "condition": "biofluidSignal1[0] > 0", "true_jump": "bsbbif_17_t", "false_jump": "bsbbif_18_f" }
        ],
        "ir_durations_s": {
          "blood_spot_mix": 30.0, "blood_N2_mix": 5.0, "blood_etch_heat": 60.0, "blood_nims_mix": 5.0,
          "urine_spot_mix": 30.0, "urine_N2_mix": 5.0, "urine_nims_mix": 5.0,
          "detect_blood": 30.0, "detect_urine": 30.0
        },
        "expected_results": {
          "blood_dominant_ions": "Phospholipids (e.g. PC lipids) partitioned into perfluorinated clathrates",
