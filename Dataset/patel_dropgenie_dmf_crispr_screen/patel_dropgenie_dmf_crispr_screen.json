{
  "protocol": {
    "title": "Miniaturized Scalable Arrayed CRISPR Screening in Primary Cells Enables Discovery at the Single Donor Resolution",
    "source": "Scientific Reports 2025, 15, 29350",
    "doi": "https://doi.org/10.1038/s41598-025-13532-z",
    "source_link": "https://www.nature.com/articles/s41598-025-13532-z",
    "platform": "DropGenie Digital Microfluidics (DMF) Electroporation System (Tri-Drop Electroporation, 48-site SBS-format cartridge)",
    "cell_types": [
      "Primary human skeletal muscle myoblasts (Zen-Bio; adherent)",
      "Primary human Pan CD3+ T cells (suspension; leukopak-derived)",
      "Primary human CD4+ Helper T cells (AllCells; suspension)",
      "Primary human CD4+CD25+ Regulatory T cells (iQ Biosciences; suspension)"
    ],
    "objective": "High-throughput, low-input genome engineering in primary human cells using DMF electroporation. Three arms: (1) CRISPR-Cas9 RNP knockout (TRAC) in T cells, (2) HDR knock-in (GFP cssDNA and anti-HER2 CAR dsDNA) at the TRAC locus, (3) Arrayed CRISPR-Cas9 exhaustion screen in chronically stimulated primary human CD4+ T cells (45 targets, 192 edits).",

    "device": {
      "name": "DropGenie Transfection System",
      "cartridge_format": "SBS (Society for Biological Screening) standard",
      "reaction_sites": 48,
      "electroporation_mechanism": "Tri-Drop Electroporation: two conductive DMFection Buffer droplets flank a central cell-and-cargo droplet on a planar electrode array; actuation forms a transient low-current electroporation zone",
      "guide_deposition": {
        "tool": "Echo 655 acoustic liquid handler (Beckman Coulter)",
        "volume_nL": 40,
        "carrier": "Poly-L-glutamic acid (PGA, Sigma Aldrich) at 100 mg/mL",
        "format": "dry-deposited spots on substrate; desiccated before cartridge assembly",
        "sgRNA_stock_concentration_pmol_uL": {
          "T_cells": 100,
          "myoblasts": 200
        },
        "sgRNA_final_concentration_pmol_uL": {
          "T_cells": 55.6,
          "myoblasts": 111.1
        },
        "plate_format": "Echo Qualified 384-well Low Dead Volume (Beckman Coulter)"
      },
      "loading_tool": "Assist Plus 8-channel 125 uL Integra Voyager pipette",
      "loading_volume_uL_per_well": 100,
      "offloading_tool": "Assist Plus into 96-well round-bottom plate",
      "electroporation_parameters": {
        "Pan_CD3_T_cells_KO":   { "voltage_V": 500, "pulse_duration_ms": 3, "pulses": 2, "incubation_min": 5 },
        "CD4_Treg_T_cells_KO":  { "voltage_V": 550, "pulse_duration_ms": 2, "pulses": 2, "incubation_min": 5 },
        "T_cell_knock_in":      { "voltage_V": 500, "pulse_duration_ms": "2 or 4", "pulses": 2 },
        "exhaustion_screen":    { "voltage_V": 550, "pulse_duration_ms": 2, "pulses": 2, "incubation_min": 5 },
        "myoblasts_KO_mRNA":    { "voltage_V": 500, "pulse_duration_ms": 3, "pulses": 3, "incubation_min": 10 }
      },
      "downstream_readouts": [
        "Flow cytometry (Attune NxT, Thermo Fisher)",
        "Sanger sequencing + ICE analysis v3.0 (Synthego / Quintara Bio)",
        "Incucyte Live-Cell Analysis System (Sartorius; 20X myoblasts, 10X T cells)",
        "Sandwich ELISA (RayBiotech TNFalpha + IFNgamma kits)",
        "Western blot (MBNL1; ECL, iBright chemiluminescence system)",
        "Fluorescence microscopy (EVOS Cell Imaging System, Thermo Fisher)"
      ]
    },

    "reagents": {
      "electroporation_buffers": {
        "DMFection_Buffer": "DropGenie proprietary electroporation buffer",
        "Transfection_Buffer": "0.01% Surfactant F (ITW Reagents) in DMFection Buffer"
      },
      "nuclease": {
        "enzyme": "SpCas9 Nuclease (Aldevron)",
        "amount_per_edit_KO_pmol": 0.42,
        "amount_per_edit_screen_pmol": 1.0,
        "amount_per_edit_KI_pmol": 0.33,
        "total_per_100uL_load_KO_pmol": 42
      },
      "cas9_enhancer": {
        "reagent": "Alt-R Cas9 Electroporation Enhancer (IDT)",
        "amount_per_edit_pmol": 0.5,
        "use": "Regulatory T cells only"
      },
      "mRNA": {
        "reagent": "EGFP mRNA (TriLink Biotechnologies)",
        "concentration_myoblasts_ug_mL": 200,
        "concentration_T_cells_ug_mL": 100
      },
      "KI_templates": {
        "GFP_cssDNA": {
          "source": "Full Circles Therapeutics",
          "type": "circular single-stranded DNA (cssDNA)",
          "size_kb": 4,
          "target_locus": "TRAC",
          "concentrations_tested_ug_per_edit": [0.03, 0.06]
        },
        "AntiHER2_CAR_dsDNA": {
          "source": "Integrated DNA Technologies (IDT) Alt-R HDR Donor Block",
          "type": "double-stranded linear DNA",
          "size_kb": 3,
          "target_locus": "TRAC",
          "homology_arms": "TRAC-targeting",
          "CAR_design": "second-generation anti-HER2 CAR based on Priceman et al. 2018",
          "concentrations_tested_ng_per_edit": [10, 5, 0.625, 0.0375, 0],
          "HDR_enhancer": "Alt-R HDR Enhancer V2 (IDT), 15 uM"
        }
      },
      "cell_culture_media": {
        "Basal_T_Cell_Media": "RPMI 1640 + GlutaMax (Gibco) + 10% FBS + 1% penicillin-streptomycin",
        "Skeletal_Muscle_Cell_Growth_Media": "Zen-Bio proprietary (myoblasts)",
        "ImmunoCult_Activator": {
          "reagent": "ImmunoCult Human CD3/CD28 T Cell Activator (STEMCELL Technologies)",
          "concentration_activation_uL_mL": 25,
          "concentration_exhaustion_uL_mL": 25
        },
        "cytokines": {
          "IL2_activation_IU_mL": 200,
          "IL2_exhaustion_IU_mL": 10,
          "IL7_activation_ng_mL": 25,
          "IL7_KI_ng_mL": 10,
          "IL15_activation_ng_mL": 50,
          "IL15_KI_ng_mL": 5
        },
        "Dynabeads_T_Activator": {
          "reagent": "Dynabeads Human T-Activator CD3/CD28 (Gibco)",
          "bead_to_cell_ratio": "2:5",
          "use": "KI arm (Pan CD3+ T cells) only; removed magnetically before loading"
        }
      },
      "flow_cytometry": {
        "buffer": "1X PBS + 2% FBS + 2 mM EDTA (Invitrogen)",
        "viability_dye": "Ghost Dye Violet 510 (Cytek Biosciences), 1:1000 in 1X PBS, 10 min RT",
        "stains": {
          "PE_LAG3": "BioLegend (exhaustion screen, ARM 3)",
          "TCR_alpha_beta": "surface stain (TRAC KO validation, ARM 1)",
          "FITC_FoxP3": "BioLegend; intracellular (Regulatory T cell characterisation)",
          "FITC_Protein_L": "GenScript, 1:300 in 4% BSA/PBS, 20 min RT in dark (CAR-T)"
        }
      },
      "ELISA": {
        "kits": ["RayBiotech TNFalpha sandwich ELISA", "RayBiotech IFNgamma sandwich ELISA"],
        "diluent": "Assay Diluent B (RayBiotech)",
        "dilution_factors": [3.84, 2.5],
        "curve_fit": "4-Parameter Logistic (4PL) regression",
        "normalisation": "Background subtracted using media-only (MO) control; normalised to event counts by flow cytometry and adjusted for dilution factors",
        "supernatant_collection_day": 28,
        "supernatant_collection_window_h": 48,
        "storage_temp_C": -80
      }
    },

    "arms": [
      {
        "id": "ARM1",
        "name": "CRISPR-Cas9 TRAC Knockout in Primary Human T Cells",
        "cell_type": "CD4+ Helper T cells (AllCells); also Pan CD3+ and Regulatory T cells",
        "cells_per_edit": 10000,
        "target_gene": "TRAC (T cell receptor alpha constant)",
        "purpose": "Validate high-efficiency RNP delivery and knockout in primary T cells at low cell input (Fig. 2B/C)",
        "bioscript_bbs": ["BB1 (main)", "BB2 (knockoutPass)", "BB3 (knockoutFail)", "BB4 (knockoutJoin)"],
        "steps": [
          {
            "id": "A1-S1",
            "name": "T cell activation (off-chip)",
            "inputs": ["CD4_T_Cells", "BasalTCellMedia", "IL2_200IU", "ImmunoCult_CD3CD28_Activator"],
            "operation": "mix + heat",
            "temperature_C": 37,
            "duration_s": 259200,
            "duration_human": "3 days",
            "cell_concentration_cells_mL": 1250000,
            "notes": "IL-2 400 IU/mL + IL-7 25 ng/mL + IL-15 50 ng/mL. Viability assessed by NucleoCounter NC-202 before use (>80% required)."
          },
          {
            "id": "A1-S2",
            "name": "Cell wash and resuspension in Transfection Buffer",
            "inputs": ["DMFectionBuffer", "SurfactantF_Buffer", "activated_cells"],
            "operation": "mix",
            "cell_concentration_cells_mL": 10000000,
            "notes": "0.01% Surfactant F in DMFection Buffer. NucleoCounter viability check before loading."
          },
          {
            "id": "A1-S3",
            "name": "sgRNA pre-deposition onto cartridge substrate",
            "tool": "Echo 655 acoustic liquid handler",
            "inputs": ["TRAC_sgRNA", "PGA_carrier"],
            "volume_per_site_nL": 40,
            "operation": "acoustic dispense (abstracted as dispense in BioScript)",
            "notes": "55.6 pmol/uL sgRNA + PGA; dry-deposited and desiccated. Per edit: 2.1 pmol sgRNA."
          },
          {
            "id": "A1-S4",
            "name": "Cartridge loading (cells + SpCas9)",
            "inputs": ["cellSuspension", "TRAC_sgRNA", "SpCas9_Nuclease"],
            "operation": "mix (abstracts Assist Plus loading)",
            "SpCas9_per_edit_pmol": 0.42,
            "sgRNA_per_edit_pmol": 2.1,
            "volume_per_well_uL": 100,
            "pre_pulse_incubation_min": 5,
            "pre_pulse_temperature_C": 25,
            "notes": "RNP complexes form in situ during 5-min incubation on substrate."
          },
          {
            "id": "A1-S5",
            "name": "Electroporation (Tri-Drop)",
            "inputs": ["cartridgeLoad", "FC_Oil"],
            "operation": "mix (abstracts Tri-Drop circuit formation + pulse delivery)",
            "voltage_V": 550,
            "pulse_duration_ms": 2,
            "pulses": 2,
            "notes": "FC_Oil abstracts flanking DMFection Buffer droplets in BioScript. Pulse delivery instantaneous."
          },
          {
            "id": "A1-S6",
            "name": "Offload and post-KO culture",
            "inputs": ["electroporatedCells", "BasalTCellMedia", "IL2_200IU"],
            "operation": "mix + heat",
            "temperature_C": 37,
            "duration_s": 259200,
            "duration_human": "3 days",
            "format": "96-well round-bottom plate"
          },
          {
            "id": "A1-S7",
            "name": "Knockout detection (flow cytometry)",
            "inputs": ["kulturedCells"],
            "operation": "detect knockoutDetection",
            "detection_duration_s": 30,
            "stains": ["anti-TCR alpha/beta", "Ghost Dye Violet 510", "CD4", "CD8"],
            "instrument": "Attune NxT",
            "results": {
              "CD4_TRAC_KO_pct": { "mean": 90.41, "sd": 3.27 },
              "CD8_TRAC_KO_pct": { "mean": 91.87, "sd": 3.13 },
              "viability_TRAC_RNP_pct": { "mean": 97.23, "sd": 0.28 },
              "viability_NTC_RNP_pct": { "mean": 97.83, "sd": 0.09 },
              "Regulatory_T_cell_TRAC_KO_pct": { "mean": 76.78, "sd": 8.62 },
              "Regulatory_T_cell_viability_pct": { "mean": 97.22, "sd": 0.89 }
            },
            "branch": {
              "pass": { "condition": "knockoutSignal > 0", "action": "dispose(kulturedCells)", "next_bb": "BB4" },
              "fail": { "condition": "knockoutSignal <= 0", "action": "drain(kulturedCells)", "next_bb": "BB4" }
            }
          }
        ]
      },

      {
        "id": "ARM2",
        "name": "GFP Knock-In at TRAC Locus via HDR (cssDNA and CAR dsDNA)",
        "cell_type": "Primary human Pan CD3+ T cells (separate donor from ARM 1)",
        "cells_per_edit": 10000,
        "target_locus": "TRAC",
        "purpose": "Validate HDR-mediated knock-in of 4 kb GFP cssDNA and 3 kb anti-HER2 CAR dsDNA at low cell input (Fig. 2D/E)",
        "bioscript_bbs": ["BB4 (knockoutJoin)", "BB5 (knockInPass)", "BB6 (knockInFail)", "BB7 (knockInJoin)"],
        "steps": [
          {
            "id": "A2-S1",
            "name": "T cell activation (Dynabead protocol, separate donor)",
            "inputs": ["CD4_T_Cells", "BasalTCellMedia", "IL2_200IU", "Dynabeads_CD3_CD28"],
            "operation": "mix + heat",
            "temperature_C": 37,
            "duration_s": 259200,
            "duration_human": "3 days",
            "cell_concentration_cells_mL": 250000,
            "cytokines": { "IL2_IU_mL": 200, "IL7_ng_mL": 10, "IL15_ng_mL": 5 },
            "notes": "Dynabeads removed magnetically before cartridge loading."
          },
          {
            "id": "A2-S2",
            "name": "On-ice RNP assembly",
            "inputs": ["TRAC_sgRNA", "SpCas9_Nuclease"],
            "operation": "mix + heat",
            "temperature_C": 4,
            "duration_s": 1200,
            "duration_human": "20 min",
            "sgRNA_total_pmol": 110,
            "Cas9_total_pmol": 33,
            "per_edit_sgRNA_pmol": 1.1,
            "per_edit_Cas9_pmol": 0.33
          },
          {
            "id": "A2-S3",
            "name": "Cartridge loading (cells + RNP + GFP cssDNA)",
            "inputs": ["cellSuspension", "rnpAssembly", "GFP_cssDNA_Template"],
            "operation": "mix (abstracts Assist Plus loading)",
            "template_concentrations_ug_per_edit": [0.03, 0.06],
            "volume_per_well_uL": 100
          },
          {
            "id": "A2-S4",
            "name": "Electroporation (Tri-Drop)",
            "voltage_V": 500,
            "pulse_duration_ms": "2 or 4",
            "pulses": 2,
            "operation": "mix (abstracts Tri-Drop circuit + pulse)"
          },
          {
            "id": "A2-S5",
            "name": "Offload and 10-day expansion",
            "inputs": ["electroporatedCells", "BasalTCellMedia", "IL2_300IU"],
            "operation": "mix + heat",
            "temperature_C": 37,
            "duration_s": 864000,
            "duration_human": "10 days",
            "format": "96-well round-bottom plate"
          },
          {
            "id": "A2-S6",
            "name": "GFP knock-in detection (flow cytometry + fluorescence microscopy)",
            "operation": "detect knockInDetection",
            "detection_duration_s": 30,
            "stains": ["GFP channel", "TRAC KO co-stain", "Ghost Dye Violet 510"],
            "microscopy": "EVOS Cell Imaging System (Day 10)",
            "results": {
              "GFP_pos_0_03ug_500V_2ms_2p_pct": { "mean": 52.37, "sd": 9.70 },
              "GFP_pos_0_06ug_500V_2ms_2p_pct": { "mean": 41.14, "sd": 9.45 },
              "GFP_pos_0_03ug_500V_4ms_2p_pct": { "mean": 42.02, "sd": 7.56 },
              "GFP_pos_0_06ug_500V_4ms_2p_pct": { "mean": 47.99, "sd": 8.24 },
              "no_template_control_pct": { "mean": 11.21, "sd": 2.83 },
              "off_chip_control_pct": { "mean": 10.62, "sd": 4.49 },
              "significance": "p < 0.0001 vs no-template and off-chip controls (One-way ANOVA)"
            },
            "branch": {
              "pass": { "condition": "knockInSignal > 0", "action": "dispose(kulturedCells)", "next_bb": "BB7" },
              "fail": { "condition": "knockInSignal <= 0", "action": "drain(kulturedCells)", "next_bb": "BB7" }
            }
          }
        ],
        "antiHER2_CAR_extension": {
          "template": "3 kb dsDNA anti-HER2 CAR (IDT Alt-R HDR Donor Block)",
          "concentrations_ng_per_edit": [10, 5, 0.625, 0.0375, 0],
          "voltage_V": 500,
          "pulse_duration_ms": 4,
          "pulses": 2,
          "HDR_enhancer": "Alt-R HDR Enhancer V2 (IDT), 15 uM in recovery media",
          "expansion_days": 10,
          "detection": "Protein L staining (FITC-Protein L, GenScript, 1:300) + CD3 co-stain",
          "results": {
            "CAR_expression_max_pct": 40,
            "CAR_expression_average_pct": 27.03,
            "viability_all_conditions_pct_min": 55,
            "significance": "p < 0.001 vs no-template at all concentrations tested"
          }
        }
      },

      {
        "id": "ARM3",
        "name": "Arrayed CRISPR-Cas9 Exhaustion Screen in Primary Human CD4+ T Cells",
        "cell_type": "Primary human CD4+ Helper T cells (AllCells; peripheral blood, negatively selected)",
        "cells_per_edit": 10000,
        "total_targets": 45,
        "total_edits": 192,
        "replicates_per_target": 4,
        "cartridge_runs": 4,
        "purpose": "Identify genetic regulators of CD4+ T cell exhaustion using miniaturized arrayed CRISPR screen at 25x fewer cells and ~50x less Cas9 vs conventional methods (Fig. 3)",
        "bioscript_bbs": ["BB7 (knockInJoin)", "BB8 (screenPass)", "BB9 (screenFail)", "BB10 (finalCleanup)"],
        "exhaustion_model": {
          "method": "Repeated ImmunoCult CD3/CD28 + low-dose IL-2 stimulation every 3 days",
          "duration_days": 28,
          "IL2_concentration_IU_mL": 10,
          "ImmunoCult_concentration_uL_mL": 25,
          "media_volume_uL": 50,
          "cycles": 9,
          "cycle_duration_days": 3,
          "final_restimulation_h": 48,
          "rationale": "Gradual acquisition of exhaustion phenotypes; recapitulates in vivo progressive T cell dysfunction"
        },
        "screen_targets": {
          "top_hits_exhaustion_escape": ["SIN3A", "PAF1", "PRDM1", "SETBP1", "STAT1", "LAG3"],
          "hits_increased_exhaustion": ["SIN3A (also top escape)", "PRDM1", "ID2"],
          "categories": ["immune checkpoints", "epigenetic regulators", "transcriptional elongation factors", "cytokine signaling"],
          "other_targets_tested": ["TOX", "NR4A1", "NR4A2", "DNMT3A", "EZH2", "FOXO1", "BATF", "TCF7", "TBX21", "EOMES", "BCL6", "VISTA", "KLRG1", "BLIMP1", "ID3", "ID2", "BRD4", "CDK8", "CDC42", "BAF", "LASS6", "NFA1", "NFA2", "MEF2", "HIF1b", "and others"]
        },
        "steps": [
          {
            "id": "A3-S1",
            "name": "CD4+ T cell activation (screen donor, off-chip)",
            "inputs": ["CD4_T_Cells", "BasalTCellMedia", "IL2_200IU", "ImmunoCult_CD3CD28_Activator"],
            "operation": "mix + heat",
            "temperature_C": 37,
            "duration_s": 259200,
            "duration_human": "3 days",
            "cell_concentration_cells_mL": 1250000,
            "cytokines": { "IL2_IU_mL": 400, "IL7_ng_mL": 25, "IL15_ng_mL": 50 }
          },
          {
            "id": "A3-S2",
            "name": "Guide pre-deposition for 45-target screen",
            "tool": "Echo 655 acoustic liquid handler",
            "volume_per_site_nL": 40,
            "targets": 45,
            "replicates": 4,
            "controls": ["NTC (non-targeting control)", "OCC (off-chip control)"],
            "total_sites": 192,
            "operation": "acoustic dispense (abstracted as dispense in BioScript)"
          },
          {
            "id": "A3-S3",
            "name": "Cartridge loading (cells + SpCas9)",
            "inputs": ["cellSuspension", "ExhaustionTarget_sgRNA", "SpCas9_Nuclease"],
            "operation": "mix + heat",
            "SpCas9_per_edit_pmol": 1.0,
            "sgRNA_per_edit_pmol": 2.0,
            "volume_per_well_uL": 100,
            "pre_pulse_incubation_min": 5,
            "pre_pulse_temperature_C": 25,
            "reagent_reduction_vs_conventional": {
              "cells": "25-50x fewer (10,000 vs 500,000 per edit)",
              "Cas9": "~100x less (1 pmol vs 100 pmol)",
              "sgRNA": "~25x less (2 pmol vs 50 pmol)"
            }
          },
          {
            "id": "A3-S4",
            "name": "Electroporation (Tri-Drop; 550 V, 2 ms, 2 pulses)",
            "voltage_V": 550,
            "pulse_duration_ms": 2,
            "pulses": 2,
            "operation": "mix (abstracts Tri-Drop circuit + pulse)"
          },
          {
            "id": "A3-S5",
            "name": "Post-KO recovery (3 days)",
            "inputs": ["electroporatedCells", "BasalTCellMedia", "IL2_200IU"],
            "operation": "mix + heat",
            "temperature_C": 37,
            "duration_s": 259200,
            "duration_human": "3 days",
            "format": "96-well round-bottom plate"
          },
          {
            "id": "A3-S6",
            "name": "Chronic exhaustion induction (9 cycles x 3 days; loop unrolled in BioScript)",
            "inputs": ["BasalTCellMedia", "IL2_10IU", "ImmunoCult_CD3CD28_Activator"],
            "operation": "9x (mix + heat)",
            "cycles": [
              { "label": "Cycle 1", "days": "3-6",   "variable": "stimCells_c1", "duration_s": 259200 },
              { "label": "Cycle 2", "days": "6-9",   "variable": "stimCells_c2", "duration_s": 259200 },
              { "label": "Cycle 3", "days": "9-12",  "variable": "stimCells_c3", "duration_s": 259200 },
              { "label": "Cycle 4", "days": "12-15", "variable": "stimCells_c4", "duration_s": 259200 },
              { "label": "Cycle 5", "days": "15-18", "variable": "stimCells_c5", "duration_s": 259200 },
              { "label": "Cycle 6", "days": "18-21", "variable": "stimCells_c6", "duration_s": 259200 },
              { "label": "Cycle 7", "days": "21-24", "variable": "stimCells_c7", "duration_s": 259200 },
              { "label": "Cycle 8", "days": "24-27", "variable": "stimCells_c8", "duration_s": 259200 },
              { "label": "Cycle 9 (final)", "days": "27-28", "variable": "stimCells_c9", "duration_s": 172800, "notes": "48 h final restimulation before Day 28 assay readout" }
            ],
            "temperature_C": 37,
            "bioscript_note": "Loop unrolled as 9 sequential mix+heat pairs; lilott8/BioScript has no repeat/while primitive"
          },
          {
            "id": "A3-S7",
            "name": "LAG-3 staining (exhaustion phenotype readout)",
            "inputs": ["stimCells_c9", "PE_LAG3_Stain"],
            "operation": "mix for 20m + detect exhaustionPhenotypeDetection",
            "detection_duration_s": 30,
            "stains": ["PE-LAG3 (BioLegend)", "Ghost Dye Violet 510 (viability)", "CD4 (lineage gate)"],
            "incubation_min": 20,
            "incubation_temp_C": 4,
            "gating": "Live > Singlets > CD4+ > LAG3-negative",
            "readout": "% LAG3-negative CD4+ T cells (exhaustion escape frequency)",
            "branch": {
              "pass": { "condition": "screenSignal > 0 (LAG3- > NTC mean)", "action": "dispose(stainedForFACS)", "next_bb": "BB10" },
              "fail": { "condition": "screenSignal <= 0", "action": "drain(stainedForFACS)", "next_bb": "BB10" }
            }
          },
          {
            "id": "A3-S8",
            "name": "Cytokine ELISA (IFNgamma + TNFalpha)",
            "inputs": ["screenSignal (supernatant proxy)"],
            "operation": "detect cytokineDetection",
            "detection_duration_s": 60,
            "kits": ["RayBiotech IFNgamma sandwich ELISA", "RayBiotech TNFalpha sandwich ELISA"],
            "collection_day": 28,
            "supernatant_window_h": 48,
            "dilution_factors": [3.84, 2.5],
            "curve_fit": "4-Parameter Logistic (4PL) regression",
            "bioscript_note": "cytokineDetection runs on screenSignal variable (detect output used as fluid proxy for supernatant); runs regardless of LAG-3 gate outcome for composite scoring."
          },
          {
            "id": "A3-S9",
            "name": "Composite exhaustion escape scoring (off-chip, terminal)",
            "method": "z-score normalization of IFNgamma + TNFalpha + %LAG3-negative CD4+ T cells",
            "exclusion_criteria": {
              "viability_threshold_pct": 70,
              "CD4_frequency_threshold_pct": 90
            },
            "top_hits": ["SIN3A", "PAF1", "PRDM1", "SETBP1", "STAT1"],
            "visualization": "Radar plot per top hit across 3 axes (IFNgamma, TNFalpha, %LAG3-)",
            "bioscript_bb": "BB10 (finalCleanup/terminal)"
          }
        ]
