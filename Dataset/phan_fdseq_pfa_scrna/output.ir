bsbbif_2_t:
	dispose(wtaReaction1[0])
bsbbif_3_f:
	dispose(wtaReaction1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(barcodeSignal1[0])
	wtaForTag11[0] = dispense(WTA_PCR_Mix)
	wtaForTag21[0] = dispense(WTA_PCR_Mix)
	tdm11[0] = dispense(TagmentDNAMix)
	tdm21[0] = dispense(TagmentDNAMix)
	atm11[0] = dispense(AmpliconTagmentMix)
	atm21[0] = dispense(AmpliconTagmentMix)
	tagStep1a1[0] = mix(wtaForTag11[0], tdm11[0]) @ 60.0SECOND
	tagStep1b1[0] = mix(wtaForTag21[0], tdm21[0]) @ 60.0SECOND
	tagWithATM11[0] = mix(tagStep1a1[0], atm11[0]) @ 60.0SECOND
	tagWithATM21[0] = mix(tagStep1b1[0], atm21[0]) @ 60.0SECOND
	heat(tagWithATM11[0]) @ 55.0CELSIUS @ 300.0SECOND
	heat(tagWithATM21[0]) @ 55.0CELSIUS @ 300.0SECOND
	nt11[0] = dispense(NTBuffer)
	nt21[0] = dispense(NTBuffer)
	neutralised11[0] = mix(tagWithATM11[0], nt11[0]) @ 300.0SECOND
	neutralised21[0] = mix(tagWithATM21[0], nt21[0]) @ 300.0SECOND
	p5tso11[0] = dispense(P5TSO_Primer)
	p5tso21[0] = dispense(P5TSO_Primer)
	n7xx11[0] = dispense(NexteraN7XX_Primer)
	n7xx21[0] = dispense(NexteraN7XX_Primer)
	npm11[0] = dispense(NexteraPCRMasterMix)
	npm21[0] = dispense(NexteraPCRMasterMix)
	tagPCRmix11[0] = mix(neutralised11[0], p5tso11[0]) @ 30.0SECOND
	tagPCRmix1b1[0] = mix(tagPCRmix11[0], n7xx11[0]) @ 30.0SECOND
	tagReaction11[0] = mix(tagPCRmix1b1[0], npm11[0]) @ 30.0SECOND
	tagPCRmix21[0] = mix(neutralised21[0], p5tso21[0]) @ 30.0SECOND
	tagPCRmix2b1[0] = mix(tagPCRmix21[0], n7xx21[0]) @ 30.0SECOND
	tagReaction21[0] = mix(tagPCRmix2b1[0], npm21[0]) @ 30.0SECOND
	heat(tagReaction11[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(tagReaction11[0]) @ 55.0CELSIUS @ 360.0SECOND
	heat(tagReaction11[0]) @ 72.0CELSIUS @ 300.0SECOND
	heat(tagReaction21[0]) @ 95.0CELSIUS @ 30.0SECOND
	heat(tagReaction21[0]) @ 55.0CELSIUS @ 360.0SECOND
	heat(tagReaction21[0]) @ 72.0CELSIUS @ 300.0SECOND
	librarySignal1[0] = detect(wqaQCDetection, tagReaction11[0]) @ 600.0SECOND
	if librarySignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	cellSample1[0] = dispense(PBS)
	bsaWash11[0] = dispense(BSA_Wash_Buffer)
	washedCells11[0] = mix(cellSample1[0], bsaWash11[0]) @ 300.0SECOND
	pfa1[0] = dispense(PFA_4pct)
	fixedCells1[0] = mix(washedCells11[0], pfa1[0]) @ 900.0SECOND
	bsaWash21[0] = dispense(BSA_Wash_Buffer)
	washedFixed1[0] = mix(fixedCells1[0], bsaWash21[0]) @ 300.0SECOND
	triton1[0] = dispense(TritonX100_01pct)
	permeabilized1[0] = mix(washedFixed1[0], triton1[0]) @ 900.0SECOND
	bsaWash31[0] = dispense(BSA_Wash_Buffer)
	washed31[0] = mix(permeabilized1[0], bsaWash31[0]) @ 300.0SECOND
	bsaWash41[0] = dispense(BSA_Wash_Buffer)
	washed41[0] = mix(washed31[0], bsaWash41[0]) @ 300.0SECOND
	bsa001_w11[0] = dispense(BSA_001pct)
	prefixed_w11[0] = mix(washed41[0], bsa001_w11[0]) @ 120.0SECOND
	bsa001_w21[0] = dispense(BSA_001pct)
	prefixed_w21[0] = mix(prefixed_w11[0], bsa001_w21[0]) @ 120.0SECOND
	bsa001_w31[0] = dispense(BSA_001pct)
	cellsReady1[0] = mix(prefixed_w21[0], bsa001_w31[0]) @ 120.0SECOND
	lysisBeads1[0] = dispense(LysisBuffer_DTT_ProtK)
	dropseqBeads1[0] = dispense(DropSeq_Beads)
	beadsReady1[0] = mix(lysisBeads1[0], dropseqBeads1[0]) @ 120.0SECOND
	cellBeadMix1[0] = mix(cellsReady1[0], beadsReady1[0]) @ 1200.0SECOND
	oil1[0] = dispense(Oil_BioRad)
	emulsion1[0] = mix(cellBeadMix1[0], oil1[0]) @ 1200.0SECOND
	heat(emulsion1[0]) @ 56.0CELSIUS @ 3600.0SECOND
	heat(emulsion1[0]) @ 25.0CELSIUS @ 600.0SECOND
	heat(emulsion1[0]) @ 4.0CELSIUS @ 300.0SECOND
	ssc11[0] = dispense(SSC_6X)
	pfol1[0] = dispense(Perfluorooctan1ol)
	brokenEmulsion1[0] = mix(emulsion1[0], ssc11[0]) @ 60.0SECOND
	brokenEmulsion21[0] = mix(brokenEmulsion1[0], pfol1[0]) @ 60.0SECOND
	ssc21[0] = dispense(SSC_6X)
	beadFraction11[0] = mix(brokenEmulsion21[0], ssc21[0]) @ 180.0SECOND
	ssc31[0] = dispense(SSC_6X)
	beadWash11[0] = mix(beadFraction11[0], ssc31[0]) @ 60.0SECOND
	ssc41[0] = dispense(SSC_6X)
	beadWash21[0] = mix(beadWash11[0], ssc41[0]) @ 60.0SECOND
	dispose(brokenEmulsion1[0])
	rtMix1[0] = dispense(RT_Mix)
	beadsInRT1[0] = mix(beadWash21[0], rtMix1[0]) @ 1800.0SECOND
	heat(beadsInRT1[0]) @ 25.0CELSIUS @ 1800.0SECOND
	heat(beadsInRT1[0]) @ 42.0CELSIUS @ 5400.0SECOND
	rtWash11[0] = dispense(BSA_Wash_Buffer)
	rtWashed11[0] = mix(beadsInRT1[0], rtWash11[0]) @ 60.0SECOND
	rtWash21[0] = dispense(BSA_Wash_Buffer)
	rtWashed21[0] = mix(rtWashed11[0], rtWash21[0]) @ 60.0SECOND
	rtWash31[0] = dispense(BSA_Wash_Buffer)
	rtWashed31[0] = mix(rtWashed21[0], rtWash31[0]) @ 60.0SECOND
	rtWash41[0] = dispense(BSA_Wash_Buffer)
	rtWashed41[0] = mix(rtWashed31[0], rtWash41[0]) @ 60.0SECOND
	exoMix1[0] = dispense(ExoI_Mix)
	beadsInExo1[0] = mix(rtWashed41[0], exoMix1[0]) @ 300.0SECOND
	heat(beadsInExo1[0]) @ 37.0CELSIUS @ 2700.0SECOND
	exoWash11[0] = dispense(BSA_Wash_Buffer)
	exoWashed11[0] = mix(beadsInExo1[0], exoWash11[0]) @ 60.0SECOND
	exoWash21[0] = dispense(BSA_Wash_Buffer)
	exoWashed21[0] = mix(exoWashed11[0], exoWash21[0]) @ 60.0SECOND
	exoWash31[0] = dispense(BSA_Wash_Buffer)
	exoWashed31[0] = mix(exoWashed21[0], exoWash31[0]) @ 60.0SECOND
	wta_water1[0] = dispense(PBS)
	beadsForWTA1[0] = mix(exoWashed31[0], wta_water1[0]) @ 120.0SECOND
	wtaMix1[0] = dispense(WTA_PCR_Mix)
	wtaReaction1[0] = mix(beadsForWTA1[0], wtaMix1[0]) @ 120.0SECOND
	heat(wtaReaction1[0]) @ 95.0CELSIUS @ 180.0SECOND
	heat(wtaReaction1[0]) @ 65.0CELSIUS @ 720.0SECOND
	heat(wtaReaction1[0]) @ 67.0CELSIUS @ 600.0SECOND
	heat(wtaReaction1[0]) @ 72.0CELSIUS @ 300.0SECOND
	barcodeSignal1[0] = detect(barcodeIntegrityDetection, wtaReaction1[0]) @ 600.0SECOND
	if barcodeSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(tagReaction11[0])
	dispose(tagReaction21[0])
bsbbif_6_f:
	dispose(tagReaction11[0])
	dispose(tagReaction21[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(librarySignal1[0])
	NOP
