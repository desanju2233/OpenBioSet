{
  "protocol": {
    "title": "Droplet-based single-cell RNA sequencing of paraformaldehyde-fixed cells (FD-seq)",
    "source": "Research Square preprint, October 1, 2021",
    "source_link": "https://www.protocols.io/view/droplet-based-single-cell-rna-sequencing-of-parafo-n2bvj94k5lk5/v1",
    "doi": "https://dx.doi.org/10.21203/rs.3.pex-1604/v1",
    "authors": [
      "Hoang Van Phan",
      "Michiel van Gent",
      "Nir Drayman",
      "Anindita Basu",
      "Michaela U. Gack",
      "Savas Tay"
    ],
    "affiliations": {
      "primary": "The University of Chicago",
      "secondary": "Cleveland Clinic"
    },
    "keywords": ["scRNA-seq", "Drop-seq", "Paraformaldehyde", "FD-seq", "single-cell", "fixed cells"],
    "platform": "Drop-seq microfluidic chip (Macosko et al., Cell 2015)",
    "objective": "Droplet-based scRNA-seq of PFA-fixed, stained, and sorted cells via in-droplet crosslink reversal using Proteinase K and heat before droplet breaking",

    "device": {
      "chip": "Drop-seq Droplet Generation Microfluidic Chip",
      "chip_source": "Commercial (Macosko 2015) or in-house PDMS fabrication",
      "hydrophobic_treatment": "Aquapel Glass Treatment Applicator (cat 47100); treat via cell inlet for 2-3 min; dry with air; rest overnight at RT",
      "syringe_pumps": ["Harvard Apparatus Pump 33 DDS", "KD Scientific model 100"],
      "collection_tube": "50 ml centrifuge tube",
      "storage_tubes": "1.5 ml Eppendorf DNA LoBind tubes (cat 022431021)",
      "flow_rates_ml_h": {
        "cell_syringe": 3,
        "bead_syringe": 3,
        "oil_syringe": 12
      },
      "pump_start_order": ["cell", "bead", "oil"],
      "collection_duration_min": 20,
      "bead_stirrer": "V&P Scientific magnetic disc VP 772DP-N42-5-2 + magnetic stirrer VP710D2"
    },

    "reagents": {
      "fixation": {
        "reagent": "4% PFA in PBS",
        "catalog": "Santa Cruz Biotechnology, cat sc-281692",
        "volume_ul": 1000,
        "duration_min": 15,
        "temperature_C": 25
      },
      "permeabilization": {
        "reagent": "0.1% Triton X-100 in wash buffer (molecular biology grade)",
        "volume_ul": 500,
        "duration_min": 15,
        "temperature_C": 25
      },
      "wash_buffer": {
        "composition": "PBS + 1% BSA (molecular biology grade) + 40 U/ml RNase inhibitor (NEB N0447S)"
      },
      "bsa_001pct": {
        "composition": "0.01% molecular biology grade BSA in PBS",
        "volume_per_wash_ml": 2,
        "washes": 3,
        "notes": "Prepare at least 10 ml per sample; filter cells through appropriate strainer before use"
      },
      "lysis_buffer": {
        "composition": {
          "nuclease_free_water_ml": 22,
          "Ficoll_20pct_ml": 15,
          "Tris_1M_pH7.5_ml": 10,
          "EDTA_0.5M_ml": 2,
          "Sarkosyl_10pct_ml": 1
        },
        "additives_per_ml": {
          "DTT_1M_ul": 50,
          "ProteinaseK_800U_ml_ul": 50
        },
        "storage": "4 C; add DTT and Proteinase K fresh before use; filter with 40 um strainer; store on ice",
        "bead_loading_concentration_per_ml": 120000
      },
      "buffers": {
        "TE_SDS": "46.9 ml NFW + 500 ul 1M Tris pH 8.0 + 100 ul 0.5M EDTA + 2.5 ml 10% SDS",
        "TE_TW": "49.4 ml NFW + 500 ul 1M Tris pH 8.0 + 100 ul 0.5M EDTA + 5 ul 100% Tween-20",
        "Tris_10mM_pH8": "49.5 ml NFW + 500 ul 1M Tris pH 8.0",
        "SSC_6X": "350 ml NFW + 150 ml 20X SSC"
      },
      "drop_seq_beads": {
        "supplier": "ChemGenes Corp",
        "catalog": "Macosko-2011-10(V+)",
        "prep": "Wash per manufacturer instructions; resuspend in TE-TW; store at 4 C",
        "loading_concentration_per_ml": 120000
      },
      "oil": {
        "supplier": "Bio-Rad",
        "catalog": "1864006",
        "syringe": "BD 10 ml Luer-Lok (cat 302995)"
      },
      "droplet_breaking_reagent": {
        "reagent": "Perfluorooctan-1-ol",
        "supplier": "Synquest",
        "catalog": "2101-3-20",
        "volume_ml": 1,
        "notes": "Use inside chemical hood"
      },
      "rt_mix": {
        "total_volume_ul": 200,
        "components": {
          "nuclease_free_water_ul": 80,
          "Maxima_H_RT_buffer_5X_ul": 40,
          "Ficoll_20pct_ul": 40,
          "dNTPs_10mM_ul": 20,
          "RNase_inhibitor_ul": 5,
          "TSO_RNAhybrid_100uM_ul": 5,
          "Maxima_H_reverse_transcriptase_ul": 10
        },
        "reagent_sources": {
          "dNTPs": "NEB, cat N0447S",
          "RNase_inhibitor": "NEB, cat M0314L",
          "Maxima_H_RT": "Thermo Fisher, cat EP0753"
        }
      },
      "exo_i_mix": {
        "total_volume_ul": 200,
        "components": {
          "nuclease_free_water_ul": 170,
          "ExoI_buffer_10X_ul": 20,
          "ExoI_ul": 10
        },
        "reagent_sources": {
          "ExoI": "NEB, M0293S"
        }
      },
      "wta_pcr": {
        "volume_per_well_ul": 50,
        "components": {
          "beads_in_water_ul": 24.6,
          "TSO_PCR_100uM_ul": 0.4,
          "Kapa_HiFi_Readymix_ul": 25
        },
        "reagent_sources": {
          "Kapa_HiFi_Readymix": "Roche, cat 7958935001"
        },
        "beads_per_well": 5000
      },
      "tagmentation": {
        "kit": "Nextera XT DNA Library Prep Kit",
        "kit_catalog": "Illumina, cat FC-131-1024",
        "input_pg_per_reaction": 450,
        "parallel_reactions": 2,
        "purification": "Ampure XP beads (Beckman Coulter, cat A63880) at 0.6X bead ratio"
      },
      "primers": {
        "TSO_RNAhybrid": "AAGCAGTGGTATCAACGCAGAGTGAATrGrGrG",
        "TSO_PCR": "AAGCAGTGGTATCAACGCAGAGT",
        "P5_TSO": "AATGATACGGCGACCACCGAGATCTACACGCCTGTCCGCGGAAGCAGTGGTATCAACGCAGAGT*A*C",
        "Nextera_N7XX": "CAAGCAGAAGACGGCATACGAGAT[i7]GTCTCGTGGGCTCGG",
        "Custom_Read1": "GCCTGTCCGCGGAAGCAGTGGTATCAACGCAGAGTAC"
      }
    },

    "steps": [
      {
        "id": "P1",
        "name": "Cell fixation",
        "bb": "BB1",
        "inputs": ["PBS", "BSA_Wash_Buffer", "PFA_4pct"],
        "operations": [
          { "op": "mix", "variables": ["cellSample", "bsaWash1"], "duration_s": 300, "notes": "1% BSA wash, 400g 5 min" },
          { "op": "mix", "variables": ["washedCells1", "pfa"], "duration_s": 900, "notes": "4% PFA fixation, RT 15 min" },
          { "op": "mix", "variables": ["fixedCells", "bsaWash2"], "duration_s": 300, "notes": "Post-fix wash, 400g 5 min" }
        ],
        "output_variable": "washedFixed",
        "storage": "Cells can be stored in wash buffer at 4 C overnight"
      },
      {
        "id": "P2",
        "name": "Cell permeabilization",
        "bb": "BB1",
        "inputs": ["TritonX100_01pct", "BSA_Wash_Buffer"],
        "operations": [
          { "op": "mix", "variables": ["washedFixed", "triton"], "duration_s": 900, "notes": "0.1% Triton X-100, RT 15 min" },
          { "op": "mix", "variables": ["permeabilized", "bsaWash3"], "duration_s": 300, "notes": "Wash 1, 400g 5 min" },
          { "op": "mix", "variables": ["washed3", "bsaWash4"], "duration_s": 300, "notes": "Wash 2, 400g 5 min" }
        ],
        "output_variable": "washed4",
        "optional": "Blocking and intracellular staining can follow before droplet generation"
      },
      {
        "id": "P3",
        "name": "Pre-droplet preparation",
        "bb": "BB1",
        "inputs": ["BSA_001pct", "LysisBuffer_DTT_ProtK", "DropSeq_Beads"],
        "operations": [
          { "op": "mix", "variables": ["washed4", "bsa001_w1"], "duration_s": 120, "notes": "0.01% BSA wash 1 of 3" },
          { "op": "mix", "variables": ["prefixed_w1", "bsa001_w2"], "duration_s": 120, "notes": "0.01% BSA wash 2 of 3" },
          { "op": "mix", "variables": ["prefixed_w2", "bsa001_w3"], "duration_s": 120, "notes": "0.01% BSA wash 3 of 3; resuspend at 100,000 cells/ml" },
          { "op": "mix", "variables": ["lysisBeads", "dropseqBeads"], "duration_s": 120, "notes": "Beads at 120,000/ml in lysis buffer + DTT + ProtK; on ice" }
        ],
        "output_variables": ["cellsReady", "beadsReady"],
        "compiler_note": "3x 0.01% BSA washes unrolled explicitly; no loop construct in BioScript"
      },
      {
        "id": "P4",
        "name": "Droplet generation",
        "bb": "BB1",
        "inputs": ["cellsReady", "beadsReady", "Oil_BioRad"],
        "operations": [
          { "op": "mix", "variables": ["cellsReady", "beadsReady"], "duration_s": 1200, "notes": "Co-encapsulation abstraction; 20 min collection" },
          { "op": "mix", "variables": ["cellBeadMix", "oil"], "duration_s": 1200, "notes": "Emulsification; droplet generation on chip" }
        ],
        "output_variable": "emulsion",
        "flow_rates_ml_h": { "cells": 3, "beads": 3, "oil": 12 },
        "collection_duration_min": 20,
        "qc": "Inspect junction under microscope; stable generation shows blur at junction"
      },
      {
        "id": "P5",
        "name": "In-droplet crosslink reversal",
        "bb": "BB1",
        "inputs": ["emulsion"],
        "operations": [
          { "op": "heat", "variable": "emulsion", "temperature_C": 56, "duration_s": 3600, "notes": "KEY STEP: PFA crosslinks reversed by Proteinase K + heat inside intact droplets" },
          { "op": "heat", "variable": "emulsion", "temperature_C": 25, "duration_s": 600, "notes": "Cool at RT for 10 min" },
          { "op": "heat", "variable": "emulsion", "temperature_C": 4, "duration_s": 300, "notes": "Place on ice for 5 min" }
        ],
        "output_variable": "emulsion",
        "qc": "Check ~15 ul oil + 5 ul droplets on hemocytometer; confirm at most 1 bead per droplet",
        "compiler_note": "heat is void/in-place in BioScript; no assignment"
      },
      {
        "id": "P6",
        "name": "Droplet breaking",
        "bb": "BB1",
        "inputs": ["SSC_6X", "Perfluorooctan1ol"],
        "operations": [
          { "op": "mix", "variables": ["emulsion", "ssc1"], "duration_s": 60, "notes": "Add 30 ml 6X SSC" },
          { "op": "mix", "variables": ["brokenEmulsion", "pfol"], "duration_s": 60, "notes": "Add 1 ml Perfluorooctan-1-ol (chemical hood); shake 4x; spin 1000g 1 min" },
          { "op": "mix", "variables": ["brokenEmulsion2", "ssc2"], "duration_s": 180, "notes": "Add 30 ml 6X SSC; transfer supernatant; spin 1000g 3 min; pool beads" },
          { "op": "mix", "variables": ["beadFraction1", "ssc3"], "duration_s": 60, "notes": "6X SSC bead wash 1 of 2; 1000g 1 min" },
          { "op": "mix", "variables": ["beadWash1", "ssc4"], "duration_s": 60, "notes": "6X SSC bead wash 2 of 2; then 1x 5X Maxima RT buffer wash" },
          { "op": "dispose", "variable": "brokenEmulsion", "notes": "Oil/emulsion shell waste after breaking" }
        ],
        "output_variable": "beadWash2"
      },
      {
        "id": "P7",
        "name": "Reverse transcription",
        "bb": "BB1",
        "inputs": ["RT_Mix"],
        "operations": [
          { "op": "mix", "variables": ["beadWash2", "rtMix"], "duration_s": 1800, "notes": "Add RT mix; incubate RT 30 min with rotation" },
          { "op": "heat", "variable": "beadsInRT", "temperature_C": 25, "duration_s": 1800, "notes": "Primer annealing / RT initiation" },
          { "op": "heat", "variable": "beadsInRT", "temperature_C": 42, "duration_s": 5400, "notes": "cDNA synthesis; 90 min with rotation" },
          { "op": "mix", "variables": ["beadsInRT", "rtWash1"], "duration_s": 60, "notes": "Wash 1: TE-SDS" },
          { "op": "mix", "variables": ["rtWashed1", "rtWash2"], "duration_s": 60, "notes": "Wash 2: TE-TW" },
          { "op": "mix", "variables": ["rtWashed2", "rtWash3"], "duration_s": 60, "notes": "Wash 3: TE-TW" },
          { "op": "mix", "variables": ["rtWashed3", "rtWash4"], "duration_s": 60, "notes": "Wash 4: 10 mM Tris pH 8.0" }
        ],
        "output_variable": "rtWashed4",
        "duration_notes": {
          "RT_init_s": 1800,
          "cDNA_synthesis_s": 5400,
          "compiler_note": "90 min = 90m (no h token in BioScript)"
        }
      },
      {
        "id": "P8",
        "name": "Exonuclease I digestion",
        "bb": "BB1",
        "inputs": ["ExoI_Mix"],
        "operations": [
          { "op": "mix", "variables": ["rtWashed4", "exoMix"], "duration_s": 300, "notes": "Add Exo I mix; prepare reaction" },
          { "op": "heat", "variable": "beadsInExo", "temperature_C": 37, "duration_s": 2700, "notes": "45 min with rotation; removes unextended primers" },
          { "op": "mix", "variables": ["beadsInExo", "exoWash1"], "duration_s": 60, "notes": "Wash 1: TE-SDS" },
          { "op": "mix", "variables": ["exoWashed1", "exoWash2"], "duration_s": 60, "notes": "Wash 2: TE-TW" },
          { "op": "mix", "variables": ["exoWashed2", "exoWash3"], "duration_s": 60, "notes": "Wash 3: TE-TW" }
        ],
        "output_variable": "exoWashed3",
        "storage": "If not proceeding immediately: store beads in 1 ml TE-TW at 4 C"
      },
      {
        "id": "P9",
        "name": "Whole transcriptome amplification (WTA)",
        "bb": "BB1",
        "inputs": ["PBS", "WTA_PCR_Mix"],
        "operations": [
          { "op": "mix", "variables": ["exoWashed3", "wta_water"], "duration_s": 120, "notes": "Resuspend beads in nuclease-free water; count beads" },
          { "op": "mix", "variables": ["beadsForWTA", "wtaMix"], "duration_s": 120, "notes": "Set up 50 ul PCR reaction; 5,000 beads per well" },
          { "op": "heat", "variable": "wtaReaction", "temperature_C": 95, "duration_s": 180, "notes": "Initial denaturation; 3 min" },
          { "op": "heat", "variable": "wtaReaction", "temperature_C": 65, "duration_s": 720, "notes": "Low-cycle annealing phase; 4 cycles x 3 min (aggregate 12 min)" },
          { "op": "heat", "variable": "wtaReaction", "temperature_C": 67, "duration_s": 600, "notes": "High-cycle annealing phase; 10 cycles x 1 min (aggregate 10 min)" },
          { "op": "heat", "variable": "wtaReaction", "temperature_C": 72, "duration_s": 300, "notes": "Final extension; 5 min" }
        ],
        "thermocycler_program": {
          "initial_denaturation": "95 C, 3 min",
          "cycle_set_1": "4x [98 C 20s, 65 C 45s, 72 C 3 min]",
          "cycle_set_2": "10x [98 C 20s, 67 C 20s, 72 C 3 min]",
          "final_extension": "72 C, 5 min",
          "hold": "4 C"
        },
        "expected_result": "Broad band, peak 600-700 bp (TapeStation, Figure 1)",
        "output_variable": "wtaReaction",
        "compiler_note": "No PCR primitive or loop; 4 heat steps represent aggregate thermocycler phases"
      },
      {
        "id": "P9_QC",
        "name": "WTA QC gate",
        "bb_pass": "BB2",
        "bb_fail": "BB3",
        "bb_join": "BB4",
        "detection_module": "barcodeIntegrityDetection",
        "detection_variable": "barcodeSignal",
        "detection_duration_s": 600,
        "abstracts": "Ampure XP 0.6X cleanup + Qubit quantification + TapeStation size QC",
        "branch": {
          "pass": { "condition": "barcodeSignal > 0", "action": "dispose(wtaReaction)", "bb": "BB2" },
          "fail": { "condition": "barcodeSignal <= 0", "action": "drain(wtaReaction)", "bb": "BB3" }
        }
      },
      {
        "id": "P10",
        "name": "Tagmentation and library preparation",
        "bb": "BB4",
        "inputs": ["WTA_PCR_Mix", "TagmentDNAMix", "AmpliconTagmentMix", "NTBuffer",
                   "P5TSO_Primer", "NexteraN7XX_Primer", "NexteraPCRMasterMix"],
        "parallel_reactions": 2,
        "operations": [
          { "op": "mix", "variables": ["wtaForTag1", "tdm1"], "duration_s": 60, "notes": "Tagment DNA mix + WTA product, reaction 1" },
          { "op": "mix", "variables": ["wtaForTag2", "tdm2"], "duration_s": 60, "notes": "Tagment DNA mix + WTA product, reaction 2" },
          { "op": "mix", "variables": ["tagStep1a", "atm1"], "duration_s": 60, "notes": "Add Amplicon Tagment mix, reaction 1" },
          { "op": "mix", "variables": ["tagStep1b", "atm2"], "duration_s": 60, "notes": "Add Amplicon Tagment mix, reaction 2" },
          { "op": "heat", "variable": "tagWithATM1", "temperature_C": 55, "duration_s": 300, "notes": "Tagmentation, exactly 5 min; reaction 1" },
          { "op": "heat", "variable": "tagWithATM2", "temperature_C": 55, "duration_s": 300, "notes": "Tagmentation, exactly 5 min; reaction 2" },
          { "op": "mix", "variables": ["tagWithATM1", "nt1"], "duration_s": 300, "notes": "Neutralise with NT buffer, RT 5 min; reaction 1" },
          { "op": "mix", "variables": ["tagWithATM2", "nt2"], "duration_s": 300, "notes": "Neutralise with NT buffer, RT 5 min; reaction 2" },
          { "op": "mix", "variables": ["neutralised1", "p5tso1", "n7xx1", "npm1"], "duration_s": 30, "notes": "Add PCR primers + master mix; reaction 1" },
          { "op": "mix", "variables": ["neutralised2", "p5tso2", "n7xx2", "npm2"], "duration_s": 30, "notes": "Add PCR primers + master mix; reaction 2" },
          { "op": "heat", "variable": "tagReaction1", "temperature_C": 95, "duration_s": 30, "notes": "PCR init denaturation; reaction 1" },
          { "op": "heat", "variable": "tagReaction1", "temperature_C": 55, "duration_s": 360, "notes": "12 cycles annealing aggregate (12 x 30s); reaction 1" },
          { "op": "heat", "variable": "tagReaction1", "temperature_C": 72, "duration_s": 300, "notes": "Final extension 5 min; reaction 1" },
          { "op": "heat", "variable": "tagReaction2", "temperature_C": 95, "duration_s": 30, "notes": "PCR init denaturation; reaction 2" },
          { "op": "heat", "variable": "tagReaction2", "temperature_C": 55, "duration_s": 360, "notes": "12 cycles annealing aggregate; reaction 2" },
          { "op": "heat", "variable": "tagReaction2", "temperature_C": 72, "duration_s": 300, "notes": "Final extension 5 min; reaction 2" }
        ],
        "thermocycler_program": {
          "initial_denaturation": "95 C, 30s",
          "cycles": "12x [95 C 10s, 55 C 30s, 72 C 30s]",
          "final_extension": "72 C, 5 min",
          "hold": "4 C"
        },
        "expected_result": "Broad band, peak ~400 bp (Fragment Analyzer, Figure 2)",
        "output_variables": ["tagReaction1", "tagReaction2"]
      },
      {
        "id": "P10_QC",
        "name": "Library QC gate",
        "bb_pass": "BB5",
        "bb_fail": "BB6",
        "bb_terminal": "BB7",
        "detection_module": "wqaQCDetection",
        "detection_variable": "librarySignal",
        "detection_duration_s": 600,
        "abstracts": "Ampure XP 0.6X cleanup + BioAnalyzer/Fragment Analyzer size QC + NextSeq loading QC",
        "branch": {
          "pass": { "condition": "librarySignal > 0", "action": "dispose(tagReaction1), dispose(tagReaction2)", "bb": "BB5" },
          "fail": { "condition": "librarySignal <= 0", "action": "drain(tagReaction1), drain(tagReaction2)", "bb": "BB6" }
        }
      },
      {
        "id": "NGS",
        "name": "Next generation sequencing",
        "platform": "Illumina NextSeq",
        "min_cycles": 75,
        "mode": "Paired-end, single index",
        "read_lengths": {
          "read1_bp": 20,
          "read2_bp": 60,
          "index1_bp": 8
        },
        "custom_primer": "Custom Read 1: GCCTGTCCGCGGAAGCAGTGGTATCAACGCAGAGTAC",
        "throughput": "One 20-min droplet collection run per high output kit"
      }
    ],

    "time_estimates": {
      "fixation_permeabilization_staining_h": 2.0,
      "sample_prep_droplet_generation_h": 1.5,
      "crosslink_reversal_h": 1.25,
      "reverse_transcription_h": 2.5,
      "exo_i_digestion_h": 1.0,
      "wta_h": 3.0,
      "ampure_purification_wta_h": 0.5,
      "tagmentation_h": 2.0,
      "ampure_purification_library_h": 0.5,
      "sequencing_h": 12.0
    },

    "anticipated_results": {
      "wta_products": "Broad band, peak 600-700 bp (TapeStation)",
      "tagmented_library": "Broad band, peak ~400 bp (Fragment Analyzer)",
      "figures": {
        "Figure_1": "Example TapeStation trace of WTA products",
        "Figure_2": "Example Fragment Analyzer trace of tagmented library"
      }
    },

    "troubleshooting": {
      "droplet_generation_failure": {
        "symptom": "Long stream of cells and beads flowing in middle of microfluidic channel (no pinching)",
        "cause": "Insufficient hydrophobic treatment of PDMS chip",
        "fix": "Switch to a different chip; ensure Aquapel treatment and overnight resting"
      },
      "successful_generation_indicator": "Blur at droplet generation junction caused by oil pinching the aqueous stream"
    },

    "cfg": {
      "basic_blocks": [
        { "id": "BB1", "label": "main",        "type": "entry",
          "content": "Phases 1-9: fixation, permeabilization, pre-droplet prep, droplet generation, crosslink reversal, droplet breaking, RT, ExoI digestion, WTA PCR" },
        { "id": "BB2", "label": "bsbbif_2_t",  "type": "branch_true",
          "condition": "barcodeSignal > 0", "action": "dispose(wtaReaction)" },
        { "id": "BB3", "label": "bsbbif_3_f",  "type": "branch_false",
          "condition": "barcodeSignal <= 0", "action": "drain(wtaReaction)" },
        { "id": "BB4", "label": "bsbbif_4_j",  "type": "join",
          "content": "dispose(barcodeSignal); fall into tagmentation (Phase 10)" },
        { "id": "BB5", "label": "bsbbif_5_t",  "type": "branch_true",
          "condition": "librarySignal > 0", "action": "dispose(tagReaction1), dispose(tagReaction2)" },
        { "id": "BB6", "label": "bsbbif_6_f",  "type": "branch_false",
          "condition": "librarySignal <= 0", "action": "drain(tagReaction1), drain(tagReaction2)" },
        { "id": "BB7", "label": "bsbbif_7_j",  "type": "terminal",
          "content": "dispose(librarySignal); NOP" }
      ],
      "edges": [
        ["BB1", "BB2"], ["BB1", "BB3"],
        ["BB2", "BB4"], ["BB3", "BB4"],
        ["BB4", "BB5"], ["BB4", "BB6"],
        ["BB5", "BB7"], ["BB6", "BB7"]
      ],
      "total_basic_blocks": 7,
      "total_edges": 8,
      "if_else_gates": 2
    },

    "bioscript": {
      "file": "phan_fdseq_pfa_scrna.bs",
      "compiler": "lilott8/BioScript (ANTLR4-based)",
      "ir_file": "phan_fdseq_pfa_scrna.ir",
      "dag_file": "phan_fdseq_pfa_scrna_main_dag.dot",
      "modules": ["barcodeIntegrityDetection", "wqaQCDetection"],
      "manifests": [
        "PFA_4pct", "PBS", "BSA_Wash_Buffer", "TritonX100_01pct", "BSA_001pct",
