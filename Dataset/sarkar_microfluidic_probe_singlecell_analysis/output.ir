bsbbif_2_t:
	dispose(lysisZone1[0])
bsbbif_3_f:
	dispose(lysisZone1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(lysisSignal1[0])
	aktAssayMix1[0] = mix(lysisBuffer1[0], aktBuffer1[0]) @ 90.0SECOND
	heat(aktAssayMix1[0]) @ 30.0CELSIUS @ 1200.0SECOND
	aktSignal1[0] = detect(aktKinaseDetection, aktAssayMix1[0]) @ 1200.0SECOND
	if aktSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	diWater1[0] = dispense(DeionizedWater)
	primedDevice1[0] = mix(diWater1[0], diWater1[0]) @ 300.0SECOND
	bsaPbs1[0] = dispense(BSA_PBS)
	diWash1[0] = dispense(DeionizedWater)
	bsaCoated1[0] = mix(primedDevice1[0], bsaPbs1[0]) @ 3600.0SECOND
	heat(bsaCoated1[0]) @ 25.0CELSIUS @ 3600.0SECOND
	bsaWashed1[0] = mix(bsaCoated1[0], diWash1[0]) @ 300.0SECOND
	heat(bsaWashed1[0]) @ 25.0CELSIUS @ 1800.0SECOND
	lysisBuffer1[0] = dispense(LysisBuffer)
	aktBuffer1[0] = dispense(AktAssayBuffer)
	gapdhBuffer1[0] = dispense(GapdhAssayBuffer)
	loadedDevice1[0] = mix(bsaWashed1[0], lysisBuffer1[0]) @ 120.0SECOND
	hepg2Cells1[0] = dispense(HepG2_Cells)
	cultureMedium1[0] = dispense(EaglesMEM_10FBS_PenStrep)
	platedCells1[0] = mix(hepg2Cells1[0], cultureMedium1[0]) @ 120.0SECOND
	heat(platedCells1[0]) @ 37.0CELSIUS @ 14400.0SECOND
	serumFree1[0] = dispense(SerumFreeMedium)
	starvedCells1[0] = mix(platedCells1[0], serumFree1[0]) @ 120.0SECOND
	heat(starvedCells1[0]) @ 37.0CELSIUS @ 43200.0SECOND
	cellTracker1[0] = dispense(CellTrackerOrange)
	labelledCells1[0] = mix(starvedCells1[0], cellTracker1[0]) @ 900.0SECOND
	heat(labelledCells1[0]) @ 37.0CELSIUS @ 900.0SECOND
	pbsWash1[0] = dispense(PBS)
	washedCells1[0] = mix(labelledCells1[0], pbsWash1[0]) @ 120.0SECOND
	recoveryMedium1[0] = dispense(SerumFreeMedium)
	recoveredCells1[0] = mix(washedCells1[0], recoveryMedium1[0]) @ 120.0SECOND
	heat(recoveredCells1[0]) @ 37.0CELSIUS @ 1200.0SECOND
	insulinStock1[0] = dispense(Insulin)
	stimulatedCells1[0] = mix(recoveredCells1[0], insulinStock1[0]) @ 120.0SECOND
	heat(stimulatedCells1[0]) @ 37.0CELSIUS @ 600.0SECOND
	lysisZone1[0] = mix(loadedDevice1[0], stimulatedCells1[0]) @ 20.0SECOND
	lysisSignal1[0] = detect(lysisDetection, lysisZone1[0]) @ 20.0SECOND
	if lysisSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(aktAssayMix1[0])
bsbbif_6_f:
	dispose(aktAssayMix1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(aktSignal1[0])
	gapdhAssayMix1[0] = mix(lysisBuffer1[0], gapdhBuffer1[0]) @ 90.0SECOND
	heat(gapdhAssayMix1[0]) @ 30.0CELSIUS @ 1200.0SECOND
	gapdhSignal1[0] = detect(gapdhActivityDetection, gapdhAssayMix1[0]) @ 1200.0SECOND
	if gapdhSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(gapdhAssayMix1[0])
bsbbif_9_f:
	dispose(gapdhAssayMix1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(gapdhSignal1[0])
	NOP
