bsbbif_2_t:
	dispose(dcAdhered1[0])
bsbbif_3_f:
	dispose(dcAdhered1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(haptotaxisSignal1[0])
	dcSuspension21[0] = dispense(DendriticCells)
	r10Medium31[0] = dispense(CellCultureMedium_R10)
	dcLoaded21[0] = mix(r10Medium31[0], dcSuspension21[0]) @ 1800.0SECOND
	ccl19Source1[0] = dispense(CCL19)
	fitcDextran1[0] = dispense(FITCDextran_10kDa)
	r10Sink1[0] = dispense(CellCultureMedium_R10)
	ccl19FitcMix1[0] = mix(ccl19Source1[0], fitcDextran1[0]) @ 5.0SECOND
	gradientSetup1[0] = mix(dcLoaded21[0], ccl19FitcMix1[0]) @ 5.0SECOND
	ccl19Gradient1[0] = mix(gradientSetup1[0], r10Sink1[0]) @ 9000.0SECOND
	chemotaxisSignal1[0] = detect(chemotaxisDetection, ccl19Gradient1[0]) @ 9000.0SECOND
	if chemotaxisSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	primingPBS11[0] = dispense(PBS)
	primingPBS21[0] = dispense(PBS)
	chipPrime1[0] = mix(primingPBS11[0], primingPBS21[0]) @ 300.0SECOND
	fibronectin1[0] = dispense(Fibronectin)
	fibronectinCoat1[0] = mix(chipPrime1[0], fibronectin1[0]) @ 3600.0SECOND
	pbsFlush11[0] = dispense(PBS)
	coatedChamber1[0] = mix(fibronectinCoat1[0], pbsFlush11[0]) @ 60.0SECOND
	r10Medium11[0] = dispense(CellCultureMedium_R10)
	chamberReady1[0] = mix(coatedChamber1[0], r10Medium11[0]) @ 600.0SECOND
	pbsWash11[0] = dispense(PBS)
	b4fSolution1[0] = dispense(B4F_BiotinFluorescein)
	b4fLoaded1[0] = mix(chamberReady1[0], pbsWash11[0]) @ 10.0SECOND
	b4fCoated1[0] = mix(b4fLoaded1[0], b4fSolution1[0]) @ 60.0SECOND
	lapapPBS1[0] = dispense(PBS)
	lapapPattern1[0] = mix(b4fCoated1[0], lapapPBS1[0]) @ 1200.0SECOND
	pbsWash21[0] = dispense(PBS)
	patternWashed1[0] = mix(lapapPattern1[0], pbsWash21[0]) @ 10.0SECOND
	saCy3Solution1[0] = dispense(StreptavidinCy3)
	saCy3Bound1[0] = mix(patternWashed1[0], saCy3Solution1[0]) @ 1200.0SECOND
	pbsWash31[0] = dispense(PBS)
	saCy3Washed1[0] = mix(saCy3Bound1[0], pbsWash31[0]) @ 10.0SECOND
	ccl21Solution1[0] = dispense(CCL21_24_98_bio)
	ccl21Immobilized1[0] = mix(saCy3Washed1[0], ccl21Solution1[0]) @ 1800.0SECOND
	pbsWash41[0] = dispense(PBS)
	ccl21Washed1[0] = mix(ccl21Immobilized1[0], pbsWash41[0]) @ 10.0SECOND
	dcSuspension1[0] = dispense(DendriticCells)
	r10Medium21[0] = dispense(CellCultureMedium_R10)
	dcLoaded1[0] = mix(ccl21Washed1[0], dcSuspension1[0]) @ 60.0SECOND
	dcAdhered1[0] = mix(dcLoaded1[0], r10Medium21[0]) @ 1800.0SECOND
	haptotaxisSignal1[0] = detect(haptotaxisDetection, dcAdhered1[0]) @ 6000.0SECOND
	if haptotaxisSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(ccl19Gradient1[0])
bsbbif_6_f:
	dispose(ccl19Gradient1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(chemotaxisSignal1[0])
	pbsCompeting1[0] = dispense(PBS)
	b4fCompeting1[0] = dispense(B4F_BiotinFluorescein)
	saCy3Competing1[0] = dispense(StreptavidinCy3)
	ccl21Competing1[0] = dispense(CCL21_24_98_bio)
	b4fLoad21[0] = mix(pbsCompeting1[0], b4fCompeting1[0]) @ 60.0SECOND
	lapapWrite21[0] = mix(b4fLoad21[0], pbsCompeting1[0]) @ 1200.0SECOND
	saCoat21[0] = mix(lapapWrite21[0], saCy3Competing1[0]) @ 1200.0SECOND
	ccl21Coat21[0] = mix(saCoat21[0], ccl21Competing1[0]) @ 1800.0SECOND
	dcSuspension31[0] = dispense(DendriticCells)
	r10Medium41[0] = dispense(CellCultureMedium_R10)
	dcOnCCL211[0] = mix(ccl21Coat21[0], dcSuspension31[0]) @ 60.0SECOND
	dcRecovered1[0] = mix(dcOnCCL211[0], r10Medium41[0]) @ 1800.0SECOND
	ccl19LowSource1[0] = dispense(CCL19)
	fitcDextran21[0] = dispense(FITCDextran_10kDa)
	r10SinkA1[0] = dispense(CellCultureMedium_R10)
	ccl19LowFitc1[0] = mix(ccl19LowSource1[0], fitcDextran21[0]) @ 5.0SECOND
	conditionA1[0] = mix(dcRecovered1[0], ccl19LowFitc1[0]) @ 5.0SECOND
	conditionAGrad1[0] = mix(conditionA1[0], r10SinkA1[0]) @ 6000.0SECOND
	ccl19MedSource1[0] = dispense(CCL19)
	fitcDextran31[0] = dispense(FITCDextran_10kDa)
	r10SinkB1[0] = dispense(CellCultureMedium_R10)
	ccl19MedFitc1[0] = mix(ccl19MedSource1[0], fitcDextran31[0]) @ 5.0SECOND
	conditionB1[0] = mix(dcRecovered1[0], ccl19MedFitc1[0]) @ 5.0SECOND
	conditionBGrad1[0] = mix(conditionB1[0], r10SinkB1[0]) @ 6000.0SECOND
	competingSignal1[0] = detect(competingGradientDetection, conditionAGrad1[0]) @ 6000.0SECOND
	if competingSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(conditionAGrad1[0])
	dispose(conditionBGrad1[0])
bsbbif_9_f:
