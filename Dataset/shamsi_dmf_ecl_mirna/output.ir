bsbbif_2_t:
	dispose(finalDroplet1[0])
bsbbif_3_f:
	dispose(finalDroplet1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(eclSignal1[0])
	NOP
main:
	beads11[0] = dispense(MagneticParticles)
	beads21[0] = dispense(MagneticParticles)
	beads31[0] = dispense(MagneticParticles)
	beadsMerge11[0] = mix(beads11[0], beads21[0]) @ 5.0SECOND
	beadsMerged1[0] = mix(beadsMerge11[0], beads31[0]) @ 5.0SECOND
	heat(beadsMerged1[0]) @ 25.0CELSIUS @ 30.0SECOND
	dispose(beadsMerged1[0])
	target11[0] = dispense(TargetSequence)
	target21[0] = dispense(TargetSequence)
	targetMerged1[0] = mix(target11[0], target21[0]) @ 5.0SECOND
	pelletForHybrid1[0] = dispense(MagneticParticles)
	hybridDroplet1[0] = mix(pelletForHybrid1[0], targetMerged1[0]) @ 900.0SECOND
	heat(hybridDroplet1[0]) @ 25.0CELSIUS @ 30.0SECOND
	dispose(hybridDroplet1[0])
	pelletW11[0] = dispense(MagneticParticles)
	washBuf11[0] = dispense(HybridizationBuffer)
	washMix11[0] = mix(pelletW11[0], washBuf11[0]) @ 60.0SECOND
	heat(washMix11[0]) @ 25.0CELSIUS @ 30.0SECOND
	dispose(washMix11[0])
	pelletW21[0] = dispense(MagneticParticles)
	washBuf21[0] = dispense(HybridizationBuffer)
	washMix21[0] = mix(pelletW21[0], washBuf21[0]) @ 60.0SECOND
	heat(washMix21[0]) @ 25.0CELSIUS @ 30.0SECOND
	dispose(washMix21[0])
	pelletW31[0] = dispense(MagneticParticles)
	washBuf31[0] = dispense(HybridizationBuffer)
	washMix31[0] = mix(pelletW31[0], washBuf31[0]) @ 60.0SECOND
	heat(washMix31[0]) @ 25.0CELSIUS @ 30.0SECOND
	dispose(washMix31[0])
	pelletW41[0] = dispense(MagneticParticles)
	washBuf41[0] = dispense(HybridizationBuffer)
	washMix41[0] = mix(pelletW41[0], washBuf41[0]) @ 60.0SECOND
	heat(washMix41[0]) @ 25.0CELSIUS @ 30.0SECOND
	dispose(washMix41[0])
	pelletForRu1[0] = dispense(MagneticParticles)
	ruDrop11[0] = dispense(RuPhen3Cl2)
	ruDrop21[0] = dispense(RuPhen3Cl2)
	ruMerged1[0] = mix(ruDrop11[0], ruDrop21[0]) @ 5.0SECOND
	ruLabelMix1[0] = mix(pelletForRu1[0], ruMerged1[0]) @ 120.0SECOND
	heat(ruLabelMix1[0]) @ 25.0CELSIUS @ 30.0SECOND
	dispose(ruLabelMix1[0])
	pelletPW11[0] = dispense(MagneticParticles)
	pbsWash11[0] = dispense(PBS)
	pbsMix11[0] = mix(pelletPW11[0], pbsWash11[0]) @ 60.0SECOND
	heat(pbsMix11[0]) @ 25.0CELSIUS @ 30.0SECOND
	dispose(pbsMix11[0])
	pelletPW21[0] = dispense(MagneticParticles)
	pbsWash21[0] = dispense(PBS)
	pbsMix21[0] = mix(pelletPW21[0], pbsWash21[0]) @ 60.0SECOND
	heat(pbsMix21[0]) @ 25.0CELSIUS @ 30.0SECOND
	dispose(pbsMix21[0])
	pelletForTPA1[0] = dispense(MagneticParticles)
	tpaDrop11[0] = dispense(TPA)
	tpaDrop21[0] = dispense(TPA)
	tpaMerged1[0] = mix(tpaDrop11[0], tpaDrop21[0]) @ 5.0SECOND
	finalDroplet1[0] = mix(pelletForTPA1[0], tpaMerged1[0]) @ 60.0SECOND
	eclSignal1[0] = detect(eclDetection, finalDroplet1[0]) @ 45.0SECOND
	if eclSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
