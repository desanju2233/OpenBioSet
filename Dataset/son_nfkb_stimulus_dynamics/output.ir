	heat(washedCells21[0]) @ 37.0CELSIUS @ 11100.0SECOND
	tnfPulse31[0] = dispense(TNFalpha)
	stimulation31[0] = mix(washedCells21[0], tnfPulse31[0]) @ 900.0SECOND
	washPBS31[0] = dispense(PBS)
	washedCells31[0] = mix(stimulation31[0], washPBS31[0]) @ 300.0SECOND
	nfkbSignal1[0] = detect(nfkbTranslocationDetection, washedCells31[0]) @ 90.0SECOND
	if nfkbSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(seqWashed41[0])
bsbbif_6_f:
	dispose(seqWashed41[0])
