main:
	primingPBS1[0] = dispense(PBS)
	primingPluronic1[0] = dispense(PluronicF127)
	primingMix1[0] = mix(primingPBS1[0], primingPluronic1[0]) @ 300.0SECOND
	reporterCells1[0] = dispense(FluorescentNFkBCells)
	loadedCells1[0] = mix(reporterCells1[0], primingMix1[0]) @ 120.0SECOND
	heat(loadedCells1[0]) @ 37.0CELSIUS @ 1800.0SECOND
	tnfPulse11[0] = dispense(TNFalpha)
	stimulation11[0] = mix(loadedCells1[0], tnfPulse11[0]) @ 900.0SECOND
	washPBS11[0] = dispense(PBS)
	washedCells11[0] = mix(stimulation11[0], washPBS11[0]) @ 300.0SECOND
	heat(washedCells11[0]) @ 37.0CELSIUS @ 11100.0SECOND
	tnfPulse21[0] = dispense(TNFalpha)
	stimulation21[0] = mix(washedCells11[0], tnfPulse21[0]) @ 900.0SECOND
