bsbbif_2_t:
	dispose(imagingWindow1[0])
bsbbif_3_f:
	dispose(imagingWindow1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(nfkbSignal1[0])
	freshMedium21[0] = dispense(FreshMedium)
	continuedIncub1[0] = mix(imagingWindow2[0], freshMedium21[0]) @ 5.0SECOND
	heat(continuedIncub1[0]) @ 37.0CELSIUS @ 16800.0SECOND
	trypLE11[0] = dispense(TrypLE_Express)
	trypLE21[0] = dispense(TrypLE_Express)
	trypLE31[0] = dispense(TrypLE_Express)
	lysisBuffer11[0] = dispense(LysisSolution)
	lysisBuffer21[0] = dispense(LysisSolution)
	lysisBuffer31[0] = dispense(LysisSolution)
	pbsNear1[0] = dispense(PBS)
	pbsMid1[0] = dispense(PBS)
	pbsFar1[0] = dispense(PBS)
	chambNear1[0] = mix(continuedIncub1[0], pbsNear1[0]) @ 1.0SECOND
	chambMid1[0] = mix(continuedIncub1[0], pbsMid1[0]) @ 1.0SECOND
	chambFar1[0] = mix(continuedIncub1[0], pbsFar1[0]) @ 1.0SECOND
	detachedNear1[0] = mix(chambNear1[0], trypLE11[0]) @ 120.0SECOND
	detachedMid1[0] = mix(chambMid1[0], trypLE21[0]) @ 120.0SECOND
	detachedFar1[0] = mix(chambFar1[0], trypLE31[0]) @ 120.0SECOND
	lysateNear1[0] = mix(detachedNear1[0], lysisBuffer11[0]) @ 60.0SECOND
	lysateMid1[0] = mix(detachedMid1[0], lysisBuffer21[0]) @ 60.0SECOND
	lysateFar1[0] = mix(detachedFar1[0], lysisBuffer31[0]) @ 60.0SECOND
	a20ProbeNear1[0] = dispense(RT_qPCR_A20_Probe)
	casp4ProbeNear1[0] = dispense(RT_qPCR_Casp4_Probe)
	rantesProbeNear1[0] = dispense(RT_qPCR_RANTES_Probe)
	a20ProbeMid1[0] = dispense(RT_qPCR_A20_Probe)
	casp4ProbeMid1[0] = dispense(RT_qPCR_Casp4_Probe)
	rantesProbeMid1[0] = dispense(RT_qPCR_RANTES_Probe)
	a20ProbeFar1[0] = dispense(RT_qPCR_A20_Probe)
	casp4ProbeFar1[0] = dispense(RT_qPCR_Casp4_Probe)
	rantesProbeFar1[0] = dispense(RT_qPCR_RANTES_Probe)
	rxnNearA1[0] = mix(lysateNear1[0], a20ProbeNear1[0]) @ 5.0SECOND
	rxnNearAC1[0] = mix(rxnNearA1[0], casp4ProbeNear1[0]) @ 5.0SECOND
	rxnNearACR1[0] = mix(rxnNearAC1[0], rantesProbeNear1[0]) @ 5.0SECOND
	rxnMidA1[0] = mix(lysateMid1[0], a20ProbeMid1[0]) @ 5.0SECOND
	rxnMidAC1[0] = mix(rxnMidA1[0], casp4ProbeMid1[0]) @ 5.0SECOND
	rxnMidACR1[0] = mix(rxnMidAC1[0], rantesProbeMid1[0]) @ 5.0SECOND
	rxnFarA1[0] = mix(lysateFar1[0], a20ProbeFar1[0]) @ 5.0SECOND
	rxnFarAC1[0] = mix(rxnFarA1[0], casp4ProbeFar1[0]) @ 5.0SECOND
	rxnFarACR1[0] = mix(rxnFarAC1[0], rantesProbeFar1[0]) @ 5.0SECOND
	heat(rxnNearACR1[0]) @ 50.0CELSIUS @ 900.0SECOND
	heat(rxnMidACR1[0]) @ 50.0CELSIUS @ 900.0SECOND
	heat(rxnFarACR1[0]) @ 50.0CELSIUS @ 900.0SECOND
	heat(rxnNearACR1[0]) @ 95.0CELSIUS @ 2520.0SECOND
	heat(rxnMidACR1[0]) @ 95.0CELSIUS @ 2520.0SECOND
	heat(rxnFarACR1[0]) @ 95.0CELSIUS @ 2520.0SECOND
	geneExprSignal1[0] = detect(geneExpressionDetection, rxnNearACR1[0]) @ 30.0SECOND
	if geneExprSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	fibronectinPBS1[0] = dispense(Fibronectin_PBS)
	washMedium11[0] = dispense(FreshMedium)
	coatedChamber1[0] = mix(fibronectinPBS1[0], washMedium11[0]) @ 43200.0SECOND
	fibroblastSeed1[0] = dispense(NIH_3T3_Fibroblast)
	pbsWash11[0] = dispense(PBS)
	attachedFibs1[0] = mix(fibroblastSeed1[0], coatedChamber1[0]) @ 5.0SECOND
	heat(attachedFibs1[0]) @ 37.0CELSIUS @ 18000.0SECOND
	trypsinFlush1[0] = mix(pbsWash11[0], attachedFibs1[0]) @ 2.0SECOND
	tnfSolution1[0] = dispense(TNF_Solution)
	diffusingChamber1[0] = mix(tnfSolution1[0], trypsinFlush1[0]) @ 3600.0SECOND
	heat(diffusingChamber1[0]) @ 37.0CELSIUS @ 3600.0SECOND
	freshMedium11[0] = dispense(FreshMedium)
	imagingWindow1[0] = mix(diffusingChamber1[0], freshMedium11[0]) @ 5.0SECOND
	heat(imagingWindow1[0]) @ 37.0CELSIUS @ 12000.0SECOND
	nfkbSignal1[0] = detect(nfkbActivationDetection, imagingWindow1[0]) @ 30.0SECOND
	if nfkbSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(rxnNearACR1[0])
	dispose(rxnMidACR1[0])
	dispose(rxnFarACR1[0])
bsbbif_6_f:
	dispose(rxnNearACR1[0])
	dispose(rxnMidACR1[0])
	dispose(rxnFarACR1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(geneExprSignal1[0])
	NOP
