bsbbif_2_t:
	dispose(plateWell41[0])
	dispose(plateWell51[0])
	dispose(plateWell61[0])
	dispose(plateWell71[0])
bsbbif_3_f:
	dispose(plateWell41[0])
	dispose(plateWell51[0])
	dispose(plateWell61[0])
	dispose(plateWell71[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(readerSignal41[0])
	dispose(readerSignal51[0])
	dispose(readerSignal61[0])
	dispose(readerSignal71[0])
	controlSignal1[0] = detect(dropletReaderDetection, plateWellCtrl1[0]) @ 60.0SECOND
	if controlSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	mm4_supermix1[0] = dispense(ddPCR_Supermix)
	mm4_h2o1[0] = dispense(NucleaseFreeH2O)
	mm4_y871[0] = dispense(PrimerY87)
	mm4_y881[0] = dispense(PrimerY88)
