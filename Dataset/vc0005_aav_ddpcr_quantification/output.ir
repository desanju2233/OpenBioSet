	mm4_s21[0] = mix(mm4_s11[0], mm4_y871[0]) @ 5.0SECOND
	mm4_s31[0] = mix(mm4_s21[0], mm4_y881[0]) @ 5.0SECOND
	masterMix41[0] = mix(mm4_s31[0], mm4_probe1[0]) @ 5.0SECOND
	mm5_supermix1[0] = dispense(ddPCR_Supermix)
	mm5_h2o1[0] = dispense(NucleaseFreeH2O)
	mm5_y871[0] = dispense(PrimerY87)
	mm5_y881[0] = dispense(PrimerY88)
	mm5_probe1[0] = dispense(Probe_FAM)
	mm5_s11[0] = mix(mm5_supermix1[0], mm5_h2o1[0]) @ 5.0SECOND
	mm5_s21[0] = mix(mm5_s11[0], mm5_y871[0]) @ 5.0SECOND
	mm5_s31[0] = mix(mm5_s21[0], mm5_y881[0]) @ 5.0SECOND
	masterMix51[0] = mix(mm5_s31[0], mm5_probe1[0]) @ 5.0SECOND
	mm6_supermix1[0] = dispense(ddPCR_Supermix)
	mm6_h2o1[0] = dispense(NucleaseFreeH2O)
