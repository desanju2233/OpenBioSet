	mm7_s11[0] = mix(mm7_supermix1[0], mm7_h2o1[0]) @ 5.0SECOND
	mm7_s21[0] = mix(mm7_s11[0], mm7_y871[0]) @ 5.0SECOND
	mm7_s31[0] = mix(mm7_s21[0], mm7_y881[0]) @ 5.0SECOND
	masterMix71[0] = mix(mm7_s31[0], mm7_probe1[0]) @ 5.0SECOND
	mmC_supermix1[0] = dispense(ddPCR_Supermix)
	mmC_h2o1[0] = dispense(NucleaseFreeH2O)
	mmC_y871[0] = dispense(PrimerY87)
	mmC_y881[0] = dispense(PrimerY88)
	mmC_probe1[0] = dispense(Probe_FAM)
	mmC_s11[0] = mix(mmC_supermix1[0], mmC_h2o1[0]) @ 5.0SECOND
	mmC_s21[0] = mix(mmC_s11[0], mmC_y871[0]) @ 5.0SECOND
	mmC_s31[0] = mix(mmC_s21[0], mmC_y881[0]) @ 5.0SECOND
	masterMixCtrl1[0] = mix(mmC_s31[0], mmC_probe1[0]) @ 5.0SECOND
	h2o_d11[0] = dispense(NucleaseFreeH2O)
	sampleRaw1[0] = dispense(AAV_Sample)
	dilution11[0] = mix(sampleRaw1[0], h2o_d11[0]) @ 10.0SECOND
	h2o_d21[0] = dispense(NucleaseFreeH2O)
	dilution21[0] = mix(dilution11[0], h2o_d21[0]) @ 10.0SECOND
	h2o_d31[0] = dispense(NucleaseFreeH2O)
	dilution31[0] = mix(dilution21[0], h2o_d31[0]) @ 10.0SECOND
	h2o_d41[0] = dispense(NucleaseFreeH2O)
	dilution41[0] = mix(dilution31[0], h2o_d41[0]) @ 10.0SECOND
	h2o_d51[0] = dispense(NucleaseFreeH2O)
	dilution51[0] = mix(dilution41[0], h2o_d51[0]) @ 10.0SECOND
	h2o_d61[0] = dispense(NucleaseFreeH2O)
	dilution61[0] = mix(dilution51[0], h2o_d61[0]) @ 10.0SECOND
	h2o_d71[0] = dispense(NucleaseFreeH2O)
	dilution71[0] = mix(dilution61[0], h2o_d71[0]) @ 10.0SECOND
	heat(dilution71[0]) @ 4.0CELSIUS @ 60.0SECOND
	d4_rxn1[0] = dispense(AAV_Sample)
	d5_rxn1[0] = dispense(AAV_Sample)
	d6_rxn1[0] = dispense(AAV_Sample)
	d7_rxn1[0] = dispense(AAV_Sample)
	reaction41[0] = mix(masterMix41[0], d4_rxn1[0]) @ 5.0SECOND
	reaction51[0] = mix(masterMix51[0], d5_rxn1[0]) @ 5.0SECOND
	reaction61[0] = mix(masterMix61[0], d6_rxn1[0]) @ 5.0SECOND
	reaction71[0] = mix(masterMix71[0], d7_rxn1[0]) @ 5.0SECOND
	heat(reaction41[0]) @ 20.0CELSIUS @ 10.0SECOND
	heat(reaction51[0]) @ 20.0CELSIUS @ 10.0SECOND
	heat(reaction61[0]) @ 20.0CELSIUS @ 10.0SECOND
	heat(reaction71[0]) @ 20.0CELSIUS @ 10.0SECOND
	posCtrlDNA1[0] = dispense(PositiveControl_DNA)
	h2o_ctrl1[0] = dispense(NucleaseFreeH2O)
	ctrlDiluted1[0] = mix(posCtrlDNA1[0], h2o_ctrl1[0]) @ 5.0SECOND
	controlReaction1[0] = mix(masterMixCtrl1[0], ctrlDiluted1[0]) @ 5.0SECOND
	heat(controlReaction1[0]) @ 20.0CELSIUS @ 10.0SECOND
	dgOil_41[0] = dispense(DropletGenerationOil)
	dgOil_51[0] = dispense(DropletGenerationOil)
	dgOil_61[0] = dispense(DropletGenerationOil)
	dgOil_71[0] = dispense(DropletGenerationOil)
	dgOil_ctrl1[0] = dispense(DropletGenerationOil)
	droplets41[0] = mix(reaction41[0], dgOil_41[0]) @ 30.0SECOND
	droplets51[0] = mix(reaction51[0], dgOil_51[0]) @ 30.0SECOND
	droplets61[0] = mix(reaction61[0], dgOil_61[0]) @ 30.0SECOND
	droplets71[0] = mix(reaction71[0], dgOil_71[0]) @ 30.0SECOND
	dropletsCtrl1[0] = mix(controlReaction1[0], dgOil_ctrl1[0]) @ 30.0SECOND
	heat(droplets41[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(droplets51[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(droplets61[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(droplets71[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(dropletsCtrl1[0]) @ 95.0CELSIUS @ 600.0SECOND
	heat(droplets41[0]) @ 94.0CELSIUS @ 1200.0SECOND
	heat(droplets51[0]) @ 94.0CELSIUS @ 1200.0SECOND
	heat(droplets61[0]) @ 94.0CELSIUS @ 1200.0SECOND
	heat(droplets71[0]) @ 94.0CELSIUS @ 1200.0SECOND
	heat(dropletsCtrl1[0]) @ 94.0CELSIUS @ 1200.0SECOND
	heat(droplets41[0]) @ 60.0CELSIUS @ 2400.0SECOND
	heat(droplets51[0]) @ 60.0CELSIUS @ 2400.0SECOND
	heat(droplets61[0]) @ 60.0CELSIUS @ 2400.0SECOND
	heat(droplets71[0]) @ 60.0CELSIUS @ 2400.0SECOND
	heat(dropletsCtrl1[0]) @ 60.0CELSIUS @ 2400.0SECOND
	heat(droplets41[0]) @ 98.0CELSIUS @ 600.0SECOND
	heat(droplets51[0]) @ 98.0CELSIUS @ 600.0SECOND
	heat(droplets61[0]) @ 98.0CELSIUS @ 600.0SECOND
	heat(droplets71[0]) @ 98.0CELSIUS @ 600.0SECOND
	heat(dropletsCtrl1[0]) @ 98.0CELSIUS @ 600.0SECOND
	heat(droplets41[0]) @ 4.0CELSIUS @ 60.0SECOND
	heat(droplets51[0]) @ 4.0CELSIUS @ 60.0SECOND
	heat(droplets61[0]) @ 4.0CELSIUS @ 60.0SECOND
	heat(droplets71[0]) @ 4.0CELSIUS @ 60.0SECOND
	heat(dropletsCtrl1[0]) @ 4.0CELSIUS @ 60.0SECOND
	readerOil_41[0] = dispense(DropletReaderOil)
	readerOil_51[0] = dispense(DropletReaderOil)
	readerOil_61[0] = dispense(DropletReaderOil)
	readerOil_71[0] = dispense(DropletReaderOil)
	readerOil_ctrl1[0] = dispense(DropletReaderOil)
	plateWell41[0] = mix(droplets41[0], readerOil_41[0]) @ 5.0SECOND
	plateWell51[0] = mix(droplets51[0], readerOil_51[0]) @ 5.0SECOND
	plateWell61[0] = mix(droplets61[0], readerOil_61[0]) @ 5.0SECOND
	plateWell71[0] = mix(droplets71[0], readerOil_71[0]) @ 5.0SECOND
	plateWellCtrl1[0] = mix(dropletsCtrl1[0], readerOil_ctrl1[0]) @ 5.0SECOND
	readerSignal41[0] = detect(dropletReaderDetection, plateWell41[0]) @ 60.0SECOND
	readerSignal51[0] = detect(dropletReaderDetection, plateWell51[0]) @ 60.0SECOND
	readerSignal61[0] = detect(dropletReaderDetection, plateWell61[0]) @ 60.0SECOND
	readerSignal71[0] = detect(dropletReaderDetection, plateWell71[0]) @ 60.0SECOND
	if readerSignal41[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(plateWellCtrl1[0])
bsbbif_6_f:
