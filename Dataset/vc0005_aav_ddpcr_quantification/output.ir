	mm6_s21[0] = mix(mm6_s11[0], mm6_y871[0]) @ 5.0SECOND
	mm6_s31[0] = mix(mm6_s21[0], mm6_y881[0]) @ 5.0SECOND
	masterMix61[0] = mix(mm6_s31[0], mm6_probe1[0]) @ 5.0SECOND
	mm7_supermix1[0] = dispense(ddPCR_Supermix)
	mm7_h2o1[0] = dispense(NucleaseFreeH2O)
	mm7_y871[0] = dispense(PrimerY87)
	mm7_y881[0] = dispense(PrimerY88)
