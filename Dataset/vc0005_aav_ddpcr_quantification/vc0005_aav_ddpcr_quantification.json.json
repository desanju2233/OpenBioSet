{
  "protocol": {
    "title": "Viral Titer Quantification by Droplet Digital PCR (ddPCR)",
    "source": "protocols.io VC0005",
    "source_link": "https://www.protocols.io/view/viral-titer-quantification-by-digital-droplet-pcr-3byl498p2go5/v1",
    "doi": "https://dx.doi.org/10.17504/protocols.io.3byl498p2go5/v1",
    "platform": "Droplet Digital PCR (Bio-Rad QX200)",
    "vector": "Recombinant AAV (rAAV)",
    "objective": "Absolute quantification of rAAV viral genome copies per mL using TaqMan ddPCR targeting the AAV ITR region; serial dilution to linear range; positive control QC gate before titer reporting",

    "assay": {
      "target": "AAV ITR region",
      "chemistry": "TaqMan (FAM probe)",
      "primers": {
        "Y87_forward": {
          "sequence": "GGAACCCCTAGTGATGGAGTT",
          "concentration_uM": 100,
          "supplier": "IDT"
        },
        "Y88_reverse": {
          "sequence": "CGGCCTCAGTGAGCGA",
          "concentration_uM": 100,
          "supplier": "IDT"
        }
      },
      "probe": {
        "sequence": "/56FAM/CGCGCAGAG/ZEN/AGGGAGTGG/3IABkFQ/",
        "dye": "FAM",
        "quencher": "ZEN/IABkFQ",
        "concentration_uM": 100,
        "supplier": "IDT"
      }
    },

    "reagents": {
      "supermix": {
        "name": "2x ddPCR Supermix for Probes (no dUTP)",
        "catalog": "Bio-Rad 1863025",
        "volume_per_plate_uL": 2112
      },
      "nuclease_free_water": {
        "volume_per_plate_uL": 1833.4
      },
      "primer_Y87_per_plate_uL": 38,
      "primer_Y88_per_plate_uL": 38,
      "probe_FAM_per_plate_uL": 10.6,
      "droplet_generation_oil": {
        "catalog": "Bio-Rad 1863005",
        "volume_per_well_uL": 70
      },
      "droplet_reader_oil": {
        "catalog": "Bio-Rad 1863004"
      },
      "positive_control": {
        "name": "iDreV plasmid DNA",
        "concentration_ng_uL": 103,
        "size_bp": 7453,
        "expected_concentration_copies_uL": "300-700",
        "at_dilution": "2.5e-6"
      }
    },

    "consumables": {
      "dg8_cartridge": "Bio-Rad 1864007",
      "dg8_gasket": "Bio-Rad 1863009",
      "ddpcr_plate": "Bio-Rad ddPCR 96-Well Plate 12001925",
      "heat_seal": "Bio-Rad Pierceable Foil Heat Seal 1814040",
      "plate_sealer": "Bio-Rad PX1 PCR Plate Sealer (95 C, 5 s)",
      "dilution_plate": "96-well non-skirted PCR plate",
      "pcr_tubes": "8-strip PCR tubes",
      "microseal": "Bio-Rad Microseal B"
    },

    "master_mix": {
      "description": "2x ddPCR master mix assembled per reaction to satisfy BioScript SSA constraints",
      "components_per_reaction": {
        "ddPCR_Supermix_units": 1,
        "NucleaseFreeH2O_units": 1,
        "PrimerY87_units": 1,
        "PrimerY88_units": 1,
        "Probe_FAM_units": 1
      },
      "total_volume_per_rxn_uL": 31.5,
      "assembly_duration_s": 20,
      "assembly_note": "Five independent master mix builds (D4, D5, D6, D7, positive control). Each uses unique SSA tokens. No split keyword used."
    },

    "serial_dilution": {
      "plate": "96-well non-skirted PCR plate",
      "chain": "purely linear D1->D2->D3->D4->D5->D6->D7 (each variable consumed once)",
      "steps": [
        { "id": "D1", "factor": "1:40",  "concentration": "2.5e-2", "input_uL": 1,  "h2o_uL": 39, "mix_cycles": 20 },
        { "id": "D2", "factor": "1:10",  "concentration": "2.5e-3", "input_uL": 10, "h2o_uL": 90, "mix_cycles": 10 },
        { "id": "D3", "factor": "1:10",  "concentration": "2.5e-4", "input_uL": 10, "h2o_uL": 90, "mix_cycles": 10 },
        { "id": "D4", "factor": "1:10",  "concentration": "2.5e-5", "input_uL": 10, "h2o_uL": 90, "mix_cycles": 10 },
        { "id": "D5", "factor": "1:10",  "concentration": "2.5e-6", "input_uL": 10, "h2o_uL": 90, "mix_cycles": 10 },
        { "id": "D6", "factor": "1:10",  "concentration": "2.5e-7", "input_uL": 10, "h2o_uL": 90, "mix_cycles": 10 },
        { "id": "D7", "factor": "1:10",  "concentration": "2.5e-8", "input_uL": 10, "h2o_uL": 90, "mix_cycles": 10 }
      ],
      "loaded_into_reactions": ["D4", "D5", "D6", "D7"],
      "storage_after_prep": "4 C, sealed with Microseal B",
      "linear_detection_range_copies_uL": "100-10000"
    },

    "pcr_reactions": {
      "master_mix_per_rxn_uL": 31.5,
      "sample_per_rxn_uL": 1.5,
      "total_volume_per_rxn_uL": 33,
      "volume_loaded_to_cartridge_uL": 22.2,
      "vortex_spin_cycles": 2,
      "reactions": [
        { "id": "reaction4", "dilution": "D4", "bs_var": "reaction4" },
        { "id": "reaction5", "dilution": "D5", "bs_var": "reaction5" },
        { "id": "reaction6", "dilution": "D6", "bs_var": "reaction6" },
        { "id": "reaction7", "dilution": "D7", "bs_var": "reaction7" },
        { "id": "controlReaction", "dilution": "positive_control_iDreV_2.5e-6", "bs_var": "controlReaction" }
      ]
    },

    "droplet_generation": {
      "instrument": "Bio-Rad QX200 Droplet Generator",
      "cartridge": "DG8 (Bio-Rad 1864007)",
      "gasket": "DG8 Gasket (Bio-Rad 1863009)",
      "oil_catalog": "Bio-Rad 1863005",
      "sample_volume_per_well_uL": 22.2,
      "oil_volume_per_well_uL": 70,
      "target_droplets_per_well": 20000,
      "droplet_volume_nL": 0.85,
      "transfer_volume_to_plate_uL": 40,
      "seal": "Pierceable Foil Heat Seal (Bio-Rad 1814040) at 95 C for 5 s",
      "bs_abstraction": "mix(reactionX, dgOil_X) for 30s per well"
    },

    "pcr_cycling": {
      "instrument": "Bio-Rad C1000 Touch Thermocycler (or equivalent)",
      "ramp_rate_C_s": 2,
      "lid_temperature_C": 105,
      "stages": [
        { "stage": 1, "name": "Enzyme activation",       "temp_C": 95, "duration_s": 600,  "cycles": 1,  "bs_heat_duration_s": 600  },
        { "stage": 2, "name": "Denaturation (x40)",      "temp_C": 94, "duration_s": 30,   "cycles": 40, "bs_heat_duration_s": 1200 },
        { "stage": 3, "name": "Annealing/Extension (x40)","temp_C": 60, "duration_s": 60,   "cycles": 40, "bs_heat_duration_s": 2400 },
        { "stage": 4, "name": "Signal stabilisation",    "temp_C": 98, "duration_s": 600,  "cycles": 1,  "bs_heat_duration_s": 600  },
        { "stage": 5, "name": "Hold",                    "temp_C": 4,  "duration_s": null, "cycles": 1,  "bs_heat_duration_s": 60   }
      ],
      "bs_note": "BioScript has no loop construct. 40-cycle stages are unrolled as accumulated heat steps: 40x30s=1200s at 94C; 40x60s=2400s at 60C."
    },

    "droplet_reader": {
      "instrument": "Bio-Rad QX200 Droplet Reader",
      "software": "QuantaSoft",
      "template": "ITR-Shenqin-24",
      "settings_per_well": {
        "experiment_type": "ABS",
        "supermix": "ddPCR mMix no dUTP",
        "channel_1": "FAM",
        "target_type": "Ch1 Unknown"
      },
      "amplitude_threshold": 1000,
      "mode": "FAM/VIC",
      "read_order": "by row",
      "plate_orientation": "black clasps down",
      "reader_oil_catalog": "Bio-Rad 1863004",
      "priming": "QuantaSoft prime button before run",
      "bs_abstraction": "mix(dropletsX, readerOil_X) for 5s; detect dropletReaderDetection for 60s",
      "valid_read_threshold": ">10000 droplets per well with clear FAM+/FAM- separation"
    },

    "titer_calculation": {
      "method": "Off-chip in QuantaSoft software",
      "steps": [
        "Identify dilutions D4-D7 within linear detection range (100-10000 copies/uL)",
        "Average concentrations from dilutions within range",
        "Back-calculate: genome copies/mL = (avg copies/uL) x (1000 uL/mL) / (dilution factor x 1.5 uL input / 33 uL rxn)"
      ],
      "positive_control_acceptance_criteria": "300-700 copies/uL for iDreV at 2.5e-6 dilution"
    },

    "steps": [
      {
        "id": "S1",
        "name": "Master mix preparation",
        "bb": "BB1",
        "inputs": ["ddPCR_Supermix", "NucleaseFreeH2O", "PrimerY87", "PrimerY88", "Probe_FAM"],
        "operation": "mix (x5 independent builds)",
        "duration_per_build_s": 20,
        "output_vars": ["masterMix4", "masterMix5", "masterMix6", "masterMix7", "masterMixCtrl"],
        "notes": "One independent build per reaction. No split keyword. Each mmX_* token consumed exactly once."
      },
      {
        "id": "S2",
        "name": "Serial dilution",
        "bb": "BB1",
        "inputs": ["AAV_Sample", "NucleaseFreeH2O (x7)"],
        "operation": "mix (linear chain)",
        "duration_per_step_s": 10,
        "dilution_steps": 7,
        "output_var_terminal": "dilution7",
        "storage": "4 C, 60 s hold in BS",
        "notes": "Purely linear SSA chain. D1-D3 context only; D4-D7 provide concentration context for reactions."
      },
      {
        "id": "S3",
        "name": "PCR reaction assembly",
        "bb": "BB1",
        "inputs": ["masterMix4-7", "AAV_Sample (x4 independent dispenses)", "PositiveControl_DNA"],
        "operation": "mix + heat (vortex/spin abstraction at 20 C, 10 s)",
        "sample_volume_uL": 1.5,
        "mastermix_volume_uL": 31.5,
        "output_vars": ["reaction4", "reaction5", "reaction6", "reaction7", "controlReaction"],
        "notes": "d4_rxn through d7_rxn are independent AAV_Sample dispenses representing pre-diluted aliquots."
      },
      {
        "id": "S4",
        "name": "Droplet generation",
        "bb": "BB1",
        "inputs": ["reaction4-7", "controlReaction", "DropletGenerationOil (x5)"],
        "operation": "mix for 30s",
        "oil_volume_uL": 70,
        "sample_volume_uL": 22.2,
        "transfer_volume_uL": 40,
        "output_vars": ["droplets4", "droplets5", "droplets6", "droplets7", "dropletsCtrl"],
        "notes": "Abstracts DG8 cartridge loading, QX200 generator run, and transfer to ddPCR plate."
      },
      {
        "id": "S5",
        "name": "PCR cycling",
        "bb": "BB1",
        "inputs": ["droplets4", "droplets5", "droplets6", "droplets7", "dropletsCtrl"],
        "operation": "heat (5 stages x 5 reactions = 25 heat calls)",
        "stages": [
          {"temp_C": 95, "bs_duration_s": 600},
          {"temp_C": 94, "bs_duration_s": 1200},
          {"temp_C": 60, "bs_duration_s": 2400},
          {"temp_C": 98, "bs_duration_s": 600},
          {"temp_C":  4, "bs_duration_s": 60}
        ],
        "notes": "In-place heat mutation; variables retain identity across all 5 stages."
      },
      {
        "id": "S6",
        "name": "Droplet reader run",
        "bb": "BB1",
        "inputs": ["droplets4-7+Ctrl", "DropletReaderOil (x5)"],
        "operation": "mix for 5s + detect for 60s",
        "software": "QuantaSoft",
        "amplitude_threshold": 1000,
        "output_vars": ["readerSignal4", "readerSignal5", "readerSignal6", "readerSignal7"],
        "notes": "readerSignal4 used as QC gate key (highest expected signal)."
      },
      {
        "id": "S7",
        "name": "Reader QC gate",
        "bb": "BB2/BB3",
        "condition": "readerSignal4 > 0",
        "branch": {
          "pass": {
            "bb": "BB2",
            "label": "bsbbif_2_t",
            "condition": "readerSignal4 > 0",
            "action": "dispose(plateWell4-7)",
            "meaning": "Valid droplet count and FAM+/FAM- separation confirmed"
          },
          "fail": {
            "bb": "BB3",
            "label": "bsbbif_3_f",
            "condition": "readerSignal4 <= 0",
            "action": "dispose(plateWell4-7) [compiler maps drain to dispose]",
            "meaning": "Insufficient droplets or no FAM signal; repeat droplet generation"
          }
        }
      },
      {
        "id": "S8",
        "name": "Reader signal cleanup",
        "bb": "BB4",
        "label": "bsbbif_4_j",
        "type": "join",
        "action": "dispose(readerSignal4-7)",
        "notes": "Disposes all 4 reader QC signal tokens before entering positive control branch."
      },
      {
        "id": "S9",
        "name": "Positive control QC gate",
        "bb": "BB5/BB6",
        "inputs": ["plateWellCtrl"],
        "operation": "detect dropletReaderDetection for 60s",
        "output_var": "controlSignal",
        "condition": "controlSignal > 0",
        "branch": {
          "pass": {
            "bb": "BB5",
            "label": "bsbbif_5_t",
            "condition": "controlSignal > 0",
            "action": "dispose(plateWellCtrl)",
            "meaning": "iDreV reads 300-700 copies/uL; master mix and cycling validated; report titer"
          },
          "fail": {
            "bb": "BB6",
            "label": "bsbbif_6_f",
            "condition": "controlSignal <= 0",
            "action": "dispose(plateWellCtrl) [compiler maps drain to dispose]",
            "meaning": "Positive control out of range; investigate master mix and cycling"
          }
        }
      },
      {
        "id": "S10",
        "name": "Final cleanup",
        "bb": "BB7",
        "label": "bsbbif_7_j",
        "type": "terminal",
        "action": "dispose(controlSignal)",
        "notes": "Terminal node. Clean hood and bench with 70% ethanol. Dispose biohazard waste per institutional guidelines."
      }
    ],

    "cfg": {
      "basic_blocks": [
        { "id": "BB1", "label": "main",         "type": "entry",        "description": "Master mix prep; serial dilutions; PCR assembly; droplet generation; PCR cycling; reader run" },
        { "id": "BB2", "label": "bsbbif_2_t",   "type": "branch_true",  "condition": "readerSignal4 > 0",   "action": "dispose(plateWell4, plateWell5, plateWell6, plateWell7)" },
        { "id": "BB3", "label": "bsbbif_3_f",   "type": "branch_false", "condition": "readerSignal4 <= 0",  "action": "dispose(plateWell4, plateWell5, plateWell6, plateWell7)" },
        { "id": "BB4", "label": "bsbbif_4_j",   "type": "join",         "action": "dispose(readerSignal4, readerSignal5, readerSignal6, readerSignal7)" },
        { "id": "BB5", "label": "bsbbif_5_t",   "type": "branch_true",  "condition": "controlSignal > 0",   "action": "dispose(plateWellCtrl)" },
        { "id": "BB6", "label": "bsbbif_6_f",   "type": "branch_false", "condition": "controlSignal <= 0",  "action": "dispose(plateWellCtrl)" },
        { "id": "BB7", "label": "bsbbif_7_j",   "type": "terminal",     "action": "dispose(controlSignal)" }
      ],
      "edges": [
        ["BB1","BB2"], ["BB1","BB3"],
        ["BB2","BB4"], ["BB3","BB4"],
        ["BB4","BB5"], ["BB4","BB6"],
        ["BB5","BB7"], ["BB6","BB7"]
      ],
      "cfg_notes": "Two nested if/else gates. 7 nodes, 8 edges. No loop constructs."
    },

    "bioscript_compiler_notes": {
      "file": "vc0005_aav_ddpcr_quantification.bs",
      "compiler": "lilott8/BioScript (ANTLR4-based)",
      "ir_output": "7 basic blocks (BB1-BB7), 2 if/else gates, 8 CFG edges",
      "dag_file": "vc0005_aav_ddpcr_quantification_main_dag.dot",
      "modules": ["dropletGenerationDetection", "dropletReaderDetection"],
      "manifests": ["AAV_Sample", "ddPCR_Supermix", "PrimerY87", "PrimerY88", "Probe_FAM", "NucleaseFreeH2O", "PositiveControl_DNA", "DropletGenerationOil", "DropletReaderOil"],
      "ir_operation_counts": {
        "dispense": 49,
        "mix": 43,
        "heat": 31,
        "detect": 5,
        "dispose": 15,
        "branches": 2,
        "jumps": 2
      },
      "ssa_strategy": "Independent dispense per token. No split keyword. Each manifest is a reservoir tapped multiple times; each tap produces a unique SSA token consumed exactly once.",
      "drain_note": "lilott8/BioScript has no visitDrain method. drain keyword in .bs source compiles to dispose() in IR. Both pass and fail branch arms emit dispose() in IR output.",
      "heat_note": "heat() is an in-place mutation in BioScript IR. The same variable token appears in multiple heat() calls then is consumed once downstream. This is correct IR semantics, not an SSA violation.",
      "pcr_cycle_note": "BioScript has no loop construct. 40-cycle PCR stages are unrolled as accumulated single heat calls: 40x30s=1200s at 94C; 40x60s=2400s at 60C.",
      "ascii_requirement": "All .bs file characters must be 7-bit ASCII. The ANTLR4 FileStream calls codecs.decode(..., ascii). Non-ASCII characters (em dash, degree symbol, mu, arrow) in comments will cause UnicodeDecodeError at compile time."
    }
  }
}
