bsbbif_2_t:
	dispose(s1Ligand1[0])
bsbbif_3_f:
	dispose(s1Ligand1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(s1Signal1[0])
	s2Ligand1[0] = dispense(LPS_MidDose)
	s2Active1[0] = mix(s1Active1[0], s2Ligand1[0]) @ 7200.0SECOND
	s2Signal1[0] = detect(nfkbTranslocationDetection, s2Active1[0]) @ 90.0SECOND
	if s2Signal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	fibronectinPBS1[0] = dispense(PBS)
	primerFlush1[0] = dispense(PBS)
	devicePrime1[0] = mix(fibronectinPBS1[0], primerFlush1[0]) @ 300.0SECOND
	mediumFlush1[0] = dispense(FluoroBriteDMEM)
	equilibratedChamber1[0] = mix(devicePrime1[0], mediumFlush1[0]) @ 300.0SECOND
	cells1[0] = dispense(RelA_DsRed_3T3_Cells)
	loadedChamber1[0] = mix(cells1[0], equilibratedChamber1[0]) @ 2.0SECOND
	heat(loadedChamber1[0]) @ 37.0CELSIUS @ 18000.0SECOND
	s1Ligand1[0] = dispense(IL1beta_MidDose)
	s1Active1[0] = mix(loadedChamber1[0], s1Ligand1[0]) @ 7200.0SECOND
	s1Signal1[0] = detect(nfkbTranslocationDetection, s1Active1[0]) @ 90.0SECOND
	if s1Signal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(s2Ligand1[0])
bsbbif_6_f:
	dispose(s2Ligand1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(s2Signal1[0])
	s3Ligand1[0] = dispense(PAM_MidDose)
	s3Active1[0] = mix(s2Active1[0], s3Ligand1[0]) @ 7200.0SECOND
	s3Signal1[0] = detect(nfkbTranslocationDetection, s3Active1[0]) @ 90.0SECOND
	if s3Signal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(s3Ligand1[0])
bsbbif_9_f:
	dispose(s3Ligand1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(s3Signal1[0])
	s4Ligand1[0] = dispense(TNFalpha_MidDose)
	s4Active1[0] = mix(s3Active1[0], s4Ligand1[0]) @ 7200.0SECOND
	s4Signal1[0] = detect(nfkbTranslocationDetection, s4Active1[0]) @ 90.0SECOND
	if s4Signal1[0] > 0	|	true: jump bsbbif_11_t	|	false: jump bsbbif_12_f
bsbbif_11_t:
	trypsin1[0] = dispense(TrypLE_Express)
	detachedCells1[0] = mix(s4Active1[0], trypsin1[0]) @ 60.0SECOND
	lysisBuffer1[0] = dispense(PBS)
	collectedCells1[0] = mix(detachedCells1[0], lysisBuffer1[0]) @ 30.0SECOND
	rnaSignal1[0] = detect(rnaSeqDetection, collectedCells1[0]) @ 30.0SECOND
	dispose(collectedCells1[0])
	dispose(rnaSignal1[0])
bsbbif_12_f:
	dispose(s4Ligand1[0])
	jump: bsbbif_13_j
bsbbif_13_j:
	ikkCells1[0] = dispense(RelA_DsRed_3T3_Cells)
	ikkMedium1[0] = dispense(FluoroBriteDMEM)
	ikkChamber1[0] = mix(ikkCells1[0], ikkMedium1[0]) @ 2.0SECOND
	heat(ikkChamber1[0]) @ 37.0CELSIUS @ 18000.0SECOND
	inhibitor1[0] = dispense(PS1145_Inhibitor)
	ikkPretreat1[0] = mix(ikkChamber1[0], inhibitor1[0]) @ 5400.0SECOND
	lpsIkk1[0] = dispense(LPS_MidDose)
	ikkLps1[0] = mix(ikkPretreat1[0], lpsIkk1[0]) @ 14400.0SECOND
	wash11[0] = dispense(CompleteDMEM)
	wash21[0] = dispense(CompleteDMEM)
	ikkWash11[0] = mix(ikkLps1[0], wash11[0]) @ 900.0SECOND
	ikkWash21[0] = mix(ikkWash11[0], wash21[0]) @ 900.0SECOND
	il1bRechallenge1[0] = dispense(IL1beta_HighDose)
	ikkRechallenge1[0] = mix(ikkWash21[0], il1bRechallenge1[0]) @ 7200.0SECOND
	ikkSignal1[0] = detect(nfkbTranslocationDetection, ikkRechallenge1[0]) @ 90.0SECOND
	if ikkSignal1[0] > 0	|	true: jump bsbbif_14_t	|	false: jump bsbbif_15_f
bsbbif_14_t:
	dispose(ikkRechallenge1[0])
bsbbif_15_f:
	dispose(ikkRechallenge1[0])
	jump: bsbbif_16_j
bsbbif_16_j:
	dispose(s4Signal1[0])
	dispose(ikkSignal1[0])
	NOP
