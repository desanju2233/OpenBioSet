bsbbif_2_t:
	dispose(pla_Library1[0])
	plaQCPassFlag1[0] = dispense(BufferEB)
	dispose(plaQCPassFlag1[0])
bsbbif_3_f:
	dispose(pla_Library1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(plaQCSignal1[0])
	phixSpike1[0] = dispense(PhiX_Spike)
	cDNA_FinalLib1[0] = mix(cDNA_mRNA_Library1[0], phixSpike1[0]) @ 120.0SECOND
	rnaQCSignal1[0] = detect(rnaExpressionDetection, cDNA_FinalLib1[0]) @ 30.0SECOND
	if rnaQCSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	tissueSection1[0] = dispense(TonsilTissueSection)
	preheatPad1[0] = dispense(SSC_3x)
	prewarmTissue1[0] = mix(tissueSection1[0], preheatPad1[0]) @ 5.0SECOND
	heat(prewarmTissue1[0]) @ 37.0CELSIUS @ 60.0SECOND
	pfaFixative1[0] = dispense(PFA_1pct)
	fixedTissue1[0] = mix(prewarmTissue1[0], pfaFixative1[0]) @ 600.0SECOND
	wash1_SSC1[0] = dispense(SSC_3x)
	wash2_SSC1[0] = dispense(SSC_3x)
	wash3_SSC1[0] = dispense(SSC_3x)
	washedTissue_11[0] = mix(fixedTissue1[0], wash1_SSC1[0]) @ 30.0SECOND
	washedTissue_21[0] = mix(washedTissue_11[0], wash2_SSC1[0]) @ 30.0SECOND
	washedTissue_31[0] = mix(washedTissue_21[0], wash3_SSC1[0]) @ 30.0SECOND
	blockingBuffer1[0] = dispense(BSA_BlockingBuffer)
	blockedTissue1[0] = mix(washedTissue_31[0], blockingBuffer1[0]) @ 600.0SECOND
	heat(blockedTissue1[0]) @ 25.0CELSIUS @ 600.0SECOND
	aocCocktail1[0] = dispense(AOC_CocktailPairs)
	probeBuffer1[0] = dispense(ProbeBindingBuffer)
	aocMix1[0] = mix(aocCocktail1[0], probeBuffer1[0]) @ 5.0SECOND
	aocBound1[0] = mix(blockedTissue1[0], aocMix1[0]) @ 5400.0SECOND
	heat(aocBound1[0]) @ 4.0CELSIUS @ 5400.0SECOND
	wb1_a1[0] = dispense(WashBuffer1)
	wb1_b1[0] = dispense(WashBuffer1)
	wb1_c1[0] = dispense(WashBuffer1)
	wb1_d1[0] = dispense(WashBuffer1)
	postAOC_w11[0] = mix(aocBound1[0], wb1_a1[0]) @ 30.0SECOND
	postAOC_w21[0] = mix(postAOC_w11[0], wb1_b1[0]) @ 30.0SECOND
	postAOC_w31[0] = mix(postAOC_w21[0], wb1_c1[0]) @ 30.0SECOND
	postAOC_w41[0] = mix(postAOC_w31[0], wb1_d1[0]) @ 30.0SECOND
	ligBuffer1[0] = dispense(LigationBuffer)
	ligatedTissue1[0] = mix(postAOC_w41[0], ligBuffer1[0]) @ 1800.0SECOND
	heat(ligatedTissue1[0]) @ 37.0CELSIUS @ 1800.0SECOND
	wb1_e1[0] = dispense(WashBuffer1)
	wb1_f1[0] = dispense(WashBuffer1)
	wb1_g1[0] = dispense(WashBuffer1)
	wb1_h1[0] = dispense(WashBuffer1)
	postLig_w11[0] = mix(ligatedTissue1[0], wb1_e1[0]) @ 30.0SECOND
	postLig_w21[0] = mix(postLig_w11[0], wb1_f1[0]) @ 30.0SECOND
	postLig_w31[0] = mix(postLig_w21[0], wb1_g1[0]) @ 30.0SECOND
	postLig_w41[0] = mix(postLig_w31[0], wb1_h1[0]) @ 30.0SECOND
	userBuffer1[0] = dispense(USER_EnzymeBuffer)
	userDigested1[0] = mix(postLig_w41[0], userBuffer1[0]) @ 1800.0SECOND
	heat(userDigested1[0]) @ 37.0CELSIUS @ 1800.0SECOND
	wb1_i1[0] = dispense(WashBuffer1)
	wb1_j1[0] = dispense(WashBuffer1)
	wb1_k1[0] = dispense(WashBuffer1)
	sscDip1[0] = dispense(SSC_3x)
	postUser_w11[0] = mix(userDigested1[0], wb1_i1[0]) @ 30.0SECOND
	postUser_w21[0] = mix(postUser_w11[0], wb1_j1[0]) @ 30.0SECOND
	postUser_w31[0] = mix(postUser_w21[0], wb1_k1[0]) @ 30.0SECOND
	imagingPrep1[0] = mix(postUser_w31[0], sscDip1[0]) @ 20.0SECOND
	heat(imagingPrep1[0]) @ 25.0CELSIUS @ 300.0SECOND
	decrosslinkBuf1[0] = dispense(SSC_1x_DecrosslinkBuffer)
	decrosslinked1[0] = mix(imagingPrep1[0], decrosslinkBuf1[0]) @ 900.0SECOND
	heat(decrosslinked1[0]) @ 70.0CELSIUS @ 900.0SECOND
	heat(decrosslinked1[0]) @ 25.0CELSIUS @ 600.0SECOND
	wb21[0] = dispense(WashBuffer2)
	wb2Rinsed1[0] = mix(decrosslinked1[0], wb21[0]) @ 60.0SECOND
	permBuffer1[0] = dispense(PermeabilizationBuffer)
	permeabilized1[0] = mix(wb2Rinsed1[0], permBuffer1[0]) @ 1500.0SECOND
	heat(permeabilized1[0]) @ 37.0CELSIUS @ 1500.0SECOND
	ssc01_a1[0] = dispense(SSC_01x)
	ssc01_b1[0] = dispense(SSC_01x)
	postPerm_w11[0] = mix(permeabilized1[0], ssc01_a1[0]) @ 30.0SECOND
	capturedMolecules1[0] = mix(postPerm_w11[0], ssc01_b1[0]) @ 30.0SECOND
	rtReagents1[0] = dispense(ReverseTranscriptaseReagents)
	cDNA_raw1[0] = mix(capturedMolecules1[0], rtReagents1[0]) @ 2700.0SECOND
	heat(cDNA_raw1[0]) @ 53.0CELSIUS @ 2700.0SECOND
	spri06x1[0] = dispense(SPRIselect_06x)
	amplifiedcDNA1[0] = mix(cDNA_raw1[0], spri06x1[0]) @ 480.0SECOND
	heat(amplifiedcDNA1[0]) @ 98.0CELSIUS @ 180.0SECOND
	cDNA_mRNA_Library1[0] = mix(amplifiedcDNA1[0], spri06x1[0]) @ 300.0SECOND
	pla_Supernatant1[0] = mix(amplifiedcDNA1[0], spri06x1[0]) @ 300.0SECOND
	spri21x1[0] = dispense(SPRIselect_21x)
	spri12x1[0] = dispense(SPRIselect_12x)
	indexPrimers1[0] = dispense(IndexingPrimers)
	bufEB1[0] = dispense(BufferEB)
	kapaHiFi1[0] = dispense(KAPA_HiFi_Mix)
	pla_Cleaned1[0] = mix(pla_Supernatant1[0], spri21x1[0]) @ 480.0SECOND
	pla_IndexedMix1[0] = mix(pla_Cleaned1[0], indexPrimers1[0]) @ 5.0SECOND
	pla_IndexedMix21[0] = mix(pla_IndexedMix1[0], kapaHiFi1[0]) @ 5.0SECOND
	heat(pla_IndexedMix21[0]) @ 98.0CELSIUS @ 120.0SECOND
	pla_Amplified1[0] = mix(pla_IndexedMix21[0], spri12x1[0]) @ 480.0SECOND
	pla_Library1[0] = mix(pla_Amplified1[0], bufEB1[0]) @ 120.0SECOND
	plaQCSignal1[0] = detect(plaDataQC, pla_Library1[0]) @ 30.0SECOND
	if plaQCSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	plaFinalLib1[0] = dispense(PhiX_Spike)
	pla_SequencingLib1[0] = mix(cDNA_FinalLib1[0], plaFinalLib1[0]) @ 120.0SECOND
	complexSignal1[0] = detect(vlaVcamInteractionDetection, pla_SequencingLib1[0]) @ 60.0SECOND
	if complexSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_6_f:
	dispose(cDNA_FinalLib1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(rnaQCSignal1[0])
	NOP
bsbbif_8_t:
	dispose(pla_SequencingLib1[0])
	dispose(cDNA_FinalLib1[0])
bsbbif_9_f:
	dispose(pla_SequencingLib1[0])
	dispose(cDNA_FinalLib1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(complexSignal1[0])
	jump: bsbbif_7_j
