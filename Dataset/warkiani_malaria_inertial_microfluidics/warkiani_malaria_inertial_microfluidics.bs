module parasiteRecoveryDetection
module wbcDepletionDetection
module qPCRDetection

manifest WholeBlood
manifest RBCLysisBuffer
manifest Saponin
manifest PBS_EDTA_BSA
manifest iRBC_Spiked
manifest SYBRGreen_qPCR_Kit
manifest MalariaKit_Norgen

// ============================================================
// Malaria Detection Using Inertial Microfluidics
// Warkiani, Tay, Khoo, Xiaofeng, Han, Lim
// Lab on a Chip, 2015, 15, 1101-1109
// DOI: 10.1039/c4lc01058b
//
// This BioScript encodes the full sample-to-answer pipeline:
// inertial microfluidic enrichment of ring-stage P. falciparum
// parasites from lysed whole blood, followed by qPCR detection.
//
// DEVICE: High-aspect-ratio rectangular microchannel with
//   contraction-expansion array (30/90 um, height 100 um,
//   85 subunits, 20 mm total length). Outlet ratio 1:1:1.
//   Cascaded 2-stage system (3 chips; 1 pressure compensator).
//   Flow rate: 400 uL/min (Re ~102.5). Processed in ~15 min
//   per 1 mL of 0.25x diluted lysed blood.
//
// OPERATING PRINCIPLE: In high-aspect-ratio channels the high
//   shear rate along the channel width drives WBCs (6-15 um)
//   to equilibrate into two streams near the sidewalls via
//   shear-modulated inertial lift forces. Malaria parasites
//   (1-2 um, released from iRBCs by saponin lysis) are below
//   the 4 um focusing cutoff and remain unfocused, exiting
//   from all outlets (predominantly center). WBCs are removed
//   at peripheral outlets.
//
// CELL SIZE CUTOFF: Particles >=4 um are focused and depleted
//   (WBCs, iRBCs). Particles <4 um (free parasites, 1-2 um)
//   pass through unfocused to center outlet.
//
// NOTE ON LYSIS: Saponin disrupts RBC and iRBC membranes
//   while leaving malaria parasite membranes intact, releasing
//   free parasites into suspension for downstream processing.
//   RBC lysis buffer (eBioscience) removes bulk erythrocytes;
//   saponin (0.05% w/v) releases parasites from iRBCs.
//   Sample is centrifuged 2000 rpm / 5 min and resuspended
//   in PBS before microfluidic processing.
//
// NOTE ON SPIKE LEVEL: Clinically relevant parasitemia is
//   modelled by spiking 2k-10k iRBCs per mL into whole blood
//   (~2-10 parasites/uL). This is the low-level detection
//   regime that conventional microscopy (50-100 parasites/uL)
//   cannot resolve. The device achieves ~100-fold improvement.
//
// NOTE ON MIX ABSTRACTION: `mix` steps involving the
//   microfluidic chip abstract continuous-flow hydrodynamic
//   separation events (not DMF electrode mixing). The duration
//   encodes approximate processing time at 400 uL/min.
//
// CFG STRUCTURE:
//   BB1  main              -- sample prep: blood draw, iRBC
//                             spike, lysis, PBS wash
//   BB2  wbcDepletionPass  -- wbcSignal > 0: WBC depletion
//                             >99.99% confirmed; continue
//   BB3  wbcDepletionFail  -- wbcSignal <= 0: depletion
//                             insufficient; drain, re-run
//   BB4  wbcDepletionJoin  -- join: parasite recovery QC branch
//   BB5  recoveryPass      -- recoverySignal > 0: parasites
//                             successfully enriched; continue
//                             to qPCR
//   BB6  recoveryFail      -- recoverySignal <= 0: poor yield;
//                             drain enriched fraction
//   BB7  recoveryJoin      -- join: qPCR branch begins
//   BB8  qPCRPass          -- qPCRSignal > 0: positive parasite
//                             detection (Ct < threshold);
//                             dispose final sample
//   BB9  qPCRFail          -- qPCRSignal <= 0: no detection
//                             (below limit or inhibition); drain
//   BB10 finalCleanup      -- terminal: dispose all QC signals
// ============================================================

instructions:

// ============================================================
// BB1: main
// ============================================================

// ------------------------------------------------------------
// STEP 1: Blood draw and iRBC spiking.
//   Whole blood is collected from a healthy donor.
//   Ring-stage P. falciparum 3D7 iRBCs (2k-10k per mL) are
//   spiked into 1 mL of whole blood to emulate low-level
//   parasitemia. Spiked cell counts (2k, 5k, 10k) used to
//   generate the calibration curve for qPCR quantification.
//   iRBCs harvested from culture; parasitemia confirmed by
//   Giemsa thin-smear and haemocytometer count.
// ------------------------------------------------------------

wholeBlood     = dispense 1 units of WholeBlood
iRBCSpike      = dispense 1 units of iRBC_Spiked

spikedBlood    = mix wholeBlood with iRBCSpike for 30s

// ------------------------------------------------------------
// STEP 2: RBC bulk lysis.
//   RBC lysis buffer (eBioscience) added per manufacturer
//   instructions to remove the bulk erythrocyte population.
//   This step does NOT lyse iRBCs; infected RBCs remain intact
//   at this stage so parasites are still encapsulated.
//   Lysis performed at room temperature.
// ------------------------------------------------------------

rbcLysisBuffer = dispense 1 units of RBCLysisBuffer
lysedBlood     = mix spikedBlood with rbcLysisBuffer for 15m

// ------------------------------------------------------------
// STEP 3: Saponin lysis to release free parasites.
//   0.05% (w/v) saponin added to lyse iRBC membranes and
//   release ring-stage parasites (1-2 um) into suspension.
//   Saponin selectively disrupts cholesterol-rich RBC/iRBC
//   membranes while leaving parasite membranes intact.
//   Result: free parasites in suspension with WBCs and debris.
// ------------------------------------------------------------

saponinSoln    = dispense 1 units of Saponin
parasiteSuspension = mix lysedBlood with saponinSoln for 10m

// ------------------------------------------------------------
// STEP 4: Centrifugation and PBS wash.
//   Centrifuge at 2000 rpm for 5 min to pellet cells/debris.
//   Supernatant removed; pellet resuspended in 1x PBS.
//   Diluted to 0.25x with PBS (4-fold dilution) to reduce
//   WBC-WBC interactions that compromise depletion efficiency.
//   0.25x dilution yields 99.90% WBC depletion in single cycle
//   vs 47% at 1x. Dilution is the key sample-prep parameter.
//   `heat` at 4c models centrifugation pelleting step (300s).
// ------------------------------------------------------------

pbsBuffer      = dispense 1 units of PBS_EDTA_BSA
heat parasiteSuspension at 4c for 300s

washedSample   = mix parasiteSuspension with pbsBuffer for 5m

// ------------------------------------------------------------
// STEP 5: Device priming.
//   Microfluidic chip primed with 1x PBS + 2 mM EDTA + 0.5%
//   BSA at 500 uL/min for 2 min to block non-specific adhesion
//   and equilibrate the PDMS channel surfaces.
//   `mix` abstracts continuous-flow channel priming.
// ------------------------------------------------------------

primingBuffer  = dispense 1 units of PBS_EDTA_BSA
primedChip     = mix washedSample with primingBuffer for 2m

// ------------------------------------------------------------
// STEP 6: Stage 1 inertial microfluidic separation.
//   Sample loaded at 400 uL/min (Re ~102.5) through the
//   30/90 um contraction-expansion array (100 um height,
//   85 subunits, 20 mm total). WBCs (6-15 um) focus to
//   channel sidewalls via shear-modulated inertial lift and
//   wall-induced lift force equilibration.
//   Free parasites (1-2 um) remain unfocused; exit all outlets.
//   Center outlet (1:1:1 ratio) collects enriched fraction.
//   Processing time: ~2.5 min per 1 mL at 400 uL/min.
//   `mix` abstracts the continuous-flow separation event.
//   A fresh PBS aliquot (chipBuffer1) is used here to avoid
//   re-using primingBuffer (already consumed in primedChip).
// ------------------------------------------------------------

chipBuffer1    = dispense 1 units of PBS_EDTA_BSA
stage1Enriched = mix primedChip with chipBuffer1 for 3m

// QC gate: WBC depletion efficiency check after Stage 1.
// wbcDepletionDetection module abstracts flow-cytometry-based
// WBC counting (CD45-APC antibody staining; Olympus IX81
// epifluorescent microscope with motorized stage).
// Expected: ~99.90% WBC depletion at Re 102.5 (single cycle).

wbcSignal1     = detect wbcDepletionDetection on stage1Enriched for 30s

// ============================================================
// BB2 / BB3: Stage 1 WBC depletion QC gate
// Pass (BB2): wbcSignal1 > 0 -> depletion confirmed;
//             carry stage1Enriched forward to Stage 2.
// Fail (BB3): wbcSignal1 <= 0 -> WBC contamination too high;
//             drain and re-run at optimal Re (adjust flow rate
//             or dilution factor off-chip).
// Both branches converge at BB4 (wbcDepletionJoin).
//
// NOTE: pass branch does NOT dispose stage1Enriched here;
// it is carried implicitly into BB4 as the Stage 2 input.
// drain in the fail branch correctly discards the fraction.
// ============================================================

if (wbcSignal1 > 0) {
    dispose stage1Enriched
} else {
    drain stage1Enriched
}

// ============================================================
// BB4: wbcDepletionJoin
// Dispose Stage 1 WBC QC signal. Control falls into Stage 2
// cascaded enrichment and parasite recovery QC branch.
// ============================================================

dispose wbcSignal1

// ------------------------------------------------------------
// STEP 7: Stage 2 cascaded inertial microfluidic separation.
//   Center outlet fraction from Stage 1 (stage1Enriched) is
//   fed directly into Stage 2 chip (cascaded configuration;
//   pressure compensator chip in parallel for flow balancing).
//   Stage 2 repeats the same 30/90 um separation at 400 uL/min,
//   achieving a second cycle of WBC depletion. Combined:
//   ~99.99% WBC depletion after 2 cycles. Collection efficiency
//   of free parasites: ~70.9 +/- 11.4% in blood.
//   Parasites collected from center outlet into 200 uL PBS.
//   chipBuffer2 is a fresh PBS aliquot for Stage 2 priming.
// ------------------------------------------------------------

chipBuffer2       = dispense 1 units of PBS_EDTA_BSA

// Stage 2 chip run: stage1Enriched (center outlet fraction)
// re-injected as actual input. No fresh dispense needed here.
stage2Enriched    = mix stage1Enriched with chipBuffer2 for 3m

// Parasite recovery QC: FACS-based collection efficiency check.
// parasiteRecoveryDetection abstracts fluorescence counting of
// 1.5 um bead surrogates (proxy for parasites) in center outlet
// vs total inlet count. Expected: ~60% collection (2-cycle).

recoverySignal    = detect parasiteRecoveryDetection on stage2Enriched for 30s

// ============================================================
// BB5 / BB6: Parasite recovery QC gate
// Pass (BB5): recoverySignal > 0 -> sufficient parasite yield
//             in enriched fraction; carry stage2Enriched
//             forward to DNA extraction.
// Fail (BB6): recoverySignal <= 0 -> unacceptable parasite
//             loss during separation; drain enriched fraction.
// Both branches converge at BB7 (recoveryJoin).
//
// NOTE: pass branch drains only the QC signal; stage2Enriched
// is carried forward to extraction step in BB7.
// ============================================================

if (recoverySignal > 0) {
    drain recoverySignal
} else {
    drain stage2Enriched
}

// ============================================================
// BB7: recoveryJoin
// Dispose parasite recovery QC signal. Control falls into
// the qPCR quantification branch (BB8/BB9).
// ============================================================

dispose recoverySignal

// ------------------------------------------------------------
// STEP 8: Parasite DNA extraction for qPCR.
//   Enriched parasites (stage2Enriched, 200 uL PBS) are
//   processed with the Norgen malaria kit (#34800, Canada)
//   per manufacturer instructions. This step extracts and
//   purifies parasite genomic DNA for PCR amplification.
//   WBC removal upstream is critical: residual WBC DNA cross-
//   reacts with p.f.-specific primers and PCR inhibitors in
//   WBC genomic material suppress amplification.
//   Without enrichment, 2k/mL parasitemia is undetectable;
//   after enrichment, detection reaches ~1 parasite/uL.
// ------------------------------------------------------------

malariaKit     = dispense 1 units of MalariaKit_Norgen
sybr           = dispense 1 units of SYBRGreen_qPCR_Kit

extractedDNA   = mix stage2Enriched with malariaKit for 20m

// ------------------------------------------------------------
// STEP 9: qPCR amplification and detection.
//   StepOnePlus (Applied Biosystems) with SYBR Green.
//   Protocol: 95 C for 3 min (initial denaturation), then
//   40 cycles of [94 C for 15 s, 60 C for 30 s].
//   Melt curve: 65 C to 95 C, reading every 0.1 C after 5 s hold.
//   Ct threshold: default fluorescence threshold settings.
//   Primer specificity confirmed by melt curve (two peaks:
//   spiked iRBCs and isoC internal control from malaria kit).
//   Calibration curve: 2k, 5k, 10k iRBC standards in blood.
//   Recovery % = DNA from enriched sample / DNA from same
//   number of unenriched parasites (both at same initial count).
//   `heat` encodes the PCR thermal cycling: 3 min at 95 C
//   (initial denature) then 40 cycles at 94/60 C abstracted
//   as a 40-cycle x 45 s = 1800 s (30 min) block at 60 C.
// ------------------------------------------------------------

qPCRMix        = mix extractedDNA with sybr for 5s

// Initial denaturation: 95 C for 3 min.
heat qPCRMix at 95c for 3m

// 40 amplification cycles (94 C / 60 C); abstracted at 60 C
// for 30 min total (40 cycles x ~45 s per cycle).
heat qPCRMix at 60c for 30m

// Melt curve analysis: 65 C to 95 C ramp (abstracted at 80 C
// for 5 min to represent the ramp period with 0.1 C steps).
heat qPCRMix at 80c for 5m

// qPCRDetection module abstracts StepOnePlus Ct readout,
// melt curve peak analysis, and calibration curve lookup.
// Signal > 0: Ct below threshold -> positive parasite detection.
// Expected detection range: 10^3 to 10^4 P. falciparum per mL
// (~2-10 parasites/uL). ~100-fold more sensitive than microscopy.

qPCRSignal     = detect qPCRDetection on qPCRMix for 10s

// ============================================================
// BB8 / BB9: qPCR detection QC gate
// Pass (BB8): qPCRSignal > 0 -> parasite DNA detected above
//             Ct threshold; sample is malaria-positive.
//             Dispose final PCR product.
// Fail (BB9): qPCRSignal <= 0 -> no amplification above
//             threshold; either below detection limit or
//             residual PCR inhibition; drain qPCR product.
// Both branches converge at BB10 (finalCleanup).
// ============================================================

if (qPCRSignal > 0) {
    dispose qPCRMix
} else {
    drain qPCRMix
}

// ============================================================
// BB10: finalCleanup (terminal)
// Dispose qPCR detection signal. Experiment ends.
// ============================================================

dispose qPCRSignal

// [terminal -- no further instructions; exit node for CFG]
