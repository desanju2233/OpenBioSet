bsbbif_2_t:
	dispose(mcf7Separated1[0])
bsbbif_3_f:
	dispose(mcf7Separated1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(ctcSignal1[0])
	t24Cells1[0] = dispense(T24_Cells)
	heat(t24Cells1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	edtaBsa21[0] = dispense(EDTA_BSA_Buffer)
	t24Resuspended1[0] = mix(t24Cells1[0], edtaBsa21[0]) @ 60.0SECOND
	wholeBlood21[0] = dispense(WholeBlood)
	rbcLysis21[0] = dispense(RBCLysisBuffer)
	lysedBlood21[0] = mix(wholeBlood21[0], rbcLysis21[0]) @ 300.0SECOND
	heat(lysedBlood21[0]) @ 25.0CELSIUS @ 300.0SECOND
	pbs21[0] = dispense(PBS)
	nucleated21[0] = mix(lysedBlood21[0], pbs21[0]) @ 60.0SECOND
	spikedT241[0] = mix(nucleated21[0], t24Resuspended1[0]) @ 60.0SECOND
	sheath21[0] = dispense(SheathFluid)
	t24Separated1[0] = mix(spikedT241[0], sheath21[0]) @ 600.0SECOND
	pfa11[0] = dispense(Paraformaldehyde)
	t24Fixed1[0] = mix(t24Separated1[0], pfa11[0]) @ 600.0SECOND
	heat(t24Fixed1[0]) @ 25.0CELSIUS @ 600.0SECOND
	triton11[0] = dispense(TritonX100)
	pbs31[0] = dispense(PBS)
	tritonPbs11[0] = mix(triton11[0], pbs31[0]) @ 60.0SECOND
	t24Permeabilized1[0] = mix(t24Fixed1[0], tritonPbs11[0]) @ 300.0SECOND
	panCK11[0] = dispense(PanCytokeratinFITC)
	cd45Ab11[0] = dispense(CD45_APC)
	hoechst11[0] = dispense(Hoechst)
	piStain1[0] = dispense(PropidiumIodide)
	viabStainMix11[0] = mix(panCK11[0], cd45Ab11[0]) @ 60.0SECOND
	viabStainMix21[0] = mix(viabStainMix11[0], hoechst11[0]) @ 60.0SECOND
	viabStainFull1[0] = mix(viabStainMix21[0], piStain1[0]) @ 60.0SECOND
	stainedViability1[0] = mix(t24Permeabilized1[0], viabStainFull1[0]) @ 1800.0SECOND
	heat(stainedViability1[0]) @ 4.0CELSIUS @ 1800.0SECOND
	viabilitySignal1[0] = detect(viabilityDetection, stainedViability1[0]) @ 30.0SECOND
	if viabilitySignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	mcf7Cells1[0] = dispense(MCF7_Cells)
	heat(mcf7Cells1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	edtaBsaBuffer1[0] = dispense(EDTA_BSA_Buffer)
	mcf7Resuspended1[0] = mix(mcf7Cells1[0], edtaBsaBuffer1[0]) @ 60.0SECOND
	wholeBlood11[0] = dispense(WholeBlood)
	rbcLysis11[0] = dispense(RBCLysisBuffer)
	lysedBlood11[0] = mix(wholeBlood11[0], rbcLysis11[0]) @ 300.0SECOND
	heat(lysedBlood11[0]) @ 25.0CELSIUS @ 300.0SECOND
	pbs11[0] = dispense(PBS)
	nucleated11[0] = mix(lysedBlood11[0], pbs11[0]) @ 60.0SECOND
	spikedMcf71[0] = mix(nucleated11[0], mcf7Resuspended1[0]) @ 60.0SECOND
	sheath11[0] = dispense(SheathFluid)
	mcf7Separated1[0] = mix(spikedMcf71[0], sheath11[0]) @ 600.0SECOND
	ctcSignal1[0] = detect(ctcDetection, mcf7Separated1[0]) @ 30.0SECOND
	if ctcSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(stainedViability1[0])
bsbbif_6_f:
	dispose(stainedViability1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(viabilitySignal1[0])
	clinicalBlood1[0] = dispense(WholeBlood)
	rbcLysis31[0] = dispense(RBCLysisBuffer)
	clinLysed1[0] = mix(clinicalBlood1[0], rbcLysis31[0]) @ 300.0SECOND
	heat(clinLysed1[0]) @ 25.0CELSIUS @ 300.0SECOND
	pbs41[0] = dispense(PBS)
	clinNucleated1[0] = mix(clinLysed1[0], pbs41[0]) @ 60.0SECOND
	sheath31[0] = dispense(SheathFluid)
	clinSeparated1[0] = mix(clinNucleated1[0], sheath31[0]) @ 600.0SECOND
	pfa21[0] = dispense(Paraformaldehyde)
	clinFixed1[0] = mix(clinSeparated1[0], pfa21[0]) @ 600.0SECOND
	heat(clinFixed1[0]) @ 25.0CELSIUS @ 600.0SECOND
	triton21[0] = dispense(TritonX100)
	pbs51[0] = dispense(PBS)
	tritonPbs21[0] = mix(triton21[0], pbs51[0]) @ 60.0SECOND
	clinPermeabilized1[0] = mix(clinFixed1[0], tritonPbs21[0]) @ 300.0SECOND
	panCK21[0] = dispense(PanCytokeratinFITC)
	cd45Ab21[0] = dispense(CD45_APC)
	hoechst21[0] = dispense(Hoechst)
	ifStainMix1[0] = mix(panCK21[0], cd45Ab21[0]) @ 60.0SECOND
	ifStainFull1[0] = mix(ifStainMix1[0], hoechst21[0]) @ 60.0SECOND
	stainedClinical1[0] = mix(clinPermeabilized1[0], ifStainFull1[0]) @ 1800.0SECOND
	heat(stainedClinical1[0]) @ 4.0CELSIUS @ 1800.0SECOND
	clinicalSignal1[0] = detect(ctcDetection, stainedClinical1[0]) @ 30.0SECOND
	if clinicalSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	her2Probe1[0] = dispense(HER2_FISHProbe)
	dapiStain1[0] = dispense(DAPI)
	pfa31[0] = dispense(Paraformaldehyde)
	fishFixed1[0] = mix(stainedClinical1[0], pfa31[0]) @ 600.0SECOND
	heat(fishFixed1[0]) @ 25.0CELSIUS @ 600.0SECOND
	rnase1[0] = dispense(RNase)
	rnaseTreated1[0] = mix(fishFixed1[0], rnase1[0]) @ 2400.0SECOND
	heat(rnaseTreated1[0]) @ 37.0CELSIUS @ 2400.0SECOND
	formamideSsc1[0] = dispense(Formamide_SSC)
	denatured1[0] = mix(rnaseTreated1[0], formamideSsc1[0]) @ 600.0SECOND
	heat(denatured1[0]) @ 80.0CELSIUS @ 600.0SECOND
	her2ProbeMix1[0] = mix(denatured1[0], her2Probe1[0]) @ 60.0SECOND
	heat(her2ProbeMix1[0]) @ 42.0CELSIUS @ 36000.0SECOND
	formamideWash1[0] = dispense(Formamide_SSC)
	sscWash1[0] = dispense(SSC_Wash)
	washed11[0] = mix(her2ProbeMix1[0], formamideWash1[0]) @ 300.0SECOND
	heat(washed11[0]) @ 45.0CELSIUS @ 300.0SECOND
	washed21[0] = mix(washed11[0], sscWash1[0]) @ 300.0SECOND
	heat(washed21[0]) @ 45.0CELSIUS @ 300.0SECOND
	dapiMix1[0] = mix(washed21[0], dapiStain1[0]) @ 300.0SECOND
	her2Signal1[0] = detect(her2FISHDetection, dapiMix1[0]) @ 30.0SECOND
	dispose(dapiMix1[0])
	dispose(her2Signal1[0])
bsbbif_9_f:
	dispose(stainedClinical1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(clinicalSignal1[0])
	NOP
