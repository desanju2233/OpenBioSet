{
  "protocol": {
    "title": "An Ultra-High-Throughput Spiral Microfluidic Biochip for the Enrichment of Circulating Tumor Cells",
    "source": "Analyst, 2014, 139, 3245-3255",
    "doi": "10.1039/c4an00355a",
    "platform": "Multiplexed spiral microfluidic biochip (continuous-flow, inertial focusing)",
    "cell_lines": [
      "MCF-7 (human breast adenocarcinoma, HTB-22, ATCC, ~20 um diameter)",
      "T24 (human bladder carcinoma, HTB-4, ATCC, ~30 um diameter)"
    ],
    "clinical_samples": {
      "patients": 10,
      "breakdown": { "metastatic_breast_cancer": 5, "NSCLC": 5 },
      "cancer_stage": "Stage IV",
      "healthy_donor_controls": 5,
      "blood_volume_mL": 7.5,
      "collection_tube": "Vacutainer EDTA (Becton-Dickinson, Franklin Lakes, NJ, USA)",
      "processing_window_h": "2-4"
    },
    "objective": "Ultra-high-throughput, label-free, size-based isolation of circulating tumor cells (CTCs) from clinically relevant blood volumes using Dean vortex and inertial lift forces in multiplexed spiral microchannels; downstream cell viability assessment, immunofluorescence identification, and HER2 FISH analysis",

    "device": {
      "type": "Multiplexed spiral microfluidic biochip",
      "configuration": "3 stacked single-layer PDMS spiral chips bonded together",
      "inlets": 2,
      "outlets": 2,
      "outlet_function": {
        "inner_wall_outlet": "CTC collection",
        "outer_wall_outlet": "WBC / waste"
      },
      "fabrication": {
        "mold": "SU-8 silicon mold by standard photolithography",
        "silanization": "Trichloro (1H,1H,2H,2H-perfluorooctyl) silane (Sigma Aldrich, USA)",
        "pdms_ratio": "1:10 (Sylgard 184, Dow Corning, USA)",
        "cure_temperature_C": 80,
        "cure_duration_h": "1-2",
        "bonding": "Oxygen plasma and manual alignment; whole assembly bonded to microscopic glass slide by air plasma"
      },
      "channel": {
        "cross_section": "Rectangular",
        "separation_principle": "Inertial focusing + Dean drag forces",
        "dean_vortices": 2,
        "ctc_equilibrium_position": "Inner microchannel wall",
        "wbc_equilibrium_position": "Outer microchannel wall"
      },
      "enrichment_factor": "~10^4-fold from RBC-depleted nucleated cell fraction"
    },

    "reagents": {
      "rbc_lysis_buffer": "Ammonium chloride RBC lysis buffer (Bioscience, USA)",
      "resuspension_buffer": "PBS (1x phosphate buffered saline)",
      "spike_buffer": "PBS + 2 mM EDTA + 0.5% BSA (Miltenyi Biotec, Germany); prevents non-specific adsorption",
      "sheath_fluid": "PBS at 750 uL/min",
      "cell_culture_media": {
        "MCF7_T24": "High-glucose DMEM (Invitrogen) + 10% FBS (Invitrogen) + 1% penicillin-streptomycin (Invitrogen)"
      },
      "cell_dissociation": "0.01% trypsin + 5.3 mM EDTA (Lonza, Switzerland)",
      "culture_conditions": "37 C, 5% CO2, humidified atmosphere; sub-cultivated 1:3 twice weekly; media replaced every 48 h",
      "fixation": "4% paraformaldehyde (PFA), 10 min at RT",
      "permeabilization": "0.1% Triton X-100 in PBS",
      "if_staining_panel": {
        "pan_cytokeratin_FITC": { "dilution": "1:100", "supplier": "Miltenyi Biotec Asia Pacific, Singapore", "target": "epithelial/cancer cells" },
        "APC_CD45": { "dilution": "1:100", "supplier": "Miltenyi Biotec Asia Pacific, Singapore", "target": "hematological cells (WBCs)" },
        "Hoechst": { "target": "DNA, nuclear counterstain" }
      },
      "ctc_scoring_criteria": "Hoechst+ / Pan-CK+ / CD45-",
      "viability_stain": {
        "propidium_iodide": { "ex_nm": 488, "em_nm": 617, "labels": "dead cells" },
        "pan_CK_FITC": { "dilution": "1:100", "labels": "cancer cell identity confirmation" }
      },
      "fish_reagents": {
        "her2_probe": "HER-2/neu gene locus probe (red)",
        "cep17_probe": "Chromosome 17 centromere probe CEP17 (green)",
        "rnase": "4 mg/mL in PBS/0.2% Tween 20",
        "denaturation_solution": "70% formamide/2xSSC",
        "post_hyb_wash_1": "50% formamide/2xSSC at 45 C under shaking",
        "post_hyb_wash_2": "2xSSC at 45 C under shaking",
        "counterstain": "DAPI",
        "coverslip": "50 x 50 mm (Fisher Scientific, USA)"
      }
    },

    "flow_parameters": {
      "sample_input_flow_rate_uL_min": 350,
      "sheath_input_flow_rate_uL_min": 750,
      "sample_concentration": "2x (7.5 mL whole blood concentrated to 3.75 mL)",
      "optimal_wbc_input": "~14e6 WBCs (2x concentration)",
      "total_processing_time_min": 10,
      "blood_volume_per_run_mL": 7.5
    },

    "performance_metrics": {
      "throughput": "7.5 mL blood in <10 min",
      "clinical_sensitivity_pct": 100,
      "clinical_sensitivity_detail": "10 of 10 patient samples positive (100%)",
      "wbc_depletion_pct": "~99.99%",
      "wbc_depletion_detail": "~99.99% of ~7e6 input nucleated cells depleted",
      "ctc_purity": "1 CTC per 30-100 WBCs (~4 log WBC depletion)",
      "ctc_counts_per_mL": {
        "breast_cancer": { "range": "20-67", "n": 5 },
        "lung_cancer_NSCLC": { "range": "33-135", "n": 5 },
        "healthy_donor_background_CK_plus": "1-4 cells/mL"
      },
      "recovery_efficiency_pct": {
        "MCF7": 87.6,
        "T24": 76.4,
        "spike_concentration": "500 cells per 7.5 mL whole blood",
        "n": 3,
        "test": "Anova single factor, P < 0.05"
      },
      "cell_viability_pct": {
        "detail": "<10% PI+ cells (>90% viable)",
        "method": "Propidium iodide staining + BD Accuri C6 flow cytometry",
        "lysis_effect": "No significant compromise (98% recovery vs whole blood, p=0.82)",
        "morphology_effect": "No significant size change after lysis (p=0.2)"
      },
      "wbc_uniformity": {
        "detail": "900-1200 WBCs collected per 5 min uniformly across 0-30 min processing",
        "p_value": "5.19E-05",
        "n": 3
      }
    },

    "steps": [
      {
        "id": "S1",
        "name": "MCF-7 cell culture and preparation",
        "bb": "BB1",
        "protocol": "PROTOCOL 1 -- MCF-7 recovery efficiency experiment",
        "cell_line": "MCF-7",
        "culture_media": "High-glucose DMEM + 10% FBS + 1% pen-strep",
        "culture_conditions": "37 C, 5% CO2, humidified, 80% confluence",
        "subculture": "1:3 twice weekly; media replaced every 48 h",
        "dissociation": "0.01% trypsin + 5.3 mM EDTA",
        "resuspension": "PBS + 2 mM EDTA + 0.5% BSA (EDTA_BSA_Buffer)",
        "operation": "heat (culture pre-incubation, abstracted per BioScript convention)",
        "temperature_C": 37,
        "duration_s": 172800,
        "duration_note": "48 h representative culture period = 2880 min = 172800 s",
        "notes": "MCF-7 and T24 spiked in separate, independent experiments (not co-spiked)"
      },
      {
        "id": "S2",
        "name": "Healthy donor blood collection and RBC lysis (MCF-7 arm)",
        "bb": "BB1",
        "protocol": "PROTOCOL 1",
        "inputs": ["WholeBlood", "RBCLysisBuffer", "PBS"],
        "blood_volume_mL": 7.5,
        "lysis_reagent": "Ammonium chloride RBC lysis buffer (Bioscience, USA)",
        "lysis_operation": "mix",
        "lysis_duration_min": 5,
        "lysis_temperature": "Room temperature, continuous gentle mixing",
        "centrifugation": "1000xg, 5 min (modelled as heat at 25c for 5m in BioScript)",
        "resuspension": "PBS; concentrated to 3.75 mL (2x)",
        "operation": "mix + heat",
        "notes": "RBC lysis removes contaminants and concentrates nucleated cells 2x for faster on-chip processing"
      },
      {
        "id": "S3",
        "name": "MCF-7 spike into nucleated cell fraction",
        "bb": "BB1",
        "protocol": "PROTOCOL 1",
        "inputs": ["nucleated1", "mcf7Resuspended"],
        "spike_concentration_cells_per_7_5mL": 500,
        "operation": "mix",
        "duration_s": 60,
        "notes": "Clinically relevant spike concentration; MCF-7 chosen for ~20 um diameter"
      },
      {
        "id": "S4",
        "name": "On-chip separation -- MCF-7 spiked sample",
        "bb": "BB1",
        "protocol": "PROTOCOL 1",
        "inputs": ["spikedMcf7", "SheathFluid"],
        "sample_flow_rate_uL_min": 350,
        "sheath_flow_rate_uL_min": 750,
        "processing_time_min": 10,
        "operation": "mix (abstracts continuous-flow hydrodynamic separation)",
        "separation_physics": "Inertial lift + Dean drag; CTCs focus at inner wall, WBCs/RBCs/platelets at outer wall",
        "ctc_outlet": "Inner wall outlet",
        "waste_outlet": "Outer wall outlet",
        "detection_module": "ctcDetection",
        "detection_duration_s": 30,
        "branch": {
          "pass": { "condition": "ctcSignal > 0", "action": "dispose(mcf7Separated)", "bb": "BB2" },
          "fail": { "condition": "ctcSignal <= 0", "action": "drain(mcf7Separated)", "bb": "BB3" }
        }
      },
      {
        "id": "S5",
        "name": "T24 cell culture and preparation",
        "bb": "BB4",
        "protocol": "PROTOCOL 2 -- T24 cell viability experiment",
        "cell_line": "T24",
        "culture_media": "High-glucose DMEM + 10% FBS + 1% pen-strep",
        "culture_conditions": "37 C, 5% CO2, humidified, 80% confluence",
        "dissociation": "0.01% trypsin + 5.3 mM EDTA",
        "resuspension": "PBS + 2 mM EDTA + 0.5% BSA (EDTA_BSA_Buffer)",
        "operation": "heat (culture pre-incubation)",
        "temperature_C": 37,
        "duration_s": 172800,
        "notes": "Independent experiment from Protocol 1; fresh blood sample used (FIX #1, FIX #2)"
      },
      {
        "id": "S6",
        "name": "Healthy donor blood collection and RBC lysis (T24 arm)",
        "bb": "BB4",
        "protocol": "PROTOCOL 2",
        "inputs": ["WholeBlood", "RBCLysisBuffer", "PBS"],
        "blood_volume_mL": 7.5,
        "lysis_duration_min": 5,
        "centrifugation": "1000xg, 5 min (heat at 25c for 5m)",
        "operation": "mix + heat",
        "notes": "T24 cells spiked into whole blood before lysis; counts compared before and after to quantify lysis-induced cell loss (98% recovery, p=0.82)"
      },
      {
        "id": "S7",
        "name": "T24 spike and on-chip separation",
        "bb": "BB4",
        "protocol": "PROTOCOL 2",
        "inputs": ["nucleated2", "t24Resuspended", "SheathFluid"],
        "spike_concentration_cells_per_7_5mL": 500,
        "sample_flow_rate_uL_min": 350,
        "sheath_flow_rate_uL_min": 750,
        "processing_time_min": 10,
        "operation": "mix (abstracts spiral chip separation)"
      },
      {
        "id": "S8",
        "name": "PFA fixation (T24 viability arm)",
        "bb": "BB4",
        "protocol": "PROTOCOL 2",
        "reagent": "4% paraformaldehyde (Sigma, USA)",
        "operation": "mix + heat",
        "duration_min": 10,
        "temperature_C": 25
      },
      {
        "id": "S9",
        "name": "Triton X-100 permeabilization (T24 viability arm)",
        "bb": "BB4",
        "protocol": "PROTOCOL 2",
        "reagent": "0.1% Triton X-100 in PBS (Sigma, USA)",
        "operation": "mix",
        "duration_min": 5
      },
      {
        "id": "S10",
        "name": "Cell viability staining -- PI + pan-CK/CD45 panel",
        "bb": "BB4",
        "protocol": "PROTOCOL 2",
        "staining_panel": {
          "pan_CK_FITC": { "dilution": "1:100", "target": "confirms cancer cell identity" },
          "APC_CD45": { "dilution": "1:100", "target": "WBC marker" },
          "Hoechst": { "target": "nuclear counterstain" },
          "propidium_iodide": { "ex_nm": 488, "em_nm": 617, "target": "dead cells" }
        },
        "incubation_temperature_C": 4,
        "incubation_duration_min": 30,
        "incubation_note": "On ice, in PBS buffer",
        "quantification": "BD Accuri C6 flow cytometer; gated on forward/side scatter and fluorescence",
        "operation": "mix + heat",
        "detection_module": "viabilityDetection",
        "detection_duration_s": 30,
        "results": {
          "viability_pct": ">90%",
          "pi_positive_pct": "<10%",
          "conclusion": "Neither lysis buffer nor spiral shear significantly affects cell viability"
        },
        "branch": {
          "pass": { "condition": "viabilitySignal > 0", "action": "dispose(stainedViability)", "bb": "BB6" },
          "fail": { "condition": "viabilitySignal <= 0", "action": "drain(stainedViability)", "bb": "BB7" }
        }
      },
      {
        "id": "S11",
        "name": "Clinical blood collection and RBC lysis",
        "bb": "BB8",
        "protocol": "PROTOCOL 3 -- Clinical CTC enrichment",
        "inputs": ["WholeBlood", "RBCLysisBuffer", "PBS"],
        "blood_volume_mL": 7.5,
        "patient_type": "Stage IV metastatic breast cancer or NSCLC",
        "n_patients": 10,
        "n_controls": 5,
        "lysis_duration_min": 5,
        "centrifugation": "1000xg, 5 min (heat at 25c for 5m)",
        "target_concentration": "3.75 mL (2x); ~14e6 WBCs",
        "operation": "mix + heat",
        "ethics": "IRB-approved protocol"
      },
      {
        "id": "S12",
        "name": "On-chip separation of clinical sample",
        "bb": "BB8",
        "protocol": "PROTOCOL 3",
        "inputs": ["clinNucleated", "SheathFluid"],
        "sample_flow_rate_uL_min": 350,
        "sheath_flow_rate_uL_min": 750,
        "processing_time_min": 10,
        "operation": "mix (abstracts spiral chip separation)",
        "wbc_depletion_pct": "~99.99%",
        "notes": "WBC depletion uniform across 0-30 min window (900-1200 WBCs / 5 min, p=5.19E-05)"
      },
      {
        "id": "S13",
        "name": "PFA fixation (clinical IF arm)",
        "bb": "BB8",
        "protocol": "PROTOCOL 3",
        "reagent": "4% paraformaldehyde (Sigma, USA)",
        "operation": "mix + heat",
        "duration_min": 10,
        "temperature_C": 25,
        "notes": "Required before intracellular pan-cytokeratin antibody staining"
      },
      {
        "id": "S14",
        "name": "Triton X-100 permeabilization (clinical IF arm)",
        "bb": "BB8",
        "protocol": "PROTOCOL 3",
        "reagent": "0.1% Triton X-100 in PBS",
        "operation": "mix",
        "duration_min": 5
      },
      {
        "id": "S15",
        "name": "Immunofluorescence (IF) staining for CTC identification",
        "bb": "BB8",
        "protocol": "PROTOCOL 3",
        "staining_panel": {
          "pan_CK_FITC": { "dilution": "1:100", "supplier": "Miltenyi Biotec Asia Pacific, Singapore" },
          "APC_CD45": { "dilution": "1:100", "supplier": "Miltenyi Biotec Asia Pacific, Singapore" },
          "Hoechst": { "target": "DNA nuclear counterstain" }
        },
        "ctc_scoring_criteria": "Hoechst+ / Pan-CK+ / CD45-",
        "incubation_temperature_C": 4,
        "incubation_duration_min": 30,
        "imaging": "Epi-fluorescence microscopy and/or BD Accuri C6 flow cytometry",
        "operation": "mix + heat",
        "detection_module": "ctcDetection",
        "detection_duration_s": 30,
        "branch": {
          "pass": { "condition": "clinicalSignal > 0", "action": "proceed to HER2 FISH (BB10)", "bb": "BB10" },
          "fail": { "condition": "clinicalSignal <= 0", "action": "drain(stainedClinical)", "bb": "BB11" }
        }
      },
      {
        "id": "S16",
        "name": "HER2 FISH analysis on isolated CTCs",
        "bb": "BB10",
        "protocol": "PROTOCOL 3 -- pass branch only",
        "condition": "clinicalSignal > 0 only",
        "patient_subset": "HER2+ breast cancer patients (n=5)",
        "her2_amplification_criterion": "HER2/CEP17 ratio > 2 in single nuclei",
        "fish_steps": [
          {
            "step": "a",
            "name": "Cytospin onto slides",
            "instrument": "Cytospin centrifuge (Thermo Scientific, USA)",
            "speed_rpm": 600,
            "duration_min": 6
          },
          {
            "step": "b+c",
            "name": "PFA fixation and ethanol dehydration series",
            "fixation": "4% PFA, 10 min RT",
            "dehydration": "Ethanol series 80%, 90%, 100%",
            "bioscript_abstraction": "heat at 25c for 10m (single combined step)"
          },
          {
            "step": "d",
            "name": "RNase treatment",
            "reagent": "RNase 4 mg/mL (Sigma, USA) in PBS/0.2% Tween 20",
            "duration_min": 40,
            "temperature_C": 37,
            "purpose": "Remove RNA to prevent non-specific probe binding"
          },
          {
            "step": "e",
            "name": "Denaturation",
            "reagent": "70% formamide/2xSSC",
            "duration_min": 10,
            "temperature_C": 80,
            "purpose": "Denature dsDNA for probe access"
          },
          {
            "step": "f",
            "name": "Probe hybridization",
            "probes": ["HER-2/neu gene locus (red)", "CEP17 chromosome 17 centromere (green)"],
            "temperature_C": 42,
            "duration": "Overnight (approximated as 600 min = 36000 s in BioScript)",
            "conditions": "Dark, humid"
          },
          {
            "step": "g",
            "name": "Post-hybridization washes",
            "wash_1": { "reagent": "50% formamide/2xSSC", "temperature_C": 45, "duration_min": 5, "agitation": "shaking" },
            "wash_2": { "reagent": "2xSSC", "temperature_C": 45, "duration_min": 5, "agitation": "shaking" }
          },
          {
            "step": "h",
            "name": "DAPI counterstain and coverslip",
            "reagent": "DAPI (4',6-diamidino-2-phenylindole)",
            "coverslip": "50 x 50 mm (Fisher Scientific, USA)"
          }
        ],
        "results": {
          "her2_positive_CTCs": "2 of 5 HER2+ patients",
          "her2_negative_CTCs": "3 of 5 HER2+ patients (HER2/CEP17 < 2)",
          "conclusion": "HER2 status in disseminated CTCs does not correlate with primary tumor; indicates CTC heterogeneity (Fig. 5C)",
          "detection_module": "her2FISHDetection",
          "detection_duration_s": 30
        }
      }
    ],

    "cfg": {
      "basic_blocks": [
        { "id": "BB1",  "label": "main",         "type": "entry",        "content": "MCF-7 culture, blood prep, RBC lysis, MCF-7 spike, on-chip separation" },
        { "id": "BB2",  "label": "bsbbif_2_t",   "type": "branch_true",  "condition": "ctcSignal > 0",        "action": "dispose(mcf7Separated)" },
        { "id": "BB3",  "label": "bsbbif_3_f",   "type": "branch_false", "condition": "ctcSignal <= 0",       "action": "drain(mcf7Separated)" },
        { "id": "BB4",  "label": "bsbbif_4_j",   "type": "join",         "content": "T24 culture, fresh blood, RBC lysis, T24 spike, separation, fixation, permeabilization, PI+pan-CK staining" },
        { "id": "BB5",  "label": "bsbbif_5_t",   "type": "branch_true",  "condition": "viabilitySignal > 0",  "action": "dispose(stainedViability)" },
        { "id": "BB6",  "label": "bsbbif_6_f",   "type": "branch_false", "condition": "viabilitySignal <= 0", "action": "drain(stainedViability)" },
        { "id": "BB7",  "label": "bsbbif_7_j",   "type": "join",         "content": "Clinical blood, RBC lysis, on-chip sep, PFA fixation, Triton permeabilization, IF staining" },
        { "id": "BB8",  "label": "bsbbif_8_t",   "type": "branch_true",  "condition": "clinicalSignal > 0",   "action": "HER2 FISH (fixation, RNase, denaturation, hybridization, washes, DAPI)" },
        { "id": "BB9",  "label": "bsbbif_9_f",   "type": "branch_false", "condition": "clinicalSignal <= 0",  "action": "drain(stainedClinical)" },
        { "id": "BB10", "label": "bsbbif_10_j",  "type": "terminal",     "content": "dispose(clinicalSignal); NOP" }
      ],
      "edges": [
        ["BB1","BB2"], ["BB1","BB3"],
        ["BB2","BB4"], ["BB3","BB4"],
        ["BB4","BB5"], ["BB4","BB6"],
        ["BB5","BB7"], ["BB6","BB7"],
        ["BB7","BB8"], ["BB7","BB9"],
        ["BB8","BB10"],["BB9","BB10"]
      ]
    },

    "bioscript_notes": {
      "bs_file": "warkiani_spiral_ctc_enrichment.bs",
      "compiler": "lilott8/BioScript (ANTLR4-based)",
      "ir_output": "warkiani_spiral_ctc_enrichment.ir",
      "dag_output": "warkiani_spiral_ctc_enrichment_main_dag.dot",
      "basic_blocks": 10,
      "cfg_edges": 12,
      "if_else_gates": 3,
      "modules": ["ctcDetection", "viabilityDetection", "her2FISHDetection"],
      "manifests": [
        "WholeBlood", "RBCLysisBuffer", "PBS", "EDTA_BSA_Buffer",
        "MCF7_Cells", "T24_Cells", "SheathFluid",
        "Paraformaldehyde", "TritonX100",
        "PanCytokeratinFITC", "CD45_APC", "Hoechst", "PropidiumIodide",
        "RNase", "Formamide_SSC", "SSC_Wash", "HER2_FISHProbe", "DAPI"
      ],
      "duration_conversions": {
        "cell_culture_48h": "2880m = 172800s",
        "rbc_lysis_5min": "5m = 300s",
        "centrifugation_5min": "5m = 300s (heat at 25c)",
        "pfa_fixation_10min": "10m = 600s",
        "rnase_40min": "40m = 2400s",
        "denaturation_80c_10min": "10m = 600s",
        "hybridization_overnight": "600m = 36000s (10h approximation)",
        "post_hyb_wash_5min": "5m = 300s each",
        "spiral_separation_10min": "10m = 600s",
        "staining_30min": "30m = 1800s"
      },
      "key_abstractions": [
        "Continuous-flow spiral chip separation abstracted as `mix` (same convention as samlali.bs channel trapping)",
        "Centrifugation at 1000xg abstracted as `heat at 25c` (no centrifuge primitive in BioScript)",
        "Cell culture pre-incubation abstracted as `heat at 37c for 2880m` (samlali.bs convention)",
        "Overnight FISH hybridization at 42C approximated as 600m (BioScript s/m-only duration tokens)",
        "Three independent protocols encoded in sequence: MCF-7 recovery (P1), T24 viability (P2), clinical+FISH (P3)",
        "T24 viability arm uses independent WholeBlood dispense (not reusing MCF-7 nucleated fraction)"
      ],
      "fixes_applied": [
        "FIX1: T24 viability arm now uses its own independent blood preparation sequence",
        "FIX2: MCF-7 and T24 are fully independent experiments with separate blood dispenses",
        "FIX3: Viability staining panel includes pan-CK/CD45/Hoechst alongside PI",
        "FIX4: PFA fixation (Paraformaldehyde) and Triton X-100 permeabilization added as explicit steps in both viability and clinical IF arms",
        "FIX5: 80C FISH denaturation step (70% formamide/2xSSC, 10 min) added",
        "FIX6: RNase treatment (4 mg/mL, 37C, 40 min) added before denaturation",
        "FIX7: Post-hybridization wash steps at 45C (formamide/2xSSC then 2xSSC) added",
        "FIX8: Cell culture pre-incubation (heat at 37c for 2880m) added for both MCF-7 and T24"
      ]
    }
  }
}
