bsbbif_2_t:
	dispose(bhisDNA1[0])
	dispose(gmmDNA1[0])
	dispose(ycfaDNA1[0])
bsbbif_3_f:
	dispose(bhisDNA1[0])
	dispose(gmmDNA1[0])
	dispose(ycfaDNA1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(richnessSignal1[0])
	dispose(bhisProfile1[0])
	dispose(gmmProfile1[0])
	dispose(ycfaProfile1[0])
	sortingStool1[0] = dispense(FetalCellSuspension)
	bhisSortMedium1[0] = dispense(BHIS_Medium)
	bhisSortOil1[0] = dispense(HFE7500_Surfactant)
	sortSuspension1[0] = mix(sortingStool1[0], bhisSortMedium1[0]) @ 2.0SECOND
	sortDroplets1[0] = mix(sortSuspension1[0], bhisSortOil1[0]) @ 3.0SECOND
	heat(sortDroplets1[0]) @ 37.0CELSIUS @ 86400.0SECOND
	sortingSignal1[0] = detect(colonyDensityDetection, sortDroplets1[0]) @ 30.0SECOND
	if sortingSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	oilPrime1[0] = dispense(FC40_Oil)
	surfactantPrime1[0] = dispense(HFE7500_Surfactant)
	devicePrime1[0] = mix(oilPrime1[0], surfactantPrime1[0]) @ 300.0SECOND
	asfFecalStock1[0] = dispense(ASF_FecalPellet)
	asfMedium1[0] = dispense(BHIS_ASF_Medium)
	asfDiluted1[0] = mix(asfFecalStock1[0], asfMedium1[0]) @ 2.0SECOND
	asfOilPhase1[0] = dispense(HFE7500_Surfactant)
	asfDroplets1[0] = mix(asfDiluted1[0], asfOilPhase1[0]) @ 3.0SECOND
	heat(asfDroplets1[0]) @ 37.0CELSIUS @ 86400.0SECOND
	asfBreakingAgent1[0] = dispense(PFO_BreakingAgent)
	asfKit1[0] = dispense(DNAExtractionKit)
	asfBroken1[0] = mix(asfDroplets1[0], asfBreakingAgent1[0]) @ 2.0SECOND
	asfDNA1[0] = mix(asfBroken1[0], asfKit1[0]) @ 1800.0SECOND
	asfComposition1[0] = detect(sixteenSrRNASequencing, asfDNA1[0]) @ 30.0SECOND
	humanStoolBhis1[0] = dispense(FetalCellSuspension)
	humanStoolGmm1[0] = dispense(FetalCellSuspension)
	humanStoolYcfa1[0] = dispense(FetalCellSuspension)
	bhisMedium1[0] = dispense(BHIS_Medium)
	bhisOil1[0] = dispense(HFE7500_Surfactant)
	bhisSuspension1[0] = mix(humanStoolBhis1[0], bhisMedium1[0]) @ 2.0SECOND
	bhisDroplets1[0] = mix(bhisSuspension1[0], bhisOil1[0]) @ 3.0SECOND
	heat(bhisDroplets1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	gmmMedium1[0] = dispense(GMM_Medium)
	gmmOil1[0] = dispense(HFE7500_Surfactant)
	gmmSuspension1[0] = mix(humanStoolGmm1[0], gmmMedium1[0]) @ 2.0SECOND
	gmmDroplets1[0] = mix(gmmSuspension1[0], gmmOil1[0]) @ 3.0SECOND
	heat(gmmDroplets1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	ycfaMedium1[0] = dispense(YCFA_Medium)
	ycfaOil1[0] = dispense(HFE7500_Surfactant)
	ycfaSuspension1[0] = mix(humanStoolYcfa1[0], ycfaMedium1[0]) @ 2.0SECOND
	ycfaDroplets1[0] = mix(ycfaSuspension1[0], ycfaOil1[0]) @ 3.0SECOND
	heat(ycfaDroplets1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	bhisBreaker1[0] = dispense(PFO_BreakingAgent)
	gmmBreaker1[0] = dispense(PFO_BreakingAgent)
	ycfaBreaker1[0] = dispense(PFO_BreakingAgent)
	bhisBroken1[0] = mix(bhisDroplets1[0], bhisBreaker1[0]) @ 2.0SECOND
	gmmBroken1[0] = mix(gmmDroplets1[0], gmmBreaker1[0]) @ 2.0SECOND
	ycfaBroken1[0] = mix(ycfaDroplets1[0], ycfaBreaker1[0]) @ 2.0SECOND
	bhisKit1[0] = dispense(DNAExtractionKit)
	gmmKit1[0] = dispense(DNAExtractionKit)
	ycfaKit1[0] = dispense(DNAExtractionKit)
	bhisDNA1[0] = mix(bhisBroken1[0], bhisKit1[0]) @ 1800.0SECOND
	gmmDNA1[0] = mix(gmmBroken1[0], gmmKit1[0]) @ 1800.0SECOND
	ycfaDNA1[0] = mix(ycfaBroken1[0], ycfaKit1[0]) @ 1800.0SECOND
	bhisProfile1[0] = detect(sixteenSrRNASequencing, bhisDNA1[0]) @ 30.0SECOND
	gmmProfile1[0] = detect(sixteenSrRNASequencing, gmmDNA1[0]) @ 30.0SECOND
	ycfaProfile1[0] = detect(sixteenSrRNASequencing, ycfaDNA1[0]) @ 30.0SECOND
	combinedProfiles1[0] = mix(bhisProfile1[0], gmmProfile1[0]) @ 5.0SECOND
	richnessMeasure1[0] = mix(combinedProfiles1[0], ycfaProfile1[0]) @ 5.0SECOND
	richnessSignal1[0] = detect(colonyDensityDetection, richnessMeasure1[0]) @ 30.0SECOND
	if richnessSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	sortedBreaker1[0] = dispense(PFO_BreakingAgent)
	sortedKit1[0] = dispense(DNAExtractionKit)
	sortedBroken1[0] = mix(sortDroplets1[0], sortedBreaker1[0]) @ 2.0SECOND
	sortedDNA1[0] = mix(sortedBroken1[0], sortedKit1[0]) @ 1800.0SECOND
	sortedProfile1[0] = detect(sixteenSrRNASequencing, sortedDNA1[0]) @ 30.0SECOND
	dispose(sortedDNA1[0])
	dispose(sortedProfile1[0])
bsbbif_6_f:
	dispose(sortDroplets1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(sortingSignal1[0])
	sortedForViability1[0] = dispense(FetalCellSuspension)
	bhisAgarMedium1[0] = dispense(BHIS_Medium)
	platedSorted1[0] = mix(sortedForViability1[0], bhisAgarMedium1[0]) @ 2.0SECOND
	heat(platedSorted1[0]) @ 37.0CELSIUS @ 172800.0SECOND
	fdaPI_Stain1[0] = dispense(FDA_PI_Stain)
	stainedPlated1[0] = mix(platedSorted1[0], fdaPI_Stain1[0]) @ 600.0SECOND
	viabilitySignal1[0] = detect(dropletViabilityDetection, stainedPlated1[0]) @ 30.0SECOND
	if viabilitySignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(stainedPlated1[0])
	dispose(platedSorted1[0])
bsbbif_9_f:
	dispose(stainedPlated1[0])
	dispose(platedSorted1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(viabilitySignal1[0])
	dispose(asfComposition1[0])
	dispose(asfDNA1[0])
	dispose(richnessMeasure1[0])
	dispose(combinedProfiles1[0])
	NOP
