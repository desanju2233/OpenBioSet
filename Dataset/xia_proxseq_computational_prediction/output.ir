bsbbif_2_t:
	dispose(jurkatSeqReady1[0])
bsbbif_3_f:
	dispose(jurkatSeqReady1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(jurkatLibSignal1[0])
	rajiCells1[0] = dispense(RajiCells)
	cellPBS21[0] = dispense(PBS)
	rajiSuspension1[0] = mix(rajiCells1[0], cellPBS21[0]) @ 300.0SECOND
	blockingBuf21[0] = dispense(BlockingBuffer)
	rajiBlocked1[0] = mix(rajiSuspension1[0], blockingBuf21[0]) @ 600.0SECOND
	heat(rajiBlocked1[0]) @ 4.0CELSIUS @ 600.0SECOND
	probeAStain21[0] = dispense(ProxSeqProbeA)
	isotypeControl21[0] = dispense(IsotypeControlAntibody)
	probeAWithCtrl21[0] = mix(probeAStain21[0], isotypeControl21[0]) @ 5.0SECOND
	rajiProbeAStained1[0] = mix(rajiBlocked1[0], probeAWithCtrl21[0]) @ 1800.0SECOND
	heat(rajiProbeAStained1[0]) @ 4.0CELSIUS @ 1800.0SECOND
	wash1A21[0] = dispense(WashBuffer)
	wash2A21[0] = dispense(WashBuffer)
	wash3A21[0] = dispense(WashBuffer)
	rajiWashedA11[0] = mix(rajiProbeAStained1[0], wash1A21[0]) @ 120.0SECOND
	rajiWashedA21[0] = mix(rajiWashedA11[0], wash2A21[0]) @ 120.0SECOND
	rajiProbeAReady1[0] = mix(rajiWashedA21[0], wash3A21[0]) @ 120.0SECOND
	probeBStain21[0] = dispense(ProxSeqProbeB)
	rajiProbeBStained1[0] = mix(rajiProbeAReady1[0], probeBStain21[0]) @ 1800.0SECOND
	heat(rajiProbeBStained1[0]) @ 4.0CELSIUS @ 1800.0SECOND
	wash1B21[0] = dispense(WashBuffer)
	wash2B21[0] = dispense(WashBuffer)
	wash3B21[0] = dispense(WashBuffer)
	rajiWashedB11[0] = mix(rajiProbeBStained1[0], wash1B21[0]) @ 120.0SECOND
	rajiWashedB21[0] = mix(rajiWashedB11[0], wash2B21[0]) @ 120.0SECOND
	rajiDualStained1[0] = mix(rajiWashedB21[0], wash3B21[0]) @ 120.0SECOND
	freeOligoA21[0] = dispense(FreeOligoA)
	freeOligoB21[0] = dispense(FreeOligoB)
	freeOligoMix21[0] = mix(freeOligoA21[0], freeOligoB21[0]) @ 5.0SECOND
	rajiWithFreeOligos1[0] = mix(rajiDualStained1[0], freeOligoMix21[0]) @ 600.0SECOND
	heat(rajiWithFreeOligos1[0]) @ 4.0CELSIUS @ 600.0SECOND
	ligBuf21[0] = dispense(LigationBuffer)
	ligase21[0] = dispense(Ligase)
	ligReagents21[0] = mix(ligBuf21[0], ligase21[0]) @ 5.0SECOND
	rajiLigated1[0] = mix(rajiWithFreeOligos1[0], ligReagents21[0]) @ 1800.0SECOND
	heat(rajiLigated1[0]) @ 25.0CELSIUS @ 1800.0SECOND
	stopSol21[0] = dispense(StopSolution)
	rajiStopped1[0] = mix(rajiLigated1[0], stopSol21[0]) @ 300.0SECOND
	wash1L21[0] = dispense(WashBuffer)
	wash2L21[0] = dispense(WashBuffer)
	wash3L21[0] = dispense(WashBuffer)
	rajiWashedL11[0] = mix(rajiStopped1[0], wash1L21[0]) @ 120.0SECOND
	rajiWashedL21[0] = mix(rajiWashedL11[0], wash2L21[0]) @ 120.0SECOND
	rajiLigatedReady1[0] = mix(rajiWashedL21[0], wash3L21[0]) @ 120.0SECOND
	dnaLibBuf21[0] = dispense(DNALibraryBuffer)
	rajiLibPrep1[0] = mix(rajiLigatedReady1[0], dnaLibBuf21[0]) @ 1800.0SECOND
	heat(rajiLibPrep1[0]) @ 37.0CELSIUS @ 1800.0SECOND
	seqReagentR1[0] = dispense(SequencingReagent)
	rajiSeqReady1[0] = mix(rajiLibPrep1[0], seqReagentR1[0]) @ 600.0SECOND
	rajiLibSignal1[0] = detect(seqLibraryQC, rajiSeqReady1[0]) @ 30.0SECOND
	if rajiLibSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	jurkatCells1[0] = dispense(JurkatCells)
	cellPBS1[0] = dispense(PBS)
	jurkatSuspension1[0] = mix(jurkatCells1[0], cellPBS1[0]) @ 300.0SECOND
	blockingBuf1[0] = dispense(BlockingBuffer)
	blockedCells1[0] = mix(jurkatSuspension1[0], blockingBuf1[0]) @ 600.0SECOND
	heat(blockedCells1[0]) @ 4.0CELSIUS @ 600.0SECOND
	probeAStain1[0] = dispense(ProxSeqProbeA)
	isotypeControl1[0] = dispense(IsotypeControlAntibody)
	probeAWithControl1[0] = mix(probeAStain1[0], isotypeControl1[0]) @ 5.0SECOND
	probeAStained1[0] = mix(blockedCells1[0], probeAWithControl1[0]) @ 1800.0SECOND
