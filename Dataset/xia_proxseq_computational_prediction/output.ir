	heat(probeBStained1[0]) @ 4.0CELSIUS @ 1800.0SECOND
	wash1B1[0] = dispense(WashBuffer)
	wash2B1[0] = dispense(WashBuffer)
	wash3B1[0] = dispense(WashBuffer)
