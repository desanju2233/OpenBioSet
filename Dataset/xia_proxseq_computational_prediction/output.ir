	washedB21[0] = mix(washedB11[0], wash2B1[0]) @ 120.0SECOND
	jurkatDualStained1[0] = mix(washedB21[0], wash3B1[0]) @ 120.0SECOND
	freeOligoADrop1[0] = dispense(FreeOligoA)
	freeOligoBDrop1[0] = dispense(FreeOligoB)
	freeOligoMix1[0] = mix(freeOligoADrop1[0], freeOligoBDrop1[0]) @ 5.0SECOND
	jurkatWithFreeOligos1[0] = mix(jurkatDualStained1[0], freeOligoMix1[0]) @ 600.0SECOND
	heat(jurkatWithFreeOligos1[0]) @ 4.0CELSIUS @ 600.0SECOND
	ligBuf1[0] = dispense(LigationBuffer)
	ligase1[0] = dispense(Ligase)
	ligationReagents1[0] = mix(ligBuf1[0], ligase1[0]) @ 5.0SECOND
	jurkatLigated1[0] = mix(jurkatWithFreeOligos1[0], ligationReagents1[0]) @ 1800.0SECOND
	heat(jurkatLigated1[0]) @ 25.0CELSIUS @ 1800.0SECOND
	stopSol1[0] = dispense(StopSolution)
	jurkatStopped1[0] = mix(jurkatLigated1[0], stopSol1[0]) @ 300.0SECOND
	wash1L1[0] = dispense(WashBuffer)
	wash2L1[0] = dispense(WashBuffer)
	wash3L1[0] = dispense(WashBuffer)
	washedL11[0] = mix(jurkatStopped1[0], wash1L1[0]) @ 120.0SECOND
	washedL21[0] = mix(washedL11[0], wash2L1[0]) @ 120.0SECOND
	jurkatLigatedReady1[0] = mix(washedL21[0], wash3L1[0]) @ 120.0SECOND
	dnaLibBuf1[0] = dispense(DNALibraryBuffer)
	jurkatLibPrep1[0] = mix(jurkatLigatedReady1[0], dnaLibBuf1[0]) @ 1800.0SECOND
	heat(jurkatLibPrep1[0]) @ 37.0CELSIUS @ 1800.0SECOND
	seqReagentJ1[0] = dispense(SequencingReagent)
	jurkatSeqReady1[0] = mix(jurkatLibPrep1[0], seqReagentJ1[0]) @ 600.0SECOND
	jurkatLibSignal1[0] = detect(seqLibraryQC, jurkatSeqReady1[0]) @ 30.0SECOND
	if jurkatLibSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(rajiSeqReady1[0])
bsbbif_6_f:
	dispose(rajiSeqReady1[0])
