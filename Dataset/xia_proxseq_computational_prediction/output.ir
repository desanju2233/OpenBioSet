	washedA21[0] = mix(washedA11[0], wash2A1[0]) @ 120.0SECOND
	jurkatProbeAReady1[0] = mix(washedA21[0], wash3A1[0]) @ 120.0SECOND
	probeBStain1[0] = dispense(ProxSeqProbeB)
