bsbbif_2_t:
	dispose(sensor1_meas1[0])
bsbbif_3_f:
	dispose(sensor1_meas1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(denv1Signal1[0])
	aem_denv21[0] = dispense(DENV2_Oligoprobe_AEM)
	sensor2_sample1[0] = mix(ssdna_amplicons1[0], aem_denv21[0]) @ 900.0SECOND
	pbs_wash_21[0] = dispense(PBS_4x)
	sensor2_washed1[0] = mix(sensor2_sample1[0], pbs_wash_21[0]) @ 300.0SECOND
	pbs_meas_21[0] = dispense(PBS_0_1x)
	sensor2_meas1[0] = mix(sensor2_washed1[0], pbs_meas_21[0]) @ 60.0SECOND
	denv2Signal1[0] = detect(denv2Detection, sensor2_meas1[0]) @ 30.0SECOND
	if denv2Signal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	plasma_sample1[0] = dispense(HumanPlasma_DENV_RNA)
	trizol1[0] = dispense(TRIzol_Reagent)
	chloroform1[0] = dispense(Chloroform)
	trizol_mix1[0] = mix(plasma_sample1[0], trizol1[0]) @ 30.0SECOND
	lysed_sample1[0] = mix(trizol_mix1[0], chloroform1[0]) @ 60.0SECOND
	heat(lysed_sample1[0]) @ 25.0CELSIUS @ 120.0SECOND
	chitosan_disc1[0] = dispense(ChitosanFilterDisc)
	rna_captured1[0] = mix(lysed_sample1[0], chitosan_disc1[0]) @ 300.0SECOND
	sds_wash1[0] = dispense(SDS_Wash)
	di_water_wash1[0] = dispense(DI_Water)
	wash11[0] = mix(rna_captured1[0], sds_wash1[0]) @ 30.0SECOND
	washed_disc1[0] = mix(wash11[0], di_water_wash1[0]) @ 30.0SECOND
	pcr_mix1[0] = dispense(RT_PCR_MasterMix)
	primers_d1_d31[0] = dispense(DENV1_Primers)
	primers_d2_d41[0] = dispense(DENV2_Primers)
	primers_d31[0] = dispense(DENV3_Primers)
	primers_d41[0] = dispense(DENV4_Primers)
	iscript_rt1[0] = dispense(iScript_RT)
	nf_water1[0] = dispense(NucleaseFree_H2O)
	primer_mix_11[0] = mix(primers_d1_d31[0], primers_d2_d41[0]) @ 5.0SECOND
	primer_mix_21[0] = mix(primer_mix_11[0], primers_d31[0]) @ 5.0SECOND
	primer_mix_all1[0] = mix(primer_mix_21[0], primers_d41[0]) @ 5.0SECOND
	rt_master_mix1[0] = mix(pcr_mix1[0], iscript_rt1[0]) @ 5.0SECOND
	full_mix1[0] = mix(rt_master_mix1[0], primer_mix_all1[0]) @ 5.0SECOND
	rxn_mix1[0] = mix(full_mix1[0], nf_water1[0]) @ 5.0SECOND
	pcr_reaction1[0] = mix(rxn_mix1[0], washed_disc1[0]) @ 10.0SECOND
	heat(pcr_reaction1[0]) @ 50.0CELSIUS @ 1800.0SECOND
	heat(pcr_reaction1[0]) @ 95.0CELSIUS @ 120.0SECOND
	heat(pcr_reaction1[0]) @ 95.0CELSIUS @ 525.0SECOND
	heat(pcr_reaction1[0]) @ 55.0CELSIUS @ 2100.0SECOND
	heat(pcr_reaction1[0]) @ 95.0CELSIUS @ 300.0SECOND
	ssdna_amplicons1[0] = mix(pcr_reaction1[0], nf_water1[0]) @ 5.0SECOND
	aem_denv11[0] = dispense(DENV1_Oligoprobe_AEM)
	sensor1_sample1[0] = mix(ssdna_amplicons1[0], aem_denv11[0]) @ 900.0SECOND
	pbs_wash_11[0] = dispense(PBS_4x)
	sensor1_washed1[0] = mix(sensor1_sample1[0], pbs_wash_11[0]) @ 300.0SECOND
	pbs_meas_11[0] = dispense(PBS_0_1x)
	sensor1_meas1[0] = mix(sensor1_washed1[0], pbs_meas_11[0]) @ 60.0SECOND
	denv1Signal1[0] = detect(denv1Detection, sensor1_meas1[0]) @ 30.0SECOND
	if denv1Signal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(sensor2_meas1[0])
bsbbif_6_f:
	dispose(sensor2_meas1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(denv2Signal1[0])
	aem_denv31[0] = dispense(DENV3_Oligoprobe_AEM)
	sensor3_sample1[0] = mix(ssdna_amplicons1[0], aem_denv31[0]) @ 900.0SECOND
	pbs_wash_31[0] = dispense(PBS_4x)
	sensor3_washed1[0] = mix(sensor3_sample1[0], pbs_wash_31[0]) @ 300.0SECOND
	pbs_meas_31[0] = dispense(PBS_0_1x)
	sensor3_meas1[0] = mix(sensor3_washed1[0], pbs_meas_31[0]) @ 60.0SECOND
	denv3Signal1[0] = detect(denv3Detection, sensor3_meas1[0]) @ 30.0SECOND
	if denv3Signal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(sensor3_meas1[0])
bsbbif_9_f:
	dispose(sensor3_meas1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(denv3Signal1[0])
	aem_denv41[0] = dispense(DENV4_Oligoprobe_AEM)
	sensor4_sample1[0] = mix(ssdna_amplicons1[0], aem_denv41[0]) @ 900.0SECOND
	pbs_wash_41[0] = dispense(PBS_4x)
	sensor4_washed1[0] = mix(sensor4_sample1[0], pbs_wash_41[0]) @ 300.0SECOND
	pbs_meas_41[0] = dispense(PBS_0_1x)
	sensor4_meas1[0] = mix(sensor4_washed1[0], pbs_meas_41[0]) @ 60.0SECOND
	denv4Signal1[0] = detect(denv4Detection, sensor4_meas1[0]) @ 30.0SECOND
	if denv4Signal1[0] > 0	|	true: jump bsbbif_11_t	|	false: jump bsbbif_12_f
bsbbif_11_t:
	dispose(sensor4_meas1[0])
bsbbif_12_f:
	dispose(sensor4_meas1[0])
	jump: bsbbif_13_j
bsbbif_13_j:
	dispose(denv4Signal1[0])
	NOP
