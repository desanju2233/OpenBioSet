bsbbif_2_t:
	dispose(mcf7FlowMix1[0])
bsbbif_3_f:
	dispose(mcf7FlowMix1[0])
	jump: bsbbif_4_j
bsbbif_4_j:
	dispose(impedanceSignal1[0])
	primingMix21[0] = dispense(BSA_PBS)
	modFlowMix1[0] = mix(modMCF7_Ready1[0], primingMix21[0]) @ 2.0SECOND
	modSignal1[0] = detect(impedanceDetection, modFlowMix1[0]) @ 30.0SECOND
	if modSignal1[0] > 0	|	true: jump bsbbif_5_t	|	false: jump bsbbif_6_f
main:
	primingBSA1[0] = dispense(BSA_PBS)
	primingPBS1[0] = dispense(PBS)
	primingMix1[0] = mix(primingBSA1[0], primingPBS1[0]) @ 1200.0SECOND
	mcf7_for_mod1[0] = dispense(MCF7_Cells)
	pmaReagent1[0] = dispense(PMA_500nM)
	modTreatmentMix1[0] = mix(mcf7_for_mod1[0], pmaReagent1[0]) @ 5.0SECOND
	heat(modTreatmentMix1[0]) @ 37.0CELSIUS @ 64800.0SECOND
	modWashPBS1[0] = dispense(PBS)
	modMCF7_Ready1[0] = mix(modTreatmentMix1[0], modWashPBS1[0]) @ 60.0SECOND
	mcf7_for_fix1[0] = dispense(MCF7_Cells)
	formaldehydeSoln1[0] = dispense(Formaldehyde_4pct)
	fixationMix1[0] = mix(mcf7_for_fix1[0], formaldehydeSoln1[0]) @ 480.0SECOND
	glycineQuench1[0] = dispense(Glycine_127mM)
	quenchedFixation1[0] = mix(fixationMix1[0], glycineQuench1[0]) @ 300.0SECOND
	fixWashPBS1[0] = dispense(PBS)
	fixedMCF7_Ready1[0] = mix(quenchedFixation1[0], fixWashPBS1[0]) @ 60.0SECOND
	mcf7Live1[0] = dispense(MCF7_Cells)
	mcf7FlowMix1[0] = mix(mcf7Live1[0], primingMix1[0]) @ 2.0SECOND
	impedanceSignal1[0] = detect(impedanceDetection, mcf7FlowMix1[0]) @ 30.0SECOND
	if impedanceSignal1[0] > 0	|	true: jump bsbbif_2_t	|	false: jump bsbbif_3_f
bsbbif_5_t:
	dispose(modFlowMix1[0])
bsbbif_6_f:
	dispose(modFlowMix1[0])
	jump: bsbbif_7_j
bsbbif_7_j:
	dispose(modSignal1[0])
	primingMix31[0] = dispense(BSA_PBS)
	fixedFlowMix1[0] = mix(fixedMCF7_Ready1[0], primingMix31[0]) @ 2.0SECOND
	fixedSignal1[0] = detect(impedanceDetection, fixedFlowMix1[0]) @ 30.0SECOND
	if fixedSignal1[0] > 0	|	true: jump bsbbif_8_t	|	false: jump bsbbif_9_f
bsbbif_8_t:
	dispose(fixedFlowMix1[0])
bsbbif_9_f:
	dispose(fixedFlowMix1[0])
	jump: bsbbif_10_j
bsbbif_10_j:
	dispose(fixedSignal1[0])
	rbcSample1[0] = dispense(RBC_Cells)
	primingMix41[0] = dispense(BSA_PBS)
	rbcFlowMix1[0] = mix(rbcSample1[0], primingMix41[0]) @ 2.0SECOND
	rbcImpedance1[0] = detect(impedanceDetection, rbcFlowMix1[0]) @ 30.0SECOND
	rbcSignal1[0] = detect(passageTimeDetection, rbcFlowMix1[0]) @ 30.0SECOND
	if rbcSignal1[0] > 0	|	true: jump bsbbif_11_t	|	false: jump bsbbif_12_f
bsbbif_11_t:
	dispose(rbcFlowMix1[0])
bsbbif_12_f:
	dispose(rbcFlowMix1[0])
	jump: bsbbif_13_j
bsbbif_13_j:
	dispose(rbcImpedance1[0])
	dispose(rbcSignal1[0])
	NOP
